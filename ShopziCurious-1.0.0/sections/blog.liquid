{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.querySelector('.szc-blog-search-input');
    const searchForm = document.querySelector('.szc-blog-search-form');
    const countContainer = document.querySelector('.szc-blog-toolbar__count');
    const blogGrid = document.querySelector('.szc-blog-grid');
    const emptyState = document.getElementById('BlogSearchEmptyState');
    const clearEmptyBtn = document.getElementById('BlogClearSearchBtn');

    if (searchInput && blogGrid) {
      const articleCards = Array.from(blogGrid.querySelectorAll('.szc-article-card'));
      const originalCountText = countContainer ? countContainer.innerHTML : '';

      function filterArticles(query) {
        const q = (query || '').toLowerCase().trim();
        let visibleCount = 0;

        articleCards.forEach(function(card) {
          const text = card.textContent.toLowerCase();
          if (q === '' || text.includes(q)) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countContainer) {
          if (q !== '') {
            countContainer.textContent = `Showing ${visibleCount} result${visibleCount !== 1 ? 's' : ''} for "${query}"`;
          } else {
            countContainer.innerHTML = originalCountText;
          }
        }

        if (emptyState) {
          if (visibleCount === 0 && q !== '') {
            emptyState.style.display = 'block';
            blogGrid.style.display = 'none';
          } else {
            emptyState.style.display = 'none';
            blogGrid.style.display = '';
          }
        }

        let dynamicClearBtn = searchInput.parentElement.querySelector('.szc-blog-search-clear');
        if (q !== '') {
          if (!dynamicClearBtn) {
            dynamicClearBtn = document.createElement('a');
            dynamicClearBtn.href = '#';
            dynamicClearBtn.className = 'szc-blog-search-clear';
            dynamicClearBtn.setAttribute('aria-label', 'Clear search');
            dynamicClearBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;
            dynamicClearBtn.addEventListener('click', function(e) {
              e.preventDefault();
              searchInput.value = '';
              filterArticles('');
              const url = new URL(window.location.href);
              url.searchParams.delete('q');
              window.history.replaceState({}, '', url.toString());
            });
            searchInput.parentElement.insertBefore(dynamicClearBtn, searchInput.nextSibling);
          }
        } else if (dynamicClearBtn) {
          dynamicClearBtn.remove();
        }
      }

      const urlParams = new URLSearchParams(window.location.search);
      const urlQ = urlParams.get('q');
      if (urlQ) {
        searchInput.value = urlQ;
        filterArticles(urlQ);
      }

      searchInput.addEventListener('input', function() {
        filterArticles(this.value);
      });

      if (searchForm) {
        searchForm.addEventListener('submit', function(e) {
          e.preventDefault();
          filterArticles(searchInput.value);
          const url = new URL(window.location.href);
          if (searchInput.value.trim() !== '') {
            url.searchParams.set('q', searchInput.value.trim());
          } else {
            url.searchParams.delete('q');
          }
          window.history.replaceState({}, '', url.toString());
        });
      }

      if (clearEmptyBtn) {
        clearEmptyBtn.addEventListener('click', function() {
          searchInput.value = '';
          filterArticles('');
          const url = new URL(window.location.href);
          url.searchParams.delete('q');
          window.history.replaceState({}, '', url.toString());
        });
      }
    }

    const sortSelects = document.querySelectorAll('.szc-blog-sort-select');
    sortSelects.forEach(function(select) {
      select.addEventListener('change', function() {
        const url = new URL(window.location.href);
        if (this.value === 'oldest') {
          url.searchParams.set('sort_by', 'oldest');
        } else {
          url.searchParams.delete('sort_by');
        }
        window.location.href = url.toString();
      });
    });
  });
{% endjavascript %}

