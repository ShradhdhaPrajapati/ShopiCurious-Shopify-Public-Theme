{% doc %}
  Injects dynamic CSS Custom Properties (Variables) and Google/Shopify fonts
  configured by the merchant in Theme Settings.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Load Primary (Body) Font Variations %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {%- assign primary_font_bold = settings.type_primary_font | font_modify: 'weight', 'bold' -%}
  {%- if primary_font_bold -%}
    {{ primary_font_bold | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- assign primary_font_bold_italic = primary_font_bold | font_modify: 'style', 'italic' -%}
  {%- if primary_font_bold_italic -%}
    {{ primary_font_bold_italic | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- assign primary_font_italic = settings.type_primary_font | font_modify: 'style', 'italic' -%}
  {%- if primary_font_italic -%}
    {{ primary_font_italic | font_face: font_display: 'swap' }}
  {%- endif -%}

  {% # Load Heading Font Variations %}
  {% unless settings.type_heading_font.family == settings.type_primary_font.family %}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_bold = settings.type_heading_font | font_modify: 'weight', 'bold' -%}
    {%- if heading_font_bold -%}
      {{ heading_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- assign heading_font_italic = settings.type_heading_font | font_modify: 'style', 'italic' -%}
    {%- if heading_font_italic -%}
      {{ heading_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
  {% endunless %}

  {% # Load Navigation Font Variations %}
  {% unless settings.type_nav_font.family == settings.type_primary_font.family or settings.type_nav_font.family == settings.type_heading_font.family %}
    {{ settings.type_nav_font | font_face: font_display: 'swap' }}
    {%- assign nav_font_bold = settings.type_nav_font | font_modify: 'weight', 'bold' -%}
    {%- if nav_font_bold -%}
      {{ nav_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {% endunless %}

  {%- liquid
    assign primary_color = settings.color_primary | default: '#111111'
    assign secondary_color = settings.color_secondary | default: '#D4A373'
    assign accent_color = settings.color_accent | default: '#E76F51'
    assign bg_color = settings.color_background | default: '#FFFFFF'
    assign surface_color = settings.color_surface | default: '#F8F9FA'
    assign border_color = settings.color_border | default: '#E5E5E5'
    assign heading_color = settings.color_heading | default: '#111111'
    assign text_primary_color = settings.color_text_primary | default: '#2B2B2B'
    assign text_muted_color = settings.color_text_muted | default: '#757575'

    assign primary_rgb = primary_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | split: ','
    assign primary_r = primary_rgb[0] | strip
    assign primary_g = primary_rgb[1] | strip
    assign primary_b = primary_rgb[2] | strip

    assign secondary_rgb = secondary_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | split: ','
    assign secondary_r = secondary_rgb[0] | strip
    assign secondary_g = secondary_rgb[1] | strip
    assign secondary_b = secondary_rgb[2] | strip
  -%}

  :root {
    /* Font Families */
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};

    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--style: {{ settings.type_heading_font.style }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};

    --font-nav--family: {{ settings.type_nav_font.family }}, {{ settings.type_nav_font.fallback_families }};
    --font-nav--style: {{ settings.type_nav_font.style }};
    --font-nav--weight: {{ settings.type_nav_font.weight }};

    --szc-font-family-body: var(--font-primary--family);
    --szc-font-family-heading: var(--font-heading--family);
    --szc-font-family-nav: var(--font-nav--family);

    --szc-font-weight-body: var(--font-primary--weight);
    --szc-font-weight-heading: var(--font-heading--weight);
    --szc-font-weight-nav: var(--font-nav--weight);

    --szc-font-size-base: {{ settings.base_font_size | default: 16 }}px;
    --szc-heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};

    --szc-font-size-h6: calc(clamp(1.1rem, 1rem + 0.4vw, 1.25rem) * var(--szc-heading-scale, 1));
    --szc-font-size-h5: calc(clamp(1.25rem, 1.1rem + 0.7vw, 1.5rem) * var(--szc-heading-scale, 1));
    --szc-font-size-h4: calc(clamp(1.5rem, 1.3rem + 1vw, 1.875rem) * var(--szc-heading-scale, 1));
    --szc-font-size-h3: calc(clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem) * var(--szc-heading-scale, 1));
    --szc-font-size-h2: calc(clamp(2.1rem, 1.6rem + 2vw, 2.85rem) * var(--szc-heading-scale, 1));
    --szc-font-size-h1: calc(clamp(2.5rem, 1.8rem + 3vw, 3.75rem) * var(--szc-heading-scale, 1));
    --szc-font-size-display: calc(clamp(3rem, 2rem + 4vw, 5rem) * var(--szc-heading-scale, 1));

    /* Dynamic Fashion Color Palette */
    --szc-color-primary: {{ primary_color }};
    --szc-color-primary-light: {{ primary_color | color_lighten: 15 }};
    --szc-color-primary-dark: {{ primary_color | color_darken: 15 }};
    --szc-color-primary-rgb: {{ primary_r }}, {{ primary_g }}, {{ primary_b }};

    --szc-color-secondary: {{ secondary_color }};
    --szc-color-secondary-light: {{ secondary_color | color_lighten: 15 }};
    --szc-color-secondary-dark: {{ secondary_color | color_darken: 15 }};
    --szc-color-secondary-rgb: {{ secondary_r }}, {{ secondary_g }}, {{ secondary_b }};

    --szc-color-accent: {{ accent_color }};
    --szc-color-accent-light: {{ accent_color | color_lighten: 15 }};
    --szc-color-accent-dark: {{ accent_color | color_darken: 15 }};

    --szc-color-background: {{ bg_color }};
    --szc-color-surface: {{ surface_color }};
    --szc-color-surface-subtle: {{ surface_color | color_darken: 3 }};
    --szc-color-surface-elevated: {{ bg_color }};

    --szc-color-heading: {{ heading_color }};
    --szc-color-text-primary: {{ text_primary_color }};
    --szc-color-text-secondary: {{ text_muted_color }};
    --szc-color-text-muted: {{ text_muted_color }};
    --szc-color-text-inverse: {{ bg_color }};

    --szc-color-border: {{ border_color }};
    --szc-color-border-subtle: {{ border_color | color_lighten: 5 }};
    --szc-color-border-strong: {{ border_color | color_darken: 10 }};

    --szc-color-success: {{ settings.color_success | default: '#2A9D8F' }};
    --szc-color-warning: {{ settings.color_warning | default: '#E9C46A' }};
    --szc-color-error: {{ settings.color_error | default: '#E63946' }};
    --szc-color-overlay: {{ settings.color_overlay | default: '#000000' }};

    /* Layout & Container Tokens */
    --page-width: {{ settings.max_page_width | default: '1280px' }};
    --page-margin: {{ settings.min_page_margin | default: 20 }}px;
    --szc-container-max-width: var(--page-width);
    --szc-container-padding: var(--page-margin);
    --szc-section-spacing-desktop: {{ settings.section_spacing_desktop | default: 80 }}px;
    --szc-grid-gap: {{ settings.grid_gap | default: 24 }}px;

    /* Border Radii */
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 2 }}px;
    --szc-radius-input: {{ settings.input_corner_radius | default: 2 }}px;
    --szc-radius-button: {{ settings.button_corner_radius | default: 2 }}px;
    --szc-radius-card: {{ settings.card_corner_radius | default: 18 }}px;

    /* Component Heights & Styles */
    --szc-button-height: {{ settings.button_height | default: '48px' }};
  }

  {% # Primary Button Design %}
  {% if settings.primary_button_style == 'accent' %}
    .szc-btn--primary {
      background-color: var(--szc-color-accent) !important;
      color: #ffffff !important;
      border-color: var(--szc-color-accent) !important;
    }
    .szc-btn--primary:hover {
      background-color: var(--szc-color-accent-dark) !important;
      border-color: var(--szc-color-accent-dark) !important;
    }
  {% elsif settings.primary_button_style == 'outline' %}
    .szc-btn--primary {
      background-color: transparent !important;
      color: var(--szc-color-primary) !important;
      border: 1px solid var(--szc-color-primary) !important;
    }
    .szc-btn--primary:hover {
      background-color: var(--szc-color-primary) !important;
      color: var(--szc-color-text-inverse) !important;
    }
  {% endif %}

  {% # Button Hover Effect %}
  {% if settings.button_hover_effect == 'lift' %}
    .szc-btn:hover,
    button.szc-btn:hover,
    a.szc-btn:hover {
      transform: translateY(-2px) !important;
      box-shadow: var(--szc-shadow-md) !important;
    }
  {% elsif settings.button_hover_effect == 'color_shift' %}
    .szc-btn:hover,
    button.szc-btn:hover,
    a.szc-btn:hover {
      transform: none !important;
      box-shadow: none !important;
      filter: brightness(0.88) !important;
    }
  {% elsif settings.button_hover_effect == 'none' %}
    .szc-btn:hover,
    button.szc-btn:hover,
    a.szc-btn:hover {
      transform: none !important;
      box-shadow: none !important;
      filter: none !important;
    }
  {% endif %}

  {% # Card Visual Style %}
  {% if settings.card_style == 'bordered' %}
    .szc-product-card,
    .szc-product-card--box-hover,
    .szc-featured-collection .szc-product-card,
    .szc-featured-collection--box-hover .szc-product-card {
      border: 1px solid var(--szc-color-border, #e5e5e5) !important;
      box-shadow: none !important;
      background-color: var(--szc-color-surface, #ffffff) !important;
      padding: 10px 10px 14px 10px !important;
      border-radius: 18px !important;
    }
    .szc-product-card:hover,
    .szc-product-card--box-hover:hover,
    .szc-featured-collection .szc-product-card:hover,
    .szc-featured-collection--box-hover .szc-product-card:hover {
      border-color: var(--szc-color-border-strong, #111111) !important;
      box-shadow: none !important;
    }
  {% elsif settings.card_style == 'flat' %}
    .szc-product-card,
    .szc-product-card--box-hover,
    .szc-featured-collection .szc-product-card,
    .szc-featured-collection--box-hover .szc-product-card {
      box-shadow: none !important;
      border: 1px solid transparent !important;
      background-color: transparent !important;
      padding: 0 !important;
      border-radius: 0 !important;
    }
    .szc-product-card .szc-product-card__info,
    .szc-product-card--box-hover .szc-product-card__info,
    .szc-featured-collection .szc-product-card .szc-product-card__info,
    .szc-featured-collection--box-hover .szc-product-card .szc-product-card__info {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .szc-product-card:hover,
    .szc-product-card--box-hover:hover,
    .szc-featured-collection .szc-product-card:hover,
    .szc-featured-collection--box-hover .szc-product-card:hover {
      box-shadow: none !important;
      border-color: transparent !important;
    }
  {% else %}
    {% # Default: Elevated Soft Shadow (White Card, 18px radius, soft shadow, framed 10px padding) %}
    .szc-product-card,
    .szc-product-card--box-hover,
    .szc-featured-collection .szc-product-card,
    .szc-featured-collection--box-hover .szc-product-card {
      box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.11), 0 4px 12px rgba(0, 0, 0, 0.04) !important;
      border: 1px solid rgba(0, 0, 0, 0.05) !important;
      background-color: #ffffff !important;
      padding: 10px 10px 14px 10px !important;
      border-radius: 18px !important;
    }
    .szc-product-card:hover,
    .szc-product-card--box-hover:hover,
    .szc-featured-collection .szc-product-card:hover,
    .szc-featured-collection--box-hover .szc-product-card:hover {
      box-shadow: 0 22px 48px -10px rgba(0, 0, 0, 0.18), 0 8px 20px rgba(0, 0, 0, 0.06) !important;
      border-color: rgba(0, 0, 0, 0.08) !important;
    }
  {% endif %}

  {% # Card Hover Micro-Animation %}
  {% if settings.card_hover_effect == 'lift' %}
    @media (hover: hover) and (pointer: fine) {
      .szc-product-card,
      .szc-product-card--box-hover,
      .szc-featured-collection .szc-product-card,
      .szc-featured-collection--box-hover .szc-product-card,
      .szc-card,
      .szc-card-collection,
      .szc-collection-card,
      .szc-article-card {
        transition: transform var(--szc-transition-base, 350ms cubic-bezier(0.25, 1, 0.5, 1)), box-shadow var(--szc-transition-base, 350ms ease), border-color var(--szc-transition-base, 350ms ease) !important;
      }
      .szc-product-card:hover,
      .szc-product-card--box-hover:hover,
      .szc-featured-collection .szc-product-card:hover,
      .szc-featured-collection--box-hover .szc-product-card:hover,
      .szc-card:hover,
      .szc-card-collection:hover,
      .szc-collection-card:hover,
      .szc-article-card:hover {
        transform: translateY(-6px) !important;
        box-shadow: 0 22px 48px -10px rgba(0, 0, 0, 0.18), 0 8px 20px rgba(0, 0, 0, 0.06) !important;
      }
      .szc-product-card:hover .szc-product-card__image,
      .szc-product-card:hover .szc-product-card__image--primary,
      .szc-product-card--box-hover:hover .szc-product-card__image,
      .szc-product-card--box-hover:hover .szc-product-card__image--primary,
      .szc-featured-collection .szc-product-card:hover .szc-product-card__image,
      .szc-featured-collection .szc-product-card:hover .szc-product-card__image--primary,
      .szc-featured-collection--box-hover .szc-product-card:hover .szc-product-card__image,
      .szc-featured-collection--box-hover .szc-product-card:hover .szc-product-card__image--primary,
      .szc-card:hover .szc-card__media img,
      .szc-card-collection:hover .szc-card-collection__image,
      .szc-collection-card:hover .szc-collection-card__image img,
      .szc-article-card:hover .szc-article-card__img {
        transform: none !important;
      }
    }
  {% elsif settings.card_hover_effect == 'none' %}
    @media (hover: hover) and (pointer: fine) {
      .szc-product-card:hover,
      .szc-product-card--box-hover:hover,
      .szc-featured-collection .szc-product-card:hover,
      .szc-featured-collection--box-hover .szc-product-card:hover,
      .szc-card:hover,
      .szc-card-collection:hover,
      .szc-collection-card:hover,
      .szc-article-card:hover {
        transform: none !important;
        {% if settings.card_style != 'shadow' %}
          box-shadow: none !important;
        {% endif %}
      }
      .szc-product-card:hover .szc-product-card__image,
      .szc-product-card:hover .szc-product-card__image--primary,
      .szc-product-card--box-hover:hover .szc-product-card__image,
      .szc-product-card--box-hover:hover .szc-product-card__image--primary,
      .szc-featured-collection .szc-product-card:hover .szc-product-card__image,
      .szc-featured-collection .szc-product-card:hover .szc-product-card__image--primary,
      .szc-featured-collection--box-hover .szc-product-card:hover .szc-product-card__image,
      .szc-featured-collection--box-hover .szc-product-card:hover .szc-product-card__image--primary,
      .szc-card:hover .szc-card__media img,
      .szc-card-collection:hover .szc-card-collection__image,
      .szc-collection-card:hover .szc-collection-card__image img,
      .szc-article-card:hover .szc-article-card__img {
        transform: none !important;
      }
    }
  {% else %}
    {% # Inner Image Zoom (Default) %}
    @media (hover: hover) and (pointer: fine) {
      .szc-product-card,
      .szc-product-card--box-hover,
      .szc-featured-collection .szc-product-card,
      .szc-featured-collection--box-hover .szc-product-card,
      .szc-card,
      .szc-card-collection,
      .szc-collection-card,
      .szc-article-card {
        transform: none !important;
        transition: border-color var(--szc-transition-base, 250ms ease) !important;
      }
      .szc-product-card:hover,
      .szc-product-card--box-hover:hover,
      .szc-featured-collection .szc-product-card:hover,
      .szc-featured-collection--box-hover .szc-product-card:hover,
      .szc-card:hover,
      .szc-card-collection:hover,
      .szc-collection-card:hover,
      .szc-article-card:hover {
        transform: none !important;
        {% if settings.card_style == 'flat' or settings.card_style == nil or settings.card_style == blank %}
          box-shadow: none !important;
        {% endif %}
      }
      .szc-product-card .szc-product-card__image,
      .szc-product-card--box-hover .szc-product-card__image,
      .szc-product-card .szc-product-card__image--primary,
      .szc-featured-collection .szc-product-card .szc-product-card__image,
      .szc-featured-collection .szc-product-card .szc-product-card__image--primary,
      .szc-featured-collection--box-hover .szc-product-card .szc-product-card__image,
      .szc-featured-collection--box-hover .szc-product-card .szc-product-card__image--primary,
      .szc-card .szc-card__media img,
      .szc-card-collection .szc-card-collection__image,
      .szc-collection-card .szc-collection-card__image img,
      .szc-article-card .szc-article-card__img {
        transition: transform var(--szc-transition-slow, 450ms cubic-bezier(0.25, 1, 0.5, 1)) !important;
      }
      .szc-product-card:hover .szc-product-card__image,
      .szc-product-card:hover .szc-product-card__image--primary,
      .szc-product-card--box-hover:hover .szc-product-card__image,
      .szc-product-card--box-hover:hover .szc-product-card__image--primary,
      .szc-featured-collection .szc-product-card:hover .szc-product-card__image,
      .szc-featured-collection .szc-product-card:hover .szc-product-card__image--primary,
      .szc-featured-collection--box-hover .szc-product-card:hover .szc-product-card__image,
      .szc-featured-collection--box-hover .szc-product-card:hover .szc-product-card__image--primary,
      .szc-card:hover .szc-card__media img,
      .szc-card-collection:hover .szc-card-collection__image,
      .szc-collection-card:hover .szc-collection-card__image img,
      .szc-article-card:hover .szc-article-card__img {
        transform: scale(1.06) !important;
      }
    }
  {% endif %}

  {% if settings.accessibility_focus_ring != false %}
    *:focus-visible {
      outline: 2px solid var(--szc-color-secondary, #d4a373) !important;
      outline-offset: 2px !important;
    }
  {% endif %}

  {% if settings.respect_reduced_motion != false %}
    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  {% endif %}
{% endstyle %}
