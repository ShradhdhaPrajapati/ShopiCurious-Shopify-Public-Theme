{% doc %}
  Renders a floating back-to-top scroll button.

  @example
  {% render 'back-to-top' %}
{% enddoc %}

{%- if settings.enable_back_to_top != false -%}
  <button
    type="button"
    class="szc-back-to-top"
    id="SzcBackToTop"
    aria-label="{{ 'general.accessibility.back_to_top' | t | default: 'Back to top' }}"
    title="{{ 'general.accessibility.back_to_top' | t | default: 'Back to top' }}"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
{%- endif -%}

{% stylesheet %}
  .szc-back-to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--szc-color-heading, #111111);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.2s ease,
                box-shadow 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
  }

  .szc-back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .szc-back-to-top:hover {
    background: var(--szc-color-primary, #000000);
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  .szc-back-to-top:focus-visible {
    outline: 2px solid var(--szc-color-secondary, #d4a373);
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .szc-back-to-top {
      bottom: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const btn = document.getElementById('SzcBackToTop');
    if (!btn) return;

    const toggleBtn = () => {
      if (window.scrollY > 300) {
        btn.classList.add('is-visible');
      } else {
        btn.classList.remove('is-visible');
      }
    };

    window.addEventListener('scroll', toggleBtn, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    toggleBtn();
  })();
{% endjavascript %}
