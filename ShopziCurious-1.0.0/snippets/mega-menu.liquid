{% doc %}
  Renders a 100% dynamic mega menu panel for a header navigation link.
  Supports Type 1 (Mega Menu - Image Left) and Type 2 (Mega Menu - Products Right).
  Zero static dummy text or hardcoded products. All arrows are inline SVGs.

  @param {object} link - The parent link object
  @param {object} mega_block - The mega menu block object
  @param {object} section - The parent section object
{% enddoc %}

{%- assign menu_type = mega_block.settings.menu_type | default: 'mega_image_left' -%}
{%- if menu_type == 'mega' -%}
  {%- assign menu_type = 'mega_image_left' -%}
{%- endif -%}

<div class="szc-mega-menu szc-mega-menu--{{ menu_type }}" id="MegaMenu-{{ link.handle }}" role="region" aria-label="Mega menu for {{ link.title }}">
  <div class="szc-mega-menu__container page-width">

    {%- if menu_type == 'mega_products_right' -%}
      <!-- ===================================================================
           TYPE 2: MEGA MENU — PRODUCTS RIGHT (100% DYNAMIC)
           =================================================================== -->
      <div class="szc-mega-menu__grid szc-mega-menu__grid--products-right">
        <!-- 3 LEFT LINK COLUMNS -->
        <div class="szc-mega-menu__left-nav">

          <!-- COLUMN 1: SHOP BY CATEGORY -->
          {%- if mega_block.settings.show_categories != false -%}
            {%- assign cat_setting = mega_block.settings.categories_menu -%}
            {%- assign category_links = nil -%}
            {%- if cat_setting != blank -%}
              {%- if cat_setting.links != blank -%}
                {%- assign category_links = cat_setting.links -%}
              {%- elsif linklists[cat_setting] != blank and linklists[cat_setting].links != blank -%}
                {%- assign category_links = linklists[cat_setting].links -%}
              {%- endif -%}
            {%- endif -%}
            {%- if category_links == nil and link.links.size > 0 -%}
              {%- assign category_links = link.links -%}
            {%- endif -%}

            {%- if category_links != blank and category_links.size > 0 -%}
              <div class="szc-mega-col szc-mega-col--links">
                {%- if mega_block.settings.category_title != blank -%}
                  <h4 class="szc-mega-col__title">{{ mega_block.settings.category_title }}</h4>
                {%- elsif cat_setting.title != blank -%}
                  <h4 class="szc-mega-col__title">{{ cat_setting.title }}</h4>
                {%- endif -%}
                <ul class="szc-mega-links-list">
                  {%- for cat_l in category_links -%}
                    <li><a href="{{ cat_l.url }}" class="szc-mega-simple-link">{{ cat_l.title }}</a></li>
                  {%- endfor -%}
                </ul>
                {%- if mega_block.settings.categories_view_all_url != blank -%}
                  <a href="{{ mega_block.settings.categories_view_all_url }}" class="szc-mega-view-all-link">
                    <span>{{ 'sections.collection_list.view_all' | t }}</span>
                    <svg class="szc-view-all-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                {%- endif -%}
              </div>
              <div class="szc-mega-divider"></div>
            {%- endif -%}
          {%- endif -%}

          <!-- COLUMN 2: SHOP BY OCCASION -->
          {%- if mega_block.settings.show_occasions != false -%}
            {%- assign occ_setting = mega_block.settings.occasions_menu -%}
            {%- assign occ_links = nil -%}
            {%- if occ_setting != blank -%}
              {%- if occ_setting.links != blank -%}
                {%- assign occ_links = occ_setting.links -%}
              {%- elsif linklists[occ_setting] != blank and linklists[occ_setting].links != blank -%}
                {%- assign occ_links = linklists[occ_setting].links -%}
              {%- endif -%}
            {%- endif -%}

            {%- if occ_links != blank and occ_links.size > 0 -%}
              <div class="szc-mega-col szc-mega-col--links">
                {%- if mega_block.settings.occasions_title != blank -%}
                  <h4 class="szc-mega-col__title">{{ mega_block.settings.occasions_title }}</h4>
                {%- elsif occ_setting.title != blank -%}
                  <h4 class="szc-mega-col__title">{{ occ_setting.title }}</h4>
                {%- endif -%}
                <ul class="szc-mega-links-list">
                  {%- for occ_l in occ_links -%}
                    <li><a href="{{ occ_l.url }}" class="szc-mega-simple-link">{{ occ_l.title }}</a></li>
                  {%- endfor -%}
                </ul>
                {%- if mega_block.settings.occasions_view_all_url != blank -%}
                  <a href="{{ mega_block.settings.occasions_view_all_url }}" class="szc-mega-view-all-link">
                    <span>{{ 'sections.collection_list.view_all' | t }}</span>
                    <svg class="szc-view-all-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                {%- endif -%}
              </div>
              <div class="szc-mega-divider"></div>
            {%- endif -%}
          {%- endif -%}

          <!-- COLUMN 3: SHOP BY COLLECTION -->
          {%- if mega_block.settings.show_collections_col != false -%}
            {%- assign coll_setting = mega_block.settings.collections_col_menu -%}
            {%- assign col_links = nil -%}
            {%- if coll_setting != blank -%}
              {%- if coll_setting.links != blank -%}
                {%- assign col_links = coll_setting.links -%}
              {%- elsif linklists[coll_setting] != blank and linklists[coll_setting].links != blank -%}
                {%- assign col_links = linklists[coll_setting].links -%}
              {%- endif -%}
            {%- endif -%}

            {%- if col_links != blank and col_links.size > 0 -%}
              <div class="szc-mega-col szc-mega-col--links">
                {%- if mega_block.settings.collections_col_title != blank -%}
                  <h4 class="szc-mega-col__title">{{ mega_block.settings.collections_col_title }}</h4>
                {%- elsif coll_setting.title != blank -%}
                  <h4 class="szc-mega-col__title">{{ coll_setting.title }}</h4>
                {%- endif -%}
                <ul class="szc-mega-links-list">
                  {%- for cl in col_links -%}
                    <li><a href="{{ cl.url }}" class="szc-mega-simple-link">{{ cl.title }}</a></li>
                  {%- endfor -%}
                </ul>
                {%- if mega_block.settings.collections_col_view_all_url != blank -%}
                  <a href="{{ mega_block.settings.collections_col_view_all_url }}" class="szc-mega-view-all-link">
                    <span>{{ 'sections.collection_list.view_all' | t }}</span>
                    <svg class="szc-view-all-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="szc-mega-divider szc-mega-divider--major"></div>

        <!-- RIGHT SIDE: DYNAMIC HORIZONTAL PRODUCT CARDS SHOWCASE -->
        {%- assign showcase_col = mega_block.settings.new_arrivals_collection -%}
        {%- assign showcase_products = nil -%}
        {%- if showcase_col != blank -%}
          {%- if showcase_col.products != blank -%}
            {%- assign showcase_products = showcase_col.products -%}
          {%- elsif collections[showcase_col] != blank -%}
            {%- assign showcase_products = collections[showcase_col].products -%}
          {%- endif -%}
        {%- endif -%}
        {%- if showcase_products == nil or showcase_products.size == 0 -%}
          {%- if link.type == 'collection_link' and link.object.products.size > 0 -%}
            {%- assign showcase_products = link.object.products -%}
          {%- else -%}
            {%- assign showcase_products = collections.all.products -%}
          {%- endif -%}
        {%- endif -%}

        {%- if showcase_products != blank and showcase_products.size > 0 -%}
          <div class="szc-mega-col szc-mega-col--showcase">
            {%- if mega_block.settings.new_arrivals_title != blank -%}
              <h4 class="szc-mega-col__title">{{ mega_block.settings.new_arrivals_title }}</h4>
            {%- endif -%}
            <div class="szc-mega-products-showcase">
              {%- assign showcase_limit = mega_block.settings.products_to_show | default: 4 -%}
              {%- for product in showcase_products limit: showcase_limit -%}
                {%- assign is_on_sale = false -%}
                {%- if product.compare_at_price > product.price -%}
                  {%- assign is_on_sale = true -%}
                {%- endif -%}
                <a href="{{ product.url }}" class="szc-mega-showcase-card">
                  <div class="szc-mega-showcase-thumb">
                    {%- if is_on_sale -%}
                      <span class="szc-showcase-badge szc-showcase-badge--sale">{{ 'products.product.on_sale' | t | default: 'Sale' }}</span>
                    {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
                      <span class="szc-showcase-badge szc-showcase-badge--new">{{ 'products.product.new' | t }}</span>
                    {%- endif -%}
                    {%- if product.featured_media != blank -%}
                      {{ product.featured_media | image_url: width: 340 | image_tag: loading: 'lazy', alt: product.title }}
                    {%- elsif product.featured_image != blank -%}
                      {{ product.featured_image | image_url: width: 340 | image_tag: loading: 'lazy', alt: product.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'szc-placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <h5 class="szc-mega-showcase-title">{{ product.title }}</h5>
                  <div class="szc-mega-showcase-pricing">
                    <span class="szc-mega-showcase-price {% if is_on_sale %}is-sale-price{% endif %}">{{ product.price | money }}</span>
                    {%- if is_on_sale -%}
                      <span class="szc-mega-showcase-compare">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

    {%- else -%}
      <!-- ===================================================================
           TYPE 1: MEGA MENU — IMAGE LEFT (100% DYNAMIC)
           =================================================================== -->
      <div class="szc-mega-menu__grid szc-mega-menu__grid--image-left">

        <!-- COLUMN 1: LEFT PROMO BANNER (DYNAMIC) -->
        {%- if mega_block.settings.show_banner -%}
          {%- if mega_block.settings.banner_image != blank or mega_block.settings.banner_heading != blank -%}
            <div class="szc-mega-col szc-mega-col--banner">
              <div class="szc-mega-banner-card">
                <div class="szc-mega-banner-img-wrap">
                  {%- if mega_block.settings.banner_image != blank -%}
                    {{ mega_block.settings.banner_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: mega_block.settings.banner_heading | default: link.title }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="szc-mega-banner-content">
                  {%- if mega_block.settings.banner_subtitle != blank -%}
                    <span class="szc-mega-banner-sub">{{ mega_block.settings.banner_subtitle }}</span>
                  {%- endif -%}
                  {%- if mega_block.settings.banner_heading != blank -%}
                    <h3 class="szc-mega-banner-title">{{ mega_block.settings.banner_heading }}</h3>
                  {%- endif -%}
                  {%- if mega_block.settings.banner_description != blank -%}
                    <p class="szc-mega-banner-desc">{{ mega_block.settings.banner_description }}</p>
                  {%- endif -%}
                  {%- if mega_block.settings.banner_button_label != blank -%}
                    <a href="{{ mega_block.settings.banner_button_link | default: link.url }}" class="szc-mega-banner-btn">
                      <span>{{ mega_block.settings.banner_button_label }}</span>
                      <svg class="szc-btn-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
            <div class="szc-mega-divider"></div>
          {%- endif -%}
        {%- endif -%}

        <!-- COLUMN 2: SHOP BY CATEGORY (DYNAMIC) -->
        {%- if mega_block.settings.show_categories != false -%}
          {%- assign cat_setting = mega_block.settings.categories_menu -%}
          {%- assign category_links = nil -%}
          {%- if cat_setting != blank -%}
            {%- if cat_setting.links != blank -%}
              {%- assign category_links = cat_setting.links -%}
            {%- elsif linklists[cat_setting] != blank and linklists[cat_setting].links != blank -%}
              {%- assign category_links = linklists[cat_setting].links -%}
            {%- endif -%}
          {%- endif -%}
          {%- if category_links == nil and link.links.size > 0 -%}
            {%- assign category_links = link.links -%}
          {%- endif -%}

          {%- if category_links != blank and category_links.size > 0 -%}
            <div class="szc-mega-col szc-mega-col--links">
              {%- if mega_block.settings.category_title != blank -%}
                <h4 class="szc-mega-col__title">{{ mega_block.settings.category_title }}</h4>
              {%- elsif cat_setting.title != blank -%}
                <h4 class="szc-mega-col__title">{{ cat_setting.title }}</h4>
              {%- endif -%}
              <ul class="szc-mega-links-list">
                {%- for cat_l in category_links -%}
                  <li><a href="{{ cat_l.url }}" class="szc-mega-simple-link">{{ cat_l.title }}</a></li>
                {%- endfor -%}
              </ul>
              {%- if mega_block.settings.categories_view_all_url != blank -%}
                <a href="{{ mega_block.settings.categories_view_all_url }}" class="szc-mega-view-all-link">
                  <span>{{ 'sections.collection_list.view_all' | t }}</span>
                  <svg class="szc-view-all-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              {%- endif -%}
            </div>
            <div class="szc-mega-divider"></div>
          {%- endif -%}
        {%- endif -%}

        <!-- COLUMN 3: SHOP BY OCCASION (DYNAMIC) -->
        {%- if mega_block.settings.show_occasions != false -%}
          {%- assign occ_setting = mega_block.settings.occasions_menu -%}
          {%- assign occ_links = nil -%}
          {%- if occ_setting != blank -%}
            {%- if occ_setting.links != blank -%}
              {%- assign occ_links = occ_setting.links -%}
            {%- elsif linklists[occ_setting] != blank and linklists[occ_setting].links != blank -%}
              {%- assign occ_links = linklists[occ_setting].links -%}
            {%- endif -%}
          {%- endif -%}

          {%- if occ_links != blank and occ_links.size > 0 -%}
            <div class="szc-mega-col szc-mega-col--links">
              {%- if mega_block.settings.occasions_title != blank -%}
                <h4 class="szc-mega-col__title">{{ mega_block.settings.occasions_title }}</h4>
              {%- elsif occ_setting.title != blank -%}
                <h4 class="szc-mega-col__title">{{ occ_setting.title }}</h4>
              {%- endif -%}
              <ul class="szc-mega-links-list">
                {%- for occ_l in occ_links -%}
                  <li><a href="{{ occ_l.url }}" class="szc-mega-simple-link">{{ occ_l.title }}</a></li>
                {%- endfor -%}
              </ul>
              {%- if mega_block.settings.occasions_view_all_url != blank -%}
                <a href="{{ mega_block.settings.occasions_view_all_url }}" class="szc-mega-view-all-link">
                  <span>{{ 'sections.collection_list.view_all' | t }}</span>
                  <svg class="szc-view-all-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              {%- endif -%}
            </div>
            <div class="szc-mega-divider"></div>
          {%- endif -%}
        {%- endif -%}

        <!-- COLUMN 4: NEW ARRIVALS / MINI PRODUCTS (DYNAMIC) -->
        {%- if mega_block.settings.show_new_arrivals != false -%}
          {%- assign arrival_col = mega_block.settings.new_arrivals_collection -%}
          {%- assign arrival_products = nil -%}
          {%- if arrival_col != blank -%}
            {%- if arrival_col.products != blank -%}
              {%- assign arrival_products = arrival_col.products -%}
            {%- elsif collections[arrival_col] != blank -%}
              {%- assign arrival_products = collections[arrival_col].products -%}
            {%- endif -%}
          {%- endif -%}
          {%- if arrival_products == nil or arrival_products.size == 0 -%}
            {%- if link.type == 'collection_link' and link.object.products.size > 0 -%}
              {%- assign arrival_products = link.object.products -%}
            {%- else -%}
              {%- assign arrival_products = collections.all.products -%}
            {%- endif -%}
          {%- endif -%}

          {%- if arrival_products != blank and arrival_products.size > 0 -%}
            <div class="szc-mega-col szc-mega-col--trending-rows">
              {%- if mega_block.settings.new_arrivals_title != blank -%}
                <h4 class="szc-mega-col__title">{{ mega_block.settings.new_arrivals_title }}</h4>
              {%- endif -%}
              <div class="szc-mega-products-list">
                {%- assign arrivals_limit = mega_block.settings.products_to_show | default: 4 -%}
                {%- for product in arrival_products limit: arrivals_limit -%}
                  <a href="{{ product.url }}" class="szc-mega-product-item">
                    <div class="szc-mega-prod-thumb">
                      {%- if product.featured_media != blank -%}
                        {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
                      {%- elsif product.featured_image != blank -%}
                        {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'szc-placeholder-svg' }}
                      {%- endif -%}
                    </div>
                    <div class="szc-mega-prod-info">
                      <h5 class="szc-mega-prod-title">{{ product.title }}</h5>
                      <div class="szc-mega-prod-price">{{ product.price | money }}</div>
                    </div>
                  </a>
                {%- endfor -%}
              </div>
            </div>
            <div class="szc-mega-divider"></div>
          {%- endif -%}
        {%- endif -%}

        <!-- COLUMN 5: FEATURED PROMO CARD (DYNAMIC) -->
        {%- if mega_block.settings.show_card_1 -%}
          {%- if mega_block.settings.card_1_image != blank or mega_block.settings.card_1_subheading != blank or mega_block.settings.card_1_title != blank -%}
            <div class="szc-mega-col szc-mega-col--featured-card">
              {%- if mega_block.settings.card_1_title != blank -%}
                <h4 class="szc-mega-col__title">{{ mega_block.settings.card_1_title }}</h4>
              {%- endif -%}
              <div class="szc-mega-featured-card">
                <div class="szc-mega-card-img-wrap">
                  {%- if mega_block.settings.card_1_image != blank -%}
                    {{ mega_block.settings.card_1_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: mega_block.settings.card_1_subheading | default: 'Featured Collection' }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'szc-placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="szc-mega-card-overlay">
                  {%- if mega_block.settings.card_1_subheading != blank -%}
                    <h5 class="szc-mega-card-heading">{{ mega_block.settings.card_1_subheading }}</h5>
                  {%- endif -%}
                  {%- if mega_block.settings.card_1_description != blank -%}
                    <p class="szc-mega-card-desc">{{ mega_block.settings.card_1_description }}</p>
                  {%- endif -%}
                  {%- if mega_block.settings.card_1_button_label != blank -%}
                    <a href="{{ mega_block.settings.card_1_button_link | default: '#' }}" class="szc-mega-card-btn">
                      <span>{{ mega_block.settings.card_1_button_label }}</span>
                      <svg class="szc-btn-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</div>
