{% doc %}
  Renders accessible SEO breadcrumb navigation links with JSON-LD BreadcrumbList structured data.

  @param {string} [class] - Optional additional CSS classes for the breadcrumb nav container

  @example
  {% render 'breadcrumbs' %}
{% enddoc %}

{%- liquid
  assign t_home = 'general.breadcrumbs.home' | t | default: 'Home'
  assign t_search = 'general.breadcrumbs.search' | t | default: 'Search'
  assign custom_class = class | default: ''
-%}

{%- unless template == 'index' or template == 'cart' or template == '404' -%}
  <nav class="szc-breadcrumbs {{ custom_class }}" aria-label="{{ 'general.breadcrumbs.label' | t | default: 'Breadcrumb' }}">
    <ol class="szc-breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ routes.root_url }}" class="szc-breadcrumbs__link" itemprop="item">
          <span itemprop="name">{{ t_home }}</span>
        </a>
        <meta itemprop="position" content="1">
        <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
      </li>

      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- liquid
            assign primary_col = collection
            
            # If no collection in URL context, pick first valid collection from product.collections
            if primary_col == blank and product.collections.size > 0
              for col in product.collections
                unless col.handle == 'all' or col.handle == 'frontpage'
                  assign primary_col = col
                  break
                endunless
              endfor
              if primary_col == blank
                assign primary_col = product.collections.first
              endif
            endif

            # Detect department / parent collection (e.g. Women, Men, Kids)
            assign department_col = blank
            if product.collections.size > 1
              for col in product.collections
                assign h_down = col.handle | downcase
                if h_down == 'women' or h_down == 'womens' or h_down == 'men' or h_down == 'mens' or h_down == 'kids' or h_down == 'unisex'
                  if primary_col == blank or col.id != primary_col.id
                    assign department_col = col
                    break
                  endif
                endif
              endfor
            endif

            assign pos = 1
          -%}

          {%- if department_col != blank -%}
            {%- assign pos = pos | plus: 1 -%}
            <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ department_col.url }}" class="szc-breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ department_col.title }}</span>
              </a>
              <meta itemprop="position" content="{{ pos }}">
              <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
            </li>
          {%- endif -%}

          {%- if primary_col != blank -%}
            {%- assign pos = pos | plus: 1 -%}
            <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ primary_col.url }}" class="szc-breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ primary_col.title }}</span>
              </a>
              <meta itemprop="position" content="{{ pos }}">
              <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
            </li>
          {%- elsif product.type != blank -%}
            {%- assign pos = pos | plus: 1 -%}
            <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ product.type | url_for_type }}" class="szc-breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ product.type }}</span>
              </a>
              <meta itemprop="position" content="{{ pos }}">
              <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
            </li>
          {%- endif -%}

          {%- assign pos = pos | plus: 1 -%}
          <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ product.title }}</span>
            <meta itemprop="position" content="{{ pos }}">
          </li>

        {%- when 'collection' -%}
          {%- if collection.handle -%}
            {%- if current_tags -%}
              <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a href="{{ collection.url }}" class="szc-breadcrumbs__link" itemprop="item">
                  <span itemprop="name">{{ collection.title }}</span>
                </a>
                <meta itemprop="position" content="2">
                <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
              </li>
              <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ current_tags | join: " + " }}</span>
                <meta itemprop="position" content="3">
              </li>
            {%- else -%}
              <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ collection.title }}</span>
                <meta itemprop="position" content="2">
              </li>
            {%- endif -%}
          {%- endif -%}

        {%- when 'blog' -%}
          {%- if current_tags -%}
            <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="{{ blog.url }}" class="szc-breadcrumbs__link" itemprop="item">
                <span itemprop="name">{{ blog.title }}</span>
              </a>
              <meta itemprop="position" content="2">
              <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
            </li>
            <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ current_tags | join: " + " }}</span>
              <meta itemprop="position" content="3">
            </li>
          {%- else -%}
            <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ blog.title }}</span>
              <meta itemprop="position" content="2">
            </li>
          {%- endif -%}

        {%- when 'article' -%}
          <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ blog.url }}" class="szc-breadcrumbs__link" itemprop="item">
              <span itemprop="name">{{ blog.title }}</span>
            </a>
            <meta itemprop="position" content="2">
            <span class="szc-breadcrumbs__separator" aria-hidden="true">/</span>
          </li>
          <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ article.title }}</span>
            <meta itemprop="position" content="3">
          </li>

        {%- when 'page' -%}
          <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ page.title }}</span>
            <meta itemprop="position" content="2">
          </li>

        {%- when 'search' -%}
          <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ t_search }}</span>
            <meta itemprop="position" content="2">
          </li>

        {%- else -%}
          <li class="szc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="szc-breadcrumbs__current" itemprop="name" aria-current="page">{{ page_title }}</span>
            <meta itemprop="position" content="2">
          </li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}

{% stylesheet %}
  .szc-breadcrumbs {
    padding: var(--szc-space-3, 12px) 0;
    font-family: var(--szc-font-family-body);
    font-size: var(--szc-font-size-xs, 12px);
    color: var(--szc-color-text-muted, #757575);
  }

  .szc-breadcrumbs__list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 6px;
  }

  .szc-breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .szc-breadcrumbs__link {
    color: var(--szc-color-text-muted, #757575);
    text-decoration: none;
    transition: color var(--szc-transition-fast, 150ms ease);
  }

  .szc-breadcrumbs__link:hover {
    color: var(--szc-color-primary, #111111);
    text-decoration: underline;
  }

  .szc-breadcrumbs__separator {
    color: var(--szc-color-border-strong, #cccccc);
    font-size: 11px;
  }

  .szc-breadcrumbs__current {
    color: var(--szc-color-text-primary, #2b2b2b);
    font-weight: 600;
  }
{% endstylesheet %}
