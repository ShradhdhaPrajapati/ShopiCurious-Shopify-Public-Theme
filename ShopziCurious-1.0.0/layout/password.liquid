{%- liquid
  assign lang_iso = request.locale.iso_code | downcase | slice: 0, 2
  assign is_rtl = false
  if lang_iso == 'ar' or lang_iso == 'he' or lang_iso == 'fa' or lang_iso == 'ur'
    assign is_rtl = true
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {%- if is_rtl -%}
      {{ 'rtl.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
