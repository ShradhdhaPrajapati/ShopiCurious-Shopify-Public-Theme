<section id="MainPage-{{ section.id }}" class="szc-main-page page-width szc-main-page--{{ section.settings.page_width }}">
  {% render 'breadcrumbs' %}

  <div class="szc-main-page__header">
    <h1 class="szc-main-page__title">{{ page.title }}</h1>
  </div>

  <div class="szc-main-page__content rte">
    {{ page.content }}
  </div>
</section>

{% stylesheet %}
  .szc-main-page {
    padding-top: var(--szc-space-4, 16px);
    padding-bottom: var(--szc-space-12, 48px);
    margin: 0 auto;
  }

  .szc-main-page--narrow {
    max-width: 800px;
  }

  .szc-main-page--normal {
    max-width: 1000px;
  }

  .szc-main-page--wide {
    max-width: var(--szc-page-max-width, 1400px);
  }

  .szc-main-page__header {
    margin-bottom: var(--szc-space-8, 32px);
    text-align: center;
  }

  .szc-main-page__title {
    margin: 0;
    font-family: var(--szc-font-family-heading);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
  }

  .szc-main-page__content {
    font-family: var(--szc-font-family-body);
    font-size: var(--szc-font-size-base, 16px);
    line-height: 1.7;
    color: var(--szc-color-text-primary, #2b2b2b);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page content",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "select",
      "id": "page_width",
      "label": "Page content width",
      "options": [
        { "value": "narrow", "label": "Narrow (800px)" },
        { "value": "normal", "label": "Normal (1000px)" },
        { "value": "wide", "label": "Wide (1400px)" }
      ],
      "default": "normal"
    }
  ]
}
{% endschema %}
