{%- comment -%}
  ShopziCurious - Native Related Products Section (Shopify Dawn Architecture)
  Follows Shopify Dawn & Online Store 2.0 Theme Store Standards:
  1. Search & Discovery / Native Recommendation API (routes.product_recommendations_url).
  2. Collection Fallback (excluding current product) when recommendations API yields 0 products.
  3. Theme Editor (request.design_mode) safe-rendering so section never disappears during Save/Customizer edits.
  4. Live Storefront: Completely hidden if no recommendations or fallback products exist.
{%- endcomment -%}

{%- capture section_header -%}
  {%- assign align_class = section.settings.heading_alignment | default: 'center' -%}
  {%- assign show_h = section.settings.show_heading -%}
  {%- assign show_sub = section.settings.show_subtitle -%}
  {%- if show_h == nil -%}{%- assign show_h = true -%}{%- endif -%}
  {%- if show_sub == nil -%}{%- assign show_sub = true -%}{%- endif -%}

  {%- assign has_subtitle = false -%}
  {%- if show_sub and section.settings.subtitle != blank -%}
    {%- assign has_subtitle = true -%}
  {%- endif -%}

  {%- assign has_heading = false -%}
  {%- if show_h and section.settings.heading != blank -%}
    {%- assign has_heading = true -%}
  {%- endif -%}
  
  {%- if has_subtitle or has_heading -%}
    <div
      class="szc-section-header szc-section-header--{{ align_class }}"
      style="
        --hdr-title-color: {{ section.settings.title_color | default: '#111111' }};
        --hdr-title-size: {{ section.settings.title_size | default: 24 }}px;
        --hdr-title-weight: {{ section.settings.title_weight | default: '700' }};
        --hdr-subtitle-color: {{ section.settings.subtitle_color | default: '#757575' }};
        --hdr-subtitle-size: {{ section.settings.subtitle_size | default: 12 }}px;
        --hdr-subtitle-weight: {{ section.settings.subtitle_weight | default: '600' }};
      "
    >
      {%- if has_subtitle -%}
        <span class="szc-section-header__subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if has_heading -%}
        <h2 class="szc-section-header__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign rec_product = product
  if rec_product == blank and cart.items.size > 0
    assign rec_product = cart.items.first.product
  endif

  if rec_product != blank and rec_product.collections.size > 0
    assign fallback_collection = rec_product.collections.first
  else
    assign fallback_collection = collections.all | default: collections.first
  endif
-%}

<product-recommendations
  class="szc-product-recommendations page-width"
  {% if rec_product != blank %}
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ rec_product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
  {% endif %}
  data-section-id="{{ section.id }}"
  style="--cols-desktop: {{ section.settings.columns_desktop | default: 4 }}; --cols-mobile: {{ section.settings.columns_mobile | default: 2 }};"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {{ section_header }}

    <div class="szc-featured-collection__grid">
      {%- for recommendation in recommendations.products -%}
        <div class="szc-featured-collection__item">
          {% render 'product-card',
            card_product: recommendation,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            show_quick_add: section.settings.show_quick_add,
            show_quick_view: true,
            show_price: section.settings.show_price
          %}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%} COLLECTION FALLBACK WHEN RECOMMENDATIONS ARE NOT YET PERFORMED OR RETURN 0 {%- endcomment -%}
    {%- if fallback_collection != blank and fallback_collection.products_count > 0 -%}
      {%- assign fallback_count = 0 -%}
      {%- capture fallback_grid -%}
        {%- for col_product in fallback_collection.products -%}
          {%- if col_product.id != rec_product.id and fallback_count < section.settings.products_to_show -%}
            {%- assign fallback_count = fallback_count | plus: 1 -%}
            <div class="szc-featured-collection__item">
              {% render 'product-card',
                card_product: col_product,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_quick_add: section.settings.show_quick_add,
                show_quick_view: true,
                show_price: section.settings.show_price
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if fallback_count > 0 -%}
        {{ section_header }}
        <div class="szc-featured-collection__grid">
          {{ fallback_grid }}
        </div>
      {%- endif -%}
    {%- elsif request.design_mode -%}
      {%- comment -%} THEME EDITOR (DESIGN MODE) SAFEGUARD {%- endcomment -%}
      {{ section_header }}
      <div class="szc-featured-collection__grid">
        {%- for i in (1..section.settings.products_to_show) -%}
          <div class="szc-featured-collection__item">
            {% render 'product-card',
              card_product: nil,
              show_secondary_image: section.settings.show_secondary_image,
              show_price: section.settings.show_price,
              show_quick_add: section.settings.show_quick_add
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</product-recommendations>

{% stylesheet %}
  .szc-product-recommendations {
    display: block;
    padding-top: var(--szc-space-12, 48px);
    padding-bottom: var(--szc-space-12, 48px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    padding-left: var(--szc-space-6, 24px);
    padding-right: var(--szc-space-6, 24px);
  }

  .szc-section-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 32px;
  }

  .szc-section-header--left {
    align-items: flex-start;
    text-align: left;
  }

  .szc-section-header--center {
    align-items: center;
    text-align: center;
  }

  .szc-section-header--right {
    align-items: flex-end;
    text-align: right;
  }

  .szc-section-header__title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: var(--hdr-title-size, 24px);
    font-weight: var(--hdr-title-weight, 700);
    color: var(--hdr-title-color, #111111);
    margin: 0;
    line-height: 1.25;
  }

  .szc-section-header__subtitle {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: var(--hdr-subtitle-size, 12px);
    font-weight: var(--hdr-subtitle-weight, 600);
    color: var(--hdr-subtitle-color, #757575);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 6px;
    line-height: 1.3;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('product-recommendations')) {
    customElements.define(
      'product-recommendations',
      class ProductRecommendations extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          const handleIntersection = (entries, observer) => {
            if (!entries[0].isIntersecting) return;
            observer.unobserve(this);
            this.loadRecommendations();
          };

          new IntersectionObserver(handleIntersection.bind(this), { rootMargin: '0px 0px 400px 0px' }).observe(this);
        }

        loadRecommendations() {
          const url = this.dataset.url;
          if (!url) return;

          fetch(url)
            .then((response) => response.text())
            .then((text) => {
              const html = document.createElement('div');
              html.innerHTML = text;
              const recommendations = html.querySelector('product-recommendations');

              if (recommendations && recommendations.innerHTML.trim().length) {
                this.innerHTML = recommendations.innerHTML;
              }

              const hasItems = this.querySelectorAll('.szc-featured-collection__item').length > 0;
              if (!hasItems) {
                if (window.Shopify && window.Shopify.designMode) {
                  this.style.display = 'block';
                } else {
                  this.style.display = 'none';
                }
              } else {
                this.style.display = 'block';
              }
            })
            .catch((e) => {
              console.error('Failed to load product recommendations:', e);
            });
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "Dynamic recommendations change based on products and search history. [Learn more](https://help.shopify.com/manual/online-store/search-and-discovery/product-recommendations)"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "default": true,
      "label": "Show Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "You May Also Like",
      "label": "Heading Text"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 24
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Subtitle Settings"
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
      "default": true,
      "label": "Show Subtitle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "COMPLETE THE LOOK",
      "label": "Subtitle Text"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#757575"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 12
    },
    {
      "type": "select",
      "id": "subtitle_weight",
      "label": "Subtitle Font Weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Product Grid Settings"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show secondary image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show product price"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "default": true,
      "label": "Enable quick add button"
    }
  ],
  "presets": [
    {
      "name": "Related products"
    }
  ]
}
{% endschema %}
