{%- comment -%}
  ShopziCurious - Announcement Bar Section
  Displays top announcements with dynamic auto-slide functionality.
{%- endcomment -%}

{%- liquid
  assign bg_color = section.settings.background_color | default: '#f7f6f4'
  assign text_color = section.settings.text_color | default: '#2b2b2b'
  assign border_color = section.settings.border_color | default: '#e8e6e1'
  assign enable_auto_slide = section.settings.enable_auto_slide
  assign slide_speed = section.settings.auto_slide_speed | default: 4 | times: 1000
-%}

<div
  id="AnnouncementBar-{{ section.id }}"
  class="szc-announcement-bar {% if enable_auto_slide %}is-auto-slider{% endif %}"
  style="--szc-announcement-bg: {{ bg_color }}; --szc-announcement-text: {{ text_color }}; --szc-announcement-border: {{ border_color }};"
  data-auto-slide="{{ enable_auto_slide }}"
  data-speed="{{ slide_speed }}"
  role="region"
  aria-label="{{ 'sections.announcement-bar.name' | t | default: 'Announcement Bar' }}"
>
  <div class="szc-announcement-bar__container">
    <div class="szc-announcement-bar__items">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'announcement' -%}
            <div class="szc-announcement-bar__item {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="szc-announcement-bar__link">
              {%- endif -%}

              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                {% render 'icon', icon: block.settings.icon, class: 'szc-announcement-bar__icon' %}
              {%- endif -%}

              <span class="szc-announcement-bar__text">
                {{ block.settings.text | escape }}
              </span>

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- else -%}
        <div class="szc-announcement-bar__item is-active" data-slide-index="0">
          {% render 'icon', icon: 'truck', class: 'szc-announcement-bar__icon' %}
          <span class="szc-announcement-bar__text">FREE SHIPPING ON ORDERS OVER $100</span>
        </div>
        <div class="szc-announcement-bar__item" data-slide-index="1">
          {% render 'icon', icon: 'award', class: 'szc-announcement-bar__icon' %}
          <span class="szc-announcement-bar__text">LIFETIME WARRANTY</span>
        </div>
        <div class="szc-announcement-bar__item" data-slide-index="2">
          {% render 'icon', icon: 'returns', class: 'szc-announcement-bar__icon' %}
          <span class="szc-announcement-bar__text">30-DAY EASY RETURNS</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .szc-announcement-bar {
    background-color: var(--szc-announcement-bg, #f7f6f4);
    color: var(--szc-announcement-text, #2b2b2b);
    border-bottom: 1px solid var(--szc-announcement-border, #e8e6e1);
    font-family: var(--szc-font-family-body, inherit);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    position: relative;
    z-index: 40;
    width: 100%;
    overflow: hidden;
  }

  .szc-announcement-bar__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--szc-space-4, 16px);
  }

  .szc-announcement-bar__items {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
  }

  /* Auto-slide transition styling */
  .szc-announcement-bar.is-auto-slider .szc-announcement-bar__items {
    height: 38px;
    overflow: hidden;
  }

  .szc-announcement-bar.is-auto-slider .szc-announcement-bar__item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1), transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .szc-announcement-bar.is-auto-slider .szc-announcement-bar__item.is-active {
    position: relative;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .szc-announcement-bar.is-auto-slider .szc-announcement-bar__item.is-exiting {
    position: absolute;
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }

  /* Static fallback list styling if auto-slide disabled */
  .szc-announcement-bar:not(.is-auto-slider) .szc-announcement-bar__items {
    justify-content: space-between;
    gap: var(--szc-space-4, 16px);
  }

  .szc-announcement-bar:not(.is-auto-slider) .szc-announcement-bar__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
    text-align: center;
    opacity: 1;
    transform: none;
  }

  .szc-announcement-bar__link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 150ms ease;
  }

  .szc-announcement-bar__link:hover {
    opacity: 0.75;
  }

  .szc-announcement-bar__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .szc-announcement-bar__text {
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .szc-announcement-bar:not(.is-auto-slider) .szc-announcement-bar__items {
      overflow-x: auto;
      justify-content: flex-start;
      scrollbar-width: none;
      padding: 8px 0;
    }

    .szc-announcement-bar:not(.is-auto-slider) .szc-announcement-bar__items::-webkit-scrollbar {
      display: none;
    }

    .szc-announcement-bar:not(.is-auto-slider) .szc-announcement-bar__item {
      flex: 0 0 auto;
      padding: 0 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const announcementBars = document.querySelectorAll('.szc-announcement-bar[data-auto-slide="true"]');

    announcementBars.forEach(function(bar) {
      const items = bar.querySelectorAll('.szc-announcement-bar__item');
      if (items.length <= 1) return;

      const speed = parseInt(bar.getAttribute('data-speed'), 10) || 4000;
      let currentIndex = 0;
      let timer = null;

      function showNextSlide() {
        const currentItem = items[currentIndex];
        currentIndex = (currentIndex + 1) % items.length;
        const nextItem = items[currentIndex];

        items.forEach(function(item) {
          item.classList.remove('is-active', 'is-exiting');
        });

        currentItem.classList.add('is-exiting');
        nextItem.classList.add('is-active');
      }

      function startAutoSlide() {
        stopAutoSlide();
        timer = setInterval(showNextSlide, speed);
      }

      function stopAutoSlide() {
        if (timer) clearInterval(timer);
      }

      startAutoSlide();

      bar.addEventListener('mouseenter', stopAutoSlide);
      bar.addEventListener('mouseleave', startAutoSlide);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_auto_slide",
      "label": "Enable auto-slide / auto-rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s",
      "label": "Auto-rotate speed (seconds)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.announcement-bar.settings.background_color.label",
      "default": "#f7f6f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.announcement-bar.settings.text_color.label",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.announcement-bar.settings.border_color.label",
      "default": "#e8e6e1"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.label",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Free Shipping Truck" },
            { "value": "award", "label": "Warranty Ribbon" },
            { "value": "returns", "label": "Return Arrow" },
            { "value": "shield", "label": "Security Shield" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label",
          "default": "Free Shipping On Orders Over $100"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "truck",
            "text": "FREE SHIPPING ON ORDERS OVER $100"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "award",
            "text": "LIFETIME WARRANTY"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "returns",
            "text": "30-DAY EASY RETURNS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
