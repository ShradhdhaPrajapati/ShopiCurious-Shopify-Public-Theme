{%- comment -%}
  ShopziCurious - Announcement Bar Section (Part 01)
  Matches the approved UI: full-width top bar displaying USP announcements with icons.
{%- endcomment -%}

{%- liquid
  assign bg_color = section.settings.background_color | default: '#f7f6f4'
  assign text_color = section.settings.text_color | default: '#2b2b2b'
  assign border_color = section.settings.border_color | default: '#e8e6e1'
-%}

<div
  id="AnnouncementBar-{{ section.id }}"
  class="kz-announcement-bar"
  style="--kz-announcement-bg: {{ bg_color }}; --kz-announcement-text: {{ text_color }}; --kz-announcement-border: {{ border_color }};"
  role="region"
  aria-label="{{ 'sections.announcement-bar.name' | t | default: 'Announcement Bar' }}"
>
  <div class="kz-announcement-bar__container">
    <div class="kz-announcement-bar__items">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'announcement' -%}
            <div class="kz-announcement-bar__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="kz-announcement-bar__link">
              {%- endif -%}

              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                {% render 'icon', icon: block.settings.icon, class: 'kz-announcement-bar__icon' %}
              {%- endif -%}

              <span class="kz-announcement-bar__text">
                {{ block.settings.text | escape }}
              </span>

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- else -%}
        <div class="kz-announcement-bar__item">
          {% render 'icon', icon: 'truck', class: 'kz-announcement-bar__icon' %}
          <span class="kz-announcement-bar__text">FREE SHIPPING ON ORDERS OVER $100</span>
        </div>
        <div class="kz-announcement-bar__item">
          {% render 'icon', icon: 'award', class: 'kz-announcement-bar__icon' %}
          <span class="kz-announcement-bar__text">LIFETIME WARRANTY</span>
        </div>
        <div class="kz-announcement-bar__item">
          {% render 'icon', icon: 'returns', class: 'kz-announcement-bar__icon' %}
          <span class="kz-announcement-bar__text">30-DAY EASY RETURNS</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .kz-announcement-bar {
    background-color: var(--kz-announcement-bg, #f7f6f4);
    color: var(--kz-announcement-text, #2b2b2b);
    border-bottom: 1px solid var(--kz-announcement-border, #e8e6e1);
    font-family: var(--kz-font-family-body, inherit);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    position: relative;
    z-index: 40;
    width: 100%;
  }

  .kz-announcement-bar__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--kz-space-4, 16px);
  }

  .kz-announcement-bar__items {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 38px;
    gap: var(--kz-space-4, 16px);
  }

  .kz-announcement-bar__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
    text-align: center;
  }

  .kz-announcement-bar__link {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 150ms ease;
  }

  .kz-announcement-bar__link:hover {
    opacity: 0.75;
  }

  .kz-announcement-bar__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .kz-announcement-bar__text {
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .kz-announcement-bar__items {
      overflow-x: auto;
      justify-content: flex-start;
      scrollbar-width: none;
      padding: 8px 0;
    }

    .kz-announcement-bar__items::-webkit-scrollbar {
      display: none;
    }

    .kz-announcement-bar__item {
      flex: 0 0 auto;
      padding: 0 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.announcement-bar.settings.background_color.label",
      "default": "#f7f6f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.announcement-bar.settings.text_color.label",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.announcement-bar.settings.border_color.label",
      "default": "#e8e6e1"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.icon.label",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Free Shipping Truck" },
            { "value": "award", "label": "Warranty Ribbon" },
            { "value": "returns", "label": "Return Arrow" },
            { "value": "shield", "label": "Security Shield" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label",
          "default": "Free Shipping On Orders Over $100"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "truck",
            "text": "FREE SHIPPING ON ORDERS OVER $100"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "award",
            "text": "LIFETIME WARRANTY"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "returns",
            "text": "30-DAY EASY RETURNS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
