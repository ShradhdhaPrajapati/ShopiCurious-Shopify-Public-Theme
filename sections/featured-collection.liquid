{%- comment -%}
  ShopziCurious - Featured Products Section (Part 06)
  Displays a curated collection grid matching the approved UI screenshot 100%.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 5
  assign cols_desktop = section.settings.columns_desktop | default: 5
  assign cols_mobile = section.settings.columns_mobile | default: '2'
  assign enable_swipe = section.settings.enable_swipe_mobile | default: false
  assign image_ratio = section.settings.image_ratio | default: settings.product_card_image_ratio | default: 'portrait'
-%}

<section
  id="FeaturedCollection-{{ section.id }}"
  class="szc-featured-collection page-width{% if enable_swipe %} szc-featured-collection--swipe-mobile{% endif %}"
  style="--cols-desktop: {{ cols_desktop }}; --cols-mobile: {{ cols_mobile }};"
>
  <!-- Section Header -->
  {%- assign align_class = section.settings.heading_alignment | default: 'left' -%}
  <div class="szc-section-header szc-section-header--{{ align_class }}">
    <div class="szc-section-header__text">
      {%- if section.settings.subtitle != blank -%}
        <span class="szc-section-header__subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="szc-section-header__title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <a href="{{ collection.url | default: '/collections/all' }}" class="szc-section-header__view-all">
        <span>{{ 'sections.featured_collection.view_all' | t | default: 'VIEW ALL' }}</span>
      </a>
    {%- endif -%}
  </div>

  <!-- Product Grid -->
  <div class="szc-featured-collection__grid">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <div class="szc-featured-collection__item szc-animate-fade-up">
          {% render 'product-card',
            card_product: product,
            show_secondary_image: true,
            show_quick_add: true,
            show_quick_view: true,
            show_price: section.settings.show_price,
            media_aspect_ratio: image_ratio
          %}
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Demo 5 Items matching approved UI screenshot pixel-for-pixel -->
      <div class="szc-featured-collection__item">
        {% render 'product-card', card_product: nil, title_override: 'Oversized Knit Sweater', price_override: '$59.99', show_price: section.settings.show_price, media_aspect_ratio: image_ratio %}
      </div>
      <div class="szc-featured-collection__item">
        {% render 'product-card', card_product: nil, title_override: 'Linen Blend Shirt', price_override: '$49.99', show_price: section.settings.show_price, media_aspect_ratio: image_ratio %}
      </div>
      <div class="szc-featured-collection__item">
        {% render 'product-card', card_product: nil, title_override: 'Satin Slip Dress', price_override: '$69.99', show_price: section.settings.show_price, media_aspect_ratio: image_ratio %}
      </div>
      <div class="szc-featured-collection__item">
        {% render 'product-card', card_product: nil, title_override: 'Classic Denim Jacket', price_override: '$78.99', show_price: section.settings.show_price, media_aspect_ratio: image_ratio %}
      </div>
      <div class="szc-featured-collection__item">
        {% render 'product-card', card_product: nil, title_override: 'Wide Leg Trousers', price_override: '$54.99', show_price: section.settings.show_price, media_aspect_ratio: image_ratio %}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if enable_swipe -%}
  <script>
    (function() {
      function initFeaturedCollectionSwipe() {
        const grid = document.querySelector('#FeaturedCollection-{{ section.id }} .szc-featured-collection__grid');
        if (grid) {
          grid.scrollLeft = 0;
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFeaturedCollectionSwipe);
      } else {
        initFeaturedCollectionSwipe();
      }
      document.addEventListener('shopify:section:load', function(e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          initFeaturedCollectionSwipe();
        }
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .szc-featured-collection {
    padding-top: var(--szc-space-12, 48px);
    padding-bottom: var(--szc-space-12, 48px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    padding-left: var(--szc-space-6, 24px);
    padding-right: var(--szc-space-6, 24px);
  }

  .szc-section-header {
    display: flex !important;
    width: 100% !important;
    margin-bottom: var(--szc-space-8, 32px);
  }

  .szc-section-header--left {
    flex-direction: row !important;
    align-items: flex-end !important;
    justify-content: space-between !important;
    text-align: left !important;
    gap: 16px !important;
  }

  .szc-section-header--left .szc-section-header__text {
    text-align: left !important;
  }

  .szc-section-header--center {
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    gap: 12px !important;
  }

  .szc-section-header--center .szc-section-header__text {
    text-align: center !important;
  }

  .szc-section-header--right {
    flex-direction: row-reverse !important;
    align-items: flex-end !important;
    justify-content: space-between !important;
    text-align: right !important;
    gap: 16px !important;
  }

  .szc-section-header--right .szc-section-header__text {
    text-align: right !important;
  }

  .szc-section-header__subtitle {
    display: block;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--szc-color-text-muted, #666666);
    margin-bottom: 6px;
  }

  .szc-section-header__title {
    margin: 0;
    font-family: var(--szc-font-family-heading, Georgia, 'Playfair Display', serif);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 500;
    color: var(--szc-color-heading, #111111);
    line-height: 1.2;
  }

  .szc-section-header__view-all {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--szc-color-text-muted, #555555);
    text-decoration: underline;
    text-decoration-color: var(--szc-color-secondary, #d4a373);
    text-underline-offset: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-bottom: 4px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .szc-section-header__view-all:hover {
    color: var(--szc-color-heading, #111111);
    text-decoration-color: var(--szc-color-heading, #111111);
  }

  .szc-featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-mobile, 2), 1fr);
    gap: var(--szc-space-4, 16px);
  }

  .szc-featured-collection__item {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 749px) {
    .szc-featured-collection--swipe-mobile .szc-featured-collection__grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      scroll-padding-left: var(--szc-space-6, 24px) !important;
      scroll-behavior: smooth !important;
      -webkit-overflow-scrolling: touch !important;
      padding-bottom: 12px !important;
      margin-left: calc(-1 * var(--szc-space-6, 24px)) !important;
      margin-right: calc(-1 * var(--szc-space-6, 24px)) !important;
      padding-left: var(--szc-space-6, 24px) !important;
      padding-right: var(--szc-space-6, 24px) !important;
      scrollbar-width: none;
    }

    .szc-featured-collection--swipe-mobile .szc-featured-collection__grid::-webkit-scrollbar {
      display: none;
    }

    .szc-featured-collection--swipe-mobile .szc-featured-collection__item {
      scroll-snap-align: start !important;
      transform: none !important;
      opacity: 1 !important;
      flex: 0 0 calc(78% - 10px) !important;
      min-width: 200px !important;
    }

    .szc-featured-collection--swipe-mobile[style*="--cols-mobile: 2"] .szc-featured-collection__item,
    .szc-featured-collection--swipe-mobile[style*='--cols-mobile: "2"'] .szc-featured-collection__item {
      flex: 0 0 calc(46% - 8px) !important;
      min-width: 155px !important;
    }
  }

  @media (min-width: 750px) {
    .szc-featured-collection__grid {
      grid-template-columns: repeat(var(--cols-desktop, 5), 1fr);
      gap: var(--szc-space-5, 20px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "default": "NEW ARRIVALS",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Handpicked Just For You",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_mobile",
      "default": false,
      "label": "Enable swipe on mobile"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image size",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show product price"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Enable 'VIEW ALL' link"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
