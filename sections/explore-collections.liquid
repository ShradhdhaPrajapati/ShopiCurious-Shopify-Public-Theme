      padding-bottom: calc(var(--szc-expcol-pb, 56px) * 0.75);
    }

    .szc-expcol-carousel {
      padding: 0;
    }

    .szc-expcol-nav-btn {
      display: none !important;
    }

    .szc-expcol-header {
      margin-bottom: 20px;
      padding: 0 16px;
    }

    .szc-expcol-header__eyebrow {
      font-size: 10px;
      gap: 10px;
    }

    .szc-expcol-header__eyebrow::before,
    .szc-expcol-header__eyebrow::after {
      width: 24px;
    }

    .szc-expcol-string-wrap {
      top: 0;
      height: 70px;
    }

    .szc-expcol-viewport {
      overflow: visible;
    }

    .szc-expcol-track {
      padding: 10px 14vw 90px 14vw;
      gap: 16px;
      scroll-snap-type: none;
      -webkit-overflow-scrolling: touch;
      position: relative;
    }

    .szc-expcol-slide {
      flex: 0 0 72vw;
      width: 72vw;
      min-width: 220px;
      max-width: 290px;
      scroll-snap-align: center;
      --card-rot: 0deg;
      --card-offset-y: 48px;
    }

    .szc-expcol-card {
      padding: 10px 10px 14px 10px;
      border-radius: 16px;
    }

    .szc-expcol-card__clip {
      width: 16px;
      height: 26px;
      top: -12px;
    }

    .szc-expcol-card__clip-hole {
      width: 5px;
      height: 5px;
    }

    .szc-expcol-card__media-wrap {
      border-radius: 12px;
    }

    .szc-expcol-card__title {
      font-size: 13px;
    }

    .szc-expcol-card__subtitle {
      font-size: 10.5px;
    }

    .szc-expcol-card__arrow-btn {
      width: 28px;
      height: 28px;
      flex: 0 0 28px;
    }

    .szc-expcol-card__arrow-btn svg {
      width: 12px;
      height: 12px;
    }

    .szc-expcol-dots {
      margin-top: 14px;
    }

    .szc-expcol-cta {
      margin-top: 20px;
    }

    /* 2 Columns on Mobile */
    .szc-expcol--mobile-cols-2 .szc-expcol-track {
      padding: 10px 16px 80px 16px;
      gap: 12px;
      scroll-snap-type: none;
