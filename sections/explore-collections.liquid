  /* ── Tablet Viewport (768px – 1023px) ───────────────────────────────────── */
  @media (min-width: 768px) and (max-width: 1023px) {
    .szc-expcol-carousel {
      padding: 0;
    }

    .szc-expcol-track {
      padding: 10px 4vw 120px 4vw;
      gap: 16px;
    }

    .szc-expcol-slide {
      flex: 0 0 clamp(220px, calc((100vw - 8vw - 2 * 16px) / 3), 290px);
      width: clamp(220px, calc((100vw - 8vw - 2 * 16px) / 3), 290px);
      min-width: 200px;
    }

    .szc-expcol-script-badge {
      right: 24px;
      font-size: 15px;
    }
  }

  /* ── Reduced Motion Support ─────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .szc-expcol-slide,
    .szc-expcol-card,
    .szc-expcol-card__img,
    .szc-expcol-dot,
    .szc-expcol-btn {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }

    .szc-expcol-track {
      scroll-behavior: auto !important;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initExplore() {
      var section = document.getElementById('ExploreCollections-{{ section.id }}');
      if (!section || section.dataset.initialized === 'true') return;
      section.dataset.initialized = 'true';

      var track = section.querySelector('[data-expcol-track]');
      if (!track) return;

      var originalSlides = Array.from(track.querySelectorAll('.szc-expcol-slide:not([data-is-clone])'));
      var N = originalSlides.length;
      if (N < 2) {
        return;
      }

      // ── Create Before and After Clones for Seamless Infinite Loop ──
      var beforeFragment = document.createDocumentFragment();
      var afterFragment = document.createDocumentFragment();

      originalSlides.forEach(function(origSlide) {
        var cloneBefore = origSlide.cloneNode(true);
        cloneBefore.setAttribute('data-is-clone', 'true');
        cloneBefore.setAttribute('data-clone-type', 'before');
        cloneBefore.setAttribute('aria-hidden', 'true');
        cloneBefore.removeAttribute('id');
        cloneBefore.removeAttribute('data-shopify-editor-block');
        var focusablesB = cloneBefore.querySelectorAll('a, button, input, [tabindex]');
        focusablesB.forEach(function(el) { el.setAttribute('tabindex', '-1'); });
        beforeFragment.appendChild(cloneBefore);

        var cloneAfter = origSlide.cloneNode(true);
        cloneAfter.setAttribute('data-is-clone', 'true');
        cloneAfter.setAttribute('data-clone-type', 'after');
        cloneAfter.setAttribute('aria-hidden', 'true');
        cloneAfter.removeAttribute('id');
        cloneAfter.removeAttribute('data-shopify-editor-block');
        var focusablesA = cloneAfter.querySelectorAll('a, button, input, [tabindex]');
        focusablesA.forEach(function(el) { el.setAttribute('tabindex', '-1'); });
        afterFragment.appendChild(cloneAfter);
      });

      track.insertBefore(beforeFragment, originalSlides[0]);
      track.appendChild(afterFragment);

      var allSlides = Array.from(track.querySelectorAll('.szc-expcol-slide'));
      var dots = Array.from(section.querySelectorAll('.szc-expcol-dot'));

      var isMobile = window.matchMedia('(max-width: 767px)').matches;
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var wasSwiping = false;
      var touchStartX = 0;
      var touchStartY = 0;
      var touchStartTime = 0;

      // Track index starts at original Card 0 (index N in 3*N slides)
      var currentTrackIdx = N;
      var activeCardIdx = 0;

      // Mouse drag state (Desktop)
      var isMouseDown = false;
      var mouseStartX = 0;
      var mouseStartScrollLeft = 0;
      var wasMouseDragging = false;

      // Autoplay state
      var autoplayTimer = null;
      var isInteracting = false;
      var isHovered = false;

      // Animation state
      var isAnimating = false;
      var animationRafId = null;

      var carouselEl = section.querySelector('.szc-expcol-carousel');
      var isAutoplayEnabled = true;
      var autoplaySpeedMs = 3500;

      if (carouselEl) {
        if (carouselEl.dataset.autoplay === 'false') {
          isAutoplayEnabled = false;
        }
        var customSpeed = parseFloat(carouselEl.dataset.autoplaySpeed);
        if (!isNaN(customSpeed) && customSpeed > 0) {
          autoplaySpeedMs = customSpeed * 1000;
        }
      }

      function getActiveCardIndex(idx) {
        return ((idx % N) + N) % N;
      }

      // Exact pixel distance of 1 complete set of N cards
      function getSetStride() {
        if (!allSlides[N] || !allSlides[0]) return 0;
        return allSlides[N].offsetLeft - allSlides[0].offsetLeft;
      }

      // Precise layout-based target scroll offset (immune to rotation / CSS transforms)
      function getTargetScroll(idx) {
        var slide = allSlides[idx];
        if (!slide) return 0;
        var slideCenter = slide.offsetLeft + slide.offsetWidth / 2;
        return Math.round(slideCenter - track.clientWidth / 2);
      }

      // Find slide closest to current track.scrollLeft
      function getNearestTrackIndex() {
        var current = track.scrollLeft;
        var minDiff = Infinity;
        var nearest = currentTrackIdx;
        for (var i = 0; i < allSlides.length; i++) {
          var target = getTargetScroll(i);
          var diff = Math.abs(current - target);
          if (diff < minDiff) {
            minDiff = diff;
            nearest = i;
          }
        }
        return nearest;
      }

      function updateDots() {
        activeCardIdx = getActiveCardIndex(currentTrackIdx);
        dots.forEach(function(dot, i) {
          dot.classList.toggle('is-active', i === activeCardIdx);
        });
      }

      // Exact setStride shift (0ms instantaneous swap without visual difference)
      function normalizeBoundary() {
        var setStride = getSetStride();
        if (setStride <= 0) return;

        var normalized = false;
        if (currentTrackIdx >= 2 * N) {
          currentTrackIdx -= N;
          track.scrollLeft -= setStride;
          normalized = true;
        } else if (currentTrackIdx < N) {
          currentTrackIdx += N;
          track.scrollLeft += setStride;
          normalized = true;
        }
        if (normalized) {
          updateFannedCards();
          updateDots();
        }
      }

      // Deterministic, silky smooth cubic-bezier scroll animation
      function smoothScrollTo(targetScroll, duration, onComplete) {
        if (animationRafId) {
          cancelAnimationFrame(animationRafId);
          animationRafId = null;
        }
        duration = duration || 450;
        var startScroll = track.scrollLeft;
        var distance = targetScroll - startScroll;

        if (Math.abs(distance) < 2) {
          track.scrollLeft = targetScroll;
          updateFannedCards();
          if (onComplete) onComplete();
          return;
        }

        isAnimating = true;
        var startTime = null;

        function easeOutCubic(t) {
          return 1 - Math.pow(1 - t, 3);
        }

        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          var elapsed = timestamp - startTime;
          var progress = Math.min(1, elapsed / duration);
          var ease = easeOutCubic(progress);

          track.scrollLeft = Math.round(startScroll + distance * ease);
          updateFannedCards();

          var nearest = getNearestTrackIndex();
          var cardIdx = getActiveCardIndex(nearest);
          if (cardIdx !== activeCardIdx) {
            activeCardIdx = cardIdx;
            dots.forEach(function(dot, i) {
              dot.classList.toggle('is-active', i === activeCardIdx);
            });
          }

          if (progress < 1) {
            animationRafId = requestAnimationFrame(step);
          } else {
            track.scrollLeft = targetScroll;
            isAnimating = false;
            animationRafId = null;
            updateFannedCards();
            updateDots();
            if (onComplete) onComplete();
          }
        }

        animationRafId = requestAnimationFrame(step);
      }

      function goToTrackIndex(idx, duration, onComplete) {
        if (idx < 0 || idx >= allSlides.length) return;
        currentTrackIdx = idx;
        activeCardIdx = getActiveCardIndex(currentTrackIdx);
        updateDots();
        smoothScrollTo(getTargetScroll(idx), duration || 450, function() {
          normalizeBoundary();
          if (onComplete) onComplete();
        });
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearTimeout(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function startAutoplay() {
        stopAutoplay();
        if (!isAutoplayEnabled || isHovered || isInteracting || isMouseDown || isAnimating) return;
        autoplayTimer = setTimeout(function() {
          advanceSlide();
        }, autoplaySpeedMs);
      }

      function advanceSlide() {
        if (!isAutoplayEnabled || isHovered || isInteracting || isMouseDown || isAnimating) return;
        goToTrackIndex(currentTrackIdx + 1, 500, function() {
          startAutoplay();
        });
      }

      function updateFannedCards() {
        if (prefersReducedMotion) return;

        var stage = section.querySelector('.szc-expcol-stage') || track;
        var stageRect = stage.getBoundingClientRect();
        var stageWidth = stageRect.width || window.innerWidth || 1;
        var svgHeight = isMobile ? 70 : 120;
        var rotSetting = section.getAttribute('data-max-rot');
        var maxRot = rotSetting !== null ? parseFloat(rotSetting) : (isMobile ? 5 : 8.5);
        if (isNaN(maxRot)) maxRot = 8.5;

        for (var i = 0; i < allSlides.length; i++) {
          var slide = allSlides[i];
          var slideRect = slide.getBoundingClientRect();
          if (slideRect.right < stageRect.left - 250 || slideRect.left > stageRect.right + 250) {
            continue;
          }
          var slideCenterX = slideRect.left + slideRect.width / 2;
          var relX = slideCenterX - stageRect.left;
          var normX = Math.max(0, Math.min(1, relX / stageWidth));

          var xSvg = normX * 1440;
          var t = Math.max(0, Math.min(1, (xSvg + 50) / 1540));
          var ySvg = 20 + 228 * t * (1 - t);
          var stringY = ySvg * (svgHeight / 120);

          var cardTop = Math.max(4, stringY - 4);
          var u = (normX - 0.5) * 2;
          var rot = -u * maxRot;

          slide.style.setProperty('--card-offset-y', cardTop.toFixed(1) + 'px');
          slide.style.setProperty('--card-rot', rot.toFixed(2) + 'deg');
        }
      }

      function setInitialPosition() {
        if (animationRafId) {
          cancelAnimationFrame(animationRafId);
          animationRafId = null;
          isAnimating = false;
        }
        track.scrollLeft = getTargetScroll(currentTrackIdx);
        updateFannedCards();
        updateDots();
      }

      setInitialPosition();
      startAutoplay();

      window.addEventListener('load', function() {
        setInitialPosition();
        startAutoplay();
      });

      window.addEventListener('resize', function() {
        isMobile = window.matchMedia('(max-width: 767px)').matches;
        setInitialPosition();
        startAutoplay();
      }, { passive: true });

      /* ── Click on Dots to Navigate (Shortest Circular Path) ── */
      dots.forEach(function(dot, cardIdx) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          if (isAnimating) return;
          var candidates = [cardIdx, N + cardIdx, 2 * N + cardIdx];
          var best = candidates[1];
          var minDiff = Infinity;
          for (var c = 0; c < candidates.length; c++) {
            var diff = Math.abs(candidates[c] - currentTrackIdx);
            if (diff < minDiff) {
              minDiff = diff;
              best = candidates[c];
            }
          }
          goToTrackIndex(best, 450, function() {
            startAutoplay();
          });
        });
      });

      /* ── Click on Card to Center OR Open Collection ── */
      allSlides.forEach(function(slide) {
        slide.addEventListener('click', function(e) {
          if (wasMouseDragging || wasSwiping) {
            e.preventDefault();
            e.stopPropagation();
            return;
          }

          if (e.target.closest('.szc-expcol-card__arrow-btn')) {
            return;
          }

          var slideIdx = allSlides.indexOf(slide);
          var activeCard = getActiveCardIndex(currentTrackIdx);
          var clickedCard = getActiveCardIndex(slideIdx);

          if (clickedCard !== activeCard) {
            e.preventDefault();
            goToTrackIndex(slideIdx, 450, function() {
              startAutoplay();
            });
          }
        });
      });

      /* ── Prevent Native HTML5 Dragging on Images and Links ── */
      track.addEventListener('dragstart', function(e) {
        e.preventDefault();
      });

      /* ── Mouse Click-and-Drag to Swipe (Desktop) ── */
      track.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        if (animationRafId) {
          cancelAnimationFrame(animationRafId);
          animationRafId = null;
          isAnimating = false;
        }
        stopAutoplay();
        isMouseDown = true;
        wasMouseDragging = false;
        isInteracting = true;
        mouseStartX = e.clientX;
        mouseStartScrollLeft = track.scrollLeft;
        track.classList.add('is-dragging');
      });

      window.addEventListener('mousemove', function(e) {
        if (!isMouseDown) return;
        var diffX = e.clientX - mouseStartX;
        if (Math.abs(diffX) > 6) {
          wasMouseDragging = true;
          track.classList.add('is-swiping');
        }
        track.scrollLeft = mouseStartScrollLeft - diffX;
        updateFannedCards();

        var nearest = getNearestTrackIndex();
        var cardIdx = getActiveCardIndex(nearest);
        if (cardIdx !== activeCardIdx) {
          activeCardIdx = cardIdx;
          dots.forEach(function(dot, i) {
            dot.classList.toggle('is-active', i === activeCardIdx);
          });
        }
      });

      function onMouseUp(e) {
        if (!isMouseDown) return;
        isMouseDown = false;
        track.classList.remove('is-dragging');
        track.classList.remove('is-swiping');

        var nearestIdx = getNearestTrackIndex();
        if (e && typeof e.clientX === 'number') {
          var dragDist = e.clientX - mouseStartX;
          if (dragDist < -35 && nearestIdx === currentTrackIdx) {
            nearestIdx = currentTrackIdx + 1;
          } else if (dragDist > 35 && nearestIdx === currentTrackIdx) {
            nearestIdx = currentTrackIdx - 1;
          }
        }
        isInteracting = false;
        goToTrackIndex(nearestIdx, 350, function() {
          setTimeout(function() {
            wasMouseDragging = false;
            if (!isHovered) startAutoplay();
          }, 60);
        });
      }

      window.addEventListener('mouseup', onMouseUp);

      /* Global capture-phase click guard while dragging */
      track.addEventListener('click', function(e) {
        if (wasMouseDragging || wasSwiping) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      /* ── Touch Swipe (Mobile) ── */
      track.addEventListener('touchstart', function(e) {
        if (animationRafId) {
          cancelAnimationFrame(animationRafId);
          animationRafId = null;
          isAnimating = false;
        }
        stopAutoplay();
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
        mouseStartScrollLeft = track.scrollLeft;
        wasSwiping = false;
        isInteracting = true;
        track.classList.add('is-swiping');
      }, { passive: true });

      track.addEventListener('touchmove', function(e) {
        var diffX = e.touches[0].clientX - touchStartX;
        var diffY = e.touches[0].clientY - touchStartY;
        if (Math.abs(diffX) > 8 || Math.abs(diffY) > 8) {
          wasSwiping = true;
        }
        track.scrollLeft = mouseStartScrollLeft - diffX;
        updateFannedCards();

        var nearest = getNearestTrackIndex();
        var cardIdx = getActiveCardIndex(nearest);
        if (cardIdx !== activeCardIdx) {
          activeCardIdx = cardIdx;
          dots.forEach(function(dot, i) {
            dot.classList.toggle('is-active', i === activeCardIdx);
          });
        }
      }, { passive: true });

      track.addEventListener('touchend', function(e) {
        track.classList.remove('is-swiping');
        var touchEndX = (e.changedTouches && e.changedTouches[0]) ? e.changedTouches[0].clientX : touchStartX;
        var diffX = touchEndX - touchStartX;
        var elapsed = Math.max(1, Date.now() - touchStartTime);
        var velocity = diffX / elapsed;

        var nearestIdx = getNearestTrackIndex();
        if (diffX < -35 || velocity < -0.25) {
          if (nearestIdx === currentTrackIdx) nearestIdx = currentTrackIdx + 1;
        } else if (diffX > 35 || velocity > 0.25) {
          if (nearestIdx === currentTrackIdx) nearestIdx = currentTrackIdx - 1;
        }

        isInteracting = false;
        goToTrackIndex(nearestIdx, 350, function() {
          setTimeout(function() {
            wasSwiping = false;
            startAutoplay();
          }, 60);
        });
      }, { passive: true });

      /* ── Hover Pause/Resume on Desktop (Cursor rakhu tyare stop thay) ── */
      var hasHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (hasHover) {
        var hoverTarget = section.querySelector('.szc-expcol-carousel') || track;
        hoverTarget.addEventListener('mouseenter', function() {
          isHovered = true;
          stopAutoplay();
        });

        hoverTarget.addEventListener('mouseleave', function() {
          isHovered = false;
          if (!isInteracting && !isMouseDown && !isAnimating) {
            startAutoplay();
          }
        });
      }

      /* ── Keyboard Left/Right Navigation ── */
      track.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToTrackIndex(currentTrackIdx - 1, 380, function() {
            startAutoplay();
          });
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToTrackIndex(currentTrackIdx + 1, 380, function() {
            startAutoplay();
          });
        }
      });

      /* ── Tab Visibility ── */
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          stopAutoplay();
        } else if (isAutoplayEnabled && !isInteracting && !isHovered && !isMouseDown && !isAnimating) {
          startAutoplay();
        }
      });

      /* ── Shopify Theme Editor Block Selection ── */
      if (window.Shopify && window.Shopify.designMode) {
        document.addEventListener('shopify:block:select', function(e) {
          var blockId = e.detail.blockId;
          var targetSlide = section.querySelector('[data-shopify-editor-block*="' + blockId + '"]');
          if (targetSlide) {
            var idx = allSlides.indexOf(targetSlide);
            if (idx !== -1) {
              goToTrackIndex(idx, 450, function() {
                startAutoplay();
              });
            }
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initExplore);
    } else {
      initExplore();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.target.id === 'shopify-section-{{ section.id }}') {
        initExplore();
      }
    });
  })();
</script>

