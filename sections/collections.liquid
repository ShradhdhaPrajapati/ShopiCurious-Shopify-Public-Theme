{% comment %}
  ShopziCurious - Main Collections List Section
  Renders a responsive, luxury grid of store collections.
{% endcomment %}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop | default: '3'
  assign columns_mobile = section.settings.columns_mobile | default: '1'
  assign image_aspect_ratio = section.settings.image_aspect_ratio | default: '4/5'
  assign collections_per_page = section.settings.collections_per_page | default: 12
-%}

<div class="szc-collections-page">
  <div class="szc-container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="szc-collections-header">
        {%- if section.settings.heading != blank -%}
          <h1 class="szc-collections-header__title">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="szc-collections-header__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- paginate collections by collections_per_page -%}
      {%- if collections.size > 0 -%}
        <div
          class="szc-collections-grid szc-collections-grid--desktop-{{ columns_desktop }} szc-collections-grid--mobile-{{ columns_mobile }}"
          style="--grid-gap: {{ section.settings.grid_gap }}px;"
        >
          {%- for collection in collections -%}
            <div class="szc-collection-card">
              <a href="{{ collection.url }}" class="szc-collection-card__media-link" aria-label="{{ collection.title | escape }}">
                {%- if collection.featured_image != blank -%}
                  {% render 'image',
                    image: collection.featured_image,
                    aspect_ratio: image_aspect_ratio,
                    loading: 'lazy',
                    class: 'szc-collection-card__image'
                  %}
                {%- else -%}
                  <div class="szc-collection-card__placeholder" style="aspect-ratio: {{ image_aspect_ratio }};">
                    {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                    {{ 'collection-' | append: current | placeholder_svg_tag: 'szc-image-placeholder' }}
                  </div>
                {%- endif -%}

                {%- if section.settings.show_product_count -%}
                  <span class="szc-collection-card__badge">
                    {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'product', 'products' }}
                  </span>
                {%- endif -%}
              </a>

              <div class="szc-collection-card__content">
                <h3 class="szc-collection-card__title">
                  <a href="{{ collection.url }}" class="szc-collection-card__title-link">
                    {{ collection.title }}
                  </a>
                </h3>

                {%- if section.settings.show_description and collection.description != blank -%}
                  <p class="szc-collection-card__description">
                    {{ collection.description | strip_html | truncatewords: 15 }}
                  </p>
                {%- endif -%}

                <a href="{{ collection.url }}" class="szc-collection-card__link">
                  <span>Explore Collection</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="szc-collections-pagination">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="szc-collections-empty">
          <p>No collections found.</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .szc-collections-page {
    padding-top: 40px;
    padding-bottom: 80px;
    background-color: var(--szc-color-background, #ffffff);
  }

  .szc-collections-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .szc-collections-header__title {
    font-family: var(--szc-font-family-heading, Georgia, serif);
    font-size: 38px;
    font-weight: 500;
    color: #111111;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .szc-collections-header__subheading {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 15px;
    color: #666666;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .szc-collections-grid {
    display: grid;
    gap: var(--grid-gap, 24px);
  }

  .szc-collections-grid--desktop-2 { grid-template-columns: repeat(2, 1fr); }
  .szc-collections-grid--desktop-3 { grid-template-columns: repeat(3, 1fr); }
  .szc-collections-grid--desktop-4 { grid-template-columns: repeat(4, 1fr); }

  @media (max-width: 990px) {
    .szc-collections-grid--desktop-3,
    .szc-collections-grid--desktop-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .szc-collections-grid--mobile-1 { grid-template-columns: 1fr !important; }
    .szc-collections-grid--mobile-2 { grid-template-columns: repeat(2, 1fr) !important; }
  }

  .szc-collection-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .szc-collection-card:hover {
    transform: translateY(-4px);
  }

  .szc-collection-card__media-link {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background-color: #f7f7f7;
    text-decoration: none;
  }

  .szc-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .szc-collection-card:hover .szc-collection-card__image img {
    transform: scale(1.06);
  }

  .szc-collection-card__placeholder {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f3ef;
  }

  .szc-collection-card__placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.4;
  }

  .szc-collection-card__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background-color: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(4px);
    color: #111111;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    z-index: 2;
  }

  .szc-collection-card__content {
    padding: 20px 4px 12px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .szc-collection-card__title {
    margin: 0 0 8px;
    font-family: var(--szc-font-family-heading, Georgia, serif);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
  }

  .szc-collection-card__title-link {
    color: #111111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .szc-collection-card__title-link:hover {
    color: #997b53;
  }

  .szc-collection-card__description {
    font-size: 13px;
    color: #666666;
    line-height: 1.5;
    margin: 0 0 16px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .szc-collection-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: none;
    margin-top: auto;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .szc-collection-card__link:hover {
    color: #997b53;
    gap: 10px;
  }

  .szc-collections-pagination {
    margin-top: 48px;
  }

  .szc-collections-empty {
    text-align: center;
    padding: 60px 20px;
    color: #757575;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated fashion collections"
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "min": 6,
      "max": 36,
      "step": 6,
      "label": "Collections per page",
      "default": 12
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/5", "label": "Portrait (4:5)" },
        { "value": "16/9", "label": "Landscape (16:9)" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show Product Count Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Collection Description",
      "default": false
    }
  ]
}
{% endschema %}
