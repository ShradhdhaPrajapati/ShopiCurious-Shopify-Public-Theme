{% javascript %}
  function initStyleThatSpeaksAnimation() {
    const sections = document.querySelectorAll('.szc-style-that-speaks.szc-sts--animate-ready:not(.is-visible)');
    if (!sections.length) return;

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.01,
        rootMargin: '120px 0px 80px 0px'
      });

      sections.forEach(sec => {
        // Immediate check if element is already in or near viewport
        const rect = sec.getBoundingClientRect();
        if (rect.top < window.innerHeight + 120 && rect.bottom > -80) {
          sec.classList.add('is-visible');
        } else {
          observer.observe(sec);
        }
      });

      // Safety fallback: ensure section is never left invisible
      setTimeout(() => {
        sections.forEach(sec => sec.classList.add('is-visible'));
      }, 1000);
    } else {
      sections.forEach(sec => sec.classList.add('is-visible'));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStyleThatSpeaksAnimation);
  } else {
    initStyleThatSpeaksAnimation();
  }

  document.addEventListener('shopify:section:load', function(e) {
    if (e.target && (e.target.matches('.szc-style-that-speaks') || e.target.querySelector('.szc-style-that-speaks'))) {
      initStyleThatSpeaksAnimation();
    }
  });
{% endjavascript %}

