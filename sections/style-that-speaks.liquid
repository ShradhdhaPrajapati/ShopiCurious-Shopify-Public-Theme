      opacity: 1;
      transform: translateY(0);
      transition-delay: 140ms;
    }
  }

  .szc-sts--animate-ready.is-visible [data-sts-item="headline"] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 40ms;
  }

  .szc-sts--animate-ready.is-visible [data-sts-item="upper-card"] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 240ms;
  }

  .szc-sts--animate-ready.is-visible [data-sts-item="lower-card"] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 320ms;
  }

  .szc-sts--animate-ready.is-visible [data-sts-item="editorial-text"] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 400ms;
  }

  .szc-sts--animate-ready.is-visible [data-sts-item="features-row"] {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 460ms;
  }

