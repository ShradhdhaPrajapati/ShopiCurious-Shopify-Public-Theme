  /* ---------------------------------------------------- */
  .szc-sts--animate-ready [data-sts-item] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .szc-sts--animate-ready [data-sts-item="main-image"] {
      opacity: 0;
      transform: translate(-50%, 18px);
      transition: opacity 750ms cubic-bezier(0.16, 1, 0.3, 1), transform 750ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .szc-sts--animate-ready.is-visible [data-sts-item="main-image"] {
      opacity: 1;
      transform: translate(-50%, 0);
      transition-delay: 140ms;
    }
  }

  @media (max-width: 767px) {
