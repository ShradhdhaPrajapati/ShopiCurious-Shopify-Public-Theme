{% comment %}
  Renders the "Style That Speaks" high-fashion editorial collage section.
  Faithfully reproduces the reference design with solid and outline royal blue headline
  typography, an overlapping central fashion visual, floating rounded cards, and
  clean editorial narrative paragraphs matching the 5 visual zones.
{% endcomment %}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading_line_1 = section.settings.heading_line_1 | default: 'STYLE THAT'
  assign heading_line_2 = section.settings.heading_line_2 | default: 'SPEAKS'
  assign heading_line_3 = section.settings.heading_line_3 | default: 'YOU'

  assign main_image = section.settings.main_image
  assign upper_right_image = section.settings.upper_right_image
  assign upper_right_title = section.settings.upper_right_title
  assign upper_right_desc = section.settings.upper_right_desc | default: 'Lorem ipsum dolor sit amet consectetur. Pharetra hendrerit cursus porttitor habitant tortor ut mollis sed eu.'

  assign lower_left_image = section.settings.lower_left_image
  assign lower_left_title = section.settings.lower_left_title
  assign lower_left_desc = section.settings.lower_left_desc | default: 'Lorem ipsum dolor sit amet consectetur. Pharetra hendrerit cursus porttitor habitant tortor ut mollis sed eu.'

  assign bottom_text = section.settings.bottom_text | default: 'Lorem ipsum dolor sit amet consectetur. Pharetra hendrerit cursus porttitor habitant tortor ut mollis sed eu. Phasellus condimentum arcu cursus at etiam urna nullam mauris tortor. Tincidunt venenatis turpis est convallis sit placerat quis sed pharetra. In dolor aliquet condimentum turpis feugiat morbi praesent sit. Non vivamus nunc scelerisque in diam at felis.'
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link

  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign heading_solid_color = section.settings.heading_solid_color | default: '#0950b2'
  assign heading_outline_color = section.settings.heading_outline_color | default: '#0950b2'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#0950b2'
  assign body_text_color = section.settings.body_text_color | default: '#333333'
  assign card_bg_color = section.settings.card_bg_color | default: '#f6f5f2'

  assign desktop_max_width = section.settings.desktop_max_width | default: 1260
  assign desktop_height = section.settings.desktop_height | default: 860
  assign heading_size_desktop = section.settings.heading_size_desktop | default: 104
  assign heading_size_mobile = section.settings.heading_size_mobile | default: 48
  assign heading_font_weight = section.settings.heading_font_weight | default: '900'
  assign heading_line_height = section.settings.heading_line_height | default: 85
  assign heading_letter_spacing = section.settings.heading_letter_spacing | default: -3
  assign outline_thickness = section.settings.outline_thickness | default: 2

  assign main_image_width = section.settings.main_image_width | default: 510
  assign upper_right_width = section.settings.upper_right_width | default: 220
  assign lower_left_width = section.settings.lower_left_width | default: 220
  assign bottom_right_width = section.settings.bottom_right_width | default: 440
  assign card_radius = section.settings.card_radius | default: 28
  assign show_card_shadow = section.settings.show_card_shadow
  assign enable_animation = section.settings.enable_animation
  assign show_features = section.settings.show_features
  if show_features == nil
    assign show_features = true
  endif
  assign features_padding_top = section.settings.features_padding_top | default: 36
-%}

<section
  id="StyleThatSpeaks-{{ section.id }}"
  class="szc-style-that-speaks {% if enable_animation %}szc-sts--animate-ready{% endif %}"
  style="
    --szc-sts-bg: {{ bg_color }};
    --szc-sts-solid: {{ heading_solid_color }};
    --szc-sts-outline: {{ heading_outline_color }};
    --szc-sts-eyebrow: {{ eyebrow_color }};
    --szc-sts-body: {{ body_text_color }};
    --szc-sts-card-bg: {{ card_bg_color }};
    --szc-sts-max-width: {{ desktop_max_width }}px;
    --szc-sts-height: {{ desktop_height }}px;
    --szc-sts-heading-desktop: {{ heading_size_desktop }}px;
    --szc-sts-heading-mobile: {{ heading_size_mobile }}px;
    --szc-sts-heading-weight: {{ heading_font_weight }};
    --szc-sts-line-height: {{ heading_line_height | divided_by: 100.0 }};
    --szc-sts-letter-spacing: {{ heading_letter_spacing }}px;
    --szc-sts-stroke-width: {{ outline_thickness }}px;
    --szc-sts-neg-stroke: -{{ outline_thickness }}px;
    --szc-sts-stroke-half: {{ outline_thickness | times: 0.7 | round | at_least: 1 }}px;
    --szc-sts-neg-stroke-half: -{{ outline_thickness | times: 0.7 | round | at_least: 1 }}px;
    --szc-sts-main-width: {{ main_image_width }}px;
    --szc-sts-ur-width: {{ upper_right_width }}px;
    --szc-sts-ll-width: {{ lower_left_width }}px;
    --szc-sts-br-width: {{ bottom_right_width }}px;
    --szc-sts-radius: {{ card_radius }}px;
    --szc-sts-features-pt: {{ features_padding_top }}px;
    --szc-sts-pt: {{ section.settings.padding_top | default: 48 }}px;
    --szc-sts-pb: {{ section.settings.padding_bottom | default: 48 }}px;
    --szc-sts-pt-mob: {{ section.settings.padding_top_mobile | default: 36 }}px;
    --szc-sts-pb-mob: {{ section.settings.padding_bottom_mobile | default: 36 }}px;
  "
>
  <div class="szc-sts__canvas">

    <!-- 1. TOP-LEFT HEADING GROUP (Box 1) -->
    <div class="szc-sts__heading-group" data-sts-item="headline">
      {%- if eyebrow != blank -%}
        <span class="szc-sts__eyebrow">{{ eyebrow }}</span>
      {%- endif -%}
      <h2 class="szc-sts__heading">
        {%- if heading_line_1 != blank -%}
          <span class="szc-sts__line szc-sts__line--1 is-filled">{{ heading_line_1 }}</span>
        {%- endif -%}
        {%- if heading_line_2 != blank -%}
          <span class="szc-sts__line szc-sts__line--2 is-outlined">{{ heading_line_2 }}</span>
        {%- endif -%}
        {%- if heading_line_3 != blank -%}
          <span class="szc-sts__line szc-sts__line--3 is-filled">{{ heading_line_3 }}</span>
        {%- endif -%}
      </h2>
    </div>

    <!-- 2. MAIN CENTER FASHION VISUAL -->
    <div class="szc-sts__main-visual" data-sts-item="main-image">
      {%- if main_image != blank -%}
        {{ main_image | image_url: width: 1200 | image_tag:
          loading: 'lazy',
          class: 'szc-sts__main-img',
          alt: main_image.alt | default: heading_line_1 | default: 'Style That Speaks Featured Fashion'
        }}
      {%- else -%}
        {{ 'style-that-speaks-model.png' | asset_url | image_tag:
          loading: 'lazy',
          class: 'szc-sts__main-img',
          alt: 'Style That Speaks Featured Model'
        }}
      {%- endif -%}
    </div>

    <!-- 3. TOP-RIGHT SUPPORTING CARD + TEXT (Box 2 & Box 3) -->
    <div class="szc-sts__top-right" data-sts-item="upper-card">
      <div class="szc-sts__card-img-box szc-sts__card-img-box--ur">
        {%- if upper_right_image != blank -%}
          {{ upper_right_image | image_url: width: 600 | image_tag:
            loading: 'lazy',
            class: 'szc-sts__card-img',
            alt: upper_right_image.alt | default: upper_right_title | default: 'Editorial preview card'
          }}
        {%- else -%}
          {{ 'style-that-speaks-tr.png' | asset_url | image_tag:
            loading: 'lazy',
            class: 'szc-sts__card-img',
            alt: 'Curated preview card'
          }}
        {%- endif -%}
      </div>
      {%- if upper_right_title != blank or upper_right_desc != blank -%}
        <div class="szc-sts__tr-content">
          {%- if upper_right_title != blank -%}
            <h3 class="szc-sts__tr-title">{{ upper_right_title }}</h3>
          {%- endif -%}
          {%- if upper_right_desc != blank -%}
            <div class="szc-sts__tr-desc">{{ upper_right_desc }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- 4. BOTTOM-LEFT SUPPORTING CARD (Box 4) -->
    <div class="szc-sts__bottom-left {% if show_card_shadow %}has-shadow{% endif %}" data-sts-item="lower-card">
      <div class="szc-sts__card-img-box szc-sts__card-img-box--ll">
        {%- if lower_left_image != blank -%}
          {{ lower_left_image | image_url: width: 600 | image_tag:
            loading: 'lazy',
            class: 'szc-sts__card-img',
            alt: lower_left_image.alt | default: lower_left_title | default: 'Editorial accent card'
          }}
        {%- else -%}
          {{ 'style-that-speaks-bl.png' | asset_url | image_tag:
            loading: 'lazy',
            class: 'szc-sts__card-img',
            alt: lower_left_title | default: 'Style That Speaks accent card'
          }}
        {%- endif -%}
      </div>
      {%- if lower_left_title != blank or lower_left_desc != blank -%}
        <div class="szc-sts__ll-content">
          {%- if lower_left_title != blank -%}
            <h3 class="szc-sts__ll-title">{{ lower_left_title }}</h3>
          {%- endif -%}
          {%- if lower_left_desc != blank -%}
            <div class="szc-sts__ll-desc">{{ lower_left_desc }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- 5. BOTTOM-RIGHT EDITORIAL TEXT & CTA (Box 5) -->
    <div class="szc-sts__bottom-right" data-sts-item="editorial-text">
      {%- if bottom_text != blank -%}
        <div class="szc-sts__narrative">{{ bottom_text }}</div>
      {%- endif -%}
      {%- if button_label != blank -%}
        <a href="{{ button_link | default: '#' }}" class="szc-sts__cta-link">
          <span>{{ button_label }}</span>
          <span class="szc-sts__cta-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </span>
        </a>
      {%- endif -%}
    </div>

  </div>

  <!-- 6. BRAND FEATURES ROW (Directly below main editorial content) -->
  {%- if show_features -%}
    <div class="szc-sts__features-wrap" data-sts-item="features-row">
      <div class="szc-sts__features-grid">
        {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
        {%- if feature_blocks.size > 0 -%}
          {%- for block in feature_blocks -%}
            <div class="szc-sts__feature-item" {{ block.shopify_attributes }}>
              <div class="szc-sts__feature-icon-box">
                {%- if block.settings.custom_icon != blank -%}
                  {{ block.settings.custom_icon | image_url: width: 64 | image_tag:
                    class: 'szc-sts__feature-custom-icon',
                    loading: 'lazy',
                    alt: block.settings.title | default: 'Brand feature icon'
                  }}
                {%- else -%}
                  {% render 'icon',
                    icon: block.settings.icon | default: 'fabric',
                    class: 'szc-sts__feature-icon'
                  %}
                {%- endif -%}
              </div>
              <div class="szc-sts__feature-text">
                {%- if block.settings.title != blank -%}
                  <h4 class="szc-sts__feature-title">{{ block.settings.title }}</h4>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="szc-sts__feature-subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback 3 Default Features from Reference Screenshot -->
          <div class="szc-sts__feature-item">
            <div class="szc-sts__feature-icon-box">
              {% render 'icon', icon: 'fabric', class: 'szc-sts__feature-icon' %}
            </div>
            <div class="szc-sts__feature-text">
              <h4 class="szc-sts__feature-title">Premium Fabrics</h4>
              <p class="szc-sts__feature-subtitle">Soft, Durable & Sustainable</p>
            </div>
          </div>

          <div class="szc-sts__feature-item">
            <div class="szc-sts__feature-icon-box">
              {% render 'icon', icon: 'shield-check', class: 'szc-sts__feature-icon' %}
            </div>
            <div class="szc-sts__feature-text">
              <h4 class="szc-sts__feature-title">Made to Last</h4>
              <p class="szc-sts__feature-subtitle">Timeless Designs</p>
            </div>
          </div>

          <div class="szc-sts__feature-item">
            <div class="szc-sts__feature-icon-box">
              {% render 'icon', icon: 'user-heart', class: 'szc-sts__feature-icon' %}
            </div>
            <div class="szc-sts__feature-text">
              <h4 class="szc-sts__feature-title">Trusted by 10,000+</h4>
              <p class="szc-sts__feature-subtitle">Happy Customers</p>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .szc-style-that-speaks {
    background-color: var(--szc-sts-bg, #ffffff);
    padding-top: var(--szc-sts-pt, 48px);
    padding-bottom: var(--szc-sts-pb, 48px);
    position: relative;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
  }

  .szc-sts__canvas {
    position: relative;
    width: 100%;
    max-width: var(--szc-sts-max-width, 1260px);
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Typography Styles */
  .szc-sts__heading-group {
    display: flex;
    flex-direction: column;
  }

  .szc-sts__eyebrow {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--szc-sts-eyebrow, #b6ae60);
    margin-bottom: 6px;
  }

  .szc-sts__heading {
    margin: 0;
    font-family: var(--font-heading--family, Montserrat, "Montserrat", "Arial Black", -apple-system, sans-serif);
    font-size: var(--szc-sts-heading-desktop, 100px);
    font-weight: var(--szc-sts-heading-weight, 900);
    line-height: var(--szc-sts-line-height, 0.85);
    letter-spacing: var(--szc-sts-letter-spacing, -3px);
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
  }

  .szc-sts__line {
    display: block;
    white-space: nowrap;
    transition: color 250ms ease;
  }

  .szc-sts__line.is-filled {
    color: var(--szc-sts-solid, #0950b2);
  }

  .szc-sts__line.is-outlined {
    color: var(--szc-sts-bg, #ffffff);
    -webkit-text-fill-color: var(--szc-sts-bg, #ffffff);
    -webkit-text-stroke: 0px transparent;
    letter-spacing: 0.05em;
    text-shadow:
      var(--szc-sts-neg-stroke, -2px) var(--szc-sts-neg-stroke, -2px) 0 var(--szc-sts-outline, #0950b2),
      0px var(--szc-sts-neg-stroke, -2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-width, 2px) var(--szc-sts-neg-stroke, -2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-neg-stroke, -2px) 0px 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-width, 2px) 0px 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-neg-stroke, -2px) var(--szc-sts-stroke-width, 2px) 0 var(--szc-sts-outline, #0950b2),
      0px var(--szc-sts-stroke-width, 2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-width, 2px) var(--szc-sts-stroke-width, 2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-neg-stroke-half, -1px) var(--szc-sts-neg-stroke, -2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-half, 1px) var(--szc-sts-neg-stroke, -2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-neg-stroke, -2px) var(--szc-sts-neg-stroke-half, -1px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-width, 2px) var(--szc-sts-neg-stroke-half, -1px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-neg-stroke, -2px) var(--szc-sts-stroke-half, 1px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-width, 2px) var(--szc-sts-stroke-half, 1px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-neg-stroke-half, -1px) var(--szc-sts-stroke-width, 2px) 0 var(--szc-sts-outline, #0950b2),
      var(--szc-sts-stroke-half, 1px) var(--szc-sts-stroke-width, 2px) 0 var(--szc-sts-outline, #0950b2);
    transition: color 250ms ease, text-shadow 250ms ease;
  }

  /* Card Image Elements */
  .szc-sts__card-img-box {
    position: relative;
    overflow: hidden;
    border-radius: var(--szc-sts-radius, 28px);
    background-color: var(--szc-sts-card-bg, #f6f5f2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .szc-sts__card-img-box--ur {
    aspect-ratio: 4 / 5;
    width: 100%;
  }

  .szc-sts__card-img-box--ll {
    aspect-ratio: 1 / 1.05;
    width: 100%;
  }

  .szc-sts__card-img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center center;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .szc-sts__top-right:hover .szc-sts__card-img,
  .szc-sts__bottom-left:hover .szc-sts__card-img {
    transform: scale(1.035);
  }

  .szc-sts__bottom-left.has-shadow .szc-sts__card-img-box {
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .szc-sts__tr-content,
  .szc-sts__ll-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 2px;
  }

  .szc-sts__tr-title,
  .szc-sts__ll-title {
    margin: 0;
    font-family: var(--font-heading--family, -apple-system, sans-serif);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #111111;
  }

  .szc-sts__tr-desc,
  .szc-sts__ll-desc {
    margin: 0;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 12px;
    line-height: 1.48;
    color: var(--szc-sts-body, #333333);
  }

  /* Editorial Narrative & CTA */
  .szc-sts__narrative {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--szc-sts-body, #333333);
  }

  .szc-sts__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--szc-font-family-heading, -apple-system, sans-serif);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #111111;
    border-bottom: 1.5px solid #111111;
    padding-bottom: 3px;
    align-self: flex-start;
    transition: color 250ms ease, border-color 250ms ease;
  }

  .szc-sts__cta-link:hover {
    color: var(--szc-sts-solid, #0950b2);
    border-bottom-color: var(--szc-sts-solid, #0950b2);
  }

  .szc-sts__cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 250ms ease;
  }

  .szc-sts__cta-arrow svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .szc-sts__cta-link:hover .szc-sts__cta-arrow {
    transform: translateX(4px);
  }

  /* ---------------------------------------------------- */
  /* Desktop Layout (1025px and above)                   */
  /* ---------------------------------------------------- */
  @media (min-width: 1025px) {
    .szc-sts__canvas {
      position: relative;
      aspect-ratio: 1024 / 904;
      min-height: var(--szc-sts-height, 860px);
    }

    /* 1. Heading Top-Left (Box 1) */
    .szc-sts__heading-group {
      position: absolute;
      left: 7.2%;
      top: 13.5%;
      z-index: 1;
      white-space: nowrap;
    }

    .szc-sts__heading {
      font-size: var(--szc-sts-heading-desktop, 104px);
      font-weight: var(--szc-sts-heading-weight, 900);
      line-height: var(--szc-sts-line-height, 0.85);
      letter-spacing: var(--szc-sts-letter-spacing, -3px);
    }

    /* 2. Main Center Visual */
    .szc-sts__main-visual {
      position: absolute;
      left: 51.5%;
      top: 7%;
      transform: translateX(-50%);
      height: 86%;
      max-height: 86%;
      width: auto;
      max-width: 48%;
      z-index: 2;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      pointer-events: none;
    }

    .szc-sts__main-img {
      width: auto;
      height: 100%;
      max-height: 100%;
      object-fit: contain;
      object-position: center center;
      filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.05));
      transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: auto;
    }

    .szc-sts__main-visual:hover .szc-sts__main-img {
      transform: scale(1.015);
    }

    /* 3. Top-Right Supporting Card (Box 2 & Box 3) */
    .szc-sts__top-right {
      position: absolute;
      right: 7.2%;
      top: 13.5%;
      width: var(--szc-sts-ur-width, 220px);
      max-width: 22%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .szc-sts__top-right:hover {
      transform: translateY(-4px);
    }

    /* 4. Bottom-Left Supporting Card (Box 4) */
    .szc-sts__bottom-left {
      position: absolute;
      left: 7.2%;
      top: 49%;
      width: var(--szc-sts-ll-width, 220px);
      max-width: 21%;
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 12px;
      transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 350ms ease;
    }

    .szc-sts__bottom-left:hover {
      transform: translateY(-4px);
    }

    /* 5. Bottom-Right Narrative (Box 5) */
    .szc-sts__bottom-right {
      position: absolute;
      left: 55%;
      right: 7.2%;
      bottom: 4.5%;
      max-width: var(--szc-sts-br-width, 440px);
      z-index: 3;
