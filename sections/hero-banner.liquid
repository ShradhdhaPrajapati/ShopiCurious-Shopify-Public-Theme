{%- liquid
  assign height_class = 'szc-hero-banner--' | append: section.settings.section_height
  assign layout_style_class = 'szc-hero-banner--layout-' | append: section.settings.layout_style | default: 'szc-hero-banner--layout-card'
  assign mobile_container_class = ''
  if section.settings.show_container_mobile
    assign mobile_container_class = 'szc-hero-banner--content-below-mobile'
  endif
  assign align_mobile_class = 'szc-hero-banner__content--align-mobile-' | append: section.settings.content_alignment_mobile | default: 'left'
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
-%}

<hero-slider
  id="HeroBanner-{{ section.id }}"
  class="szc-hero-banner {{ height_class }} {{ layout_style_class }} {{ mobile_container_class }} {{ align_mobile_class }}"
  style="--szc-banner-radius: {{ section.settings.card_border_radius | default: 16 }}px;"
  data-auto-rotate="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_every }}"
>
  <div class="szc-hero-banner__slides" data-slides-container>
    {%- if has_blocks -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'slide' -%}
            {%- liquid
              assign hero_img = block.settings.image
              assign hero_img_mobile = block.settings.image_mobile | default: hero_img
              assign align_class = 'szc-hero-banner__content--align-' | append: block.settings.content_alignment
              assign overlay_op = block.settings.overlay_opacity | default: section.settings.overlay_opacity
            -%}
            <div
              class="szc-hero-banner__slide {% if forloop.first %}is-active{% endif %}"
              data-slide-index="{{ forloop.index0 }}"
              style="--szc-overlay-opacity: {{ overlay_op | divided_by: 100.0 }};"
              {{ block.shopify_attributes }}
            >
              <div class="szc-hero-banner__media">
                {%- if hero_img != blank -%}
                  <picture>
                    {%- if hero_img_mobile != blank -%}
                      <source media="(max-width: 767px)" srcset="{{ hero_img_mobile | image_url: width: 800 }}">
                    {%- endif -%}
                    {{
                      hero_img
                      | image_url: width: 2400
                      | image_tag:
                        class: 'szc-hero-banner__image',
                        loading: 'eager',
                        fetchpriority: 'high',
                        alt: block.settings.heading
                    }}
                  </picture>
                {%- else -%}
                  <div class="szc-hero-banner__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
                  </div>
                {%- endif -%}
                <div class="szc-hero-banner__overlay"></div>
              </div>

              <div class="szc-hero-banner__container page-width">
                <div class="szc-hero-banner__content {{ align_class }} szc-animate-fade-up">
                  {%- if block.settings.subheading != blank -%}
                    <span class="szc-hero-banner__subheading">{{ block.settings.subheading }}</span>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <h1 class="szc-hero-banner__heading">{{ block.settings.heading }}</h1>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="szc-hero-banner__text">{{ block.settings.text }}</div>
                  {%- endif -%}

                  {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                    {%- liquid
                      assign b1_variant = block.settings.button_1_style | default: 'primary'
                      assign b1_size = block.settings.button_1_size | default: 'md'
                      assign b2_variant = block.settings.button_2_style | default: 'outline'
                      assign b2_size = block.settings.button_2_size | default: 'md'
                      assign mobile_layout = section.settings.buttons_layout_mobile | default: 'inline'
                    -%}
                    <div class="szc-hero-banner__buttons szc-hero-banner__buttons--mobile-{{ mobile_layout }}">
                      {%- if block.settings.button_label_1 != blank -%}
                        {% render 'button',
                          label: block.settings.button_label_1,
                          url: block.settings.button_link_1,
                          variant: b1_variant,
                          size: b1_size
                        %}
                      {%- endif -%}

                      {%- if block.settings.button_label_2 != blank -%}
                        {%- assign hide_b2 = block.settings.hide_button_2_mobile -%}
                        <div class="{% if hide_b2 %}szc-hero-banner__btn-2-mobile-hide{% endif %}">
                          {% render 'button',
                            label: block.settings.button_label_2,
                            url: block.settings.button_link_2,
                            variant: b2_variant,
                            size: b2_size
                          %}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
      {%- liquid
        assign hero_img = section.settings.image
        assign hero_img_mobile = section.settings.image_mobile | default: hero_img
        assign align_class = 'szc-hero-banner__content--align-' | append: section.settings.content_alignment
      -%}
      <div
        class="szc-hero-banner__slide is-active"
        data-slide-index="0"
        style="--szc-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      >
        <div class="szc-hero-banner__media">
          {%- if hero_img != blank -%}
            <picture>
              {%- if hero_img_mobile != blank -%}
                <source media="(max-width: 767px)" srcset="{{ hero_img_mobile | image_url: width: 800 }}">
              {%- endif -%}
              {{
                hero_img
                | image_url: width: 2400
                | image_tag:
                  class: 'szc-hero-banner__image',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: section.settings.heading
              }}
            </picture>
          {%- else -%}
            <div class="szc-hero-banner__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
            </div>
          {%- endif -%}
          <div class="szc-hero-banner__overlay"></div>
        </div>

        <div class="szc-hero-banner__container page-width">
          <div class="szc-hero-banner__content {{ align_class }} szc-animate-fade-up">
            {%- if section.settings.subheading != blank -%}
              <span class="szc-hero-banner__subheading">{{ section.settings.subheading }}</span>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h1 class="szc-hero-banner__heading">{{ section.settings.heading }}</h1>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <div class="szc-hero-banner__text">{{ section.settings.text }}</div>
            {%- endif -%}

            {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
              <div class="szc-hero-banner__buttons szc-hero-banner__buttons--mobile-{{ section.settings.buttons_layout_mobile | default: 'inline' }}">
                {%- if section.settings.button_label_1 != blank -%}
                  {% render 'button',
                    label: section.settings.button_label_1,
                    url: section.settings.button_link_1,
                    variant: 'primary',
                    size: 'md'
                  %}
                {%- endif -%}

                {%- if section.settings.button_label_2 != blank -%}
                  <div class="szc-hero-banner__btn-2-mobile-hide">
                    {% render 'button',
                      label: section.settings.button_label_2,
                      url: section.settings.button_link_2,
                      variant: 'outline',
                      size: 'md'
                    %}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="szc-hero-banner__controls">
      <button
        type="button"
        class="szc-hero-banner__nav-btn szc-hero-banner__nav-btn--prev"
        data-nav-prev
        aria-label="{{ 'general.pagination.previous' | t | default: 'Previous slide' }}"
      >
        {% render 'icon', icon: 'chevron-left', class: 'szc-hero-banner__nav-icon' %}
      </button>

      <div class="szc-hero-banner__dots" data-dots-container>
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="szc-hero-banner__dot {% if forloop.first %}is-active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="szc-hero-banner__nav-btn szc-hero-banner__nav-btn--next"
        data-nav-next
        aria-label="{{ 'general.pagination.next' | t | default: 'Next slide' }}"
      >
        {% render 'icon', icon: 'chevron-right', class: 'szc-hero-banner__nav-icon' %}
      </button>
    </div>
  {%- endif -%}
</hero-slider>

{% stylesheet %}
  /* ==========================================================================
     1. HERO BANNER - BASE & SHARED STYLES
     ========================================================================== */
  .szc-hero-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
    background: transparent;
  }

  /* Default Desktop / Tablet: Full Width Layout (Ignore Card Settings) */
  .szc-hero-banner--layout-full,
  .szc-hero-banner--layout-card {
    width: 100%;
    max-width: none;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .szc-hero-banner__slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .szc-hero-banner__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 600ms cubic-bezier(0.4, 0, 0.2, 1), visibility 600ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .szc-hero-banner__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .szc-hero-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .szc-hero-banner__media picture {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .szc-hero-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .szc-hero-banner__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #2b2b2b;
  }

  .szc-hero-banner__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, var(--szc-overlay-opacity, 0.3));
    z-index: 2;
  }

  .szc-hero-banner__container {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    display: flex;
  }

  .szc-hero-banner__content {
    display: flex;
    flex-direction: column;
    color: #ffffff;
  }

  .szc-hero-banner__subheading {
    font-family: var(--szc-font-family-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--szc-letter-spacing-uppercase, 0.15em);
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-hero-banner__heading {
    font-family: var(--szc-font-family-heading);
    font-weight: 700;
    color: #ffffff;
  }

  .szc-hero-banner__text {
    font-family: var(--szc-font-family-body);
    color: rgba(255, 255, 255, 0.9);
  }

  .szc-hero-banner__buttons {
    display: flex;
    align-items: center;
  }

  .szc-hero-banner .szc-button--outline {
    border-color: #ffffff;
    color: #ffffff;
  }

  .szc-hero-banner .szc-button--outline:hover {
    background-color: #ffffff;
    color: #111111;
  }

  /* Shared Slider Navigation Controls */
  .szc-hero-banner__controls {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    height: auto;
    width: auto;
    box-sizing: border-box;
  }

  .szc-hero-banner__nav-btn {
    background: transparent !important;
    border: none !important;
    color: #ffffff !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 2px !important;
    margin: 0 !important;
    width: 20px !important;
    height: 20px !important;
    opacity: 0.85 !important;
    box-shadow: none !important;
    transition: opacity 150ms ease, transform 150ms ease !important;
  }

  .szc-hero-banner__nav-btn:hover {
    opacity: 1 !important;
    transform: scale(1.1) !important;
  }

  .szc-hero-banner__nav-icon {
    width: 16px !important;
    height: 16px !important;
  }

  .szc-hero-banner__dots {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    height: 12px !important;
  }

  .szc-hero-banner__dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 9999px !important;
    background-color: rgba(255, 255, 255, 0.45) !important;
    border: none !important;
    cursor: pointer !important;
    padding: 0 !important;
    margin: 0 !important;
    outline: none !important;
    flex-shrink: 0 !important;
    transition: all 250ms ease !important;
  }

  .szc-hero-banner__dot.is-active {
    width: 22px !important;
    height: 8px !important;
    background-color: #ffffff !important;
  }

  /* ==========================================================================
     2. DESKTOP LAYOUT (≥ 1024px)
     ========================================================================== */
  @media (min-width: 1024px) {
    .szc-hero-banner--small {
      height: 450px;
    }
    .szc-hero-banner--medium {
      height: 600px;
    }
    .szc-hero-banner--large {
      height: 750px;
    }
    .szc-hero-banner--full {
      height: 90vh;
      min-height: 650px;
    }

    .szc-hero-banner__container {
      padding: 48px 24px 110px 24px;
      align-items: center;
    }

    .szc-hero-banner__content {
      max-width: 640px;
    }

    .szc-hero-banner__content--align-left {
      text-align: left;
      align-items: flex-start;
    }
    .szc-hero-banner__content--align-center {
      text-align: center;
      align-items: center;
      margin: 0 auto;
    }
    .szc-hero-banner__content--align-right {
      text-align: right;
      align-items: flex-end;
      margin-left: auto;
    }

    .szc-hero-banner__subheading {
      font-size: 14px;
      margin-bottom: 12px;
    }

    .szc-hero-banner__heading {
      font-size: 64px;
      line-height: 1.1;
      margin: 0 0 16px 0;
    }

    .szc-hero-banner__text {
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .szc-hero-banner__buttons {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
    }

    .szc-hero-banner__controls {
      bottom: 72px;
      padding: 8px 16px;
      gap: 14px;
    }
  }

  /* ==========================================================================
     3. TABLET LAYOUT (768px – 1023px)
     ========================================================================== */
  @media (min-width: 768px) and (max-width: 1023px) {
    .szc-hero-banner--small {
      height: 380px;
    }
    .szc-hero-banner--medium {
      height: 480px;
    }
    .szc-hero-banner--large {
      height: 560px;
    }
    .szc-hero-banner--full {
      height: 75vh;
      min-height: 480px;
    }

    .szc-hero-banner__container {
      padding: 36px 20px 80px 20px;
      align-items: center;
    }

    .szc-hero-banner__content {
      max-width: 540px;
    }

    .szc-hero-banner__content--align-left {
      text-align: left;
      align-items: flex-start;
    }
    .szc-hero-banner__content--align-center {
      text-align: center;
      align-items: center;
      margin: 0 auto;
    }
    .szc-hero-banner__content--align-right {
      text-align: right;
      align-items: flex-end;
      margin-left: auto;
    }

    .szc-hero-banner__subheading {
      font-size: 13px;
      margin-bottom: 10px;
    }

    .szc-hero-banner__heading {
      font-size: 42px;
      line-height: 1.12;
      margin: 0 0 14px 0;
    }

    .szc-hero-banner__text {
      font-size: 15px;
      line-height: 1.5;
      margin-bottom: 20px;
    }

    .szc-hero-banner__buttons {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }

    .szc-hero-banner__controls {
      bottom: 42px;
      padding: 6px 14px;
      gap: 12px;
    }
  }

  /* ==========================================================================
     4. MOBILE LAYOUT (320px – 767px)
     ========================================================================== */
  @media (max-width: 767px) {
    /* Banner Layout Style & Card Corner Radius Settings apply ONLY on Mobile */
    .szc-hero-banner--layout-card {
      margin: 10px 12px;
      width: calc(100% - 24px);
      border-radius: var(--szc-banner-radius, 16px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
      overflow: hidden;
    }

    .szc-hero-banner--layout-full {
      margin: 0;
      width: 100%;
      border-radius: 0;
      box-shadow: none;
    }

    .szc-hero-banner--small {
      height: 360px;
    }
    .szc-hero-banner--medium {
      height: 300px;
    }
    .szc-hero-banner--large {
      height: 300px;
    }
    .szc-hero-banner--full {
      height: 40vh;
      min-height: 300px;
    }

    .szc-hero-banner__container {
      padding: 24px 16px 64px 16px;
      align-items: center;
    }

    .szc-hero-banner__content {
      width: 100%;
      max-width: 100%;
    }

    .szc-hero-banner__content--align-mobile-left {
      text-align: left;
      align-items: flex-start;
    }
    .szc-hero-banner__content--align-mobile-center {
      text-align: center;
      align-items: center;
      margin: 0 auto;
    }
    .szc-hero-banner__content--align-mobile-right {
      text-align: right;
      align-items: flex-end;
      margin-left: auto;
    }

    .szc-hero-banner__subheading {
      font-size: 11px;
      letter-spacing: 0.12em;
      margin-bottom: 6px;
    }

    .szc-hero-banner__heading {
      font-size: clamp(22px, 6vw, 32px);
      line-height: 1.15;
      margin: 0 0 8px 0;
    }

    .szc-hero-banner__text {
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 16px;
    }

    /* Mobile Compact Luxury Pill Buttons */
    .szc-hero-banner__buttons {
      width: 100%;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 10px;
    }

    .szc-hero-banner__content--align-mobile-center .szc-hero-banner__buttons {
      justify-content: center;
    }

    .szc-hero-banner__content--align-mobile-left .szc-hero-banner__buttons {
      justify-content: flex-start;
    }

    .szc-hero-banner__content--align-mobile-right .szc-hero-banner__buttons {
      justify-content: flex-end;
    }

    .szc-hero-banner__buttons .szc-button,
    .szc-hero-banner__buttons a,
    .szc-hero-banner__buttons button {
      width: fit-content !important;
      flex: 0 0 auto !important;
      height: 42px !important;
      min-height: 42px !important;
      padding: 0 28px !important;
      font-size: 13px !important;
      border-radius: 999px !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-sizing: border-box !important;
      letter-spacing: 0.05em !important;
      white-space: nowrap !important;
    }

    .szc-hero-banner__btn-2-mobile-hide {
      display: none !important;
    }

    .szc-hero-banner__controls {
      bottom: 18px;
      padding: 4px 10px;
      gap: 8px;
    }

    /* Content Below Mobile Option */
    .szc-hero-banner--content-below-mobile {
      height: auto !important;
    }

    .szc-hero-banner--content-below-mobile .szc-hero-banner__slides {
      min-height: 0;
      height: auto;
    }

    .szc-hero-banner--content-below-mobile .szc-hero-banner__slide {
      position: absolute;
      inset: 0;
      flex-direction: column;
      height: auto;
    }

    .szc-hero-banner--content-below-mobile .szc-hero-banner__slide.is-active {
      position: relative;
    }

    .szc-hero-banner--content-below-mobile .szc-hero-banner__media {
      position: relative;
      height: 240px;
      width: 100%;
    }

    .szc-hero-banner--content-below-mobile .szc-hero-banner__container {
      position: relative;
      background-color: var(--szc-color-surface-dark, #161616);
      padding: 20px 16px 64px 16px;
      width: 100%;
      height: auto;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('hero-slider')) {
    customElements.define(
      'hero-slider',
      class HeroSlider extends HTMLElement {
        constructor() {
          super();
          this.slides = this.querySelectorAll('.szc-hero-banner__slide');
          this.dots = this.querySelectorAll('.szc-hero-banner__dot');
          this.prevBtn = this.querySelector('[data-nav-prev]');
          this.nextBtn = this.querySelector('[data-nav-next]');
          this.autoRotate = this.dataset.autoRotate === 'true';
          this.speed = (parseInt(this.dataset.speed, 10) || 5) * 1000;
          this.currentIndex = 0;
          this.timer = null;

          if (this.slides.length <= 1) return;

          if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.prev());
          if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.next());

          this.dots.forEach((dot) => {
            dot.addEventListener('click', () => {
              const index = parseInt(dot.dataset.dotIndex, 10);
              this.goToSlide(index);
            });
          });

          if (this.autoRotate) {
            this.startAutoRotate();
            this.addEventListener('mouseenter', () => this.stopAutoRotate());
            this.addEventListener('mouseleave', () => this.startAutoRotate());
          }
        }

        goToSlide(index) {
          this.slides[this.currentIndex].classList.remove('is-active');
          if (this.dots[this.currentIndex]) {
            this.dots[this.currentIndex].classList.remove('is-active');
          }

          this.currentIndex = index;

          this.slides[this.currentIndex].classList.add('is-active');
          if (this.dots[this.currentIndex]) {
            this.dots[this.currentIndex].classList.add('is-active');
          }
        }

        next() {
          const nextIndex = (this.currentIndex + 1) % this.slides.length;
          this.goToSlide(nextIndex);
        }

        prev() {
          const prevIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;
          this.goToSlide(prevIndex);
        }

        startAutoRotate() {
          if (this.timer) clearInterval(this.timer);
          this.timer = setInterval(() => this.next(), this.speed);
        }

        stopAutoRotate() {
          if (this.timer) clearInterval(this.timer);
        }
      }
    );
  }
{% endjavascript %}

