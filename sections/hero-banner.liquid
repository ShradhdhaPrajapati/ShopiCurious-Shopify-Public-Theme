{%- liquid
  assign height_class = 'szc-hero-banner--' | append: section.settings.section_height
  assign layout_style_class = 'szc-hero-banner--layout-' | append: section.settings.layout_style | default: 'szc-hero-banner--layout-card'
  assign mobile_container_class = ''
  if section.settings.show_container_mobile
    assign mobile_container_class = 'szc-hero-banner--content-below-mobile'
  endif
  assign align_mobile_class = 'szc-hero-banner__content--align-mobile-' | append: section.settings.content_alignment_mobile | default: 'left'
  assign has_blocks = false
  if section.blocks.size > 0
    assign has_blocks = true
  endif
  assign hero_style = section.settings.hero_style | default: 'classic_slider'
-%}

{%- if hero_style == 'hover_panels' -%}
  <hero-hover-panels
    id="HeroBanner-{{ section.id }}"
    class="szc-hero-hover-panels {{ height_class }} {{ layout_style_class }}"
    style="--szc-banner-radius: {{ section.settings.card_border_radius | default: 16 }}px;"
  >
    <div class="szc-hero-hover-panels__container page-width">
      <div class="szc-hero-hover-panels__grid">
        {%- if has_blocks -%}
          {%- for block in section.blocks limit: 4 -%}
            {%- liquid
              assign hero_img = block.settings.image
              assign hero_img_mobile = block.settings.image_mobile | default: hero_img
              assign align_class = 'szc-hero-hover-panels__content--align-' | append: block.settings.content_alignment
              assign overlay_op = block.settings.overlay_opacity | default: section.settings.overlay_opacity

              assign sub_size = block.settings.subheading_font_size | default: 14
              assign sub_weight = block.settings.subheading_font_weight | default: '700'
              assign sub_color = block.settings.subheading_color

              assign head_size = block.settings.heading_font_size | default: 48
              assign head_weight = block.settings.heading_font_weight | default: '700'
              assign head_color = block.settings.heading_color

              assign text_size = block.settings.text_font_size | default: 15
              assign text_weight = block.settings.text_font_weight | default: '400'
              assign text_color = block.settings.text_color

              assign bd_color = block.settings.content_backdrop_color
              if bd_color == blank or bd_color == 'rgba(0,0,0,0)'
                assign bd_color = section.settings.hover_backdrop_color
              endif
              if bd_color == blank or bd_color == 'rgba(0,0,0,0)'
                assign bd_color = '#121212'
              endif

              assign bd_op = block.settings.content_backdrop_opacity
              if bd_op == blank
                assign bd_op = section.settings.hover_backdrop_opacity | default: 58
              endif
              assign bd_alpha = bd_op | divided_by: 100.0
              assign backdrop_bg = bd_color | color_modify: 'alpha', bd_alpha
            -%}
            <div
              class="szc-hero-hover-panels__panel {% if forloop.first %}is-active{% endif %}"
              data-panel-index="{{ forloop.index0 }}"
              tabindex="0"
              style="
                --szc-overlay-opacity: {{ overlay_op | divided_by: 100.0 }};
                --szc-content-backdrop: {{ backdrop_bg }};
                --szc-subheading-size: {{ sub_size }}px;
                --szc-subheading-weight: {{ sub_weight }};
                {% if sub_color != blank and sub_color != 'rgba(0,0,0,0)' %}--szc-subheading-color: {{ sub_color }};{% endif %}
                --szc-heading-size: {{ head_size }}px;
                --szc-heading-weight: {{ head_weight }};
                {% if head_color != blank and head_color != 'rgba(0,0,0,0)' %}--szc-heading-color: {{ head_color }};{% endif %}
                --szc-text-size: {{ text_size }}px;
                --szc-text-weight: {{ text_weight }};
                {% if text_color != blank and text_color != 'rgba(0,0,0,0)' %}--szc-text-color: {{ text_color }};{% endif %}
              "
              {{ block.shopify_attributes }}
            >
              <div class="szc-hero-hover-panels__media">
                {%- if hero_img != blank -%}
                  <picture>
                    {%- if hero_img_mobile != blank -%}
                      <source media="(max-width: 767px)" srcset="{{ hero_img_mobile | image_url: width: 800 }}">
                    {%- endif -%}
                    {{
                      hero_img
                      | image_url: width: 1600
                      | image_tag:
                        class: 'szc-hero-hover-panels__image',
                        loading: 'eager',
                        fetchpriority: 'high',
                        alt: block.settings.heading
                    }}
                  </picture>
                {%- else -%}
                  <div class="szc-hero-hover-panels__placeholder">
                    {%- assign placeholder_idx = forloop.index | modulo: 3 | plus: 1 -%}
                    {{ 'lifestyle-' | append: placeholder_idx | placeholder_svg_tag: 'szc-image-placeholder' }}
                  </div>
                {%- endif -%}
                <div class="szc-hero-hover-panels__overlay"></div>
              </div>

              <div class="szc-hero-hover-panels__content-wrapper">
                <div class="szc-hero-hover-panels__content {{ align_class }}">
                  {%- if block.settings.subheading != blank -%}
                    <span class="szc-hero-hover-panels__subheading">{{ block.settings.subheading }}</span>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <h2 class="szc-hero-hover-panels__heading">{{ block.settings.heading }}</h2>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="szc-hero-hover-panels__text">{{ block.settings.text }}</div>
                  {%- endif -%}

                  {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                    {%- liquid
                      assign b1_variant = block.settings.button_1_style | default: 'primary'
                      assign b1_size = block.settings.button_1_size | default: 'md'
                      assign b2_variant = block.settings.button_2_style | default: 'outline'
                      assign b2_size = block.settings.button_2_size | default: 'md'
                    -%}
                    <div class="szc-hero-hover-panels__buttons">
                      {%- if block.settings.button_label_1 != blank -%}
                        {% render 'button',
                          label: block.settings.button_label_1,
                          url: block.settings.button_link_1,
                          variant: b1_variant,
                          size: b1_size
                        %}
                      {%- endif -%}

                      {%- if block.settings.button_label_2 != blank -%}
                        {%- assign hide_b2 = block.settings.hide_button_2_mobile -%}
                        <div class="{% if hide_b2 %}szc-hero-hover-panels__btn-2-mobile-hide{% endif %}">
                          {% render 'button',
                            label: block.settings.button_label_2,
                            url: block.settings.button_link_2,
                            variant: b2_variant,
                            size: b2_size
                          %}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            assign hero_img = section.settings.image
            assign hero_img_mobile = section.settings.image_mobile | default: hero_img
            assign align_class = 'szc-hero-hover-panels__content--align-' | append: section.settings.content_alignment
            assign overlay_op = section.settings.overlay_opacity

            assign sub_size = section.settings.subheading_font_size | default: 14
            assign sub_weight = section.settings.subheading_font_weight | default: '700'
            assign sub_color = section.settings.subheading_color

            assign head_size = section.settings.heading_font_size | default: 48
            assign head_weight = section.settings.heading_font_weight | default: '700'
            assign head_color = section.settings.heading_color

            assign text_size = section.settings.text_font_size | default: 15
            assign text_weight = section.settings.text_font_weight | default: '400'
            assign text_color = section.settings.text_color

            assign bd_color = section.settings.hover_backdrop_color
            if bd_color == blank or bd_color == 'rgba(0,0,0,0)'
              assign bd_color = '#121212'
            endif
            assign bd_op = section.settings.hover_backdrop_opacity | default: 58
            assign bd_alpha = bd_op | divided_by: 100.0
            assign backdrop_bg = bd_color | color_modify: 'alpha', bd_alpha
          -%}
          <div
            class="szc-hero-hover-panels__panel is-active"
            tabindex="0"
            style="
              --szc-overlay-opacity: {{ overlay_op | divided_by: 100.0 }};
              --szc-content-backdrop: {{ backdrop_bg }};
              --szc-subheading-size: {{ sub_size }}px;
              --szc-subheading-weight: {{ sub_weight }};
              {% if sub_color != blank and sub_color != 'rgba(0,0,0,0)' %}--szc-subheading-color: {{ sub_color }};{% endif %}
              --szc-heading-size: {{ head_size }}px;
              --szc-heading-weight: {{ head_weight }};
              {% if head_color != blank and head_color != 'rgba(0,0,0,0)' %}--szc-heading-color: {{ head_color }};{% endif %}
              --szc-text-size: {{ text_size }}px;
              --szc-text-weight: {{ text_weight }};
              {% if text_color != blank and text_color != 'rgba(0,0,0,0)' %}--szc-text-color: {{ text_color }};{% endif %}
            "
          >
            <div class="szc-hero-hover-panels__media">
              {%- if hero_img != blank -%}
                <picture>
                  {%- if hero_img_mobile != blank -%}
                    <source media="(max-width: 767px)" srcset="{{ hero_img_mobile | image_url: width: 800 }}">
                  {%- endif -%}
                  {{
                    hero_img
                    | image_url: width: 1600
                    | image_tag:
                      class: 'szc-hero-hover-panels__image',
                      loading: 'eager',
                      fetchpriority: 'high',
                      alt: section.settings.heading
                  }}
                </picture>
              {%- else -%}
                <div class="szc-hero-hover-panels__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
                </div>
              {%- endif -%}
              <div class="szc-hero-hover-panels__overlay"></div>
            </div>

            <div class="szc-hero-hover-panels__content-wrapper">
              <div class="szc-hero-hover-panels__content {{ align_class }}">
                {%- if section.settings.subheading != blank -%}
                  <span class="szc-hero-hover-panels__subheading">{{ section.settings.subheading }}</span>
                {%- endif -%}

                {%- if section.settings.heading != blank -%}
                  <h2 class="szc-hero-hover-panels__heading">{{ section.settings.heading }}</h2>
                {%- endif -%}

                {%- if section.settings.text != blank -%}
                  <div class="szc-hero-hover-panels__text">{{ section.settings.text }}</div>
                {%- endif -%}

                {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
                  {%- liquid
                    assign sec_b1_variant = section.settings.button_1_style | default: 'primary'
                    assign sec_b1_size = section.settings.button_1_size | default: 'md'
                    assign sec_b2_variant = section.settings.button_2_style | default: 'outline'
                    assign sec_b2_size = section.settings.button_2_size | default: 'md'
                  -%}
                  <div class="szc-hero-hover-panels__buttons">
                    {%- if section.settings.button_label_1 != blank -%}
                      {% render 'button',
                        label: section.settings.button_label_1,
                        url: section.settings.button_link_1,
                        variant: sec_b1_variant,
                        size: sec_b1_size
                      %}
                    {%- endif -%}

                    {%- if section.settings.button_label_2 != blank -%}
                      <div class="szc-hero-hover-panels__btn-2-mobile-hide">
                        {% render 'button',
                          label: section.settings.button_label_2,
                          url: section.settings.button_link_2,
                          variant: sec_b2_variant,
                          size: sec_b2_size
                        %}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="szc-hover-panels-dots" aria-hidden="true" data-hover-panels-dots></div>
      {%- endif -%}
    </div>
  </hero-hover-panels>
{%- else -%}
  <hero-slider
    id="HeroBanner-{{ section.id }}"
    class="szc-hero-banner {{ height_class }} {{ layout_style_class }} {{ mobile_container_class }} {{ align_mobile_class }}"
    style="--szc-banner-radius: {{ section.settings.card_border_radius | default: 16 }}px;"
    data-auto-rotate="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_every }}"
  >
    <div class="szc-hero-banner__slides" data-slides-container>
      {%- if has_blocks -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'slide' -%}
              {%- liquid
                assign hero_img = block.settings.image
                assign hero_img_mobile = block.settings.image_mobile | default: hero_img
                assign align_class = 'szc-hero-banner__content--align-' | append: block.settings.content_alignment
                assign overlay_op = block.settings.overlay_opacity | default: section.settings.overlay_opacity

                assign sub_size = block.settings.subheading_font_size | default: 14
                assign sub_weight = block.settings.subheading_font_weight | default: '700'
                assign sub_color = block.settings.subheading_color

                assign head_size = block.settings.heading_font_size | default: 64
                assign head_weight = block.settings.heading_font_weight | default: '700'
                assign head_color = block.settings.heading_color

                assign text_size = block.settings.text_font_size | default: 16
                assign text_weight = block.settings.text_font_weight | default: '400'
                assign text_color = block.settings.text_color
              -%}
              <div
                class="szc-hero-banner__slide {% if forloop.first %}is-active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                style="
                  --szc-overlay-opacity: {{ overlay_op | divided_by: 100.0 }};
                  --szc-subheading-size: {{ sub_size }}px;
                  --szc-subheading-weight: {{ sub_weight }};
                  {% if sub_color != blank and sub_color != 'rgba(0,0,0,0)' %}--szc-subheading-color: {{ sub_color }};{% endif %}
                  --szc-heading-size: {{ head_size }}px;
                  --szc-heading-weight: {{ head_weight }};
                  {% if head_color != blank and head_color != 'rgba(0,0,0,0)' %}--szc-heading-color: {{ head_color }};{% endif %}
                  --szc-text-size: {{ text_size }}px;
                  --szc-text-weight: {{ text_weight }};
                  {% if text_color != blank and text_color != 'rgba(0,0,0,0)' %}--szc-text-color: {{ text_color }};{% endif %}
                "
                {{ block.shopify_attributes }}
              >
                <div class="szc-hero-banner__media">
                  {%- if hero_img != blank -%}
                    <picture>
                      {%- if hero_img_mobile != blank -%}
                        <source media="(max-width: 767px)" srcset="{{ hero_img_mobile | image_url: width: 800 }}">
                      {%- endif -%}
                      {{
                        hero_img
                        | image_url: width: 2400
                        | image_tag:
                          class: 'szc-hero-banner__image',
                          loading: 'eager',
                          fetchpriority: 'high',
                          alt: block.settings.heading
                      }}
                    </picture>
                  {%- else -%}
                    <div class="szc-hero-banner__placeholder">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
                    </div>
                  {%- endif -%}
                  <div class="szc-hero-banner__overlay"></div>
                </div>

                <div class="szc-hero-banner__container page-width">
                  <div class="szc-hero-banner__content {{ align_class }} szc-animate-fade-up">
                    {%- if block.settings.subheading != blank -%}
                      <span class="szc-hero-banner__subheading">{{ block.settings.subheading }}</span>
                    {%- endif -%}

                    {%- if block.settings.heading != blank -%}
                      <h1 class="szc-hero-banner__heading">{{ block.settings.heading }}</h1>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <div class="szc-hero-banner__text">{{ block.settings.text }}</div>
                    {%- endif -%}

                    {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                      {%- liquid
                        assign b1_variant = block.settings.button_1_style | default: 'primary'
                        assign b1_size = block.settings.button_1_size | default: 'md'
                        assign b2_variant = block.settings.button_2_style | default: 'outline'
                        assign b2_size = block.settings.button_2_size | default: 'md'
                        assign mobile_layout = section.settings.buttons_layout_mobile | default: 'inline'
                      -%}
                      <div class="szc-hero-banner__buttons szc-hero-banner__buttons--mobile-{{ mobile_layout }}">
                        {%- if block.settings.button_label_1 != blank -%}
                          {% render 'button',
                            label: block.settings.button_label_1,
                            url: block.settings.button_link_1,
                            variant: b1_variant,
                            size: b1_size
                          %}
                        {%- endif -%}

                        {%- if block.settings.button_label_2 != blank -%}
                          {%- assign hide_b2 = block.settings.hide_button_2_mobile -%}
                          <div class="{% if hide_b2 %}szc-hero-banner__btn-2-mobile-hide{% endif %}">
                            {% render 'button',
                              label: block.settings.button_label_2,
                              url: block.settings.button_link_2,
                              variant: b2_variant,
                              size: b2_size
                            %}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      {%- else -%}
        {%- liquid
          assign hero_img = section.settings.image
          assign hero_img_mobile = section.settings.image_mobile | default: hero_img
          assign align_class = 'szc-hero-banner__content--align-' | append: section.settings.content_alignment

          assign sub_size = section.settings.subheading_font_size | default: 14
          assign sub_weight = section.settings.subheading_font_weight | default: '700'
          assign sub_color = section.settings.subheading_color

          assign head_size = section.settings.heading_font_size | default: 64
          assign head_weight = section.settings.heading_font_weight | default: '700'
          assign head_color = section.settings.heading_color

          assign text_size = section.settings.text_font_size | default: 16
          assign text_weight = section.settings.text_font_weight | default: '400'
          assign text_color = section.settings.text_color
        -%}
        <div
          class="szc-hero-banner__slide is-active"
          data-slide-index="0"
          style="
            --szc-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
            --szc-subheading-size: {{ sub_size }}px;
            --szc-subheading-weight: {{ sub_weight }};
            {% if sub_color != blank and sub_color != 'rgba(0,0,0,0)' %}--szc-subheading-color: {{ sub_color }};{% endif %}
            --szc-heading-size: {{ head_size }}px;
            --szc-heading-weight: {{ head_weight }};
            {% if head_color != blank and head_color != 'rgba(0,0,0,0)' %}--szc-heading-color: {{ head_color }};{% endif %}
            --szc-text-size: {{ text_size }}px;
            --szc-text-weight: {{ text_weight }};
            {% if text_color != blank and text_color != 'rgba(0,0,0,0)' %}--szc-text-color: {{ text_color }};{% endif %}
          "
        >
          <div class="szc-hero-banner__media">
            {%- if hero_img != blank -%}
              <picture>
                {%- if hero_img_mobile != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ hero_img_mobile | image_url: width: 800 }}">
                {%- endif -%}
                {{
                  hero_img
                  | image_url: width: 2400
                  | image_tag:
                    class: 'szc-hero-banner__image',
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: section.settings.heading
                }}
              </picture>
            {%- else -%}
              <div class="szc-hero-banner__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
              </div>
            {%- endif -%}
            <div class="szc-hero-banner__overlay"></div>
          </div>

          <div class="szc-hero-banner__container page-width">
            <div class="szc-hero-banner__content {{ align_class }} szc-animate-fade-up">
              {%- if section.settings.subheading != blank -%}
                <span class="szc-hero-banner__subheading">{{ section.settings.subheading }}</span>
              {%- endif -%}

              {%- if section.settings.heading != blank -%}
                <h1 class="szc-hero-banner__heading">{{ section.settings.heading }}</h1>
              {%- endif -%}

              {%- if section.settings.text != blank -%}
                <div class="szc-hero-banner__text">{{ section.settings.text }}</div>
              {%- endif -%}

              {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
                <div class="szc-hero-banner__buttons szc-hero-banner__buttons--mobile-{{ section.settings.buttons_layout_mobile | default: 'inline' }}">
                  {%- if section.settings.button_label_1 != blank -%}
                    {% render 'button',
                      label: section.settings.button_label_1,
                      url: section.settings.button_link_1,
                      variant: 'primary',
                      size: 'md'
                    %}
                  {%- endif -%}

                  {%- if section.settings.button_label_2 != blank -%}
                    <div class="szc-hero-banner__btn-2-mobile-hide">
                      {% render 'button',
                        label: section.settings.button_label_2,
                        url: section.settings.button_link_2,
                        variant: 'outline',
                        size: 'md'
                      %}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="szc-hero-banner__controls">
        <button
          type="button"
          class="szc-hero-banner__nav-btn szc-hero-banner__nav-btn--prev"
          data-nav-prev
          aria-label="{{ 'general.pagination.previous' | t | default: 'Previous slide' }}"
        >
          {% render 'icon', icon: 'chevron-left', class: 'szc-hero-banner__nav-icon' %}
        </button>

        <div class="szc-hero-banner__dots" data-dots-container>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="szc-hero-banner__dot {% if forloop.first %}is-active{% endif %}"
              data-dot-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="szc-hero-banner__nav-btn szc-hero-banner__nav-btn--next"
          data-nav-next
          aria-label="{{ 'general.pagination.next' | t | default: 'Next slide' }}"
        >
          {% render 'icon', icon: 'chevron-right', class: 'szc-hero-banner__nav-icon' %}
        </button>
      </div>
    {%- endif -%}
  </hero-slider>
{%- endif -%}

{% stylesheet %}
  /* ==========================================================================
     1. HERO BANNER - BASE & SHARED STYLES
     ========================================================================== */
  .szc-hero-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
    background: transparent;
  }

  /* Default Desktop / Tablet: Full Width Layout (Ignore Card Settings) */
  .szc-hero-banner--layout-full,
  .szc-hero-banner--layout-card {
    width: 100%;
    max-width: none;
    margin: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .szc-hero-banner__slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .szc-hero-banner__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 600ms cubic-bezier(0.4, 0, 0.2, 1), visibility 600ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
  }

  .szc-hero-banner__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .szc-hero-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .szc-hero-banner__media picture {
