      width: 100%;
      margin: 0;
      padding: 0;
      box-sizing: border-box;

      /* CSS Scroll Snap – horizontal, one panel at a time */
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;

      /* Hide scrollbar visually on all browsers */
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .szc-hero-hover-panels__grid::-webkit-scrollbar {
      display: none;
    }

    /* Each panel = one full-viewport-width slide */
    .szc-hero-hover-panels__panel {
      flex: 0 0 100%;           /* exactly one panel per viewport */
      width: 100%;
      max-width: 100%;
      height: 420px;
      min-height: 360px;
      border-radius: 0;         /* edge-to-edge on mobile */
      box-shadow: none;
      box-sizing: border-box;

      /* Snap to the start of each panel */
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    /* Only the active / tapped panel reveals its content on mobile */
    .szc-hero-hover-panels__content-wrapper {
      padding: 16px;
      overflow: hidden;
    }

    .szc-hero-hover-panels__content {
      width: 100%;
      max-width: 100%;
      padding: 18px 18px 22px 18px;
      border-radius: 12px;
      border-top: none;
      transform: translateY(calc(100% + 30px));
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: transform 450ms cubic-bezier(0.25, 1, 0.5, 1),
                  opacity 400ms cubic-bezier(0.25, 1, 0.5, 1),
                  visibility 450ms ease;
    }

    /* Active / tapped panel reveals only its own content */
    .szc-hero-hover-panels__panel.is-active .szc-hero-hover-panels__content {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .szc-hero-hover-panels__heading {
      font-size: clamp(20px, 5.5vw, 28px);
      margin-bottom: 6px;
    }

    .szc-hero-hover-panels__text {
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 14px;
    }

    .szc-hero-hover-panels__btn-2-mobile-hide {
      display: none !important;
    }

    /* Dot indicators for the mobile carousel */
    .szc-hover-panels-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 12px 0 4px;
    }

    .szc-hover-panels-dot {
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      background-color: rgba(0, 0, 0, 0.22);
      border: none;
      cursor: pointer;
      padding: 0;
      margin: 0;
      outline: none;
      flex-shrink: 0;
      transition: all 250ms ease;
    }

    .szc-hover-panels-dot.is-active {
      width: 22px;
      background-color: rgba(0, 0, 0, 0.6);
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .szc-hero-hover-panels__panel,
    .szc-hero-hover-panels__image,
    .szc-hero-hover-panels__content,
    .szc-hero-hover-panels__overlay {
      transition: none !important;
    }

    .szc-hero-hover-panels__panel:hover .szc-hero-hover-panels__content,
    .szc-hero-hover-panels__panel:focus-within .szc-hero-hover-panels__content,
    .szc-hero-hover-panels__panel.is-active .szc-hero-hover-panels__content {
      transform: translateY(0) !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('hero-hover-panels')) {
    customElements.define(
      'hero-hover-panels',
      class HeroHoverPanels extends HTMLElement {
        constructor() {
          super();
          this.panels = Array.from(this.querySelectorAll('.szc-hero-hover-panels__panel'));
          if (!this.panels.length) return;

          const grid = this.querySelector('.szc-hero-hover-panels__grid');

          // Ensure no panel is marked is-active on desktop on initial load
          if (!this._isMobile()) {
            this.clearActive();
          }

          // ── Desktop & Mobile Panel Event Listeners ─────────────────────────
          this.panels.forEach((panel) => {
            panel.addEventListener('mouseenter', () => {
              if (!this._isMobile()) {
                this.setActive(panel);
              }
            });

            panel.addEventListener('mouseleave', () => {
              if (!this._isMobile()) {
                panel.classList.remove('is-active');
              }
            });

            panel.addEventListener('focus', () => {
              if (!this._isMobile()) {
                this.setActive(panel);
              }
            });

            panel.addEventListener('blur', () => {
              if (!this._isMobile()) {
                panel.classList.remove('is-active');
              }
            });

            panel.addEventListener('click', (e) => {
              // Suppress click if user was scrolling vertically or swiping horizontally
              if (this._isScrollingOrSwiping || this._wasSwiping) return;

              // Let direct clicks on links or buttons function natively
              if (e.target.closest('a, button')) return;

              if (this._isMobile()) {
                // On mobile: deliberate tap on panel activates/reveals it
                if (panel.classList.contains('is-active')) {
                  const primaryBtn = panel.querySelector('.szc-hero-hover-panels__buttons a, .szc-hero-hover-panels__buttons button');
                  if (primaryBtn) primaryBtn.click();
                } else {
                  this.setActive(panel);
                }
              } else {
                // Desktop: click anywhere on panel triggers primary button
                const primaryBtn = panel.querySelector('.szc-hero-hover-panels__buttons a, .szc-hero-hover-panels__buttons button');
                if (primaryBtn) primaryBtn.click();
              }
            });
          });

          // When mouse leaves the entire grid on desktop, clear any active state
          if (grid) {
            grid.addEventListener('mouseleave', () => {
              if (!this._isMobile()) {
                this.clearActive();
              }
            });
          }

          // Mobile carousel (≤ 767px)
          this._initMobileCarousel();

          // Re-initialise if viewport crosses breakpoint (e.g. orientation change)
          this._mq = window.matchMedia('(max-width: 767px)');
          this._mq.addEventListener('change', () => {
            if (!this._isMobile()) {
              this.clearActive();
            }
            this._initMobileCarousel();
          });
        }

        _isMobile() {
          return window.matchMedia('(max-width: 767px)').matches;
        }

        setActive(targetPanel) {
          this.panels.forEach((p) => p.classList.remove('is-active'));
          if (targetPanel) {
            targetPanel.classList.add('is-active');
          }
        }

        clearActive() {
          this.panels.forEach((p) => p.classList.remove('is-active'));
        }

        // Mobile carousel helpers
        _initMobileCarousel() {
          const grid = this.querySelector('.szc-hero-hover-panels__grid');
          const dotsContainer = this.querySelector('[data-hover-panels-dots]');
          if (!grid) return;

          const isMobile = this._isMobile();

          if (!isMobile) {
            // Desktop: dots hidden, observers disconnected
            if (dotsContainer) dotsContainer.innerHTML = '';
            if (this._scrollObserver) {
              this._scrollObserver.disconnect();
              this._scrollObserver = null;
            }
            return;
          }

          // On mobile, ensure the first slide is active if none is active
          const hasActive = this.panels.some((p) => p.classList.contains('is-active'));
          if (!hasActive && this.panels.length > 0) {
            this.panels[0].classList.add('is-active');
          }

          // Build dot buttons
          if (dotsContainer && this.panels.length > 1) {
            dotsContainer.innerHTML = '';
            this.panels.forEach((_, i) => {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'szc-hover-panels-dot' + (this.panels[i].classList.contains('is-active') ? ' is-active' : '');
              btn.setAttribute('aria-label', 'Go to panel ' + (i + 1));
              btn.addEventListener('click', () => {
                grid.scrollTo({ left: grid.offsetWidth * i, behavior: 'smooth' });
                this.setActive(this.panels[i]);
              });
              dotsContainer.appendChild(btn);
            });
          }

          // ── Sync active dot and panel on horizontal scroll (IntersectionObserver) ──
          if (this._scrollObserver) this._scrollObserver.disconnect();

          if (this.panels.length > 1) {
            this._scrollObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                    const idx = this.panels.indexOf(entry.target);
                    if (idx < 0) return;
                    if (dotsContainer) {
                      const dots = dotsContainer.querySelectorAll('.szc-hover-panels-dot');
                      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
                    }
                    this.panels.forEach((p, i) => p.classList.toggle('is-active', i === idx));
                  }
                });
              },
              { root: grid, threshold: 0.5 }
            );
            this.panels.forEach((p) => this._scrollObserver.observe(p));
          }

          // ── Scroll & Swipe guard: prevent accidental opening while scrolling ──
          this._wasSwiping = false;
          this._isScrollingOrSwiping = false;
          this._touchStartX = 0;
          this._touchStartY = 0;

          if (!this._touchListenersAdded) {
            this._touchListenersAdded = true;

            grid.addEventListener('touchstart', (e) => {
              if (!e.touches || !e.touches[0]) return;
              this._touchStartX = e.touches[0].clientX;
              this._touchStartY = e.touches[0].clientY;
              this._wasSwiping = false;
              this._isScrollingOrSwiping = false;
            }, { passive: true });

            grid.addEventListener('touchmove', (e) => {
              if (!e.touches || !e.touches[0]) return;
              const deltaX = Math.abs(e.touches[0].clientX - this._touchStartX);
              const deltaY = Math.abs(e.touches[0].clientY - this._touchStartY);
              if (deltaX > 8 || deltaY > 8) {
                this._wasSwiping = true;
                this._isScrollingOrSwiping = true;
              }
            }, { passive: true });

            // Reset flags after touch finishes
            grid.addEventListener('touchend', () => {
              setTimeout(() => {
                this._wasSwiping = false;
                this._isScrollingOrSwiping = false;
              }, 350);
            }, { passive: true });
          }
        }
      }
    );
  }


  if (!customElements.get('hero-slider')) {
    customElements.define(
      'hero-slider',
      class HeroSlider extends HTMLElement {
        constructor() {
          super();
          this.slides = this.querySelectorAll('.szc-hero-banner__slide');
          this.dots = this.querySelectorAll('.szc-hero-banner__dot');
          this.prevBtn = this.querySelector('[data-nav-prev]');
          this.nextBtn = this.querySelector('[data-nav-next]');
          this.autoRotate = this.dataset.autoRotate === 'true';
          this.speed = (parseInt(this.dataset.speed, 10) || 5) * 1000;
          this.currentIndex = 0;
          this.timer = null;

          if (this.slides.length <= 1) return;

          if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.prev());
          if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.next());

          this.dots.forEach((dot) => {
            dot.addEventListener('click', () => {
              const index = parseInt(dot.dataset.dotIndex, 10);
              this.goToSlide(index);
            });
          });

          if (this.autoRotate) {
            this.startAutoRotate();
            this.addEventListener('mouseenter', () => this.stopAutoRotate());
            this.addEventListener('mouseleave', () => this.startAutoRotate());
          }
        }

        goToSlide(index) {
          this.slides[this.currentIndex].classList.remove('is-active');
          if (this.dots[this.currentIndex]) {
            this.dots[this.currentIndex].classList.remove('is-active');
          }

          this.currentIndex = index;

          this.slides[this.currentIndex].classList.add('is-active');
          if (this.dots[this.currentIndex]) {
            this.dots[this.currentIndex].classList.add('is-active');
          }
        }

        next() {
          const nextIndex = (this.currentIndex + 1) % this.slides.length;
          this.goToSlide(nextIndex);
        }

        prev() {
          const prevIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;
          this.goToSlide(prevIndex);
        }

        startAutoRotate() {
          if (this.timer) clearInterval(this.timer);
          this.timer = setInterval(() => this.next(), this.speed);
        }

        stopAutoRotate() {
          if (this.timer) clearInterval(this.timer);
        }
      }
    );
  }
{% endjavascript %}

