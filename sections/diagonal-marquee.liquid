{%- doc -%}
  Renders two crossed diagonal infinite marquee strips with customizable content,
  speed, colors, typography, angles, and responsive controls.
{%- enddoc -%}

{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color | default: '#FAF8F5'
  assign pause_on_hover = section.settings.pause_on_hover

  assign height_desktop = section.settings.height_desktop | default: 280
  assign height_mobile = section.settings.height_mobile | default: 200
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0

  assign strip_height_desktop = section.settings.strip_height_desktop | default: 58
  assign strip_height_mobile = section.settings.strip_height_mobile | default: 46
  assign item_spacing_desktop = section.settings.item_spacing_desktop | default: 32
  assign item_spacing_mobile = section.settings.item_spacing_mobile | default: 20

  assign row1_bg = section.settings.row1_bg_color | default: '#2F2F2F'
  assign row1_color = section.settings.row1_text_color | default: '#F5F5F5'
  assign row1_angle_desktop = section.settings.row1_angle_desktop | default: -4
  assign row1_angle_mobile = section.settings.row1_angle_mobile | default: -4
  assign row1_direction = section.settings.row1_direction | default: 'left'
  assign row1_speed = section.settings.row1_speed | default: 35
  assign row1_font_size_desktop = section.settings.row1_font_size_desktop | default: 16
  assign row1_font_size_mobile = section.settings.row1_font_size_mobile | default: 14
  assign row1_font_weight = section.settings.row1_font_weight | default: '500'
  assign row1_text_transform = section.settings.row1_text_transform | default: 'none'

  assign row2_bg = section.settings.row2_bg_color | default: '#000000'
  assign row2_color = section.settings.row2_text_color | default: '#F5F5F5'
  assign row2_angle_desktop = section.settings.row2_angle_desktop | default: 4
  assign row2_angle_mobile = section.settings.row2_angle_mobile | default: 4
  assign row2_direction = section.settings.row2_direction | default: 'right'
  assign row2_speed = section.settings.row2_speed | default: 40
  assign row2_font_size_desktop = section.settings.row2_font_size_desktop | default: 16
  assign row2_font_size_mobile = section.settings.row2_font_size_mobile | default: 14
  assign row2_font_weight = section.settings.row2_font_weight | default: '500'
  assign row2_text_transform = section.settings.row2_text_transform | default: 'none'
  assign row2_on_top = section.settings.row2_on_top

  assign block_count = section.blocks.size
  if block_count == 0
    assign repeat_times = 6
  elsif block_count == 1
    assign repeat_times = 14
  elsif block_count == 2
    assign repeat_times = 8
  elsif block_count <= 4
    assign repeat_times = 5
  elsif block_count <= 8
    assign repeat_times = 4
  else
    assign repeat_times = 3
  endif
-%}

<div
  id="szc-diagonal-marquee-{{ section_id }}"
  class="szc-diagonal-marquee{% if pause_on_hover %} szc-diagonal-marquee--pause-hover{% endif %}"
  style="
    --szc-dm-bg: {{ bg_color }};
    --szc-dm-height-desktop: {{ height_desktop }}px;
    --szc-dm-height-mobile: {{ height_mobile }}px;
    --szc-dm-padding-top: {{ padding_top }}px;
    --szc-dm-padding-bottom: {{ padding_bottom }}px;
    --szc-dm-strip-height-desktop: {{ strip_height_desktop }}px;
    --szc-dm-strip-height-mobile: {{ strip_height_mobile }}px;
    --szc-dm-spacing-desktop: {{ item_spacing_desktop }}px;
    --szc-dm-spacing-mobile: {{ item_spacing_mobile }}px;
    --szc-dm-row1-bg: {{ row1_bg }};
    --szc-dm-row1-color: {{ row1_color }};
    --szc-dm-row1-angle-desktop: {{ row1_angle_desktop }}deg;
    --szc-dm-row1-angle-mobile: {{ row1_angle_mobile }}deg;
    --szc-dm-row1-speed: {{ row1_speed }}s;
    --szc-dm-row1-fs-desktop: {{ row1_font_size_desktop }}px;
    --szc-dm-row1-fs-mobile: {{ row1_font_size_mobile }}px;
    --szc-dm-row1-fw: {{ row1_font_weight }};
    --szc-dm-row1-tt: {{ row1_text_transform }};
    --szc-dm-row2-bg: {{ row2_bg }};
    --szc-dm-row2-color: {{ row2_color }};
    --szc-dm-row2-angle-desktop: {{ row2_angle_desktop }}deg;
    --szc-dm-row2-angle-mobile: {{ row2_angle_mobile }}deg;
    --szc-dm-row2-speed: {{ row2_speed }}s;
    --szc-dm-row2-fs-desktop: {{ row2_font_size_desktop }}px;
    --szc-dm-row2-fs-mobile: {{ row2_font_size_mobile }}px;
    --szc-dm-row2-fw: {{ row2_font_weight }};
    --szc-dm-row2-tt: {{ row2_text_transform }};
    --szc-dm-row1-z: {% if row2_on_top %}1{% else %}2{% endif %};
    --szc-dm-row2-z: {% if row2_on_top %}2{% else %}1{% endif %};
