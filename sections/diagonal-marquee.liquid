{% stylesheet %}
  .szc-diagonal-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--szc-dm-bg);
    padding-top: var(--szc-dm-padding-top);
    padding-bottom: var(--szc-dm-padding-bottom);
    contain: paint;
    box-sizing: border-box;
  }

  .szc-diagonal-marquee__container {
    position: relative;
    width: 100%;
    height: var(--szc-dm-height-desktop);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .szc-diagonal-marquee__row {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 135vw;
    min-width: 135%;
    max-width: none;
    display: flex;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: auto;
    transform-origin: center center;
    box-sizing: border-box;
  }

  .szc-diagonal-marquee__row--1 {
    background-color: var(--szc-dm-row1-bg);
    color: var(--szc-dm-row1-color);
    z-index: var(--szc-dm-row1-z);
    height: var(--szc-dm-strip-height-desktop);
    transform: translate(-50%, -50%) rotate(var(--szc-dm-row1-angle-desktop));
    font-size: var(--szc-dm-row1-fs-desktop);
    font-weight: var(--szc-dm-row1-fw);
    text-transform: var(--szc-dm-row1-tt);
  }

  .szc-diagonal-marquee__row--2 {
    background-color: var(--szc-dm-row2-bg);
    color: var(--szc-dm-row2-color);
    z-index: var(--szc-dm-row2-z);
    height: var(--szc-dm-strip-height-desktop);
    transform: translate(-50%, -50%) rotate(var(--szc-dm-row2-angle-desktop));
    font-size: var(--szc-dm-row2-fs-desktop);
    font-weight: var(--szc-dm-row2-fw);
    text-transform: var(--szc-dm-row2-tt);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
  }

  .szc-diagonal-marquee__track {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
    will-change: transform;
  }

  .szc-diagonal-marquee__track--left {
    animation: szc-marquee-move-left linear infinite;
  }

  .szc-diagonal-marquee__track--right {
    animation: szc-marquee-move-right linear infinite;
  }

  @keyframes szc-marquee-move-left {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @keyframes szc-marquee-move-right {
    0% {
      transform: translate3d(-100%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  .szc-diagonal-marquee--pause-hover:hover .szc-diagonal-marquee__track,
  .szc-diagonal-marquee__row:hover .szc-diagonal-marquee__track {
    animation-play-state: paused;
  }

  .szc-diagonal-marquee__item {
    display: inline-flex;
    align-items: center;
    padding-right: var(--szc-dm-spacing-desktop);
    line-height: 1;
    flex-shrink: 0;
  }

  .szc-diagonal-marquee__text {
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .szc-diagonal-marquee__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    transition: opacity 0.2s ease, text-decoration-thickness 0.2s ease;
  }

  .szc-diagonal-marquee__link:hover {
    opacity: 0.82;
    text-decoration-thickness: 2px;
  }

  .szc-diagonal-marquee__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .szc-diagonal-marquee__separator {
    display: inline-block;
    padding-left: var(--szc-dm-spacing-desktop);
    opacity: 0.65;
    font-size: 0.75em;
    line-height: 1;
    vertical-align: middle;
    user-select: none;
  }

  @media (max-width: 767px) {
    .szc-diagonal-marquee__container {
      height: var(--szc-dm-height-mobile);
    }

    .szc-diagonal-marquee__row {
      width: 145vw;
      min-width: 145%;
    }

    .szc-diagonal-marquee__row--1 {
      height: var(--szc-dm-strip-height-mobile);
      transform: translate(-50%, -50%) rotate(var(--szc-dm-row1-angle-mobile));
      font-size: var(--szc-dm-row1-fs-mobile);
    }

    .szc-diagonal-marquee__row--2 {
      height: var(--szc-dm-strip-height-mobile);
      transform: translate(-50%, -50%) rotate(var(--szc-dm-row2-angle-mobile));
      font-size: var(--szc-dm-row2-fs-mobile);
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.2);
    }

    .szc-diagonal-marquee__item {
      padding-right: var(--szc-dm-spacing-mobile);
    }

    .szc-diagonal-marquee__separator {
      padding-left: var(--szc-dm-spacing-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .szc-diagonal-marquee__track {
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Diagonal Marquee",
  "tag": "section",
  "class": "section-diagonal-marquee",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop Section Height",
      "min": 180,
      "max": 450,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile Section Height",
      "min": 140,
