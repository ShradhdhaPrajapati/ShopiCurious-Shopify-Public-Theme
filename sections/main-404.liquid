<section id="Main404-{{ section.id }}" class="szc-main-404 page-width">
  <div class="szc-main-404__container">
    <span class="szc-main-404__code">404</span>
    <h1 class="szc-main-404__title">
      {{ '404.title' | t | default: 'Page Not Found' }}
    </h1>
    <p class="szc-main-404__text">
      {{ '404.not_found' | t | default: 'The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.' }}
    </p>

    <!-- Search Form -->
    <form action="{{ routes.search_url }}" method="get" role="search" class="szc-main-404__search-form">
      <div class="szc-main-404__search-field">
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.search' | t | default: 'Search our store...' }}"
          class="szc-main-404__search-input"
          aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
        >
        <button type="submit" class="szc-button szc-button--primary">
          {% render 'icon', icon: 'search', class: 'szc-button__icon' %}
        </button>
      </div>
    </form>

    <div class="szc-main-404__actions">
      <a href="{{ routes.all_products_collection_url }}" class="szc-button szc-button--primary szc-button--lg">
        <span>{{ '404.back_to_shopping' | t | default: 'Back to Shopping' }}</span>
        {% render 'icon', icon: 'arrow-right', class: 'szc-button__icon' %}
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .szc-main-404 {
    padding-top: var(--szc-space-12, 48px);
    padding-bottom: var(--szc-space-12, 48px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
  }

  .szc-main-404__container {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .szc-main-404__code {
    font-family: var(--szc-font-family-heading);
    font-size: clamp(80px, 12vw, 140px);
    font-weight: 800;
    line-height: 1;
    color: var(--szc-color-surface-subtle, #f4f3ef);
    letter-spacing: var(--szc-letter-spacing-wide, 0.05em);
    margin-bottom: -20px;
  }

  .szc-main-404__title {
    margin: 0 0 var(--szc-space-3, 12px) 0;
    font-family: var(--szc-font-family-heading);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    color: var(--szc-color-text-primary, #111111);
  }

  .szc-main-404__text {
    font-family: var(--szc-font-family-body);
    font-size: var(--szc-font-size-base, 16px);
    color: var(--szc-color-text-secondary, #666666);
    line-height: 1.6;
    margin-bottom: var(--szc-space-6, 24px);
  }

  .szc-main-404__search-form {
    width: 100%;
    margin-bottom: var(--szc-space-8, 32px);
  }

  .szc-main-404__search-field {
    display: flex;
    gap: 8px;
    max-width: 440px;
    margin: 0 auto;
  }

  .szc-main-404__search-input {
    flex: 1;
    height: 44px;
    padding: 0 16px;
    font-family: var(--szc-font-family-body);
    font-size: 14px;
    border: 1px solid var(--szc-color-border, #e5e5e5);
    border-radius: var(--szc-radius-button, 2px);
    background-color: var(--szc-color-surface, #f8f9fa);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
