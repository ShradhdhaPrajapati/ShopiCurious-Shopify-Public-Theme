{% comment %}
  ShopziCurious Luxury Dedicated Cart Page Section
  Pixel-matched to approved Cart Page UI specification.
{% endcomment %}

<div class="szc-cart-page page-width" id="MainCartPage">
  <!-- Cart Header Row -->
  <div class="szc-cart-page__header">
    <h1 class="szc-cart-page__title">
      YOUR CART <span class="szc-cart-page__count">({{ cart.item_count }})</span>
    </h1>
    <a href="{{ routes.all_products_collection_url }}" class="szc-cart-page__continue">
      <span>Continue Shopping</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="szc-cart-page__form">
      <!-- Cart Table Header -->
      <div class="szc-cart-table">
        <div class="szc-cart-table__head">
          <div class="szc-cart-col szc-cart-col--product">PRODUCT</div>
          <div class="szc-cart-col szc-cart-col--price">PRICE</div>
          <div class="szc-cart-col szc-cart-col--quantity">QUANTITY</div>
          <div class="szc-cart-col szc-cart-col--total">TOTAL</div>
        </div>

        <!-- Cart Line Items -->
        <div class="szc-cart-table__body">
          {%- for item in cart.items -%}
            <div class="szc-cart-table__row" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <!-- Product Column -->
              <div class="szc-cart-col szc-cart-col--product">
                <a href="{{ item.url }}" class="szc-cart-item__media">
                  {%- if item.image != blank -%}
                    <img
                      src="{{ item.image | image_url: width: 240 }}"
                      alt="{{ item.title | escape }}"
                      width="100"
                      height="120"
                      loading="lazy"
                      class="szc-cart-item__img"
                    >
                  {%- else -%}
                    <div class="szc-cart-item__placeholder">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {%- endif -%}
                </a>

                <div class="szc-cart-item__info">
                  <a href="{{ item.url }}" class="szc-cart-item__title">
                    {{ item.product.title }}
                  </a>

                  {%- unless item.product.has_only_default_variant -%}
                    <div class="szc-cart-item__variants">
                      {%- for option in item.options_with_values -%}
                        <span>{{ option.value }}</span>{%- unless forloop.last -%} <span class="szc-cart-dot">•</span> {%- endunless -%}
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                  <div class="szc-cart-item__actions">
                    <a href="{{ item.url }}" class="szc-cart-item__edit">Edit</a>
                    <span class="szc-cart-divider">|</span>
                    <button
                      type="button"
                      class="szc-cart-item__remove-btn"
                      data-action="remove"
                      data-line="{{ forloop.index }}"
                    >
                      Remove
                    </button>
                  </div>
                </div>
              </div>

              <!-- Price Column -->
              <div class="szc-cart-col szc-cart-col--price">
                <span class="szc-cart-price">
                  {%- if item.original_price != item.final_price -%}
                    <s class="szc-price--compare">{{ item.original_price | money }}</s>
                    <span class="szc-price--final">{{ item.final_price | money }}</span>
                  {%- else -%}
                    {{ item.final_price | money }}
                  {%- endif -%}
                </span>
              </div>

              <!-- Quantity Column -->
              <div class="szc-cart-col szc-cart-col--quantity">
                <div class="szc-cart-stepper">
                  <button
                    type="button"
                    class="szc-stepper-btn"
                    data-action="minus"
                    data-line="{{ forloop.index }}"
                    aria-label="Decrease quantity"
                  >-</button>
                  <input
                    type="number"
                    name="updates[]"
                    class="szc-stepper-input"
                    value="{{ item.quantity }}"
                    min="0"
                    data-line="{{ forloop.index }}"
                    readonly
                  >
                  <button
                    type="button"
                    class="szc-stepper-btn"
                    data-action="plus"
                    data-line="{{ forloop.index }}"
                    aria-label="Increase quantity"
                  >+</button>
                </div>
              </div>

              <!-- Total Line Price Column -->
              <div class="szc-cart-col szc-cart-col--total">
                <span class="szc-cart-total-price">
                  {{ item.final_line_price | money }}
                </span>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Bottom Layout: Discount Code (Left) & Order Summary (Right) -->
      <div class="szc-cart-bottom">
        <!-- Left Column: Discount Code & Trust Badges -->
        <div class="szc-cart-bottom__left">
          <!-- Discount Code Box -->
          <div class="szc-discount-box">
            <h3 class="szc-discount-box__title">DISCOUNT CODE</h3>
            <p class="szc-discount-box__desc">Enter your promotional or discount code below.</p>

            <div class="szc-discount-form-row">
              <label for="CartDiscountInput" class="visually-hidden">Discount Code</label>
              <input
                type="text"
                id="CartDiscountInput"
                name="discount"
                class="szc-discount-input{% if cart.cart_level_discount_applications.size > 0 %} is-applied{% endif %}"
                placeholder="Enter discount code"
                aria-label="Enter discount code"
                aria-describedby="DiscountStatusMessage"
                value="{% if cart.cart_level_discount_applications.size > 0 %}{{ cart.cart_level_discount_applications.first.title }}{% endif %}"
                {% if cart.cart_level_discount_applications.size > 0 %}disabled{% endif %}
                autocomplete="off"
              >
              <button
                type="button"
                class="szc-discount-apply-btn{% if cart.cart_level_discount_applications.size > 0 %} is-applied{% endif %}"
                id="ApplyDiscountBtn"
                aria-label="Apply discount code"
                {% if cart.cart_level_discount_applications.size > 0 %}disabled{% endif %}
              >
                <span class="szc-btn-text">
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    ✓ APPLIED
                  {%- else -%}
                    APPLY
                  {%- endif -%}
                </span>
                <span class="szc-btn-spinner-wrapper" style="display:none;" aria-hidden="true">
                  <svg class="szc-btn-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.2" stroke-width="2.5"></circle>
                    <path d="M12 2 a 10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                  </svg>
                </span>
              </button>
            </div>
            
            <!-- Applied Discount Tag Pill (Matching User Specification) -->
            <div id="DiscountTagsContainer" class="szc-discount-tags">
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                {%- for discount_application in cart.cart_level_discount_applications -%}
                  <div class="szc-discount-tag" data-discount-title="{{ discount_application.title }}">
                    <svg class="szc-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                      <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span class="szc-tag-title">{{ discount_application.title }}</span>
                    <button type="button" class="szc-tag-remove-btn" data-remove-discount aria-label="Remove discount {{ discount_application.title }}">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>

            <div id="DiscountStatusMessage" class="szc-discount-status" aria-live="polite" style="display:none;"></div>
          </div>

          <!-- Reusable Trust Badges -->
          <div class="szc-cart-page__trust-badges">
            {% render 'trust-badges' %}
          </div>
        </div>

        <!-- Right Column: Order Summary Card -->
        <div class="szc-cart-bottom__right">
          <div class="szc-order-summary-card">
            <h2 class="szc-summary-card__title">ORDER SUMMARY</h2>

            <div class="szc-summary-card__rows">
              <div class="szc-summary-card__row">
                <span class="szc-summary-label">Subtotal</span>
                <span class="szc-summary-val">{{ cart.original_total_price | money }}</span>
              </div>

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                {%- for discount_application in cart.cart_level_discount_applications -%}
                  <div class="szc-summary-card__row szc-summary-card__row--discount">
                    <div class="szc-summary-discount-info">
                      <span class="szc-summary-label">Discount</span>
                      <div class="szc-summary-discount-tag" data-discount-title="{{ discount_application.title }}">
                        <svg class="szc-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                          <line x1="7" y1="7" x2="7.01" y2="7"></line>
                        </svg>
                        <span class="szc-tag-title">{{ discount_application.title }}</span>
                        <button type="button" class="szc-tag-remove-btn" data-remove-discount aria-label="Remove discount">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </button>
                      </div>
                    </div>
                    <span class="szc-summary-val szc-summary-val--discount">-{{ discount_application.total_allocated_amount | money }}</span>
                  </div>
                {%- endfor -%}
              {%- elsif cart.total_discount > 0 -%}
                <div class="szc-summary-card__row szc-summary-card__row--discount">
                  <div class="szc-summary-discount-info">
                    <span class="szc-summary-label">Discount</span>
                    {%- if cart.discount_applications.size > 0 -%}
                      <div class="szc-summary-discount-tag" data-discount-title="{{ cart.discount_applications.first.title }}">
                        <svg class="szc-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                          <line x1="7" y1="7" x2="7.01" y2="7"></line>
                        </svg>
                        <span class="szc-tag-title">{{ cart.discount_applications.first.title }}</span>
                        <button type="button" class="szc-tag-remove-btn" data-remove-discount aria-label="Remove discount">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </button>
                      </div>
                    {%- endif -%}
                  </div>
                  <span class="szc-summary-val szc-summary-val--discount">-{{ cart.total_discount | money }}</span>
                </div>
              {%- endif -%}

              <div class="szc-summary-card__row">
                <span class="szc-summary-label">Shipping</span>
                <span class="szc-summary-subtext">Calculated at checkout</span>
              </div>

              <div class="szc-summary-card__row">
                <span class="szc-summary-label">
                  Estimated Taxes
                  <span class="szc-tooltip-icon" title="Estimated tax calculated at checkout">?</span>
                </span>
                <span class="szc-summary-val">{{ cart.total_tax | money }}</span>
              </div>

              <hr class="szc-summary-card__divider">

              <div class="szc-summary-card__row szc-summary-card__row--total">
                <span class="szc-summary-label">Total</span>
                <span class="szc-summary-val">{{ cart.total_price | money }}</span>
              </div>
            </div>

            <!-- Checkout Buttons -->
            <div class="szc-summary-card__actions">
              <button type="submit" name="checkout" class="szc-cart-page-btn szc-cart-page-btn--checkout">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>CHECKOUT SECURELY</span>
              </button>

              {%- if additional_checkout_buttons -%}
                <div class="szc-additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </form>
  {%- else -%}
    <!-- Empty Cart Page State -->
    <div class="szc-cart-page__empty">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#999999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <h2 class="szc-cart-empty__title">Your shopping bag is currently empty</h2>
      <p class="szc-cart-empty__subtitle">Explore our latest arrivals and find your perfect piece.</p>
      <a href="{{ routes.all_products_collection_url }}" class="szc-cart-empty__btn">
        START SHOPPING
      </a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .szc-cart-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .szc-cart-page__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .szc-cart-page__title {
    margin: 0;
    font-family: var(--szc-font-family-heading, Georgia, serif);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #111111;
    text-transform: uppercase;
  }

  .szc-cart-page__count {
    font-weight: 500;
    color: #111111;
  }

  .szc-cart-page__continue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-cart-page__continue:hover {
    color: #d4a373;
  }

  /* Table Header */
  .szc-cart-table {
    width: 100%;
    margin-bottom: 40px;
  }

  .szc-cart-table__head {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1fr;
    align-items: center;
    background-color: #f8f9fa;
    padding: 12px 20px;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }

  .szc-cart-col {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #444444;
  }

  .szc-cart-col--price {
    text-align: center;
  }

  .szc-cart-col--quantity {
    text-align: center;
  }

  .szc-cart-col--total {
    text-align: right;
  }

  /* Table Line Items */
  .szc-cart-table__row {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr 1fr;
    align-items: center;
    padding: 24px 20px;
    border-bottom: 1px solid #f0f0f0;
  }

  .szc-cart-col--product {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .szc-cart-item__media {
    width: 90px;
    height: 105px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background-color: #f7f5f0;
    display: block;
  }

  .szc-cart-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-cart-item__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .szc-cart-item__title {
    font-size: 15px;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    line-height: 1.3;
  }

  .szc-cart-item__title:hover {
    color: #d4a373;
  }

  .szc-cart-item__variants {
    font-size: 13px;
    color: #666666;
  }

  .szc-cart-dot {
    margin: 0 4px;
    color: #999999;
  }

  .szc-cart-item__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 12px;
  }

  .szc-cart-item__edit {
    color: #666666;
    text-decoration: underline;
  }

  .szc-cart-item__remove-btn {
    background: none;
    border: none;
    padding: 0;
    color: #666666;
    cursor: pointer;
    text-decoration: underline;
    font-size: 12px;
  }

  .szc-cart-item__remove-btn:hover {
    color: #e63946;
  }

  .szc-cart-price {
    font-size: 15px;
    font-weight: 600;
    color: #111111;
  }

  /* Quantity Stepper */
  .szc-cart-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    height: 38px;
    background-color: #ffffff;
    overflow: hidden;
  }

  .szc-stepper-btn {
    width: 36px;
    height: 100%;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 500;
    color: #333333;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease;
  }

  .szc-stepper-btn:hover {
    background-color: #f5f5f5;
  }

  .szc-stepper-input {
    width: 40px;
    height: 100%;
    border: none;
    outline: none;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #111111;
    background: transparent;
  }

  .szc-cart-total-price {
    font-size: 16px;
    font-weight: 700;
    color: #111111;
  }

  /* Bottom Grid Layout */
  .szc-cart-bottom {
    display: grid;
    grid-template-columns: 1fr 440px;
    gap: 48px;
    align-items: start;
    margin-top: 40px;
  }

  /* Visually Hidden Helper for Accessibility */
  .visually-hidden {
    position: absolute !important;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0, 0, 0, 0);
  }

  /* Left Column: Discount Code Box */
  .szc-discount-box {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 24px;
    background-color: #ffffff;
    margin-bottom: 24px;
  }

  .szc-discount-box__title {
    margin: 0 0 6px 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111111;
  }

  .szc-discount-box__desc {
    font-size: 13px;
    color: #666666;
    margin: 0 0 16px 0;
  }

  .szc-discount-form-row {
    display: flex;
    gap: 10px;
    position: relative;
  }

  .szc-discount-input {
    flex: 1;
    height: 44px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    padding: 0 14px;
    font-size: 13px;
    font-family: inherit;
    color: #111111;
    outline: none;
    box-sizing: border-box;
    transition: border-color 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
  }

  .szc-discount-input:focus-visible,
  .szc-discount-input:focus {
    border-color: #111111;
    box-shadow: 0 0 0 1px #111111;
  }

  .szc-discount-input--error {
    border-color: #e63946 !important;
    box-shadow: 0 0 0 1px #e63946 !important;
    background-color: #fff8f8;
  }

  .szc-discount-apply-btn {
    height: 44px;
    padding: 0 22px;
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 150ms ease, opacity 150ms ease;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 105px;
  }

  .szc-discount-apply-btn:hover:not(:disabled) {
    background-color: #222222;
  }

  .szc-discount-apply-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .szc-discount-apply-btn.is-applied {
    background-color: #333333;
  }

  /* Spinner animation */
  @keyframes szc-spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .szc-btn-spinner {
    animation: szc-spin 0.6s linear infinite;
    display: block;
  }

  .szc-btn-spinner-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .szc-discount-status {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 13px;
    line-height: 1.4;
    transition: all 150ms ease;
  }

  .szc-discount-status--success {
    background-color: #f5f5f5;
    color: #111111;
    border: 1px solid #e0e0e0;
  }

  .szc-discount-status--error {
    background-color: #fdf2f2;
    color: #e63946;
    border: 1px solid #ffcdd2;
  }

  /* Discount Tag Pills (User Image 2 Match) */
  .szc-discount-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .szc-discount-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: #efefef;
