{% endstylesheet %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', () => {
    const cartPage = document.getElementById('MainCartPage');
    if (!cartPage) return;

    // Helper: Reset button state when input changes
    const resetApplyButtonState = (discountInput, discountBtn, statusDiv) => {
      if (discountInput) {
        discountInput.classList.remove('szc-discount-input--error');
        discountInput.removeAttribute('aria-invalid');
      }
      if (discountBtn && discountBtn.classList.contains('is-applied')) {
        discountBtn.classList.remove('is-applied');
        const textSpan = discountBtn.querySelector('.szc-btn-text');
        if (textSpan) textSpan.textContent = 'APPLY';
      }
      if (statusDiv && statusDiv.style.display !== 'none') {
        statusDiv.style.display = 'none';
        statusDiv.innerHTML = '';
      }
    };

    // 1. Delegated Event Listener for Input Events (Input change reset)
    document.addEventListener('input', (e) => {
      if (e.target && e.target.id === 'CartDiscountInput') {
        const discountInput = e.target;
        const parentBox = discountInput.closest('.szc-discount-box');
        const discountBtn = parentBox ? parentBox.querySelector('#ApplyDiscountBtn') : document.getElementById('ApplyDiscountBtn');
        const statusDiv = parentBox ? parentBox.querySelector('#DiscountStatusMessage') : document.getElementById('DiscountStatusMessage');
        
        resetApplyButtonState(discountInput, discountBtn, statusDiv);
      }
    });

    // 2. Delegated Keydown Listener for Enter Key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target && e.target.id === 'CartDiscountInput') {
        e.preventDefault();
        const parentBox = e.target.closest('.szc-discount-box');
        const applyBtn = parentBox ? parentBox.querySelector('#ApplyDiscountBtn') : document.getElementById('ApplyDiscountBtn');
        if (applyBtn && !applyBtn.disabled) {
          applyBtn.click();
        }
      }
    });

    // 3. Delegated Click Listener for Quantity Steppers, Apply Button & Remove Discount Tag
    document.addEventListener('click', async (e) => {
      // --- A. Quantity Steppers & Line Item Removal ---
      const stepperBtn = e.target.closest('[data-action]');
      if (stepperBtn && cartPage.contains(stepperBtn)) {
        const action = stepperBtn.dataset.action;
        const line = stepperBtn.dataset.line;
        if (line) {
          const input = cartPage.querySelector(`input.szc-stepper-input[data-line="${line}"]`);
          let currentQty = input ? parseInt(input.value, 10) || 1 : 1;
          let newQty = currentQty;
          if (action === 'plus') newQty = currentQty + 1;
          else if (action === 'minus') newQty = Math.max(0, currentQty - 1);
          else if (action === 'remove') newQty = 0;

          try {
            const res = await fetch('/cart/change.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ line: parseInt(line, 10), quantity: parseInt(newQty, 10) })
            });
            if (res.ok) {
              const cartRes = await fetch('/cart.js');
              const cartData = await cartRes.json();
              ShopziCurious.pubsub.publish(ShopziCurious.events.CART_UPDATED, { item_count: cartData.item_count, openDrawer: false });
              if (window.ShopziCurious && window.ShopziCurious.refreshCartPage) {
                await window.ShopziCurious.refreshCartPage();
              }
            }
          } catch (err) {
            console.error('Failed to update cart page item:', err);
          }
        }
        return;
      }

      // --- B. Apply Discount Button ---
      const applyBtn = e.target.closest('#ApplyDiscountBtn');
      if (applyBtn) {
        e.preventDefault();

        // Prevent Race Condition: Guard multiple parallel clicks
        if (window._szcIsApplyingDiscount) return;
        window._szcIsApplyingDiscount = true;

        // Abort any previous pending discount fetch
        if (window._szcDiscountAbortController) {
          window._szcDiscountAbortController.abort();
        }
        window._szcDiscountAbortController = new AbortController();
        const signal = window._szcDiscountAbortController.signal;

        const parentBox = applyBtn.closest('.szc-discount-box') || document;
        const discountInput = parentBox.querySelector('#CartDiscountInput');
        const statusDiv = parentBox.querySelector('#DiscountStatusMessage');

        // Clear previous error messages & styles immediately when starting new application
        if (statusDiv) {
          statusDiv.style.display = 'none';
          statusDiv.innerHTML = '';
        }
        if (discountInput) {
          discountInput.classList.remove('szc-discount-input--error');
          discountInput.removeAttribute('aria-invalid');
        }

        const rawCode = discountInput.value.trim();

        // 1. Validation: Empty check
        if (!rawCode) {
          discountInput.classList.add('szc-discount-input--error');
          discountInput.setAttribute('aria-invalid', 'true');
          if (statusDiv) {
            statusDiv.style.display = 'block';
            statusDiv.className = 'szc-discount-status szc-discount-status--error';
            statusDiv.setAttribute('aria-live', 'assertive');
            statusDiv.textContent = 'Please enter a valid discount code.';
          }
          discountInput.focus();
          window._szcIsApplyingDiscount = false;
          return;
        }

        // 2. Loading State: Set aria-busy, show spinner, disable controls
        const activeCartPage = document.getElementById('MainCartPage');
        if (activeCartPage) activeCartPage.setAttribute('aria-busy', 'true');

        applyBtn.disabled = true;
        discountInput.disabled = true;

        const textSpan = applyBtn.querySelector('.szc-btn-text');
        const spinnerWrapper = applyBtn.querySelector('.szc-btn-spinner-wrapper');
        if (textSpan) textSpan.style.display = 'none';
        if (spinnerWrapper) spinnerWrapper.style.display = 'inline-flex';

        try {
          // Native Shopify Discount endpoint with Abort Signal
          await fetch(`/discount/${encodeURIComponent(rawCode)}?redirect=/cart`, { signal });

          // 3. Dynamic Cart Refresh BEFORE evaluating success (Promise resolves strictly after DOM swap)
          if (window.ShopziCurious && window.ShopziCurious.refreshCartPage) {
            await window.ShopziCurious.refreshCartPage();
          }

          // 4. Source of Truth Verification via Official Shopify Cart Data & Newly Rendered DOM
          const cartRes = await fetch(`/cart.js?_t=${Date.now()}`, { signal, cache: 'no-store' });
          const cartData = await cartRes.json();

          // Re-query newly rendered DOM elements after refresh
          const newCartPage = document.getElementById('MainCartPage') || document;
          const newDiscountInput = newCartPage.querySelector('#CartDiscountInput');
          const newApplyBtn = newCartPage.querySelector('#ApplyDiscountBtn');
          const newStatusDiv = newCartPage.querySelector('#DiscountStatusMessage');
          const hasRenderedTag = !!newCartPage.querySelector('.szc-discount-tag') || !!newCartPage.querySelector('[data-remove-discount]');

          const applications = (cartData && cartData.cart_level_discount_applications) || [];
          const hasDiscountApplications = hasRenderedTag || applications.length > 0 || (cartData && cartData.total_discount > 0);

          if (hasDiscountApplications) {
            // SUCCESS STATE: Prestige/Enterprise Style (No inline green text, Toast after refresh, Input disabled)
            const appliedTitle = applications.length > 0 ? applications[0].title : rawCode.toUpperCase();

            if (newDiscountInput) {
              newDiscountInput.value = appliedTitle;
              newDiscountInput.disabled = true;
              newDiscountInput.classList.add('is-applied');
              newDiscountInput.classList.remove('szc-discount-input--error');
              newDiscountInput.removeAttribute('aria-invalid');
            }

            if (newApplyBtn) {
              newApplyBtn.disabled = true;
              newApplyBtn.classList.add('is-applied');
              const newTextSpan = newApplyBtn.querySelector('.szc-btn-text');
              if (newTextSpan) newTextSpan.textContent = '✓ APPLIED';
            }

            // Hide inline success message (Applied tag & Order summary pill serve as visual indicator)
            if (newStatusDiv) {
              newStatusDiv.style.display = 'none';
              newStatusDiv.innerHTML = '';
            }

            // Show Toast ONLY after section refresh has completed
            if (window.ShopziCurious && window.ShopziCurious.showToast) {
              window.ShopziCurious.showToast('Discount applied successfully.');
            }

            // Focus Management: Focus the Remove Discount button (✕)
            const removeBtn = newCartPage.querySelector('.szc-tag-remove-btn') || newCartPage.querySelector('[data-remove-discount]');
            if (removeBtn) {
              removeBtn.focus();
            }
          } else {
            // ERROR STATE (Shopify rejected the coupon code)
            if (newDiscountInput) {
              newDiscountInput.disabled = false;
              newDiscountInput.classList.remove('is-applied');
              newDiscountInput.classList.add('szc-discount-input--error');
              newDiscountInput.setAttribute('aria-invalid', 'true');
              newDiscountInput.focus();
            }

            if (newApplyBtn) {
              newApplyBtn.disabled = false;
              newApplyBtn.classList.remove('is-applied');
              const newTextSpan = newApplyBtn.querySelector('.szc-btn-text');
              if (newTextSpan) newTextSpan.textContent = 'APPLY';
            }

            if (newStatusDiv) {
              newStatusDiv.style.display = 'block';
              newStatusDiv.className = 'szc-discount-status szc-discount-status--error';
              newStatusDiv.setAttribute('aria-live', 'assertive');
              newStatusDiv.textContent = 'Invalid discount code. Please check and try again.';
            }
          }
        } catch (err) {
          if (err.name === 'AbortError') {
            return; // Silently handle aborted fetch requests
          }
          console.error('Failed to apply discount:', err);
          const newCartPage = document.getElementById('MainCartPage') || document;
          const newDiscountInput = newCartPage.querySelector('#CartDiscountInput');
          const newApplyBtn = newCartPage.querySelector('#ApplyDiscountBtn');
          const newStatusDiv = newCartPage.querySelector('#DiscountStatusMessage');

          if (newDiscountInput) {
            newDiscountInput.disabled = false;
            newDiscountInput.classList.remove('is-applied');
            newDiscountInput.classList.add('szc-discount-input--error');
            newDiscountInput.setAttribute('aria-invalid', 'true');
            newDiscountInput.focus();
          }
          if (newApplyBtn) {
            newApplyBtn.disabled = false;
            newApplyBtn.classList.remove('is-applied');
            const newTextSpan = newApplyBtn.querySelector('.szc-btn-text');
            if (newTextSpan) newTextSpan.textContent = 'APPLY';
          }
          if (newStatusDiv) {
            newStatusDiv.style.display = 'block';
            newStatusDiv.className = 'szc-discount-status szc-discount-status--error';
            newStatusDiv.setAttribute('aria-live', 'assertive');
            newStatusDiv.textContent = 'Invalid discount code. Please check and try again.';
          }
        } finally {
          window._szcIsApplyingDiscount = false;
          const newCartPage = document.getElementById('MainCartPage') || document;
          if (newCartPage && newCartPage.removeAttribute) newCartPage.removeAttribute('aria-busy');

          const finalApplyBtn = newCartPage.querySelector('#ApplyDiscountBtn') || applyBtn;
          const finalDiscountInput = newCartPage.querySelector('#CartDiscountInput') || discountInput;
          const isApplied = finalApplyBtn && finalApplyBtn.classList.contains('is-applied');

          if (finalApplyBtn) {
            finalApplyBtn.disabled = isApplied;
            const textSpan = finalApplyBtn.querySelector('.szc-btn-text');
            const spinnerWrapper = finalApplyBtn.querySelector('.szc-btn-spinner-wrapper');
            if (textSpan) textSpan.style.display = 'inline';
            if (spinnerWrapper) spinnerWrapper.style.display = 'none';
          }
          if (finalDiscountInput) {
            finalDiscountInput.disabled = isApplied;
          }
        }
        return;
      }

      // --- C. Remove Discount Tag Button (`[data-remove-discount]`) ---
      const removeBtn = e.target.closest('[data-remove-discount]');
      if (removeBtn) {
        e.preventDefault();
        removeBtn.disabled = true;

        // Abort any pending discount requests
        if (window._szcDiscountAbortController) {
          window._szcDiscountAbortController.abort();
        }
        window._szcDiscountAbortController = new AbortController();
        const signal = window._szcDiscountAbortController.signal;

        const activeCartPage = document.getElementById('MainCartPage');
        if (activeCartPage) activeCartPage.setAttribute('aria-busy', 'true');

        try {
          // 1. Clear discount via official Shopify AJAX Cart API
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ discount: "" }),
            signal
          });

          // 2. Also trigger native Shopify /discount/CLEAR endpoint for session clearance
          await fetch('/discount/CLEAR?redirect=/cart', { signal });
          await fetch('/cart?discount=', { signal });

          // 3. Dynamic Section Refresh (Wait until DOM replacement finishes)
          if (window.ShopziCurious && window.ShopziCurious.refreshCartPage) {
            await window.ShopziCurious.refreshCartPage();
          }

          // 4. Complete State Reset on Newly Rendered DOM
          const newCartPage = document.getElementById('MainCartPage') || document;
          const newDiscountInput = newCartPage.querySelector('#CartDiscountInput');
          const newApplyBtn = newCartPage.querySelector('#ApplyDiscountBtn');
          const newStatusDiv = newCartPage.querySelector('#DiscountStatusMessage');
          const newTagsContainer = newCartPage.querySelector('#DiscountTagsContainer');
          const newDiscountSummaryRow = newCartPage.querySelector('.szc-cart-summary__discount-row');

          if (newDiscountInput) {
            newDiscountInput.value = '';
            newDiscountInput.disabled = false;
            newDiscountInput.classList.remove('szc-discount-input--error', 'is-applied');
            newDiscountInput.removeAttribute('aria-invalid');
            newDiscountInput.focus();
          }

          if (newApplyBtn) {
            newApplyBtn.disabled = false;
            newApplyBtn.classList.remove('is-applied');
            const textSpan = newApplyBtn.querySelector('.szc-btn-text');
            if (textSpan) textSpan.textContent = 'APPLY';
          }

          if (newTagsContainer) {
            newTagsContainer.innerHTML = '';
          }

          if (newDiscountSummaryRow) {
            newDiscountSummaryRow.remove();
          }

          if (newStatusDiv) {
            newStatusDiv.style.display = 'none';
            newStatusDiv.innerHTML = '';
          }

          // 5. Show Toast ONLY AFTER Cart Refresh Finishes
          if (window.ShopziCurious && window.ShopziCurious.showToast) {
            window.ShopziCurious.showToast('Discount removed');
          }
        } catch (err) {
          if (err.name === 'AbortError') return;
          console.error('Failed to remove discount:', err);
        } finally {
          const newCartPage = document.getElementById('MainCartPage') || document;
          if (newCartPage && newCartPage.removeAttribute) newCartPage.removeAttribute('aria-busy');
        }
      }
    });
  });
{% endjavascript %}

