{%- comment -%}
  ShopziCurious - Category Cards Section (Part 05)
  Matches the approved UI: 4 Category Cards in a grid with glassmorphism overlay buttons.
{%- endcomment -%}

{%- liquid
  assign cols_desktop = section.settings.columns_desktop | default: 4
  assign cols_mobile = section.settings.columns_mobile | default: '2'
  assign aspect_ratio = section.settings.image_ratio | default: '4/5'
-%}

<section
  id="CollectionList-{{ section.id }}"
  class="szc-collection-list page-width"
  style="--cols-desktop: {{ cols_desktop }}; --cols-mobile: {{ cols_mobile }};"
>
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    {%- assign align_class = section.settings.heading_alignment | default: 'left' -%}
    <div class="szc-section-header szc-section-header--{{ align_class }}">
      <div class="szc-section-header__text">
        {%- if section.settings.subtitle != blank -%}
          <span class="szc-section-header__subtitle">{{ section.settings.subtitle }}</span>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="szc-section-header__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="szc-collection-list__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'featured_collection' -%}
          <div class="szc-collection-list__item" {{ block.shopify_attributes }}>
            {% render 'card-collection',
              card_collection: block.settings.collection,
              title: block.settings.title,
              image: block.settings.image,
              button_text: block.settings.button_text,
              media_aspect_ratio: aspect_ratio
            %}
          </div>
      {%- endcase -%}
    {%- else -%}
      <!-- Default 4 Category Cards matching the approved UI -->
      <div class="szc-collection-list__item">
        {% render 'card-collection', card_collection: nil, title: 'WOMEN', button_text: 'SHOP NOW', media_aspect_ratio: aspect_ratio %}
      </div>
      <div class="szc-collection-list__item">
        {% render 'card-collection', card_collection: nil, title: 'MEN', button_text: 'SHOP NOW', media_aspect_ratio: aspect_ratio %}
      </div>
      <div class="szc-collection-list__item">
        {% render 'card-collection', card_collection: nil, title: 'ACCESSORIES', button_text: 'SHOP NOW', media_aspect_ratio: aspect_ratio %}
      </div>
      <div class="szc-collection-list__item">
        {% render 'card-collection', card_collection: nil, title: 'SHOES', button_text: 'SHOP NOW', media_aspect_ratio: aspect_ratio %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .szc-collection-list {
    padding-top: var(--szc-space-12, 48px);
    padding-bottom: var(--szc-space-12, 48px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    padding-left: var(--szc-space-6, 24px);
    padding-right: var(--szc-space-6, 24px);
  }

  .szc-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-direction: row;
    margin-bottom: var(--szc-space-8, 32px);
  }

  .szc-section-header--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .szc-section-header--right {
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .szc-section-header__subtitle {
    display: block;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #666666;
    margin-bottom: 6px;
  }

  .szc-section-header__title {
    margin: 0;
    font-family: var(--szc-font-family-heading, Georgia, 'Playfair Display', serif);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 500;
    color: #111111;
    line-height: 1.2;
  }

  .szc-collection-list__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-mobile, 2), 1fr);
    gap: var(--szc-space-5, 20px);
  }

  @media (min-width: 750px) {
    .szc-collection-list__grid {
      grid-template-columns: repeat(var(--cols-desktop, 4), 1fr);
      gap: var(--szc-space-6, 24px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Cards",
  "tag": "section",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "default": "CURATED COLLECTIONS",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title Override",
          "info": "Leave empty to use Collection Title"
        },
        {
          "type": "text",
          "id": "button_text",
          "default": "SHOP NOW",
          "label": "Button Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Cards",
      "blocks": [
        {
          "type": "featured_collection",
          "settings": {
            "title": "WOMEN",
            "button_text": "SHOP NOW"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "MEN",
            "button_text": "SHOP NOW"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "ACCESSORIES",
            "button_text": "SHOP NOW"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "SHOES",
            "button_text": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
