{% comment %}
  Renders the "BRANDS WE LOVE" brand logo showcase.
  Displays tasteful typographic wordmarks or optional logo images in a minimal,
  monochrome horizontal row with a mobile swipeable rail.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'BRANDS WE LOVE'
  assign eyebrow = section.settings.eyebrow
  assign heading_alignment = section.settings.heading_alignment | default: 'center'
  assign logo_color = section.settings.logo_color | default: '#111111'
  assign logo_size = section.settings.logo_size | default: 22
  assign logo_spacing = section.settings.logo_spacing | default: 48
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign show_top_border = section.settings.show_top_border
  assign border_color = section.settings.border_color | default: '#e5e5e5'
  assign padding_top = section.settings.padding_top | default: 36
  assign padding_bottom = section.settings.padding_bottom | default: 36
-%}

<section
  id="BrandLogos-{{ section.id }}"
  class="szc-brand-logos-section"
  style="
    --szc-bl-bg: {{ bg_color }};
    --szc-bl-color: {{ logo_color }};
    --szc-bl-size: {{ logo_size }}px;
    --szc-bl-gap: {{ logo_spacing }}px;
    --szc-bl-border: {{ border_color }};
    --szc-bl-pt: {{ padding_top }}px;
    --szc-bl-pb: {{ padding_bottom }}px;
  "
>
  {%- if show_top_border -%}
    <div class="szc-brand-logos__divider"></div>
  {%- endif -%}

  <div class="szc-brand-logos__inner page-width">
    {%- if heading != blank or eyebrow != blank -%}
      <div class="szc-brand-logos__header szc-brand-logos__header--{{ heading_alignment }}">
        {%- if eyebrow != blank -%}
          <span class="szc-brand-logos__eyebrow">{{ eyebrow }}</span>
        {%- endif -%}
        {%- if heading != blank -%}
          <h3 class="szc-brand-logos__heading">{{ heading }}</h3>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="szc-brand-logos__track" role="list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="szc-brand-logos__item" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.brand_link != blank -%}
              <a href="{{ block.settings.brand_link }}" class="szc-brand-logos__link" aria-label="{{ block.settings.brand_name | default: 'Brand' }}">
            {%- endif -%}

            {%- if block.settings.brand_image != blank -%}
              {%- assign brand_alt = block.settings.brand_name | default: 'Brand logo' -%}
              {{ block.settings.brand_image | image_url: width: 300 | image_tag:
                class: 'szc-brand-logos__img',
                loading: 'lazy',
                alt: brand_alt
              }}
            {%- else -%}
              <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--{{ block.settings.wordmark_style | default: 'bold' }}">
                {{ block.settings.brand_name | default: 'BRAND' }}
              </span>
            {%- endif -%}

            {%- if block.settings.brand_link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback Wordmarks -->
        <div class="szc-brand-logos__item" role="listitem">
          <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--bold">NIKE</span>
        </div>
        <div class="szc-brand-logos__item" role="listitem">
          <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--geometric">ADIDAS</span>
        </div>
        <div class="szc-brand-logos__item" role="listitem">
          <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--classic">LEVI'S</span>
        </div>
        <div class="szc-brand-logos__item" role="listitem">
          <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--serif">ZARA</span>
        </div>
        <div class="szc-brand-logos__item" role="listitem">
          <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--modern">UNIQLO</span>
        </div>
        <div class="szc-brand-logos__item" role="listitem">
          <span class="szc-brand-logos__wordmark szc-brand-logos__wordmark--wide">COS</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .szc-brand-logos-section {
    background-color: var(--szc-bl-bg, #ffffff);
    padding-top: var(--szc-bl-pt, 36px);
    padding-bottom: var(--szc-bl-pb, 36px);
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .szc-brand-logos__divider {
    width: 100%;
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto calc(var(--szc-bl-pt, 36px) * 0.75);
    height: 1px;
    background-color: var(--szc-bl-border, #e5e5e5);
  }

  .szc-brand-logos__inner {
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    box-sizing: border-box;
  }

  .szc-brand-logos__header {
    margin-bottom: 24px;
  }

  .szc-brand-logos__header--center {
    text-align: center;
  }

  .szc-brand-logos__header--left {
    text-align: left;
  }

  .szc-brand-logos__eyebrow {
    display: block;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #888888;
    margin-bottom: 4px;
  }

  .szc-brand-logos__heading {
    margin: 0;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #555555;
  }

  .szc-brand-logos__track {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--szc-bl-gap, 48px);
    width: 100%;
    box-sizing: border-box;
  }

  .szc-brand-logos__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .szc-brand-logos__item:hover {
    opacity: 0.75;
    transform: translateY(-1px);
  }

  .szc-brand-logos__link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }

  .szc-brand-logos__img {
    height: calc(var(--szc-bl-size, 22px) * 1.5);
    max-height: 48px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: grayscale(100%);
    transition: filter 250ms ease;
  }

  .szc-brand-logos__item:hover .szc-brand-logos__img {
    filter: grayscale(0%);
  }

  /* Typographic Wordmark Variants */
  .szc-brand-logos__wordmark {
    display: inline-block;
    color: var(--szc-bl-color, #111111);
    font-size: var(--szc-bl-size, 22px);
    line-height: 1;
    user-select: none;
  }

  .szc-brand-logos__wordmark--bold {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Arial Black", sans-serif;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-style: italic;
  }

  .szc-brand-logos__wordmark--geometric {
    font-family: var(--szc-font-family-body, sans-serif);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .szc-brand-logos__wordmark--classic {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .szc-brand-logos__wordmark--serif {
    font-family: "Didot", "Bodoni MT", "Playfair Display", Georgia, serif;
    font-weight: 700;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    font-size: calc(var(--szc-bl-size, 22px) * 1.16);
  }

  .szc-brand-logos__wordmark--modern {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .szc-brand-logos__wordmark--wide {
    font-family: var(--szc-font-family-body, sans-serif);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .szc-brand-logos__track {
      gap: clamp(24px, 3.8vw, 36px);
    }
  }

  /* Mobile Horizontal Swipeable Rail */
  @media (max-width: 767px) {
    .szc-brand-logos-section {
      padding-top: calc(var(--szc-bl-pt, 36px) * 0.8);
      padding-bottom: calc(var(--szc-bl-pb, 36px) * 0.8);
      overflow: hidden;
    }

    .szc-brand-logos__inner {
      padding-left: 0;
      padding-right: 0;
    }

    .szc-brand-logos__header {
      padding-left: 20px;
      padding-right: 20px;
      margin-bottom: 18px;
    }

    .szc-brand-logos__track {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 28px;
      padding-left: 20px;
      padding-right: 20px;
      box-sizing: border-box;
      width: 100%;
    }

    .szc-brand-logos__track::-webkit-scrollbar {
      display: none;
    }

    .szc-brand-logos__item {
      scroll-snap-align: center;
    }

    .szc-brand-logos__wordmark {
      font-size: calc(var(--szc-bl-size, 22px) * 0.9);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Logos",
  "tag": "section",
  "class": "section-brand-logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BRANDS WE LOVE"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow tag (optional)"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo wordmark color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "logo_size",
      "min": 14,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Logo text size",
      "default": 22
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Spacing between logos (Desktop)",
      "default": 48
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show subtle divider line above",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider line color",
      "default": "#e5e5e5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "default": "NIKE"
        },
        {
          "type": "select",
          "id": "wordmark_style",
          "label": "Wordmark Typography Style",
          "options": [
            { "value": "bold", "label": "Athletic Bold Italic (e.g. Nike)" },
            { "value": "geometric", "label": "Clean Geometric (e.g. Adidas)" },
            { "value": "classic", "label": "Classic Bold (e.g. Levi's)" },
            { "value": "serif", "label": "Fashion Serif (e.g. Zara)" },
            { "value": "modern", "label": "Modern Bold Sans (e.g. Uniqlo)" },
            { "value": "wide", "label": "Airy Wide Tracking (e.g. COS)" }
          ],
          "default": "bold"
        },
        {
          "type": "image_picker",
          "id": "brand_image",
          "label": "Custom Brand Logo Image (optional)",
          "info": "Overrides typographic wordmark if uploaded"
        },
        {
          "type": "url",
          "id": "brand_link",
          "label": "Brand Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands We Love",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "brand_name": "NIKE",
            "wordmark_style": "bold"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "ADIDAS",
            "wordmark_style": "geometric"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "LEVI'S",
            "wordmark_style": "classic"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "ZARA",
            "wordmark_style": "serif"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "UNIQLO",
            "wordmark_style": "modern"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "COS",
            "wordmark_style": "wide"
          }
        }
      ]
    }
  ]
}
{% endschema %}
