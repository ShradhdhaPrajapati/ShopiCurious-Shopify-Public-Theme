{%- comment -%}
  ShopziCurious - Recent Blog Posts Section
  Displays the latest published blog posts in a luxury editorial carousel with infinite looping.
{%- endcomment -%}

{%- liquid
  assign blog_source = section.settings.blog
  if blog_source != blank
    if blog_source.articles != blank
      assign current_blog = blog_source
    else
      assign current_blog = blogs[blog_source]
    endif
  endif

  if current_blog == blank or current_blog.articles_count == 0
    if blog != blank and blog.articles_count > 0
      assign current_blog = blog
    else
      assign current_blog = blogs['news']
      if current_blog == blank or current_blog.articles_count == 0
        for b in blogs
          if blogs[b].articles_count > 0
            assign current_blog = blogs[b]
            break
          endif
        endfor
      endif
    endif
  endif

  assign articles_limit = section.settings.articles_to_show | default: 6
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_tablet = section.settings.columns_tablet | default: 2
  assign card_gap = section.settings.card_gap | default: 24
  assign show_arrows = section.settings.show_arrows

  assign panel_base_color = section.settings.panel_bg_color | default: '#ffffff'
  assign panel_opacity = section.settings.panel_bg_opacity | default: 70 | divided_by: 100.0
  assign panel_bg = panel_base_color | color_modify: 'alpha', panel_opacity
  if panel_bg == blank
    assign panel_bg = 'rgba(255, 255, 255, 0.72)'
  endif
  assign panel_blur = section.settings.panel_blur | default: 18
-%}

{%- if current_blog != blank and current_blog.articles.size > 0 -%}
  <div class="szc-recent-blog-posts page-width" id="RecentBlogPosts-{{ section.id }}" data-animate="slide-up">
    <!-- Header with Title & Navigation Controls -->
    <div class="szc-recent-blog-posts__header">
      <div class="szc-recent-blog-posts__header-text">
        {%- if section.settings.subtitle != blank -%}
          <span class="szc-recent-blog-posts__subtitle">{{ section.settings.subtitle }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="szc-recent-blog-posts__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if show_arrows and current_blog.articles.size > 1 -%}
        <div class="szc-recent-blog-posts__nav" aria-label="Carousel navigation">
          <button
            type="button"
            class="szc-recent-blog-carousel__arrow szc-recent-blog-carousel__arrow--prev"
            aria-label="Previous articles"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button
            type="button"
            class="szc-recent-blog-carousel__arrow szc-recent-blog-carousel__arrow--next"
            aria-label="Next articles"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <!-- Carousel Component -->
    <recent-blog-carousel
      class="szc-recent-blog-carousel"
      data-section-id="{{ section.id }}"
      data-autoplay="{{ section.settings.enable_autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
      style="--carousel-cols: {{ columns_desktop }}; --carousel-cols-tablet: {{ columns_tablet }}; --carousel-gap: {{ card_gap }}px; --panel-bg: {{ panel_bg }}; --panel-blur: {{ panel_blur }}px;"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.heading | default: 'Recent Blog Posts' }}"
    >
      <div class="szc-recent-blog-carousel__viewport">
        <div class="szc-recent-blog-carousel__track" id="RecentBlogPostsGrid-{{ section.id }}">
          {%- for article in current_blog.articles limit: articles_limit -%}
            {%- liquid
              assign words = article.content | default: article.excerpt | strip_html | split: ' ' | size
              assign read_mins = words | divided_by: 200 | at_least: 1
            -%}
            <div
              class="szc-recent-blog-carousel__slide"
              data-slide-index="{{ forloop.index0 }}"
              role="group"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} of {{ current_blog.articles.size | at_most: articles_limit }}"
            >
              <article class="szc-blog-card">
                <a href="{{ article.url }}" class="szc-blog-card__link" aria-label="{{ article.title | escape }}">
                  <!-- Image Visual -->
                  <div class="szc-blog-card__media">
                    {%- if article.image -%}
                      {{ article.image | image_url: width: 900 | image_tag:
                        class: 'szc-blog-card__img',
                        loading: 'lazy',
                        alt: article.title,
                        widths: '400, 600, 800, 1000'
                      }}
                    {%- else -%}
                      <div class="szc-blog-card__placeholder" aria-hidden="true">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-blog-card__placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                  <!-- Floating Frosted Glass Content Panel -->
                  <div class="szc-blog-card__panel">
                    <!-- Meta Row: Tag / Category + Date + Read time -->
                    <div class="szc-blog-card__meta">
                      <span class="szc-blog-card__badge">
                        {%- if article.tags.size > 0 -%}
                          {{ article.tags.first | capitalize }}
                        {%- else -%}
                          {{ current_blog.title | default: 'Blog' | capitalize }}
                        {%- endif -%}
                      </span>

                      {%- if article.published_at -%}
                        <span class="szc-blog-card__dot" aria-hidden="true">•</span>
                        <time class="szc-blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                          {{ article.published_at | date: "%b %d, %Y" }}
                        </time>
                      {%- endif -%}

                      <span class="szc-blog-card__dot" aria-hidden="true">•</span>
                      <span class="szc-blog-card__read-time">{{ read_mins }} mins read</span>
                    </div>

                    <!-- Title -->
                    <h3 class="szc-blog-card__title">{{ article.title }}</h3>

                    <!-- Excerpt & Circular Read Article Button -->
                    <div class="szc-blog-card__bottom">
                      {%- assign article_excerpt = article.excerpt_or_content | default: article.excerpt | default: article.content | strip_html | truncate: 110 -%}
                      <p class="szc-blog-card__excerpt">
                        {{ article_excerpt | default: 'Discover the full story, inspiration, and styling insights.' }}
                      </p>

                      <span class="szc-blog-card__arrow-btn" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </recent-blog-carousel>
  </div>
{%- endif -%}

{% stylesheet %}
  .szc-recent-blog-posts {
    padding-top: 48px;
    padding-bottom: 56px;
    position: relative;
  }

  .szc-recent-blog-posts__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .szc-recent-blog-posts__header-text {
    flex: 1;
  }

  .szc-recent-blog-posts__subtitle {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888888;
    margin-bottom: 8px;
  }

  .szc-recent-blog-posts__title {
    font-family: var(--szc-font-family-heading, Georgia, serif);
    font-size: 32px;
    font-weight: 500;
    color: #111111;
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .szc-recent-blog-posts__nav {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .szc-recent-blog-carousel__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #e5e5e5;
    background-color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #111111;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    padding: 0;
  }

  .szc-recent-blog-carousel__arrow:hover {
    background-color: #111111;
    color: #ffffff;
    border-color: #111111;
    transform: scale(1.06);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
  }

  .szc-recent-blog-carousel__arrow:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 2px;
  }

  .szc-recent-blog-carousel__arrow svg,
  .szc-recent-blog-carousel__arrow line,
  .szc-recent-blog-carousel__arrow polyline {
    pointer-events: none;
  }

  /* Carousel Web Component Layout */
  .szc-recent-blog-carousel {
    display: block;
    position: relative;
    width: 100%;
  }

  .szc-recent-blog-carousel__viewport {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 8px 0 16px 0;
    margin: -8px 0 -16px 0;
  }

  .szc-recent-blog-carousel__track {
    display: flex;
    gap: var(--carousel-gap, 24px);
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
    cursor: grab;
  }

  .szc-recent-blog-carousel__track.is-dragging {
    cursor: grabbing;
  }

  .szc-recent-blog-carousel__slide {
    flex: 0 0 calc((100% - (var(--carousel-gap, 24px) * (var(--carousel-cols, 3) - 1))) / var(--carousel-cols, 3));
    min-width: 0;
    box-sizing: border-box;
  }

  @media (max-width: 1024px) {
    .szc-recent-blog-carousel__slide {
      flex: 0 0 calc((100% - (var(--carousel-gap, 20px) * (var(--carousel-cols-tablet, 2) - 1))) / var(--carousel-cols-tablet, 2));
    }
  }

  @media (max-width: 640px) {
    .szc-recent-blog-carousel__slide {
      flex: 0 0 85%;
      max-width: 360px;
    }
  }

  @media (max-width: 380px) {
    .szc-recent-blog-carousel__slide {
      flex: 0 0 88%;
      max-width: 310px;
    }
  }

  /* Reference-Matching Editorial Blog Card */
  .szc-blog-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    background-color: #f7f7f7;
    height: 100%;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
  }

  .szc-blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }

  .szc-blog-card__link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    -webkit-user-drag: none;
    user-select: none;
  }

  /* Image Visual Area */
  .szc-blog-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 13;
    min-height: 380px;
    overflow: hidden;
    background-color: #f0f0f0;
  }

  @media (max-width: 640px) {
    .szc-blog-card__media {
      aspect-ratio: 16 / 14;
      min-height: 330px;
    }
  }

  .szc-blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .szc-blog-card:hover .szc-blog-card__img {
    transform: scale(1.05);
  }

  .szc-blog-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f5f7;
    color: #999999;
  }

  .szc-blog-card__placeholder-svg {
    width: 64px;
    height: 64px;
    opacity: 0.6;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Floating Frosted Glass Panel */
  .szc-blog-card__panel {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    background: var(--panel-bg, rgba(255, 255, 255, 0.72));
    backdrop-filter: blur(var(--panel-blur, 18px));
    -webkit-backdrop-filter: blur(var(--panel-blur, 18px));
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 16px;
    padding: 16px 18px 18px 18px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    z-index: 2;
  }

  .szc-blog-card:hover .szc-blog-card__panel {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  }

  /* Meta Row */
  .szc-blog-card__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .szc-blog-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    font-size: 11px;
    font-weight: 600;
    color: #111111;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .szc-blog-card__dot {
    color: #999999;
    font-size: 11px;
  }

  .szc-blog-card__date,
  .szc-blog-card__read-time {
    font-size: 11.5px;
    color: #666666;
    font-weight: 500;
  }

  /* Article Title */
  .szc-blog-card__title {
    font-family: var(--szc-font-family-heading, Georgia, serif);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.32;
    color: #111111;
    margin: 0 0 8px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Bottom Row: Excerpt + Circular Arrow Button */
  .szc-blog-card__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
  }

  .szc-blog-card__excerpt {
    font-size: 12.5px;
    color: #555555;
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .szc-blog-card__arrow-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid #e2e2e2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #111111;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    transition: all 0.25s ease;
    pointer-events: none;
  }

  .szc-blog-card:hover .szc-blog-card__arrow-btn {
    transform: scale(1.08) translateX(2px);
    background-color: #111111;
    color: #ffffff;
    border-color: #111111;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 576px) {
    .szc-recent-blog-posts {
      padding-top: 36px;
      padding-bottom: 44px;
    }

    .szc-recent-blog-posts__title {
      font-size: 26px;
    }

    .szc-blog-card__panel {
      left: 10px;
      right: 10px;
      bottom: 10px;
      padding: 14px 14px 16px 14px;
      border-radius: 14px;
    }

    .szc-blog-card__title {
      font-size: 16px;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('recent-blog-carousel')) {
    customElements.define(
      'recent-blog-carousel',
      class RecentBlogCarousel extends HTMLElement {
        constructor() {
          super();
          this.currentIndex = 0;
          this.currentTranslate = 0;
          this.isPointerDown = false;
          this.isDragging = false;
          this.hasDragged = false;
          this.startX = 0;
          this.startY = 0;
          this.startTranslate = 0;
          this.startTime = 0;
          this.animTimeout = null;
        }

        connectedCallback() {
          this.track = this.querySelector('.szc-recent-blog-carousel__track');
          this.viewport = this.querySelector('.szc-recent-blog-carousel__viewport');

          const sectionId = this.dataset.sectionId;
          const section = this.closest('.szc-recent-blog-posts') || (sectionId ? document.getElementById(`RecentBlogPosts-${sectionId}`) : null);
          this.prevBtn = section ? section.querySelector('.szc-recent-blog-carousel__arrow--prev') : null;
          this.nextBtn = section ? section.querySelector('.szc-recent-blog-carousel__arrow--next') : null;

          if (!this.track || !this.viewport) return;

          this.originalSlides = Array.from(this.track.children);
          this.origCount = this.originalSlides.length;

          if (this.origCount === 0) return;

          if (this.origCount === 1) {
            if (this.prevBtn) this.prevBtn.style.display = 'none';
            if (this.nextBtn) this.nextBtn.style.display = 'none';
            return;
          }

          this.enableAutoplay = this.dataset.autoplay === 'true';
          this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed, 10) || 5000;

          this.setupInfiniteLoop();
          this.bindEvents();

          if (this.enableAutoplay) {
            this.startAutoplay();
          }
        }

        disconnectedCallback() {
          this.stopAutoplay();
          if (this.animTimeout) clearTimeout(this.animTimeout);
          if (this.resizeObserver) {
            this.resizeObserver.disconnect();
          }
        }

        setupInfiniteLoop() {
          // If fewer than 6 slides, replicate whole set so there is always a clean continuous cycle
          let baseSlides = this.originalSlides;
          while (baseSlides.length < 6) {
            for (let i = 0; i < this.origCount; i++) {
              const dup = this.originalSlides[i].cloneNode(true);
              this.track.appendChild(dup);
            }
            baseSlides = Array.from(this.track.children);
          }

          this.baseCount = baseSlides.length;
          this.bufferCount = 4;

          // Prepend last bufferCount slides
          const startClones = [];
          for (let i = this.baseCount - this.bufferCount; i < this.baseCount; i++) {
            const clone = baseSlides[i].cloneNode(true);
            clone.setAttribute('data-clone', 'start');
            clone.setAttribute('aria-hidden', 'true');
            clone.querySelectorAll('a, button').forEach(el => el.setAttribute('tabindex', '-1'));
            startClones.push(clone);
          }
          startClones.slice().reverse().forEach(clone => {
            this.track.insertBefore(clone, this.track.firstElementChild);
          });

          // Append first bufferCount slides
          for (let i = 0; i < this.bufferCount; i++) {
            const clone = baseSlides[i].cloneNode(true);
            clone.setAttribute('data-clone', 'end');
            clone.setAttribute('aria-hidden', 'true');
            clone.querySelectorAll('a, button').forEach(el => el.setAttribute('tabindex', '-1'));
            this.track.appendChild(clone);
          }

          this.currentIndex = this.bufferCount;

          requestAnimationFrame(() => {
            this.updatePosition(false);
          });
        }

        getStep() {
          if (!this.track.children[1] || !this.track.children[0]) return 360;
          const step = this.track.children[1].offsetLeft - this.track.children[0].offsetLeft;
          return step > 0 ? step : 360;
        }

        updatePosition(animate = true) {
          if (!this.track.children[this.currentIndex]) return;

          const targetX = -this.track.children[this.currentIndex].offsetLeft;
          const isSamePosition = Math.abs(this.currentTranslate - targetX) < 1;

          this.currentTranslate = targetX;

          if (animate && !isSamePosition) {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const duration = prefersReducedMotion ? 0 : 380;
            this.track.style.transition = `transform ${duration}ms cubic-bezier(0.25, 1, 0.5, 1)`;

            clearTimeout(this.animTimeout);
            this.animTimeout = setTimeout(() => {
              this.checkBoundary();
            }, duration + 30);
          } else {
            this.track.style.transition = 'none';
          }

          this.track.style.transform = `translate3d(${targetX}px, 0, 0)`;
        }

        goTo(index, animate = true) {
          this.currentIndex = index;
          this.updatePosition(animate);
        }

        next() {
          this.stopAutoplay();
          this.goTo(this.currentIndex + 1, true);
        }

        prev() {
          this.stopAutoplay();
          this.goTo(this.currentIndex - 1, true);
        }

        checkBoundary() {
          let needsReset = false;
          while (this.currentIndex >= this.bufferCount + this.baseCount) {
            this.currentIndex -= this.baseCount;
            needsReset = true;
          }
          while (this.currentIndex < this.bufferCount) {
            this.currentIndex += this.baseCount;
            needsReset = true;
          }

          if (needsReset) {
            this.track.style.transition = 'none';
            const resetX = -this.track.children[this.currentIndex].offsetLeft;
            this.currentTranslate = resetX;
            this.track.style.transform = `translate3d(${resetX}px, 0, 0)`;
            void this.track.offsetHeight;
          }
        }

        bindEvents() {
          if (this.prevBtn) {
            this.prevBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              this.prev();
              if (this.enableAutoplay) this.startAutoplay();
            });
          }

          if (this.nextBtn) {
            this.nextBtn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              this.next();
              if (this.enableAutoplay) this.startAutoplay();
            });
          }

          this.track.addEventListener('transitionend', (e) => {
            if (e.target !== this.track) return;
            clearTimeout(this.animTimeout);
            this.checkBoundary();
          });

          this.resizeObserver = new ResizeObserver(() => {
            if (!this.isPointerDown && !this.isDragging) {
              this.updatePosition(false);
            }
          });
          this.resizeObserver.observe(this.viewport);

          window.addEventListener('load', () => {
            this.updatePosition(false);
          }, { once: true });

          this.setupDragEvents();

          if (this.enableAutoplay) {
            this.addEventListener('mouseenter', () => this.stopAutoplay());
            this.addEventListener('mouseleave', () => this.startAutoplay());
            this.addEventListener('focusin', () => this.stopAutoplay());
            this.addEventListener('focusout', () => this.startAutoplay());
          }

          this.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
              this.prev();
            } else if (e.key === 'ArrowRight') {
              this.next();
            }
          });
        }

        setupDragEvents() {
          const onPointerDown = (e) => {
            if (e.button && e.button !== 0) return;

            this.isPointerDown = true;
            this.isDragging = false;
            this.hasDragged = false;
            this.startX = e.clientX;
            this.startY = e.clientY;
            this.startTime = Date.now();
            this.startTranslate = this.currentTranslate;
            this.stopAutoplay();
          };

          const onPointerMove = (e) => {
            if (!this.isPointerDown) return;

            const diffX = e.clientX - this.startX;
            const diffY = e.clientY - this.startY;

            if (!this.isDragging) {
              if (Math.abs(diffY) > Math.abs(diffX) && Math.abs(diffY) > 8) {
                this.isPointerDown = false;
                return;
              }

              if (Math.abs(diffX) > 6) {
                this.isDragging = true;
                this.hasDragged = true;
                this.track.classList.add('is-dragging');
                this.track.style.transition = 'none';

                try {
                  if (e.pointerId && this.track.setPointerCapture) {
                    this.track.setPointerCapture(e.pointerId);
                  }
                } catch (_) {}
              }
            }

            if (this.isDragging) {
              if (e.cancelable) e.preventDefault();
              this.currentTranslate = this.startTranslate + diffX;
              this.track.style.transform = `translate3d(${this.currentTranslate}px, 0, 0)`;
            }
          };

          const onPointerUp = (e) => {
            if (!this.isPointerDown && !this.isDragging) return;
            this.isPointerDown = false;

            if (this.isDragging) {
              this.isDragging = false;
              this.track.classList.remove('is-dragging');

              try {
                if (e.pointerId && this.track.releasePointerCapture) {
                  this.track.releasePointerCapture(e.pointerId);
                }
              } catch (_) {}

              const diffX = e.clientX - this.startX;
              const elapsed = Date.now() - this.startTime;
              const velocity = Math.abs(diffX) / (elapsed || 1);
              const step = this.getStep();

              const moved = Math.round(-diffX / step);
              let targetIndex = this.currentIndex;

              if (moved !== 0) {
                targetIndex = this.currentIndex + moved;
              } else if (Math.abs(diffX) > step * 0.15 || velocity > 0.25) {
                targetIndex = this.currentIndex + (diffX < 0 ? 1 : -1);
              }

              this.goTo(targetIndex, true);
            }

            if (this.enableAutoplay) {
              this.startAutoplay();
            }
          };

          this.track.addEventListener('pointerdown', onPointerDown);
          this.track.addEventListener('pointermove', onPointerMove);
          this.track.addEventListener('pointerup', onPointerUp);
          this.track.addEventListener('pointercancel', onPointerUp);

          this.track.addEventListener('click', (e) => {
            if (this.hasDragged) {
              e.preventDefault();
              e.stopPropagation();
              this.hasDragged = false;
            }
          }, true);
        }

        startAutoplay() {
          this.stopAutoplay();
          this.autoplayTimer = setInterval(() => {
            this.next();
          }, this.autoplaySpeed);
        }

        stopAutoplay() {
          if (this.autoplayTimer) {
            clearInterval(this.autoplayTimer);
            this.autoplayTimer = null;
          }
        }
      }
    );
  }
