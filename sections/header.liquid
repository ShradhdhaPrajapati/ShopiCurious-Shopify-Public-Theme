    height: 50px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .szc-mob-promo-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mob-promo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .szc-mob-promo-sub {
    font-size: 13px;
    font-weight: 700;
  }

  .szc-mob-promo-link-btn {
    font-size: 11px;
    font-weight: 600;
    color: #c86d51;
    text-transform: uppercase;
  }

  .szc-mob-banner-card {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #111111;
    color: #ffffff;
    padding: 16px;
  }

  .szc-mob-banner-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }

  .szc-mob-banner-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mob-banner-content {
