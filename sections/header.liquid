    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: #333333;
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .desktop-only {
      display: none !important;
    }
  }

  @media (min-width: 990px) {
    .mobile-only {
      display: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}

  document.addEventListener('DOMContentLoaded', function() {
    const menuItems = document.querySelectorAll('.szc-header__menu-item.has-mega-menu, .szc-header__menu-item.has-dropdown');
    menuItems.forEach(item => {
      let timer = null;

      item.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        menuItems.forEach(other => {
          if (other !== item) other.classList.remove('is-hovered');
        });
        item.classList.add('is-hovered');
        const toggle = item.querySelector('.szc-header__menu-link');
        if (toggle) toggle.setAttribute('aria-expanded', 'true');
      });

      item.addEventListener('mouseleave', () => {
        timer = setTimeout(() => {
          item.classList.remove('is-hovered');
          const toggle = item.querySelector('.szc-header__menu-link');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }, 180);
      });

      item.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          item.classList.remove('is-hovered');
          const toggle = item.querySelector('.szc-header__menu-link');
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        }
      });
    });

    const triggerBtns = document.querySelectorAll('[data-mobile-menu-trigger]');
    const drawer = document.getElementById('MobileMenuDrawer');
    const closeBtns = document.querySelectorAll('[data-mobile-menu-close]');

    if (drawer && triggerBtns.length > 0) {
      function openDrawer() {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      triggerBtns.forEach(btn => btn.addEventListener('click', openDrawer));
      closeBtns.forEach(btn => btn.addEventListener('click', closeDrawer));

      const accordions = drawer.querySelectorAll('.szc-mobile-drawer__accordion-toggle');
      const menuItems = drawer.querySelectorAll('[data-mobile-tab-trigger]');
      const tabContents = drawer.querySelectorAll('[data-mobile-tab-content]');

      menuItems.forEach(item => {
        item.addEventListener('click', function(e) {
          const tabTarget = this.getAttribute('data-mobile-tab-trigger');
          if (tabTarget) {
            menuItems.forEach(mi => mi.classList.remove('is-active'));
            this.classList.add('is-active');

            tabContents.forEach(content => {
              if (content.getAttribute('data-mobile-tab-content') === tabTarget) {
                content.classList.add('is-active');
              } else {
                content.classList.remove('is-active');
              }
            });
          }
        });
      });

      accordions.forEach(toggle => {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          const menuItem = this.closest('.szc-mobile-drawer__menu-item');
          const subMenu = menuItem ? menuItem.querySelector('.szc-mobile-drawer__sub-menu') : null;
          if (subMenu) {
            const isOpen = subMenu.style.display !== 'none';
            subMenu.style.display = isOpen ? 'none' : 'flex';
            this.classList.toggle('is-active', !isOpen);
            this.setAttribute('aria-expanded', !isOpen);
          }
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer();
        }
      });
    }
  });
{% endjavascript %}

