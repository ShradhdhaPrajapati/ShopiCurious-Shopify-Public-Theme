{%- liquid
  assign menu_setting = section.settings.menu
  assign main_menu_links = nil
  if menu_setting != blank and menu_setting.links != blank
    assign main_menu_links = menu_setting.links
  elsif linklists[menu_setting] != blank and linklists[menu_setting].links != blank
    assign main_menu_links = linklists[menu_setting].links
  elsif linklists['main-menu'] != blank
    assign main_menu_links = linklists['main-menu'].links
  endif
  assign logo_width = section.settings.logo_width | default: settings.logo_width | default: 140
  assign header_logo = section.settings.logo | default: settings.logo
  assign header_logo_mobile = settings.logo_mobile
  assign is_sticky = section.settings.enable_sticky_header
-%}

<sticky-header class="szc-header-wrapper {% if is_sticky %}is-sticky{% endif %}">
  <header class="szc-header page-width">
    <!-- Mobile Hamburger Toggle Button -->
    <button
      type="button"
      class="szc-header__icon-btn szc-header__mobile-toggle mobile-only"
      aria-label="{{ 'sections.header.menu' | t | default: 'Toggle menu' }}"
      data-mobile-menu-trigger
    >
      {% render 'icon', icon: 'menu', class: 'szc-header__icon' %}
    </button>

    <!-- Brand Logo -->
    <div class="szc-header__logo">
      <a href="{{ routes.root_url }}" class="szc-header__logo-link">
        {%- if header_logo != blank -%}
          {%- assign logo_height = logo_width | divided_by: header_logo.aspect_ratio -%}
          <picture>
            {%- if header_logo_mobile != blank -%}
              <source media="(max-width: 767px)" srcset="{{ header_logo_mobile | image_url: width: 400 }}">
            {%- endif -%}
            {{ header_logo | image_url: width: 400 | image_tag:
              class: 'szc-header__logo-img',
              width: logo_width,
              height: logo_height,
              alt: shop.name,
              preload: true
            }}
          </picture>
        {%- else -%}
          <span class="szc-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <!-- Desktop Navigation Menu with Theme Store Grade Mega Menu Engine -->
    <nav class="szc-header__inline-menu desktop-only" aria-label="{{ 'sections.header.menu' | t | default: 'Main Navigation' }}">
      <ul class="szc-header__menu-list" role="list">
        {%- for link in main_menu_links -%}
          {%- liquid
            assign nav_link_handle = link.handle | default: ''
            assign nav_link_title_handle = link.title | handleize
            assign nav_link_title_down = link.title | downcase | strip
            assign mega_block = null
            for block in section.blocks
              if block.type == 'mega_menu'
                assign block_title = block.settings.menu_item_title | default: ''
                assign block_handle = block_title | handleize
                assign block_title_down = block_title | downcase | strip
                if block_handle != blank
                  if block_handle == nav_link_handle or block_handle == nav_link_title_handle or block_title_down == nav_link_title_down
                    assign mega_block = block
                    break
                  endif
                endif
              endif
            endfor

            if mega_block != null
              assign display_type = 'mega'
            elsif link.links != blank
              assign display_type = 'dropdown'
            else
              assign display_type = 'simple'
            endif
          -%}

          <li class="szc-header__menu-item {% if display_type == 'mega' %}has-mega-menu{% elsif display_type == 'dropdown' %}has-dropdown{% endif %}" {{ mega_block.shopify_attributes }}>
            <a
              href="{{ link.url }}"
              class="szc-header__menu-link {% if link.child_active or link.active %}is-active{% endif %}"
              {% if display_type != 'simple' %}aria-expanded="false" aria-haspopup="true"{% endif %}
            >
              <span>{{ link.title }}</span>
              {%- if display_type != 'simple' -%}
                {% render 'icon', icon: 'chevron-down', class: 'szc-header__menu-chevron' %}
              {%- endif -%}
            </a>

            <!-- DYNAMIC MEGA MENU PANEL (PURE SCHEMAS & THEME EDITOR DRIVEN) -->
            {%- if display_type == 'mega' and mega_block != null -%}
              {% render 'mega-menu', link: link, mega_block: mega_block, section: section %}
            {%- endif -%}

            <!-- STANDARD DROPDOWN (If Menu Type is Dropdown) -->
            {%- if display_type == 'dropdown' -%}
              {%- liquid
                assign dropdown_links = link.links
                if dropdown_links == blank and mega_block != null
                  if mega_block.settings.categories_menu != blank
                    assign cat_m = mega_block.settings.categories_menu
                    if cat_m.links != blank
                      assign dropdown_links = cat_m.links
                    elsif linklists[cat_m] != blank and linklists[cat_m].links != blank
                      assign dropdown_links = linklists[cat_m].links
                    endif
                  elsif mega_block.settings.occasions_menu != blank
                    assign occ_m = mega_block.settings.occasions_menu
                    if occ_m.links != blank
                      assign dropdown_links = occ_m.links
                    elsif linklists[occ_m] != blank and linklists[occ_m].links != blank
                      assign dropdown_links = linklists[occ_m].links
                    endif
                  endif
                endif
              -%}
              {%- if dropdown_links != blank and dropdown_links.size > 0 -%}
                <ul class="szc-header__dropdown" role="list">
                  {%- for childlink in dropdown_links -%}
                    <li class="szc-header__dropdown-item">
                      <a
                        href="{{ childlink.url }}"
                        class="szc-header__dropdown-link {% if childlink.active %}is-active{% endif %}"
                      >
                        {{ childlink.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}

          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <!-- Header Actions (Search, Account, Wishlist, Cart) -->
    <div class="szc-header__icons">
      <!-- Search Trigger -->
      <button
        type="button"
        class="szc-header__icon-btn szc-search-trigger"
        aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
      >
        {% render 'icon', icon: 'search', class: 'szc-header__icon' %}
      </button>

      <!-- Customer Account Link -->
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="szc-header__icon-btn desktop-only"
          aria-label="{{ 'customer.account_fallback' | t | default: 'Account' }}"
        >
          {% render 'icon', icon: 'user', class: 'szc-header__icon' %}
        </a>
      {%- endif -%}

      <!-- Wishlist Icon Link -->
      {%- if settings.enable_wishlist != false -%}
        {%- assign wishlist_url = settings.wishlist_page_url -%}
        {%- if wishlist_url == blank or wishlist_url == '#' -%}
          {%- assign wishlist_url = '/pages/wishlist' -%}
        {%- endif -%}
        <a
          href="{{ wishlist_url }}"
          class="szc-header__icon-btn szc-wishlist-header-link"
          aria-label="Wishlist"
          title="Wishlist"
        >
          {% render 'icon', icon: 'heart', class: 'szc-header__icon' %}
          <span class="szc-header__wishlist-badge" data-wishlist-count="0">
            0
          </span>
        </a>
      {%- endif -%}

      <!-- Cart Icon -->
      {%- if settings.cart_type == 'page' -%}
        <a
          href="{{ routes.cart_url }}"
          class="szc-header__icon-btn"
          aria-label="{{ 'sections.header.cart' | t | default: 'Shopping bag' }}"
        >
          {% render 'icon', icon: 'bag', class: 'szc-header__icon' %}
          <span class="szc-header__cart-badge" data-cart-count="{{ cart.item_count }}">
            {{ cart.item_count }}
          </span>
        </a>
      {%- else -%}
        <button
          type="button"
          class="szc-header__icon-btn szc-cart-trigger"
          aria-label="{{ 'sections.header.cart' | t | default: 'Shopping bag' }}"
        >
          {% render 'icon', icon: 'bag', class: 'szc-header__icon' %}
          <span class="szc-header__cart-badge" data-cart-count="{{ cart.item_count }}">
            {{ cart.item_count }}
          </span>
        </button>
      {%- endif -%}
    </div>
  </header>

  <!-- DYNAMIC MOBILE NAVIGATION DRAWER -->
  {% render 'mobile-drawer', main_menu_links: main_menu_links, section: section %}
</sticky-header>

{% stylesheet %}
  sticky-header {
    display: block;
    width: 100%;
  }

  .szc-header-wrapper {
    display: block;
    width: 100%;
    background-color: var(--szc-color-background, #ffffff);
    border-bottom: 1px solid var(--szc-color-border, #e5e5e5);
    position: relative;
    z-index: var(--szc-z-header, 300);
  }

  sticky-header.is-sticky,
  .szc-header-wrapper.is-sticky {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--szc-color-background, #ffffff);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform var(--szc-transition-base, 250ms ease), box-shadow 200ms ease;
  }

  sticky-header.is-sticky.is-scrolled,
  .szc-header-wrapper.is-sticky.is-scrolled {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
  }

  .shopify-section-group-header-group:has(.is-sticky),
  [id*="shopify-section-"][id*="header"]:has(.is-sticky) {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .szc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--szc-header-height, 70px);
    padding: 0 var(--szc-space-6, 24px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    position: relative;
  }

  .szc-header__logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--szc-color-text-primary, #111111);
  }

  .szc-header__logo-text {
    font-family: var(--szc-font-family-heading);
    font-size: var(--szc-font-size-xl, 22px);
    font-weight: 700;
    letter-spacing: var(--szc-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
  }

  .szc-header__inline-menu {
    display: flex;
    align-items: center;
  }

  .szc-header__menu-list {
    display: flex;
    align-items: center;
    gap: var(--szc-space-6, 24px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .szc-header__menu-item {
    position: relative;
  }

  .szc-header__menu-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 24px 0;
    font-family: var(--szc-font-family-body);
    font-size: var(--szc-font-size-sm, 14px);
    font-weight: 600;
    color: var(--szc-color-text-primary, #111111);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--szc-letter-spacing-wide, 0.05em);
    transition: color var(--szc-transition-fast, 150ms ease);
  }

  .szc-header__menu-link:hover,
  .szc-header__menu-link.is-active,
  .szc-header__menu-item.is-hovered .szc-header__menu-link {
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-header__menu-chevron {
    width: 12px;
    height: 12px;
  }

  /* Standard Dropdown Menu */
  .szc-header__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background-color: var(--szc-color-background, #ffffff);
    border: 1px solid var(--szc-color-border, #e5e5e5);
    border-radius: var(--szc-radius-card, 4px);
    box-shadow: var(--szc-shadow-md);
    padding: var(--szc-space-2, 8px) 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease;
    z-index: 400;
  }

  .szc-header__menu-item:hover .szc-header__dropdown,
  .szc-header__menu-item.is-hovered .szc-header__dropdown,
  .szc-header__menu-item:focus-within .szc-header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .szc-header__dropdown-link {
    display: block;
    padding: 8px 16px;
    font-size: 13px;
    color: var(--szc-color-text-primary, #2b2b2b);
    text-decoration: none;
    transition: background-color var(--szc-transition-fast, 150ms ease);
  }

  .szc-header__dropdown-link:hover {
    background-color: var(--szc-color-surface, #f8f9fa);
    color: var(--szc-color-secondary, #d4a373);
  }

  /* ==========================================================================
     💎 THEME STORE 10/10 ULTRA-LUXURY MEGA MENU PANEL (Prestige & Impact Level)
     ========================================================================== */
  .szc-header__menu-item.has-mega-menu {
    position: static;
  }

  .szc-mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: #ffffff;
    border-top: 1px solid #eeeeee;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease;
    z-index: 500;
  }

  .szc-header__menu-item.is-hovered .szc-mega-menu,
  .szc-header__menu-item:focus-within .szc-mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .szc-mega-menu__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px var(--szc-space-6, 24px) 0 var(--szc-space-6, 24px);
  }

  /* CSS AUTO GRID LAYOUT: Auto Resizing & Stretching */
  .szc-mega-menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 28px;
    align-items: start;
    padding-bottom: 24px;
  }

  .szc-mega-col--banner {
    grid-column: span 1;
  }

  .szc-mega-col {
    display: flex;
    flex-direction: column;
  }

  .szc-mega-col__title {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #111111;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  /* COLUMN 1: LEFT PROMO BANNER */
  .szc-mega-banner-card {
    position: relative;
    height: 100%;
    min-height: 280px;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: #f4efea;
  }

  .szc-mega-banner-img-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .szc-mega-banner-img-wrap img,
  .szc-mega-banner-img-wrap svg.szc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mega-banner-content {
    position: relative;
    z-index: 2;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 100%);
    margin: -24px;
    padding: 28px 24px 24px 24px;
    color: #ffffff;
  }

  .szc-mega-banner-sub {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #d4a373;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }

  .szc-mega-banner-title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 6px 0;
    color: #ffffff;
  }

  .szc-mega-banner-desc {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 16px 0;
  }

  .szc-mega-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: #000000;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 150ms ease;
  }

  .szc-mega-banner-btn:hover {
    background: #333333;
  }

  /* COLUMN 2: CATEGORIES (Auto-fetched) */
  .szc-mega-categories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-mega-cat-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #333333;
    transition: color 150ms ease;
  }

  .szc-mega-cat-link:hover {
    color: #c86d51;
  }

  .szc-mega-cat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #111111;
  }

  .szc-mega-cat-name {
    font-size: 13.5px;
    font-weight: 600;
  }

  .szc-mega-subcategories-list {
    list-style: none;
    padding: 6px 0 0 40px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .szc-mega-subcat-link {
    font-size: 12.5px;
    color: #666666;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-mega-subcat-link:hover {
    color: #111111;
  }

  .szc-mobile-drawer__grandchild-menu {
    list-style: none;
    padding: 4px 0 4px 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* COLUMN 3: OCCASIONS */
  .szc-mega-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-mega-simple-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #444444;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-mega-simple-link:hover {
    color: #111111;
    font-weight: 600;
  }

  /* COLUMN 4: NEW ARRIVALS (Mini Products) */
  .szc-mega-products-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-mega-product-item {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .szc-mega-product-item:hover {
    transform: translateX(3px);
  }

  .szc-mega-prod-thumb {
    width: 48px;
    height: 58px;
    border-radius: 6px;
    overflow: hidden;
    background: #f4f4f4;
    flex-shrink: 0;
  }

  .szc-mega-prod-thumb img,
  .szc-mega-prod-thumb svg.szc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mega-prod-info {
    display: flex;
    flex-direction: column;
  }

  .szc-mega-prod-title {
    font-size: 13px;
    font-weight: 600;
    color: #111111;
    margin: 0 0 2px 0;
    line-height: 1.3;
  }

  .szc-mega-prod-price {
    font-size: 12.5px;
    font-weight: 700;
    color: #111111;
  }

  /* COLUMNS 5 & 6: PROMO CARDS */
  .szc-mega-promo-card-wrap {
    text-decoration: none;
    display: block;
    height: 100%;
  }

  .szc-mega-promo-card {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    overflow: hidden;
    background: #f9f9f9;
    height: 100%;
  }

  .szc-mega-card-img-wrap {
    width: 100%;
    height: 150px;
    overflow: hidden;
  }

  .szc-mega-card-img-wrap img,
  .szc-mega-card-img-wrap svg.szc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .szc-mega-promo-card-wrap:hover .szc-mega-card-img-wrap img,
  .szc-mega-promo-card-wrap:hover .szc-mega-card-img-wrap svg.szc-placeholder-svg {
    transform: scale(1.05);
  }

  .szc-mega-card-content {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .szc-mega-card-heading {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 15px;
    font-weight: 700;
    color: #111111;
    margin: 0 0 2px 0;
  }

  .szc-mega-card-desc {
    font-size: 12px;
    color: #666666;
    margin: 0 0 10px 0;
  }

  .szc-mega-card-link {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #111111;
    text-transform: uppercase;
    margin-top: auto;
    transition: color 150ms ease;
  }

  .szc-mega-promo-card-wrap:hover .szc-mega-card-link {
    color: #c86d51;
  }

  /* BOTTOM USP / TRUST BANNER (Dynamic Grid) */
  .szc-mega-trust-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    padding: 16px 20px;
    border-top: 1px solid #eeeeee;
    background: #fcfbf9;
    margin: 0 -24px;
  }

  .szc-mega-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .szc-trust-icon {
    color: #c86d51;
    flex-shrink: 0;
  }

  .szc-trust-text {
    display: flex;
    flex-direction: column;
  }

  .szc-trust-title {
    font-size: 12.5px;
    font-weight: 700;
    color: #111111;
  }

  .szc-trust-sub {
    font-size: 11px;
    color: #777777;
  }

  /* Header Action Icons */
  .szc-header__icons {
    display: flex;
    align-items: center;
    gap: var(--szc-space-3, 12px);
  }

  .szc-header__icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: var(--szc-color-text-primary, #111111);
    cursor: pointer;
    text-decoration: none;
    border-radius: 50%;
    transition: background-color var(--szc-transition-fast, 150ms ease);
  }

  .szc-header__icon-btn:hover {
    background-color: var(--szc-color-surface, #f8f9fa);
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-header__icon {
    width: 20px;
    height: 20px;
  }

  .szc-header__cart-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
