    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .szc-mob-banner-title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 16px;
    font-weight: 700;
    margin: 0;
  }

  .szc-mob-banner-btn {
    display: inline-block;
    margin-top: 6px;
    padding: 6px 14px;
    background: #ffffff;
    color: #111111;
    font-size: 10px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .szc-mobile-drawer__footer {
