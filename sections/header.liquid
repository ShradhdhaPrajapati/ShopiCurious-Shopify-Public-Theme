  .szc-header__wishlist-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--szc-color-accent, #e76f51);
    border-radius: 9999px;
    transition: transform var(--szc-transition-fast, 150ms ease);
    z-index: 2;
  }

  .szc-header__wishlist-badge.is-pop {
    transform: scale(1.35);
  }

  .szc-wishlist-header-link > svg ~ svg {
    display: none !important;
  }

  /* Mobile Menu Drawer Styling */
  .szc-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 300ms ease;
  }

  .szc-mobile-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .szc-mobile-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .szc-mobile-drawer.is-open .szc-mobile-drawer__overlay {
    opacity: 1;
  }

  .szc-mobile-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 380px;
    height: 100%;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .szc-mobile-drawer.is-open .szc-mobile-drawer__panel {
    transform: translateX(0);
  }

  .szc-mobile-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #eeeeee;
  }

  .szc-mobile-drawer__title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #111111;
  }

  .szc-mobile-drawer__close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 150ms ease;
  }

  .szc-mobile-drawer__close-btn:hover {
    background-color: #f5f5f5;
  }

  .szc-mobile-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
  }

  .szc-mobile-drawer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .szc-mobile-drawer__menu-item {
    border-bottom: 1px solid #f5f5f5;
  }

  .szc-mobile-drawer__link-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
  }

  .szc-mobile-drawer__link {
    display: block;
    padding: 8px 0;
