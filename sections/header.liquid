{%- liquid
  assign menu_setting = section.settings.menu
  assign main_menu_links = nil
  if menu_setting != blank and menu_setting.links != blank
    assign main_menu_links = menu_setting.links
  elsif linklists[menu_setting] != blank and linklists[menu_setting].links != blank
    assign main_menu_links = linklists[menu_setting].links
  elsif linklists['main-menu'] != blank
    assign main_menu_links = linklists['main-menu'].links
  endif
  assign logo_width = section.settings.logo_width | default: settings.logo_width | default: 140
  assign header_logo = section.settings.logo | default: settings.logo
  assign header_logo_mobile = settings.logo_mobile
  assign is_sticky = section.settings.enable_sticky_header
-%}

<sticky-header class="szc-header-wrapper {% if is_sticky %}is-sticky{% endif %}" style="--szc-header-accent: {{ section.settings.accent_color | default: '#c87a38' }};">
  <header class="szc-header">
    <!-- Row 1: Brand & Controls (3-Column Grid for True Mathematical Center) -->
    <div class="szc-header__main-row page-width">
      <!-- Left Controls: Mobile Hamburger (mobile-only) + Language & Country Selectors (desktop-only) -->
      <div class="szc-header__left-controls">
        <button
          type="button"
          class="szc-header__icon-btn szc-header__mobile-toggle mobile-only"
          aria-label="{{ 'sections.header.menu' | t | default: 'Toggle menu' }}"
          data-mobile-menu-trigger
        >
          {% render 'icon', icon: 'menu', class: 'szc-header__icon' %}
        </button>

        {% render 'language-selector', class: 'desktop-only', id_prefix: 'Header' %}

        {%- if section.settings.show_country_selector != false -%}
          {% render 'country-selector', class: 'desktop-only', id_prefix: 'Header', display_format: 'flag_currency' %}
        {%- endif -%}
      </div>

      <!-- Center: Brand Logo with Short Accent Underline -->
      <div class="szc-header__brand">
        <div class="szc-header__logo">
          <a href="{{ routes.root_url }}" class="szc-header__logo-link {% if header_logo != blank %}szc-header__logo-link--image{% else %}szc-header__logo-link--text{% endif %}" style="--logo-width: {{ logo_width }}px;">
            {%- if header_logo != blank -%}
              {%- assign logo_height = logo_width | divided_by: header_logo.aspect_ratio -%}
              <picture>
                {%- if header_logo_mobile != blank -%}
                  <source media="(max-width: 767px)" srcset="{{ header_logo_mobile | image_url: width: 400 }}">
                {%- endif -%}
                {{ header_logo | image_url: width: 400 | image_tag:
                  class: 'szc-header__logo-img',
                  width: logo_width,
                  height: logo_height,
                  alt: shop.name,
                  preload: true
                }}
              </picture>
            {%- else -%}
              <span class="szc-header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </div>
        {%- if section.settings.show_logo_underline != false -%}
          <div class="szc-header__logo-accent-line desktop-only" aria-hidden="true"></div>
        {%- endif -%}
      </div>

      <!-- Right Controls: Header Actions (Search, Account, Wishlist, Cart) -->
      <div class="szc-header__icons">
        <!-- Search Trigger -->
        <button
          type="button"
          class="szc-header__icon-btn szc-search-trigger"
          aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
        >
          {% render 'icon', icon: 'search', class: 'szc-header__icon' %}
        </button>

        <!-- Customer Account Link -->
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="szc-header__icon-btn desktop-only"
            aria-label="{{ 'customer.account_fallback' | t | default: 'Account' }}"
          >
            {% render 'icon', icon: 'user', class: 'szc-header__icon' %}
          </a>
        {%- endif -%}

        <!-- Wishlist Icon Link -->
        {%- if settings.enable_wishlist != false -%}
          {%- assign wishlist_url = settings.wishlist_page_url -%}
          {%- if wishlist_url == blank or wishlist_url == '#' -%}
            {%- assign wishlist_url = '/pages/wishlist' -%}
          {%- endif -%}
          <a
            href="{{ wishlist_url }}"
            class="szc-header__icon-btn szc-wishlist-header-link"
            aria-label="Wishlist"
            title="Wishlist"
          >
            {% render 'icon', icon: 'heart', class: 'szc-header__icon' %}
            <span class="szc-header__wishlist-badge" data-wishlist-count="0">
              0
            </span>
          </a>
        {%- endif -%}

        <!-- Cart Icon -->
        {%- if settings.cart_type == 'page' -%}
          <a
            href="{{ routes.cart_url }}"
            class="szc-header__icon-btn"
            aria-label="{{ 'sections.header.cart' | t | default: 'Shopping bag' }}"
          >
            {% render 'icon', icon: 'bag', class: 'szc-header__icon' %}
            <span class="szc-header__cart-badge" data-cart-count="{{ cart.item_count }}">
              {{ cart.item_count }}
            </span>
          </a>
        {%- else -%}
          <button
            type="button"
            class="szc-header__icon-btn szc-cart-trigger"
            aria-label="{{ 'sections.header.cart' | t | default: 'Shopping bag' }}"
          >
            {% render 'icon', icon: 'bag', class: 'szc-header__icon' %}
            <span class="szc-header__cart-badge" data-cart-count="{{ cart.item_count }}">
              {{ cart.item_count }}
            </span>
          </button>
        {%- endif -%}
      </div>
    </div>

    <!-- Row 2: Desktop Navigation Menu Centered Underneath Logo -->
    <div class="szc-header__nav-row desktop-only">
      <div class="szc-header__nav-container page-width">
        <nav class="szc-header__inline-menu" aria-label="{{ 'sections.header.menu' | t | default: 'Main Navigation' }}">
          <ul class="szc-header__menu-list" role="list">
            {%- for link in main_menu_links -%}
              {%- liquid
                assign nav_link_handle = link.handle | default: ''
                assign nav_link_title_handle = link.title | handleize
                assign nav_link_title_down = link.title | downcase | strip
                assign mega_block = null
                for block in section.blocks
                  if block.type == 'mega_menu'
                    assign block_title = block.settings.menu_item_title | default: ''
                    assign block_handle = block_title | handleize
                    assign block_title_down = block_title | downcase | strip
                    if block_handle != blank
                      if block_handle == nav_link_handle or block_handle == nav_link_title_handle or block_title_down == nav_link_title_down
                        assign mega_block = block
                        break
                      endif
                    endif
                  endif
                endfor

                assign mega_type = 'mega_image_left'
                if mega_block != null
                  assign mega_type = mega_block.settings.menu_type | default: 'mega_image_left'
                  if mega_type == 'mega'
                    assign mega_type = 'mega_image_left'
                  endif

                  if mega_type == 'dropdown_flyout'
                    assign display_type = 'dropdown'
                  else
                    assign display_type = 'mega'
                  endif
                elsif link.links != blank
                  assign display_type = 'dropdown'
                else
                  assign display_type = 'simple'
                endif
              -%}

              <li class="szc-header__menu-item {% if display_type == 'mega' %}has-mega-menu{% elsif display_type == 'dropdown' %}has-dropdown{% endif %}" {{ mega_block.shopify_attributes }}>
                <a
                  href="{{ link.url }}"
                  class="szc-header__menu-link {% if link.child_active or link.active %}is-active{% endif %}"
                  {% if display_type != 'simple' %}aria-expanded="false" aria-haspopup="true"{% endif %}
                >
                  <span>{{ link.title }}</span>
                  {%- if display_type != 'simple' -%}
                    {% render 'icon', icon: 'chevron-down', class: 'szc-header__menu-chevron' %}
                  {%- endif -%}
                </a>

                <!-- DYNAMIC MEGA MENU PANEL (PURE SCHEMAS & THEME EDITOR DRIVEN) -->
                {%- if display_type == 'mega' and mega_block != null -%}
                  {% render 'mega-menu', link: link, mega_block: mega_block, section: section %}
                {%- endif -%}

                <!-- TYPE 3: SIMPLE DROPDOWN & MULTI-LEVEL FLYOUT SUB MENU -->
                {%- if display_type == 'dropdown' -%}
                  {%- liquid
                    assign dropdown_links = link.links
                    if dropdown_links == blank and mega_block != null
                      if mega_block.settings.categories_menu != blank
                        assign cat_m = mega_block.settings.categories_menu
                        if cat_m.links != blank
                          assign dropdown_links = cat_m.links
                        elsif linklists[cat_m] != blank and linklists[cat_m].links != blank
                          assign dropdown_links = linklists[cat_m].links
                        endif
                      elsif mega_block.settings.occasions_menu != blank
                        assign occ_m = mega_block.settings.occasions_menu
                        if occ_m.links != blank
                          assign dropdown_links = occ_m.links
                        elsif linklists[occ_m] != blank and linklists[occ_m].links != blank
                          assign dropdown_links = linklists[occ_m].links
                        endif
                      endif
                    endif
                  -%}
                  {%- if dropdown_links != blank and dropdown_links.size > 0 -%}
                    <ul class="szc-header__dropdown szc-header__dropdown--multilevel" role="list">
                      {%- for childlink in dropdown_links -%}
                        {%- assign has_sub = false -%}
                        {%- if childlink.links != blank and childlink.links.size > 0 -%}
                          {%- assign has_sub = true -%}
                        {%- endif -%}
                        <li class="szc-header__dropdown-item {% if has_sub %}has-submenu{% endif %}">
                          <a
                            href="{{ childlink.url }}"
                            class="szc-header__dropdown-link {% if childlink.active %}is-active{% endif %}"
                            {% if has_sub %}aria-haspopup="true" aria-expanded="false"{% endif %}
                          >
                            <span>{{ childlink.title }}</span>
                            {%- if has_sub -%}
                              <svg class="szc-header__sub-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 1 7 5 3 9"></polyline></svg>
                            {%- endif -%}
                          </a>

                          {%- if has_sub -%}
                            <ul class="szc-header__sub-dropdown" role="list">
                              {%- for grandchildlink in childlink.links -%}
                                <li class="szc-header__sub-dropdown-item">
                                  <a
                                    href="{{ grandchildlink.url }}"
                                    class="szc-header__sub-dropdown-link {% if grandchildlink.active %}is-active{% endif %}"
                                  >
                                    {{ grandchildlink.title }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- endif -%}

              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>
    </div>
  </header>
</sticky-header>

<!-- DYNAMIC MOBILE NAVIGATION DRAWER -->
{% render 'mobile-drawer', main_menu_links: main_menu_links, section: section %}

{% stylesheet %}
  sticky-header {
    display: block;
    width: 100%;
  }

  .szc-header-wrapper {
    display: block;
    width: 100%;
    background-color: var(--szc-color-background, #ffffff);
    border-bottom: 1px solid var(--szc-color-border, #e5e5e5);
    position: relative;
    z-index: var(--szc-z-header, 300);
  }

  sticky-header.is-sticky,
  .szc-header-wrapper.is-sticky {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--szc-color-background, #ffffff);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform var(--szc-transition-base, 250ms ease), box-shadow 200ms ease;
  }

  sticky-header.is-sticky.is-scrolled,
  .szc-header-wrapper.is-sticky.is-scrolled {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
  }

  .shopify-section-group-header-group:has(.is-sticky),
  [id*="shopify-section-"][id*="header"]:has(.is-sticky) {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .szc-header {
    width: 100%;
    position: relative;
    background-color: var(--szc-color-background, #ffffff);
  }

  /* Row 1: Brand & Controls (3-Column Grid for Mathematical Center) */
  .szc-header__main-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 20px var(--szc-space-6, 24px) 14px;
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    box-sizing: border-box;
    width: 100%;
    position: relative;
    z-index: 20;
    transition: padding var(--szc-transition-base, 250ms ease);
  }

  .szc-header-wrapper.is-sticky.is-scrolled .szc-header__main-row {
    padding-top: 12px;
    padding-bottom: 10px;
  }

  .szc-header__left-controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    min-width: 0;
  }

  .szc-header__left-controls .szc-country-toggle-btn {
    height: 32px;
    font-size: 12px;
    padding: 0 10px;
    border-radius: 4px;
    border: 1px solid var(--szc-color-border, #e0e0e0);
    color: var(--szc-color-text-primary, #111111);
    background-color: transparent;
    box-shadow: none;
  }

  .szc-header__left-controls .szc-country-toggle-btn:hover,
  .szc-header__left-controls .szc-country-toggle-btn[aria-expanded="true"] {
    border-color: var(--szc-header-accent, var(--szc-color-secondary, #d4a373));
    background-color: var(--szc-color-surface, #fafafa);
    box-shadow: none;
  }

  .szc-header__left-controls .szc-localization-dropdown {
    left: 0;
    right: auto;
  }

  .szc-header__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-width: 0;
    padding: 0 16px;
  }

  .szc-header__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    min-width: 0;
  }

  .szc-header__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--szc-color-text-primary, #111111);
    min-width: 0;
  }

  .szc-header__logo-link--image {
    max-width: var(--logo-width, 140px);
    flex-shrink: 0;
  }

  .szc-header__logo-img {
    display: block;
    width: 100%;
    height: auto;
    max-width: var(--logo-width, 140px);
    max-height: 70px;
    object-fit: contain;
  }

  .szc-header__logo-link--text {
    max-width: min(380px, 40vw);
  }

  .szc-header__logo-text {
    font-family: var(--szc-font-family-heading, serif);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 700;
    letter-spacing: var(--szc-letter-spacing-wide, 0.08em);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    display: block;
    max-width: 100%;
    color: var(--szc-color-text-primary, #111111);
  }

  /* Short Accent Underline directly below the Logo */
  .szc-header__logo-accent-line {
    width: 48px;
    height: 2px;
    background-color: var(--szc-header-accent, var(--szc-color-secondary, #d4a373));
    margin: 8px auto 0;
    border-radius: 2px;
    transition: background-color var(--szc-transition-fast, 150ms ease), width var(--szc-transition-fast, 150ms ease);
  }

  /* Row 2: Centered Navigation Row */
  .szc-header__nav-row {
    position: relative;
    z-index: 10;
    width: 100%;
    border-bottom: 1px solid var(--szc-color-border, #e5e5e5);
    background-color: var(--szc-color-background, #ffffff);
  }

  .szc-header__nav-container {
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    padding: 0 var(--szc-space-6, 24px);
    display: flex;
    justify-content: center;
    position: static;
  }

  .szc-header__inline-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    position: static;
  }

  .szc-header__menu-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 2.5vw, 36px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .szc-header__menu-item {
    position: relative;
  }

  .szc-header__menu-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 12px 0 14px;
    font-family: var(--szc-font-family-nav, var(--szc-font-family-body));
    font-size: var(--szc-font-size-sm, 13px);
    font-weight: 600;
    color: var(--szc-color-text-primary, #111111);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--szc-letter-spacing-wide, 0.06em);
    transition: color var(--szc-transition-fast, 150ms ease);
    position: relative;
  }

  .szc-header__menu-link:hover,
  .szc-header__menu-link.is-active,
  .szc-header__menu-item.is-hovered .szc-header__menu-link {
    color: var(--szc-header-accent, var(--szc-color-secondary, #d4a373));
  }

  /* Thin Accent Underline on Active Navigation Item */
  .szc-header__menu-link.is-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--szc-header-accent, var(--szc-color-secondary, #d4a373));
    border-radius: 1px;
  }

  .szc-header__menu-chevron {
    width: 11px;
    height: 11px;
    stroke-width: 2.2;
    transition: transform var(--szc-transition-fast, 150ms ease);
  }

  .szc-header__menu-item.is-hovered .szc-header__menu-chevron {
    transform: rotate(180deg);
  }

  @media (max-width: 767px) {
    .szc-header__main-row {
      padding: 10px 16px;
      min-height: 56px;
    }
    .szc-header__brand {
      padding: 0 8px;
    }
    .szc-header__logo-link--image {
      max-width: min(var(--logo-width, 140px), 120px);
    }
    .szc-header__logo-img {
      max-width: min(var(--logo-width, 140px), 120px);
      max-height: 42px;
    }
    .szc-header__logo-link--text {
      max-width: calc(100vw - 140px);
    }
    .szc-header__logo-text {
      font-size: clamp(14px, 4.5vw, 18px);
      letter-spacing: 0.04em;
    }
    .szc-header__logo-accent-line {
      display: none;
    }
    .szc-header__icons {
      gap: 4px;
    }
    .szc-header__icon-btn {
      width: 36px;
      height: 36px;
    }
  }

  @media (max-width: 360px) {
    .szc-header__main-row {
      padding: 8px 10px;
    }
    .szc-header__logo-link--text {
      max-width: calc(100vw - 120px);
    }
    .szc-header__logo-text {
      font-size: 13px;
    }
    .szc-header__icon-btn {
      width: 32px;
      height: 32px;
    }
    .szc-header__icon {
      width: 18px;
      height: 18px;
    }
  }

  /* Standard & Multi-Level Dropdown Menu (Type 3) */
  .szc-header__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background-color: var(--szc-color-background, #ffffff);
    border: 1px solid var(--szc-color-border, #e5e5e5);
    border-radius: var(--szc-radius-card, 6px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09);
    padding: 8px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease;
    z-index: 400;
  }

  .szc-header__menu-item:hover .szc-header__dropdown,
  .szc-header__menu-item.is-hovered .szc-header__dropdown,
  .szc-header__menu-item:focus-within .szc-header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .szc-header__dropdown-item {
    position: relative;
    list-style: none;
  }

  .szc-header__dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 18px;
    font-size: 13.5px;
    color: var(--szc-color-text-primary, #2b2b2b);
    text-decoration: none;
    transition: background-color var(--szc-transition-fast, 150ms ease), color var(--szc-transition-fast, 150ms ease);
  }

  .szc-header__dropdown-link:hover,
  .szc-header__dropdown-item:hover > .szc-header__dropdown-link,
  .szc-header__dropdown-item:focus-within > .szc-header__dropdown-link {
    background-color: var(--szc-color-surface, #f8f9fa);
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-header__sub-chevron {
    margin-left: auto;
    color: #888888;
    transition: transform 150ms ease;
  }

  .szc-header__dropdown-item:hover > .szc-header__dropdown-link .szc-header__sub-chevron {
    color: var(--szc-color-secondary, #d4a373);
    transform: translateX(2px);
  }

  /* Multi-Level Flyout Submenu (Type 3) */
  .szc-header__sub-dropdown {
    position: absolute;
    top: -8px;
    left: 100%;
    min-width: 220px;
    background-color: #ffffff;
    border: 1px solid var(--szc-color-border, #eeeeee);
    border-radius: 6px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09);
    padding: 8px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateX(6px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    z-index: 450;
  }

  .szc-header__dropdown-item:hover > .szc-header__sub-dropdown,
  .szc-header__dropdown-item:focus-within > .szc-header__sub-dropdown,
  .szc-header__dropdown-item.is-expanded > .szc-header__sub-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  html[dir="rtl"] .szc-header__sub-chevron {
    margin-left: 0;
    margin-right: auto;
    transform: scaleX(-1);
  }

  html[dir="rtl"] .szc-header__dropdown-item:hover > .szc-header__dropdown-link .szc-header__sub-chevron {
    transform: scaleX(-1) translateX(2px);
  }

  html[dir="rtl"] .szc-header__sub-dropdown {
    left: auto;
    right: 100%;
    transform: translateX(-6px);
  }

  html[dir="rtl"] .szc-header__dropdown-item:hover > .szc-header__sub-dropdown,
  html[dir="rtl"] .szc-header__dropdown-item:focus-within > .szc-header__sub-dropdown,
  html[dir="rtl"] .szc-header__dropdown-item.is-expanded > .szc-header__sub-dropdown {
    transform: translateX(0);
  }

  .szc-header__sub-dropdown-item {
    list-style: none;
  }

  .szc-header__sub-dropdown-link {
    display: block;
    padding: 8px 18px;
    font-size: 13px;
    color: var(--szc-color-text-primary, #333333);
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .szc-header__sub-dropdown-link:hover {
    background-color: #f8f9fa;
    color: var(--szc-color-secondary, #d4a373);
  }

  /* ==========================================================================
     THEME STORE 10/10 ULTRA-LUXURY MEGA MENU PANEL (Prestige & Impact Level)
     ========================================================================== */
  .szc-header__menu-item.has-mega-menu {
    position: static;
  }

  .szc-mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: #ffffff;
    border-top: 1px solid #eeeeee;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 200ms ease, transform 200ms ease, visibility 200ms ease;
    z-index: 500;
  }

  .szc-header__menu-item.is-hovered .szc-mega-menu,
  .szc-header__menu-item:focus-within .szc-mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .szc-mega-menu__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 24px var(--szc-space-6, 24px) 0 var(--szc-space-6, 24px);
  }

  /* Thin 1px Vertical Dividers (Exact Match to Reference Screenshot) */
  .szc-mega-divider {
    width: 1px;
    background-color: #eeeeee;
    align-self: stretch;
    flex-shrink: 0;
    margin: 0 4px;
  }

  .szc-mega-divider--major {
    margin: 0 14px;
  }

  /* Base Mega Menu Grid */
  .szc-mega-menu__grid {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 24px;
  }

  /* TYPE 1: MEGA MENU (IMAGE LEFT) */
  .szc-mega-menu__grid--image-left {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 24px;
  }

  .szc-mega-menu__grid--image-left .szc-mega-col--banner {
    flex: 1.15;
    min-width: 220px;
    max-width: 260px;
  }

  .szc-mega-menu__grid--image-left .szc-mega-col--links {
    flex: 1;
    min-width: 140px;
  }

  .szc-mega-menu__grid--image-left .szc-mega-col--products {
    flex: 1.25;
    min-width: 200px;
  }

  .szc-mega-menu__grid--image-left .szc-mega-col--promo {
    flex: 1.15;
    min-width: 200px;
    max-width: 250px;
  }

  /* TYPE 2: MEGA MENU (PRODUCTS RIGHT) */
  .szc-mega-menu__grid--products-right {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 18px;
    padding-bottom: 24px;
  }

  .szc-mega-menu__left-nav {
    display: flex;
    flex: 1.1;
    align-items: stretch;
    justify-content: space-between;
    gap: 16px;
  }

  .szc-mega-menu__left-nav .szc-mega-col--links {
    flex: 1;
    min-width: 140px;
  }

  .szc-mega-col--showcase {
    flex: 1.5;
    display: flex;
    flex-direction: column;
  }

  .szc-mega-col--banner {
    grid-column: span 1;
  }

  .szc-mega-col {
    display: flex;
    flex-direction: column;
  }

  .szc-mega-col__title {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #111111;
    text-transform: uppercase;
    margin: 0 0 16px 0;
  }

  /* COLUMN 1: LEFT PROMO BANNER */
  .szc-mega-banner-card {
    position: relative;
    height: 100%;
    min-height: 280px;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: #f4efea;
  }

  .szc-mega-banner-img-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .szc-mega-banner-img-wrap img,
  .szc-mega-banner-img-wrap svg.szc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mega-banner-content {
    position: relative;
    z-index: 2;
    background: linear-gradient(to top, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0) 100%);
    margin: -24px;
    padding: 28px 24px 24px 24px;
    color: #ffffff;
  }

  .szc-mega-banner-sub {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #d4a373;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }

  .szc-mega-banner-title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 6px 0;
    color: #ffffff;
  }

  .szc-mega-banner-desc {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 16px 0;
  }

  .szc-mega-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: #000000;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 150ms ease;
  }

  .szc-mega-banner-btn:hover {
    background: #333333;
  }

  /* COLUMN 2: CATEGORIES (Auto-fetched) */
  .szc-mega-categories-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-mega-cat-link {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #333333;
    transition: color 150ms ease;
  }

  .szc-mega-cat-link:hover {
    color: #c86d51;
  }

  .szc-mega-cat-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: #111111;
  }

  .szc-mega-cat-name {
    font-size: 13.5px;
    font-weight: 600;
  }

  .szc-mega-subcategories-list {
    list-style: none;
    padding: 6px 0 0 40px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .szc-mega-subcat-link {
    font-size: 12.5px;
    color: #666666;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-mega-subcat-link:hover {
    color: #111111;
  }

  .szc-mobile-drawer__grandchild-menu {
    list-style: none;
    padding: 4px 0 4px 16px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* COLUMN 3: OCCASIONS */
  .szc-mega-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-mega-simple-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #444444;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-mega-simple-link:hover {
    color: #111111;
    font-weight: 600;
  }

  /* COLUMN 4: NEW ARRIVALS (Mini Products) */
  .szc-mega-products-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-mega-product-item {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .szc-mega-product-item:hover {
    transform: translateX(3px);
  }

  .szc-mega-prod-thumb {
    width: 48px;
    height: 58px;
    border-radius: 6px;
    overflow: hidden;
    background: #f4f4f4;
    flex-shrink: 0;
  }

  .szc-mega-prod-thumb img,
  .szc-mega-prod-thumb svg.szc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mega-prod-info {
    display: flex;
    flex-direction: column;
  }

  .szc-mega-prod-title {
    font-size: 13px;
    font-weight: 600;
    color: #111111;
    margin: 0 0 2px 0;
    line-height: 1.3;
  }

  .szc-mega-prod-price {
    font-size: 12.5px;
    font-weight: 700;
    color: #111111;
  }

  /* COLUMNS 5 & 6: PROMO CARDS */
  .szc-mega-promo-card-wrap {
    text-decoration: none;
    display: block;
    height: 100%;
  }

  .szc-mega-promo-card {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    overflow: hidden;
    background: #f9f9f9;
    height: 100%;
  }

  .szc-mega-card-img-wrap {
    width: 100%;
    height: 150px;
    overflow: hidden;
  }

  .szc-mega-card-img-wrap img,
  .szc-mega-card-img-wrap svg.szc-placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .szc-mega-promo-card-wrap:hover .szc-mega-card-img-wrap img,
  .szc-mega-promo-card-wrap:hover .szc-mega-card-img-wrap svg.szc-placeholder-svg {
    transform: scale(1.05);
  }

  .szc-mega-card-content {
    padding: 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .szc-mega-card-heading {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 15px;
    font-weight: 700;
    color: #111111;
    margin: 0 0 2px 0;
  }

  .szc-mega-card-desc {
    font-size: 12px;
    color: #666666;
    margin: 0 0 10px 0;
  }

  .szc-mega-card-link {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #111111;
    text-transform: uppercase;
    margin-top: auto;
    transition: color 150ms ease;
  }

  .szc-mega-promo-card-wrap:hover .szc-mega-card-link {
    color: #c86d51;
  }

  /* TYPE 2: PRODUCT SHOWCASE GRID (4 HORIZONTAL CARDS) */
  .szc-mega-products-showcase {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  .szc-mega-showcase-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: transparent;
    border-radius: 6px;
    overflow: hidden;
    transition: transform 180ms ease;
  }

  .szc-mega-showcase-card:hover {
    transform: translateY(-3px);
  }

  .szc-mega-showcase-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f6f6f6;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 10px;
  }

  .szc-mega-showcase-thumb img,
  .szc-mega-showcase-thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .szc-mega-showcase-card:hover .szc-mega-showcase-thumb img {
    transform: scale(1.04);
  }

  .szc-showcase-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 3px;
    color: #ffffff;
    line-height: 1.1;
  }

  .szc-showcase-badge--sale {
    background-color: #d85a38;
  }

  .szc-showcase-badge--new {
    background-color: #5b8c6c;
  }

  .szc-mega-showcase-title {
    font-size: 13px;
    font-weight: 600;
    color: #111111;
    margin: 0 0 4px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .szc-mega-showcase-pricing {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }

  .szc-mega-showcase-price {
    font-weight: 700;
    color: #111111;
  }

  .szc-mega-showcase-price.is-sale-price {
    color: #d85a38;
  }

  .szc-mega-showcase-compare {
    font-size: 12px;
    color: #888888;
    text-decoration: line-through;
  }

  /* View All Link (Bottom of Link Columns) */
  .szc-mega-view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    margin-top: 14px;
    transition: color 150ms ease;
  }

  .szc-mega-view-all-link:hover {
    color: #c87a38;
  }

  .szc-view-all-svg,
  .szc-btn-svg {
    display: inline-block;
    transition: transform 150ms ease;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .szc-mega-view-all-link:hover .szc-view-all-svg,
  .szc-mega-banner-btn:hover .szc-btn-svg,
  .szc-mega-card-btn:hover .szc-btn-svg {
    transform: translateX(4px);
  }

  /* Responsive styling for Mega Menu Variations */
  @media (max-width: 1200px) {
    .szc-mega-menu__container {
      padding-left: 16px;
      padding-right: 16px;
    }
    .szc-mega-menu__grid--image-left {
      gap: 10px;
    }
    .szc-mega-menu__grid--image-left .szc-mega-col--banner {
      flex: 1 1 170px;
      min-width: 160px;
      max-width: 210px;
    }
    .szc-mega-menu__grid--image-left .szc-mega-col--links {
      flex: 1 1 120px;
      min-width: 110px;
    }
    .szc-mega-menu__grid--image-left .szc-mega-col--trending-rows {
      flex: 1 1 150px;
      min-width: 140px;
    }
    .szc-mega-menu__grid--image-left .szc-mega-col--featured-card {
      flex: 1 1 160px;
      min-width: 150px;
    }
    .szc-mega-menu__grid--products-right {
      gap: 12px;
    }
    .szc-mega-menu__left-nav {
      gap: 10px;
    }
    .szc-mega-menu__left-nav .szc-mega-col--links {
      flex: 1 1 120px;
      min-width: 110px;
    }
    .szc-mega-showcase-card {
      min-width: 120px;
    }
    .szc-mega-divider {
      margin: 0 2px;
    }
    .szc-mega-divider--major {
      margin: 0 8px;
    }
    .szc-mega-products-showcase {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  /* Header Action Icons */
  .szc-header__icons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--szc-space-3, 12px);
  }

  .szc-header__icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: var(--szc-color-text-primary, #111111);
    cursor: pointer;
    text-decoration: none;
    border-radius: 50%;
    transition: background-color var(--szc-transition-fast, 150ms ease);
  }

  .szc-header__icon-btn:hover {
    background-color: var(--szc-color-surface, #f8f9fa);
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-header__icon {
    width: 20px;
    height: 20px;
  }

  .szc-header__cart-badge {
    position: absolute;
    top: 4px;
    right: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--szc-color-primary, #111111);
    border-radius: 9999px;
  }

  .szc-header__wishlist-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 10px;
    font-weight: 700;
    color: #ffffff;
    background-color: var(--szc-color-accent, #e76f51);
    border-radius: 9999px;
    transition: transform var(--szc-transition-fast, 150ms ease);
    z-index: 2;
  }

  .szc-header__wishlist-badge.is-pop {
    transform: scale(1.35);
  }

  .szc-wishlist-header-link > svg ~ svg {
    display: none !important;
  }

  /* Mobile Menu Drawer Styling */
  .szc-mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 99999;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 300ms ease;
  }

  .szc-mobile-drawer:not(.is-open) {
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .szc-mobile-drawer.is-open {
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .szc-mobile-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .szc-mobile-drawer.is-open .szc-mobile-drawer__overlay {
    opacity: 1;
  }

  .szc-mobile-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    width: 85%;
    max-width: 380px;
    height: 100%;
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .szc-mobile-drawer.is-open .szc-mobile-drawer__panel {
    transform: translateX(0);
  }

  .szc-mobile-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #eeeeee;
  }

  .szc-mobile-drawer__title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #111111;
  }

  .szc-mobile-drawer__close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background-color 150ms ease;
  }

  .szc-mobile-drawer__close-btn:hover {
    background-color: #f5f5f5;
  }

  .szc-mobile-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
  }

  .szc-mobile-drawer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .szc-mobile-drawer__menu-item {
    border-bottom: 1px solid #f5f5f5;
  }

  .szc-mobile-drawer__link-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
  }

  .szc-mobile-drawer__link {
    display: block;
    padding: 8px 0;
    font-family: var(--szc-font-family-nav, var(--szc-font-family-body));
    font-size: 15px;
    font-weight: 700;
    color: #111111;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition: color 150ms ease;
  }

  .szc-mobile-drawer__link.is-sale-link {
    color: #d9381e !important;
  }

  .szc-mobile-drawer__accordion-toggle {
    background: transparent;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: #111111;
    transition: transform 200ms ease;
    display: flex;
    align-items: center;
  }

  .szc-mobile-drawer__chevron {
    width: 14px;
    height: 14px;
  }

  .szc-mobile-drawer__accordion-toggle.is-active {
    transform: rotate(180deg);
  }

  .szc-mobile-drawer__sub-menu {
    padding: 8px 0 16px 12px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid #f9f9f9;
  }

  /* Responsive Mega Menu Schema Section Styling */
  .szc-mob-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .szc-mob-section-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #888888;
    margin: 0 0 4px 0;
  }

  .szc-mob-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .szc-mob-link {
    font-size: 14px;
    font-weight: 600;
    color: #222222;
    text-decoration: none;
    display: block;
    transition: color 150ms ease;
  }

  .szc-mob-link:hover {
    color: #c86d51;
  }

  .szc-mob-sublinks-list {
    list-style: none;
    padding: 4px 0 0 12px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .szc-mob-sublink {
    font-size: 13px;
    font-weight: 400;
    color: #666666;
    text-decoration: none;
    display: block;
  }

  /* Responsive Products Grid */
  .szc-mob-products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .szc-mob-product-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #111111;
    background: #fafafa;
    border-radius: 8px;
    overflow: hidden;
    padding: 8px;
  }

  .szc-mob-prod-thumb {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: #f0f0f0;
    margin-bottom: 6px;
  }

  .szc-mob-prod-thumb img,
  .szc-mob-prod-thumb svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mob-prod-title {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 2px;
  }

  .szc-mob-prod-price {
    font-size: 11px;
    font-weight: 700;
    color: #555555;
  }

  /* Responsive Promo Card & Banner */
  .szc-mob-promo-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background: #f9f8f6;
    border-radius: 8px;
    text-decoration: none;
    color: #111111;
  }

  .szc-mob-promo-img {
    width: 50px;
    height: 50px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .szc-mob-promo-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mob-promo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .szc-mob-promo-sub {
    font-size: 13px;
    font-weight: 700;
  }

  .szc-mob-promo-link-btn {
    font-size: 11px;
    font-weight: 600;
    color: #c86d51;
    text-transform: uppercase;
  }

  .szc-mob-banner-card {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #111111;
    color: #ffffff;
    padding: 16px;
  }

  .szc-mob-banner-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }

  .szc-mob-banner-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-mob-banner-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .szc-mob-banner-sub {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .szc-mob-banner-title {
    font-family: var(--szc-font-family-heading, serif);
    font-size: 16px;
    font-weight: 700;
    margin: 0;
  }

  .szc-mob-banner-btn {
    display: inline-block;
    margin-top: 6px;
    padding: 6px 14px;
    background: #ffffff;
    color: #111111;
    font-size: 10px;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .szc-mobile-drawer__footer {
    padding: 16px 20px;
    border-top: 1px solid #eeeeee;
    background: #fafafa;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0.5;
  }

  .szc-mobile-drawer__footer-link {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    font-weight: 600;
    color: #333333;
    text-decoration: none;
  }

  @media (max-width: 989px) {
    .desktop-only {
      display: none !important;
    }
  }

  @media (min-width: 990px) {
    .mobile-only {
      display: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}

  function initHeader() {
    const menuItems = document.querySelectorAll('.szc-header__menu-item.has-mega-menu, .szc-header__menu-item.has-dropdown');
    menuItems.forEach(item => {
      let timer = null;

      item.addEventListener('mouseenter', () => {
        clearTimeout(timer);
        menuItems.forEach(other => {
          if (other !== item) other.classList.remove('is-hovered');
        });
        item.classList.add('is-hovered');
        const toggle = item.querySelector('.szc-header__menu-link');
        if (toggle) toggle.setAttribute('aria-expanded', 'true');
      });

      item.addEventListener('mouseleave', () => {
        timer = setTimeout(() => {
          item.classList.remove('is-hovered');
          const toggle = item.querySelector('.szc-header__menu-link');
          if (toggle) toggle.setAttribute('aria-expanded', 'false');
        }, 180);
      });

      item.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          item.classList.remove('is-hovered');
          const toggle = item.querySelector('.szc-header__menu-link');
          if (toggle) {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.focus();
          }
        }
      });
    });

    const subMenuItems = document.querySelectorAll('.szc-header__dropdown-item.has-submenu');
    subMenuItems.forEach(subItem => {
      const toggle = subItem.querySelector('.szc-header__dropdown-link');
      if (!toggle) return;

      subItem.addEventListener('mouseenter', () => {
        toggle.setAttribute('aria-expanded', 'true');
        subItem.classList.add('is-expanded');
      });

      subItem.addEventListener('mouseleave', () => {
        toggle.setAttribute('aria-expanded', 'false');
        subItem.classList.remove('is-expanded');
      });

      subItem.addEventListener('focusin', () => {
        toggle.setAttribute('aria-expanded', 'true');
        subItem.classList.add('is-expanded');
      });

      subItem.addEventListener('focusout', (e) => {
        if (!subItem.contains(e.relatedTarget)) {
          toggle.setAttribute('aria-expanded', 'false');
          subItem.classList.remove('is-expanded');
        }
      });

      subItem.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.stopPropagation();
          toggle.setAttribute('aria-expanded', 'false');
          subItem.classList.remove('is-expanded');
          toggle.focus();
        }
      });
    });

    const triggerBtns = document.querySelectorAll('[data-mobile-menu-trigger]');
    const drawer = document.getElementById('MobileMenuDrawer');
    const closeBtns = document.querySelectorAll('[data-mobile-menu-close]');

    if (drawer && triggerBtns.length > 0) {
      function openDrawer() {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      triggerBtns.forEach(btn => {
        btn.removeEventListener('click', openDrawer);
        btn.addEventListener('click', openDrawer);
      });
      closeBtns.forEach(btn => {
        btn.removeEventListener('click', closeDrawer);
        btn.addEventListener('click', closeDrawer);
      });

      const accordions = drawer.querySelectorAll('.szc-mobile-drawer__accordion-toggle');
      const menuItems = drawer.querySelectorAll('[data-mobile-tab-trigger]');
      const tabContents = drawer.querySelectorAll('[data-mobile-tab-content]');

      menuItems.forEach(item => {
        item.addEventListener('click', function(e) {
          const tabTarget = this.getAttribute('data-mobile-tab-trigger');
          if (tabTarget) {
            menuItems.forEach(mi => mi.classList.remove('is-active'));
            this.classList.add('is-active');

            tabContents.forEach(content => {
              if (content.getAttribute('data-mobile-tab-content') === tabTarget) {
                content.classList.add('is-active');
              } else {
                content.classList.remove('is-active');
              }
            });
          }
        });
      });

      accordions.forEach(toggle => {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          const menuItem = this.closest('.szc-mobile-drawer__menu-item');
          const subMenu = menuItem ? menuItem.querySelector('.szc-mobile-drawer__sub-menu') : null;
          if (subMenu) {
            const isOpen = subMenu.style.display !== 'none';
            subMenu.style.display = isOpen ? 'none' : 'flex';
            this.classList.toggle('is-active', !isOpen);
            this.setAttribute('aria-expanded', !isOpen);
          }
        });
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
          closeDrawer();
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target && (e.target.matches('.shopify-section-group-header-group') || e.target.querySelector('.szc-header') || (e.target.id && e.target.id.includes('header')))) {
      initHeader();
    }
  });
{% endjavascript %}

