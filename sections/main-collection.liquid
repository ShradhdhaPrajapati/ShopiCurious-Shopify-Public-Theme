  }

  .szc-collection-hero--align-center .szc-collection-hero__container {
    align-items: center;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .szc-collection-hero--align-right .szc-collection-hero__container {
    align-items: flex-end;
