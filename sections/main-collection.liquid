  /* ==========================================================================
     4. MAIN LAYOUT & STICKY SIDEBAR
     ========================================================================== */
  .szc-collection-layout {
    display: block;
    width: 100%;
  }

  .szc-collection-layout.has-sidebar {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 32px;
    align-items: start;
