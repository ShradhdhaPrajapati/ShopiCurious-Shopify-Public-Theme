  .szc-collection-hero__breadcrumbs .szc-breadcrumbs__link,
  .szc-collection-hero__breadcrumbs .szc-breadcrumbs__current,
  .szc-collection-hero__breadcrumbs .szc-breadcrumbs__separator {
