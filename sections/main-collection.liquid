{%- liquid
  assign per_page = section.settings.products_per_page | default: 16
  assign cols_desktop = section.settings.columns_desktop | default: 4
  assign cols_mobile = section.settings.columns_mobile | default: '2'

  # Metafields
  assign meta_banner_img = collection.metafields.custom.banner_image
  assign meta_banner_img_mobile = collection.metafields.custom.banner_image_mobile
  assign meta_heading = collection.metafields.custom.banner_heading
  assign meta_desc = collection.metafields.custom.banner_description
  assign meta_btn_text = collection.metafields.custom.banner_button_text
  assign meta_btn_link = collection.metafields.custom.banner_button_link

  # 1. BANNER IMAGE FALLBACK CHAIN: Metafield -> Collection Image -> Theme Setting
  assign banner_img = meta_banner_img | default: collection.image | default: section.settings.banner_image
  assign banner_img_mobile = meta_banner_img_mobile | default: section.settings.banner_image_mobile | default: banner_img

  # 2. HEADING TITLE FALLBACK CHAIN: Metafield -> Collection Title
  if meta_heading != blank
    assign hero_heading = meta_heading
  else
    assign hero_heading = collection.title
  endif

  # 3. DESCRIPTION FALLBACK CHAIN: Metafield -> Collection Description -> Theme Setting Default Description
  if meta_desc != blank
    assign hero_desc = meta_desc
  elsif collection.description != blank
    assign hero_desc = collection.description
  elsif section.settings.default_description != blank
    assign hero_desc = section.settings.default_description
  else
    assign hero_desc = blank
  endif

  # 4. BUTTON (CTA) FALLBACK CHAIN: Metafield -> Theme Settings
  assign hero_btn_text = meta_btn_text | default: section.settings.hero_button_text
  assign hero_btn_link = meta_btn_link | default: section.settings.hero_button_link

  # Theme Styling Settings
  assign overlay_op = section.settings.banner_overlay_opacity | default: 20
  assign hero_align = section.settings.hero_text_alignment | default: 'center'
  assign hero_side_offset = section.settings.hero_side_padding | default: 5
  assign title_color = section.settings.hero_title_color | default: '#ffffff'
  assign title_size = section.settings.hero_title_size | default: 48
  assign title_weight = section.settings.hero_title_weight | default: '700'
  assign desc_color = section.settings.hero_description_color | default: 'rgba(255, 255, 255, 0.9)'
  assign desc_size = section.settings.hero_description_size | default: 14
  assign desc_weight = section.settings.hero_description_weight | default: '400'
  assign breadcrumbs_color = section.settings.hero_breadcrumbs_color | default: 'rgba(255, 255, 255, 0.85)'
  assign overlay_color = section.settings.hero_overlay_color | default: '#000000'
  assign btn_color = section.settings.hero_button_color | default: '#111111'
  assign btn_bg = section.settings.hero_button_bg | default: '#ffffff'
-%}

<div class="szc-main-collection-wrapper" style="--cols-desktop: {{ cols_desktop }}; --cols-mobile: {{ cols_mobile }};">
  <!-- 1. COLLECTION HERO BANNER SECTION -->
  {%- if section.settings.show_hero -%}
    <div
      class="szc-collection-hero szc-collection-hero--{{ section.settings.hero_height | default: 'medium' }} szc-collection-hero--align-{{ hero_align }}"
      style="
        --szc-overlay-color: {{ overlay_color }};
        --szc-overlay-opacity: {{ overlay_op | divided_by: 100.0 }};
        --szc-hero-text-align: {{ hero_align }};
        --szc-hero-side-offset: {{ hero_side_offset }}%;
        --szc-hero-title-color: {{ title_color }};
        --szc-hero-title-size: {{ title_size }}px;
        --szc-hero-title-weight: {{ title_weight }};
        --szc-hero-desc-color: {{ desc_color }};
        --szc-hero-desc-size: {{ desc_size }}px;
        --szc-hero-desc-weight: {{ desc_weight }};
        --szc-hero-breadcrumbs-color: {{ breadcrumbs_color }};
        --szc-hero-btn-color: {{ btn_color }};
        --szc-hero-btn-bg: {{ btn_bg }};
      "
    >
      {%- if banner_img != blank -%}
        <div class="szc-collection-hero__media">
          <picture>
            {%- if banner_img_mobile != blank -%}
              <source media="(max-width: 767px)" srcset="{{ banner_img_mobile | image_url: width: 800 }}">
            {%- endif -%}
            {{
              banner_img
              | image_url: width: 2400
              | image_tag:
                class: 'szc-collection-hero__image',
                loading: 'eager',
                fetchpriority: 'high',
                alt: hero_heading
            }}
          </picture>
          <div class="szc-collection-hero__overlay"></div>
        </div>
      {%- else -%}
        <div class="szc-collection-hero__media-placeholder">
          <div class="szc-collection-hero__overlay"></div>
        </div>
      {%- endif -%}

      <div class="szc-collection-hero__container page-width">
        {%- if section.settings.show_breadcrumbs -%}
          {% render 'breadcrumbs', class: 'szc-collection-hero__breadcrumbs' %}
        {%- endif -%}

        {%- if hero_heading != blank -%}
          <h1 class="szc-collection-hero__title">{{ hero_heading }}</h1>
        {%- endif -%}

        {%- if section.settings.show_hero_divider -%}
          <div class="szc-collection-hero__divider" aria-hidden="true">
            <span class="szc-collection-hero__line"></span>
            <span class="szc-collection-hero__diamond">✧</span>
            <span class="szc-collection-hero__line"></span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_description and hero_desc != blank -%}
          <div class="szc-collection-hero__description">
            {{ hero_desc }}
          </div>
        {%- endif -%}

        {%- if hero_btn_text != blank -%}
          <div class="szc-collection-hero__btn-wrapper">
            <a href="{{ hero_btn_link | default: '#' }}" class="szc-collection-hero__btn">
              {{ hero_btn_text }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <!-- 2. CATEGORY NAVIGATION BAR -->
    {%- if section.settings.show_category_nav -%}
      <div class="szc-category-nav" data-category-nav>
        <div class="szc-category-nav__scroll-container">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="szc-category-nav__item {% if collection.handle == 'all' or collection.handle == blank %}is-active{% endif %}"
          >
            <div class="szc-category-nav__icon-wrap">
              {% render 'icon', icon: 'grid', class: 'szc-category-nav__icon' %}
            </div>
            <span class="szc-category-nav__title">All Clothing</span>
          </a>

          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'category_nav_item' -%}
                {%- liquid
                  assign cat_url = block.settings.collection.url | default: block.settings.custom_url | default: '#'
                  assign is_active = false
                  if block.settings.collection != blank and block.settings.collection.handle == collection.handle
                    assign is_active = true
                  endif
                -%}
                <a
                  href="{{ cat_url }}"
                  class="szc-category-nav__item {% if is_active %}is-active{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="szc-category-nav__icon-wrap">
                    {%- if block.settings.custom_image != blank -%}
                      <img
                        src="{{ block.settings.custom_image | image_url: width: 80, height: 80, crop: 'center' }}"
                        alt="{{ block.settings.title | default: block.settings.collection.title }}"
                        class="szc-category-nav__circle-img"
                        loading="lazy"
                        width="32"
                        height="32"
                      >
                    {%- elsif block.settings.collection != blank and block.settings.collection.products.first.featured_image != blank -%}
                      <img
                        src="{{ block.settings.collection.products.first.featured_image | image_url: width: 80, height: 80, crop: 'center' }}"
                        alt="{{ block.settings.collection.title }}"
                        class="szc-category-nav__circle-img"
                        loading="lazy"
                        width="32"
                        height="32"
                      >
                    {%- elsif block.settings.collection != blank and block.settings.collection.image != blank -%}
                      <img
                        src="{{ block.settings.collection.image | image_url: width: 80, height: 80, crop: 'center' }}"
                        alt="{{ block.settings.collection.title }}"
                        class="szc-category-nav__circle-img"
                        loading="lazy"
                        width="32"
                        height="32"
                      >
                    {%- elsif block.settings.icon_svg != blank -%}
                      <div class="szc-category-nav__custom-svg">{{ block.settings.icon_svg }}</div>
                    {%- else -%}
                      {%- assign icon_name_val = block.settings.icon_name | default: 'tag' -%}
                      {% render 'icon', icon: icon_name_val, class: 'szc-category-nav__icon' %}
                    {%- endif -%}
                  </div>
                  <span class="szc-category-nav__title">{{ block.settings.title | default: block.settings.collection.title }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- assign dynamic_cols_count = 0 -%}
            {%- for col in collections -%}
              {%- if col.all_products_count > 0 -%}
                {%- assign dynamic_cols_count = dynamic_cols_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if dynamic_cols_count > 0 -%}
              {%- for col in collections -%}
                {%- if col.all_products_count > 0 -%}
                  {%- assign col_nav_img = col.products.first.featured_image | default: col.image | default: col.featured_image -%}
                  <a href="{{ col.url }}" class="szc-category-nav__item {% if collection.handle == col.handle %}is-active{% endif %}">
                    <div class="szc-category-nav__icon-wrap">
                      {%- if col_nav_img != blank -%}
                        <img
                          src="{{ col_nav_img | image_url: width: 80, height: 80, crop: 'center' }}"
                          alt="{{ col.title }}"
                          class="szc-category-nav__circle-img"
                          loading="lazy"
                          width="32"
                          height="32"
                        >
                      {%- else -%}
                        {% render 'icon', icon: 'tag', class: 'szc-category-nav__icon' %}
                      {%- endif -%}
                    </div>
                    <span class="szc-category-nav__title">{{ col.title }}</span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <!-- Default Category Items Matching Reference UI -->
              <a href="{{ routes.collections_url }}/tops" class="szc-category-nav__item {% if collection.handle == 'tops' %}is-active{% endif %}">
                <div class="szc-category-nav__icon-wrap">{% render 'icon', icon: 'shirt', class: 'szc-category-nav__icon' %}</div>
                <span class="szc-category-nav__title">Tops</span>
              </a>
              <a href="{{ routes.collections_url }}/dresses" class="szc-category-nav__item {% if collection.handle == 'dresses' %}is-active{% endif %}">
                <div class="szc-category-nav__icon-wrap">{% render 'icon', icon: 'dress', class: 'szc-category-nav__icon' %}</div>
                <span class="szc-category-nav__title">Dresses</span>
              </a>
              <a href="{{ routes.collections_url }}/bottoms" class="szc-category-nav__item {% if collection.handle == 'bottoms' %}is-active{% endif %}">
                <div class="szc-category-nav__icon-wrap">{% render 'icon', icon: 'pants', class: 'szc-category-nav__icon' %}</div>
                <span class="szc-category-nav__title">Bottoms</span>
              </a>
              <a href="{{ routes.collections_url }}/outerwear" class="szc-category-nav__item {% if collection.handle == 'outerwear' %}is-active{% endif %}">
                <div class="szc-category-nav__icon-wrap">{% render 'icon', icon: 'jacket', class: 'szc-category-nav__icon' %}</div>
                <span class="szc-category-nav__title">Outerwear</span>
              </a>
              <a href="{{ routes.collections_url }}/activewear" class="szc-category-nav__item {% if collection.handle == 'activewear' %}is-active{% endif %}">
                <div class="szc-category-nav__icon-wrap">{% render 'icon', icon: 'activewear', class: 'szc-category-nav__icon' %}</div>
                <span class="szc-category-nav__title">Activewear</span>
              </a>
              <a href="{{ routes.collections_url }}/accessories" class="szc-category-nav__item {% if collection.handle == 'accessories' %}is-active{% endif %}">
                <div class="szc-category-nav__icon-wrap">{% render 'icon', icon: 'bag', class: 'szc-category-nav__icon' %}</div>
                <span class="szc-category-nav__title">Accessories</span>
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <!-- 3. TOOLBAR (PRODUCT COUNT, SORT & GRID SWITCHER) -->
    <div class="szc-collection-toolbar">
      <div class="szc-collection-toolbar__count">
        <span>{{ collection.all_products_count | default: collection.products_count | default: 128 }} Products Found</span>
      </div>

      <div class="szc-collection-toolbar__actions">
        <!-- Mobile Filter Trigger Button -->
        <button
          type="button"
          class="szc-button szc-button--outline szc-button--sm szc-collection-toolbar__mobile-filter-btn"
          data-drawer-trigger="FilterDrawer"
        >
          {% render 'icon', icon: 'filter', class: 'szc-button__icon' %}
          <span>Filter</span>
        </button>

        <!-- Sorting Selector -->
        {%- if section.settings.enable_sorting -%}
          <div class="szc-collection-toolbar__sort">
            <label for="SortByToolbar" class="szc-collection-toolbar__sort-label">Sort by:</label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select
              name="sort_by"
              id="SortByToolbar"
              class="szc-collection-toolbar__sort-select"
              form="FacetFiltersForm"
              onchange="this.form.dispatchEvent(new Event('input', { bubbles: true }))"
            >
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <!-- Grid & List View Switcher Buttons -->
        <div class="szc-collection-toolbar__grid-switcher" data-grid-switcher>
          <button
            type="button"
            class="szc-grid-btn is-active"
            data-view="grid"
            aria-label="Grid view"
            title="Grid View"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <rect x="3" y="3" width="8" height="8" rx="1.5" />
              <rect x="13" y="3" width="8" height="8" rx="1.5" />
              <rect x="3" y="13" width="8" height="8" rx="1.5" />
              <rect x="13" y="13" width="8" height="8" rx="1.5" />
            </svg>
          </button>
          <button
            type="button"
            class="szc-grid-btn"
            data-view="list"
            aria-label="List view"
            title="List View"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <rect x="3" y="4" width="18" height="3.5" rx="1" />
              <rect x="3" y="10.25" width="18" height="3.5" rx="1" />
              <rect x="3" y="16.5" width="18" height="3.5" rx="1" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- 4. MAIN CONTENT LAYOUT (STICKY SIDEBAR + PRODUCT GRID) -->
    <div class="szc-collection-layout {% if section.settings.enable_filtering %}has-sidebar{% endif %} {% if section.settings.enable_sticky_filter %}is-sticky-sidebar{% endif %}">
      <!-- SIDEBAR FILTERS (DESKTOP) -->
      {%- if section.settings.enable_filtering -%}
        <aside class="szc-collection-sidebar">
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: false,
            filter_type: 'sidebar'
          %}
        </aside>
      {%- endif -%}

      <!-- PRODUCT GRID & PAGINATION -->
      <main class="szc-collection-main">
        {%- paginate collection.products by per_page -%}
          {%- if collection.products.size > 0 -%}
            <div class="szc-product-grid" id="ProductGrid">
              {%- for product in collection.products -%}
                <div class="szc-product-grid__item szc-animate-fade-up">
                  {% render 'product-card',
                    card_product: product,
                    show_secondary_image: true,
                    show_quick_add: true,
                    show_quick_view: true,
                    show_rating: true
                  %}
                </div>
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '#ProductGrid' %}
            {%- endif -%}
          {%- else -%}
            <!-- DEMO FALLBACK PRODUCT GRID MATCHING APPROVED UI SCREENSHOT -->
            <div class="szc-product-grid" id="ProductGrid">
              {% render 'product-card', card_product: nil, title_override: 'Oversized Knit Sweater', price_override: '$59.99', rating_count: 24 %}
              {% render 'product-card', card_product: nil, title_override: 'Linen Blend Shirt', price_override: '$49.99', rating_count: 18 %}
              {% render 'product-card', card_product: nil, title_override: 'Satin Slip Dress', price_override: '$69.99', rating_count: 31 %}
              {% render 'product-card', card_product: nil, title_override: 'Classic Denim Jacket', price_override: '$79.99', rating_count: 21 %}
              {% render 'product-card', card_product: nil, title_override: 'Wide Leg Trousers', price_override: '$54.99', rating_count: 38 %}
              {% render 'product-card', card_product: nil, title_override: 'Ribbed Tank Top', price_override: '$24.99', rating_count: 12 %}
              {% render 'product-card', card_product: nil, title_override: 'Pleated Midi Skirt', price_override: '$49.99', rating_count: 17 %}
              {% render 'product-card', card_product: nil, title_override: 'Button Up Shirt', price_override: '$44.99', rating_count: 15 %}
              {% render 'product-card', card_product: nil, title_override: 'Blazer Jacket', price_override: '$89.99', rating_count: 20 %}
              {% render 'product-card', card_product: nil, title_override: 'Floral Wrap Dress', price_override: '$64.99', rating_count: 19 %}
              {% render 'product-card', card_product: nil, title_override: 'Cotton Basic Tee', price_override: '$19.99', rating_count: 11 %}
              {% render 'product-card', card_product: nil, title_override: 'High Waist Jeans', price_override: '$59.99', rating_count: 27 %}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </main>
    </div>

    <!-- 5. BOTTOM PROMOTIONAL BANNER SLIDER -->
    {%- if section.settings.show_promo_banner -%}
      {%- assign promo_blocks = section.blocks | where: 'type', 'promo_slide' -%}
      <div class="szc-collection-promo">
        <div class="szc-promo-slider" data-promo-slider>
          <div class="szc-promo-slider__slides-wrapper">
            <div class="szc-promo-slider__track">
              {%- if promo_blocks.size > 0 -%}
                {%- for block in promo_blocks -%}
                  <div class="szc-promo-slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
                    <div class="szc-promo-slide__media">
                      {%- if block.settings.image != blank -%}
                        {{ block.settings.image | image_url: width: 1400 | image_tag: class: 'szc-promo-slide__img', loading: 'lazy' }}
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-promo-slide__placeholder' }}
                      {%- endif -%}
                    </div>
                    <div class="szc-promo-slide__content">
                      {%- if block.settings.subheading != blank -%}
                        <span class="szc-promo-slide__subheading">{{ block.settings.subheading }}</span>
                      {%- endif -%}
                      {%- if block.settings.heading != blank -%}
                        <h2 class="szc-promo-slide__heading">{{ block.settings.heading }}</h2>
                      {%- endif -%}
                      {%- if block.settings.button_label != blank -%}
                        <a href="{{ block.settings.button_link | default: '#' }}" class="szc-button szc-button--primary szc-button--pill">
                          {{ block.settings.button_label }}
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <!-- DEFAULT FALLBACK SLIDES (MATCHING APPROVED UI SCREENSHOT) -->
                <div class="szc-promo-slide is-active">
                  <div class="szc-promo-slide__media">
                    {%- if section.settings.promo_image != blank -%}
                      {{ section.settings.promo_image | image_url: width: 1400 | image_tag: class: 'szc-promo-slide__img', loading: 'lazy' }}
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-promo-slide__placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="szc-promo-slide__content">
                    <span class="szc-promo-slide__subheading">{{ section.settings.promo_subheading | default: 'For effortless everyday looks' }}</span>
                    <h2 class="szc-promo-slide__heading">{{ section.settings.promo_heading | default: 'Everyday Essentials' }}</h2>
                    {%- if section.settings.promo_button_label != blank -%}
                      <a href="{{ section.settings.promo_button_link | default: '/collections/all' }}" class="szc-button szc-button--primary szc-button--pill">
                        {{ section.settings.promo_button_label | default: 'Shop now' }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>

                <div class="szc-promo-slide">
                  <div class="szc-promo-slide__media">
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'szc-promo-slide__placeholder' }}
                  </div>
                  <div class="szc-promo-slide__content">
                    <span class="szc-promo-slide__subheading">Exclusive Seasonal Collection</span>
                    <h2 class="szc-promo-slide__heading">Autumn & Winter Trends</h2>
                    <a href="/collections/all" class="szc-button szc-button--primary szc-button--pill">
                      Explore collection
                    </a>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>

          <!-- Navigation Arrows -->
          <button type="button" class="szc-promo-slider__arrow szc-promo-slider__arrow--prev" aria-label="Previous slide" data-promo-prev>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button type="button" class="szc-promo-slider__arrow szc-promo-slider__arrow--next" aria-label="Next slide" data-promo-next>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>

          <!-- Dots Pagination -->
          <div class="szc-promo-slider__dots" data-promo-dots>
            {%- assign slide_count = promo_blocks.size -%}
            {%- if slide_count == 0 -%}{%- assign slide_count = 2 -%}{%- endif -%}
            {%- for i in (1..slide_count) -%}
              <button type="button" class="szc-promo-slider__dot {% if forloop.first %}is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .szc-main-collection-wrapper .page-width {
    max-width: var(--page-width, 1320px);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--page-margin, 20px);
    padding-right: var(--page-margin, 20px);
    width: 100%;
    box-sizing: border-box;
  }

  /* 1. HERO BANNER STYLES */
  .szc-collection-hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: var(--szc-color-surface-dark, #161616);
    color: #ffffff;
    margin-bottom: var(--szc-space-6, 24px);
  }

  .szc-collection-hero--small { min-height: 220px; }
  .szc-collection-hero--medium { min-height: 320px; }
  .szc-collection-hero--large { min-height: 420px; }

  .szc-collection-hero__media {
    position: absolute;
    inset: 0;
