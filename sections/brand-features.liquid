{%- comment -%}
  ShopziCurious - Brand Features Section (Part 08)
  Displays brand trust pillars (Premium Fabrics, Ethically Made, etc.) matching the approved UI screenshot.
{%- endcomment -%}

<section id="BrandFeatures-{{ section.id }}" class="szc-brand-features-section page-width">
  <div class="szc-brand-features">
    <div class="szc-brand-features__grid">
      {%- for block in section.blocks -%}
        <div class="szc-brand-features__item" {{ block.shopify_attributes }}>
          <div class="szc-brand-features__icon-wrapper">
            {%- if block.settings.custom_icon != blank -%}
              {% render 'image',
                image: block.settings.custom_icon,
                aspect_ratio: '1/1',
                loading: 'lazy',
                class: 'szc-brand-features__custom-icon'
              %}
            {%- else -%}
              {% render 'icon',
                icon: block.settings.icon,
                class: 'szc-brand-features__icon'
              %}
            {%- endif -%}
          </div>

          <div class="szc-brand-features__text">
            {%- if block.settings.title != blank -%}
              <h3 class="szc-brand-features__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="szc-brand-features__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <!-- Default 4 Brand Features matching approved UI screenshot -->
        <div class="szc-brand-features__item">
          <div class="szc-brand-features__icon-wrapper">
            {% render 'icon', icon: 'fabric', class: 'szc-brand-features__icon' %}
          </div>
          <div class="szc-brand-features__text">
            <h3 class="szc-brand-features__title">Premium Fabrics</h3>
            <p class="szc-brand-features__subtitle">Soft, Durable & Sustainable</p>
          </div>
        </div>

        <div class="szc-brand-features__item">
          <div class="szc-brand-features__icon-wrapper">
            {% render 'icon', icon: 'diamond', class: 'szc-brand-features__icon' %}
          </div>
          <div class="szc-brand-features__text">
            <h3 class="szc-brand-features__title">Ethically Made</h3>
            <p class="szc-brand-features__subtitle">Fair Labor Practices</p>
          </div>
        </div>

        <div class="szc-brand-features__item">
          <div class="szc-brand-features__icon-wrapper">
            {% render 'icon', icon: 'shield-check', class: 'szc-brand-features__icon' %}
          </div>
          <div class="szc-brand-features__text">
            <h3 class="szc-brand-features__title">Made to Last</h3>
            <p class="szc-brand-features__subtitle">Timeless Designs</p>
          </div>
        </div>

        <div class="szc-brand-features__item">
          <div class="szc-brand-features__icon-wrapper">
            {% render 'icon', icon: 'user-heart', class: 'szc-brand-features__icon' %}
          </div>
          <div class="szc-brand-features__text">
            <h3 class="szc-brand-features__title">Trusted by 10,000+</h3>
            <p class="szc-brand-features__subtitle">Happy Customers</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .szc-brand-features-section {
    padding-top: var(--szc-space-8, 32px);
    padding-bottom: var(--szc-space-8, 32px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
    padding-left: var(--szc-space-6, 24px);
    padding-right: var(--szc-space-6, 24px);
  }

  .szc-brand-features {
    background-color: #f7f4ee;
    border-radius: 12px;
    padding: 24px 32px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .szc-brand-features__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 24px;
  }

  @media (min-width: 600px) {
    .szc-brand-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .szc-brand-features__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
    }
  }

  .szc-brand-features__item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .szc-brand-features__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .szc-brand-features__icon {
    width: 28px;
    height: 28px;
    color: #111111;
  }

  .szc-brand-features__custom-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .szc-brand-features__text {
    display: flex;
    flex-direction: column;
  }

  .szc-brand-features__title {
    margin: 0;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: #111111;
    line-height: 1.3;
  }

  .szc-brand-features__subtitle {
    margin: 2px 0 0 0;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 12px;
    color: #666666;
    line-height: 1.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Features",
  "tag": "section",
  "class": "section-brand-features",
  "max_blocks": 6,
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "fabric", "label": "Fabric / Lotus" },
            { "value": "diamond", "label": "Diamond / Ethical" },
            { "value": "shield-check", "label": "Shield / Quality" },
            { "value": "user-heart", "label": "User / Trust" },
            { "value": "bag", "label": "Shopping Bag" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "fabric"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "info": "Overrides selected SVG icon if provided"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Premium Fabrics",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "default": "Soft, Durable & Sustainable",
          "label": "Subtitle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "fabric",
            "title": "Premium Fabrics",
            "subtitle": "Soft, Durable & Sustainable"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "diamond",
            "title": "Ethically Made",
            "subtitle": "Fair Labor Practices"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shield-check",
            "title": "Made to Last",
            "subtitle": "Timeless Designs"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "user-heart",
            "title": "Trusted by 10,000+",
            "subtitle": "Happy Customers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
