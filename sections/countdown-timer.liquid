{%- liquid
  assign target_date = section.settings.target_date | default: '2026-12-31'
  assign target_time = section.settings.target_time | default: '23:59:59'
  assign heading = section.settings.heading | default: 'Limited Time Offer'
  assign subheading = section.settings.subheading | default: "Don't miss out! Special discounts end soon."
  assign button_label = section.settings.button_label | default: 'SHOP THE SALE'
  assign button_link = section.settings.button_link | default: '/collections/all'
  assign expired_msg = section.settings.expired_message | default: 'This promotion has ended.'
  assign bg_img = section.settings.bg_image
-%}

<section
  id="CountdownTimer-{{ section.id }}"
  class="szc-countdown-section page-width"
  aria-label="Countdown timer"
  style="
    --szc-cd-bg: {{ section.settings.bg_color | default: '#111111' }};
    --szc-cd-text: {{ section.settings.text_color | default: '#ffffff' }};
    --szc-cd-accent: {{ section.settings.accent_color | default: '#d4a373' }};
    --szc-cd-digit-bg: {{ section.settings.digit_bg_color | default: 'rgba(255, 255, 255, 0.1)' }};
    --szc-cd-pt: {{ section.settings.padding_top | default: 48 }}px;
    --szc-cd-pb: {{ section.settings.padding_bottom | default: 48 }}px;
  "
>
  <div
    class="szc-countdown-wrapper"
    data-countdown-timer
    data-target-date="{{ target_date }}"
    data-target-time="{{ target_time }}"
  >
    {%- if bg_img != blank -%}
      <div class="szc-countdown__bg">
        {{
          bg_img
          | image_url: width: 1920
          | image_tag: loading: 'lazy', class: 'szc-countdown__bg-img'
        }}
      </div>
    {%- endif -%}

    <div class="szc-countdown__header">
      {%- if heading != blank -%}
        <h2 class="szc-countdown__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="szc-countdown__subheading">{{ subheading }}</p>
      {%- endif -%}
    </div>

    <div class="szc-countdown__timer" role="region" aria-live="polite">
      <div class="szc-countdown__item">
        <span class="szc-countdown__digit" data-cd-days>00</span>
        <span class="szc-countdown__label">{{ 'general.countdown.days' | t: default: 'Days' }}</span>
      </div>
      <div class="szc-countdown__separator" aria-hidden="true">:</div>
      <div class="szc-countdown__item">
        <span class="szc-countdown__digit" data-cd-hours>00</span>
        <span class="szc-countdown__label">{{ 'general.countdown.hours' | t: default: 'Hours' }}</span>
      </div>
      <div class="szc-countdown__separator" aria-hidden="true">:</div>
      <div class="szc-countdown__item">
        <span class="szc-countdown__digit" data-cd-minutes>00</span>
        <span class="szc-countdown__label">{{ 'general.countdown.minutes' | t: default: 'Mins' }}</span>
      </div>
      <div class="szc-countdown__separator" aria-hidden="true">:</div>
      <div class="szc-countdown__item">
        <span class="szc-countdown__digit" data-cd-seconds>00</span>
        <span class="szc-countdown__label">{{ 'general.countdown.seconds' | t: default: 'Secs' }}</span>
      </div>
    </div>

    <div class="szc-countdown__expired-msg" data-cd-expired style="display: none;">
      <p>{{ expired_msg }}</p>
    </div>

    {%- if button_label != blank -%}
      <div class="szc-countdown__cta">
        <a href="{{ button_link }}" class="szc-button szc-countdown__btn">
          {{ button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .szc-countdown-section {
    padding-top: var(--szc-cd-pt, 48px);
    padding-bottom: var(--szc-cd-pb, 48px);
  }

  .szc-countdown-wrapper {
    position: relative;
    overflow: hidden;
    background-color: var(--szc-cd-bg, #111111);
    color: var(--szc-cd-text, #ffffff);
    border-radius: var(--szc-card-corner-radius, 12px);
    padding: 48px 32px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    box-sizing: border-box;
  }

  .szc-countdown__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .szc-countdown__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .szc-countdown__header,
  .szc-countdown__timer,
  .szc-countdown__expired-msg,
  .szc-countdown__cta {
    position: relative;
    z-index: 1;
  }

  .szc-countdown__header {
    max-width: 600px;
  }

  .szc-countdown__heading {
    font-family: var(--szc-font-family-heading);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    margin: 0 0 10px 0;
    color: var(--szc-cd-text, #ffffff);
    line-height: 1.25;
  }

  .szc-countdown__subheading {
    font-size: clamp(14px, 2vw, 16px);
    margin: 0;
    opacity: 0.85;
    line-height: 1.5;
  }

  .szc-countdown__timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 8px 0;
  }

  .szc-countdown__item {
    background: var(--szc-cd-digit-bg, rgba(255, 255, 255, 0.1));
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--szc-card-corner-radius, 8px);
    padding: 16px 20px;
    min-width: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .szc-countdown__digit {
    font-family: var(--szc-font-family-heading);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 700;
    line-height: 1;
    color: var(--szc-cd-accent, #d4a373);
  }

  .szc-countdown__label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 6px;
    opacity: 0.8;
  }

  .szc-countdown__separator {
    font-size: 32px;
    font-weight: 700;
    color: var(--szc-cd-accent, #d4a373);
    margin-top: -16px;
  }

  .szc-countdown__expired-msg {
    font-size: 18px;
    font-weight: 600;
    color: var(--szc-cd-accent, #d4a373);
  }

  .szc-countdown__cta {
    margin-top: 4px;
  }

  .szc-countdown__btn {
    background-color: var(--szc-cd-accent, #d4a373);
    color: #111111;
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .szc-countdown__btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .szc-countdown-wrapper {
      padding: 32px 16px;
      gap: 20px;
    }
    .szc-countdown__timer {
      gap: 6px;
    }
    .szc-countdown__item {
      min-width: 56px;
      padding: 12px 10px;
    }
    .szc-countdown__separator {
      font-size: 24px;
      margin-top: -12px;
    }
    .szc-countdown__label {
      font-size: 10px;
    }
  }

  @media (max-width: 360px) {
    .szc-countdown__item {
      min-width: 48px;
      padding: 10px 6px;
    }
    .szc-countdown__separator {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initCountdown(container) {
      const targetDateStr = container.getAttribute('data-target-date');
      const targetTimeStr = container.getAttribute('data-target-time') || '00:00:00';
      if (!targetDateStr) return;

      const targetIso = targetDateStr.trim() + 'T' + targetTimeStr.trim();
      const targetTime = new Date(targetIso).getTime();

      if (isNaN(targetTime)) return;

      const daysElem = container.querySelector('[data-cd-days]');
      const hoursElem = container.querySelector('[data-cd-hours]');
      const minsElem = container.querySelector('[data-cd-minutes]');
      const secsElem = container.querySelector('[data-cd-seconds]');
      const expiredElem = container.querySelector('[data-cd-expired]');

      function padZero(num) {
        return num < 10 ? '0' + num : num;
      }

      function update() {
        const now = new Date().getTime();
        const diff = targetTime - now;

        if (diff <= 0) {
          if (daysElem) daysElem.textContent = '00';
          if (hoursElem) hoursElem.textContent = '00';
          if (minsElem) minsElem.textContent = '00';
          if (secsElem) secsElem.textContent = '00';
          if (expiredElem) expiredElem.style.display = 'block';
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        if (daysElem) daysElem.textContent = padZero(days);
        if (hoursElem) hoursElem.textContent = padZero(hours);
        if (minsElem) minsElem.textContent = padZero(minutes);
        if (secsElem) secsElem.textContent = padZero(seconds);
      }

      update();
      const timerId = setInterval(update, 1000);

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.target.contains(container)) {
          clearInterval(timerId);
        }
      });
    }

    document.querySelectorAll('[data-countdown-timer]').forEach(initCountdown);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Countdown banner",
  "tag": "section",
  "class": "section-countdown-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Optional)"
    },
    {
      "type": "text",
      "id": "target_date",
      "label": "Target Date (YYYY-MM-DD)",
      "default": "2026-12-31",
      "info": "Format: YYYY-MM-DD (e.g. 2026-12-31)"
    },
    {
      "type": "text",
      "id": "target_time",
      "label": "Target Time (HH:MM:SS)",
      "default": "23:59:59",
      "info": "Format: 24-hour HH:MM:SS (e.g. 23:59:59)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Offer"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't miss out! Special discounts end soon."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP THE SALE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired Message",
      "default": "This promotion has ended."
    },
    {
      "type": "header",
      "content": "Color Customization"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4A373"
    },
    {
      "type": "color",
      "id": "digit_bg_color",
      "label": "Digit Box Background",
      "default": "rgba(255, 255, 255, 0.1)"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
