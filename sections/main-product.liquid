{% javascript %}
  function initProductPageGallery() {
    const sliderList = document.querySelector('[data-slider-list]');
    const slides = Array.from(document.querySelectorAll('.szc-main-product__slider-slide'));
    const thumbnailBtns = Array.from(document.querySelectorAll('.szc-main-product__thumbnail-btn'));
    const prevArrow = document.querySelector('[data-media-prev]');
    const nextArrow = document.querySelector('[data-media-next]');
    const thumbnailsList = document.querySelector('[data-thumbnails-list]');
    let activeIndex = 0;

    function scrollThumbnailIntoView(btn) {
      if (!thumbnailsList || !btn) return;
      const isDesktop = window.innerWidth >= 750;
      if (isDesktop) {
        const top = btn.offsetTop - thumbnailsList.clientHeight / 2 + btn.clientHeight / 2;
        thumbnailsList.scrollTo({ top, behavior: 'smooth' });
      } else {
        const left = btn.offsetLeft - thumbnailsList.clientWidth / 2 + btn.clientWidth / 2;
        thumbnailsList.scrollTo({ left, behavior: 'smooth' });
      }
    }

    function scrollToSlide(index) {
      if (slides.length === 0) return;
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      activeIndex = index;
      const targetSlide = slides[activeIndex];
      if (sliderList && targetSlide) {
        const targetLeft = targetSlide.offsetLeft > 0 ? targetSlide.offsetLeft : activeIndex * sliderList.clientWidth;
        sliderList.scrollTo({
          left: targetLeft,
          behavior: 'smooth',
        });
      }

      slides.forEach((s) => s.classList.remove('is-active'));
      if (targetSlide) targetSlide.classList.add('is-active');

      thumbnailBtns.forEach((b) => b.classList.remove('is-active'));
      const activeBtn = thumbnailBtns[activeIndex];
      if (activeBtn) {
        activeBtn.classList.add('is-active');
        scrollThumbnailIntoView(activeBtn);
      }
    }

    thumbnailBtns.forEach((btn, idx) => {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        scrollToSlide(idx);
      });
    });

    if (prevArrow) {
      prevArrow.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        scrollToSlide(activeIndex - 1);
      });
    }

    if (nextArrow) {
      nextArrow.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        scrollToSlide(activeIndex + 1);
      });
    }

    const thumbScrollUp = document.querySelector('[data-thumb-scroll-up]');
    const thumbScrollDown = document.querySelector('[data-thumb-scroll-down]');

    if (thumbScrollUp && thumbnailsList) {
      thumbScrollUp.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isDesktop = window.innerWidth >= 750;
        if (isDesktop) {
          thumbnailsList.scrollBy({ top: -160, behavior: 'smooth' });
        } else {
          thumbnailsList.scrollBy({ left: -160, behavior: 'smooth' });
        }
      });
    }

    if (thumbScrollDown && thumbnailsList) {
      thumbScrollDown.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isDesktop = window.innerWidth >= 750;
        if (isDesktop) {
          thumbnailsList.scrollBy({ top: 160, behavior: 'smooth' });
        } else {
          thumbnailsList.scrollBy({ left: 160, behavior: 'smooth' });
        }
      });
    }

    // Scroll listener on main slider to update thumbnail index on swipe
    if (sliderList && slides.length > 0) {
      let isScrolling;
      sliderList.addEventListener('scroll', () => {
        clearTimeout(isScrolling);
        isScrolling = setTimeout(() => {
          const scrollPos = sliderList.scrollLeft;
          const slideWidth = sliderList.clientWidth;
          if (slideWidth <= 0) return;
          const detectedIdx = Math.round(scrollPos / slideWidth);
          if (detectedIdx !== activeIndex && detectedIdx >= 0 && detectedIdx < slides.length) {
            activeIndex = detectedIdx;
            thumbnailBtns.forEach((b) => b.classList.remove('is-active'));
            if (thumbnailBtns[activeIndex]) {
              thumbnailBtns[activeIndex].classList.add('is-active');
              scrollThumbnailIntoView(thumbnailBtns[activeIndex]);
            }
          }
        }, 60);
      });
    }

    // Shopify Style Interactive Ultra High-Res Zoom Modal Lightbox
    const zoomBtn = document.querySelector('[data-zoom-btn]');
    const zoomModal = document.querySelector('[data-zoom-modal]');
    const zoomModalImg = document.getElementById('ZoomModalImg');
    const zoomViewport = document.querySelector('[data-zoom-viewport]');
    const zoomCounter = document.querySelector('[data-zoom-counter]');
    const zoomInBtn = document.querySelector('[data-zoom-in-btn]');
    const zoomOutBtn = document.querySelector('[data-zoom-out-btn]');
    const zoomClose = document.querySelector('[data-zoom-close]');
    const zoomPrev = document.querySelector('[data-zoom-prev]');
    const zoomNext = document.querySelector('[data-zoom-next]');
    let isZoomedIn = false;

    function openZoomModal(index) {
      if (!zoomModal || slides.length === 0) return;
      activeIndex = index;
      const targetSlide = slides[activeIndex];
      const targetBtn = thumbnailBtns[activeIndex];
      const zoomUrl =
        (targetSlide ? targetSlide.dataset.zoomUrl : null) || (targetBtn ? targetBtn.dataset.zoomUrl : null);
      const slideImg = targetSlide ? targetSlide.querySelector('img') : null;

      if (zoomModalImg) {
        zoomModalImg.src = zoomUrl || (slideImg ? slideImg.src : '');
      }
      if (zoomCounter) {
        zoomCounter.textContent = `${activeIndex + 1} / ${slides.length}`;
      }
      isZoomedIn = false;
      if (zoomViewport) {
        zoomViewport.classList.remove('is-zoomed');
        zoomViewport.scrollTop = 0;
      }
      zoomModal.classList.add('is-open');
      zoomModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeZoomModal() {
      if (!zoomModal) return;
      zoomModal.classList.remove('is-open');
      zoomModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function setZoomState(zoomed) {
      isZoomedIn = zoomed;
      if (zoomViewport) {
        if (isZoomedIn) {
          zoomViewport.classList.add('is-zoomed');
        } else {
          zoomViewport.classList.remove('is-zoomed');
          zoomViewport.scrollTop = 0;
        }
      }
    }

    if (zoomBtn) {
      zoomBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openZoomModal(activeIndex);
      });
    }

    slides.forEach((slide, idx) => {
      slide.addEventListener('click', () => {
        openZoomModal(idx);
      });
    });

    if (zoomInBtn)
      zoomInBtn.addEventListener('click', () => {
        setZoomState(true);
      });
    if (zoomOutBtn)
      zoomOutBtn.addEventListener('click', () => {
        setZoomState(false);
      });
    if (zoomViewport) {
      zoomViewport.addEventListener('click', (e) => {
        if (e.target === zoomModalImg) {
          setZoomState(!isZoomedIn);
        } else if (e.target === zoomViewport) {
          closeZoomModal();
        }
      });
    }

    if (zoomClose) zoomClose.addEventListener('click', closeZoomModal);

    if (zoomPrev) {
      zoomPrev.addEventListener('click', () => {
        let prevIdx = activeIndex - 1;
        if (prevIdx < 0) prevIdx = slides.length - 1;
        openZoomModal(prevIdx);
      });
    }

    if (zoomNext) {
      zoomNext.addEventListener('click', () => {
        let nextIdx = activeIndex + 1;
        if (nextIdx >= slides.length) nextIdx = 0;
        openZoomModal(nextIdx);
      });
    }

    document.addEventListener('keydown', (e) => {
      if (!zoomModal || !zoomModal.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeZoomModal();
      if (e.key === 'ArrowLeft' && zoomPrev) zoomPrev.click();
      if (e.key === 'ArrowRight' && zoomNext) zoomNext.click();
      if (e.key === '+' || e.key === '=') {
        setZoomState(true);
      }
      if (e.key === '-') {
        setZoomState(false);
      }
    });

    // Global Swatch Selection Text Update (Event Delegation for 100% Reliability)
    document.addEventListener('change', function (e) {
      if (e.target && e.target.classList.contains('szc-swatch__input')) {
        const optionName = e.target.name;
        const selectedSpan = document.querySelector(`[data-option-selected="${optionName}"]`);
        if (selectedSpan) {
          selectedSpan.textContent = e.target.value;
        }
      }
    });

    // Tabs Switcher Logic
    const tabBtns = document.querySelectorAll('.szc-tab-btn');
    const tabPanes = document.querySelectorAll('.szc-tab-pane');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        const targetId = this.dataset.tab;
        tabBtns.forEach((b) => b.classList.remove('is-active'));
        tabPanes.forEach((p) => p.classList.remove('is-active'));

        this.classList.add('is-active');
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.classList.add('is-active');
        }
      });
    });

    // Sticky ATC Bar IntersectionObserver
    const mainAddBtn = document.querySelector('[data-add-to-cart-btn]');
    const stickyBar = document.querySelector('[data-sticky-atc-bar]');
    const stickyBtn = document.querySelector('[data-sticky-atc-btn]');

    if (mainAddBtn && stickyBar) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              stickyBar.classList.add('is-visible');
            } else {
              stickyBar.classList.remove('is-visible');
            }
          });
        },
        { threshold: 0.1 }
      );

      observer.observe(mainAddBtn);
    }

    if (stickyBtn && mainAddBtn) {
      stickyBtn.addEventListener('click', (e) => {
        if (stickyBtn.classList.contains('szc-btn--loading') || stickyBtn.classList.contains('is-loading') || stickyBtn.disabled) return;
        stickyBtn.classList.add('szc-btn--loading', 'is-loading');
        stickyBtn.setAttribute('aria-disabled', 'true');
        stickyBtn.disabled = true;
        mainAddBtn.click();
      });

      const resetStickyState = () => {
        stickyBtn.classList.remove('szc-btn--loading', 'is-loading');
        stickyBtn.removeAttribute('aria-disabled');
        const textSpan = stickyBtn.querySelector('.szc-btn-text') || stickyBtn.querySelector('span');
        if (textSpan && textSpan.textContent.trim() !== 'SOLD OUT') {
          stickyBtn.disabled = false;
          textSpan.textContent = 'ADD TO BAG';
        }
      };

      if (window.ShopziCurious && window.ShopziCurious.pubsub && window.ShopziCurious.events) {
        window.ShopziCurious.pubsub.subscribe(window.ShopziCurious.events.CART_UPDATED, resetStickyState);
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductPageGallery);
  } else {
    initProductPageGallery();
  }
{% endjavascript %}

