  // Product Share Popover Web Component
  if (!customElements.get('product-share-popover')) {
    customElements.define(
      'product-share-popover',
      class ProductSharePopover extends HTMLElement {
        constructor() {
          super();
          this.trigger = this.querySelector('[data-share-trigger]');
          this.menu = this.querySelector('[data-share-menu]');
          if (!this.trigger || !this.menu) return;

          this.onTriggerClick = this.toggle.bind(this);
          this.onDocumentClick = this.onDocumentClick.bind(this);
          this.onKeyDown = this.onKeyDown.bind(this);
          this.onActionClick = this.onActionClick.bind(this);

          this.trigger.addEventListener('click', this.onTriggerClick);
          this.menu.addEventListener('click', this.onActionClick);
        }

        connectedCallback() {
          document.addEventListener('click', this.onDocumentClick);
          document.addEventListener('keydown', this.onKeyDown);
        }

        disconnectedCallback() {
          document.removeEventListener('click', this.onDocumentClick);
          document.removeEventListener('keydown', this.onKeyDown);
        }

        toggle(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          const isOpen = this.menu.classList.contains('is-open');
          if (isOpen) {
            this.close();
          } else {
            this.open();
          }
        }

        open() {
          this.menu.classList.add('is-open');
          this.trigger.classList.add('is-active');
          this.trigger.setAttribute('aria-expanded', 'true');
          this.menu.setAttribute('aria-hidden', 'false');
        }

        close() {
          this.menu.classList.remove('is-open');
          this.trigger.classList.remove('is-active');
          this.trigger.setAttribute('aria-expanded', 'false');
          this.menu.setAttribute('aria-hidden', 'true');
        }

        onDocumentClick(e) {
          if (!this.contains(e.target)) {
            this.close();
          }
        }

        onKeyDown(e) {
          if (e.key === 'Escape' && this.menu.classList.contains('is-open')) {
            this.close();
            this.trigger.focus();
          }
        }

        getUrl() {
          return this.dataset.shareUrl || window.location.href;
        }

        getTitle() {
          return this.dataset.shareTitle || document.title;
        }

        getImage() {
          return this.dataset.shareImg || '';
        }

        async onActionClick(e) {
          const item = e.target.closest('[data-share-action]');
          if (!item) return;

          const action = item.dataset.shareAction;
          const url = this.getUrl();
          const title = this.getTitle();
          const image = this.getImage();

          if (action === 'copy') {
            e.preventDefault();
            let copied = false;
            if (navigator.clipboard && navigator.clipboard.writeText) {
              try {
                await navigator.clipboard.writeText(url);
                copied = true;
              } catch (err) {
                copied = false;
              }
            }
            if (!copied) {
              try {
                const input = document.createElement('input');
                input.value = url;
                document.body.appendChild(input);
                input.select();
                document.execCommand('copy');
                document.body.removeChild(input);
                copied = true;
              } catch (err) {
                copied = false;
              }
            }

            const labelEl = item.querySelector('[data-copy-label]');
            const iconWrap = item.querySelector('[data-copy-icon-wrap]');
            if (labelEl) {
              const originalText = labelEl.textContent;
              const originalSvg = iconWrap ? iconWrap.innerHTML : '';
              labelEl.textContent = 'Link copied!';
              item.classList.add('szc-share-menu__item--copied');
              if (iconWrap) {
                iconWrap.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              }
              setTimeout(() => {
                labelEl.textContent = originalText;
                item.classList.remove('szc-share-menu__item--copied');
                if (iconWrap) iconWrap.innerHTML = originalSvg;
              }, 2000);
            }
          } else if (action === 'more') {
            e.preventDefault();
            if (navigator.share) {
              try {
                await navigator.share({
                  title: title,
                  text: title,
                  url: url
                });
                this.close();
              } catch (err) {
                // User cancelled or share dismissed
              }
            } else {
              const copyBtn = this.querySelector('[data-share-action="copy"]');
              if (copyBtn) copyBtn.click();
            }
          } else if (action === 'whatsapp') {
            e.preventDefault();
            const whatsappUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + url)}`;
            window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
            this.close();
          } else if (action === 'facebook') {
            e.preventDefault();
            const fbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
            window.open(fbUrl, '_blank', 'noopener,noreferrer');
            this.close();
          } else if (action === 'twitter') {
            e.preventDefault();
            const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
            window.open(twitterUrl, '_blank', 'noopener,noreferrer');
            this.close();
          } else if (action === 'pinterest') {
            e.preventDefault();
            const pinUrl = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&media=${encodeURIComponent(image)}&description=${encodeURIComponent(title)}`;
            window.open(pinUrl, '_blank', 'noopener,noreferrer');
            this.close();
          } else if (action === 'email') {
            this.close();
          }
        }
      }
    );
  }

  if (!customElements.get('recent-blog-carousel')) {
    customElements.define(
      'recent-blog-carousel',
