{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<section
  id="MainProduct-{{ section.id }}"
  class="szc-main-product page-width"
  data-product-handle="{{ product.handle }}"
>
  <script>
    (function recordViewedProduct() {
      function track() {
        try {
          const handle = {{ product.handle | json }};
          if (!handle) return;
          const key = 'szc_recently_viewed_products';
          let history = JSON.parse(localStorage.getItem(key) || '[]');
          history = history.filter(function(h) { return h !== handle; });
          history.unshift(handle);
          if (history.length > 15) {
            history = history.slice(0, 15);
          }
          localStorage.setItem(key, JSON.stringify(history));
          window.dispatchEvent(new CustomEvent('szc:recently-viewed-updated', { detail: { handle: handle } }));
        } catch (e) {}
      }
      track();
      window.addEventListener('pageshow', function(e) {
        if (e.persisted) {
          track();
        }
      });
    })();
  </script>
  {% render 'breadcrumbs' %}

  <div class="szc-main-product__grid" data-animate="slide-up">
    <!-- 1. Media Gallery Column (Vertical Thumbnails + Real Slider + Model Info) -->
    <div class="szc-main-product__media-col">
      <div class="szc-main-product__gallery-wrap szc-gallery-layout--{{ section.settings.gallery_layout | default: settings.gallery_layout | default: 'stacked' }}{% if product.media.size <= 1 %} szc-gallery-wrap--single-media{% endif %}">
        {%- if product.media.size > 1 -%}
          <div class="szc-main-product__thumbnails-col">
            {%- if product.media.size > 5 -%}
              <button
                type="button"
                class="szc-thumb-nav-btn szc-thumb-nav-btn--prev"
                aria-label="Scroll Thumbnails Previous"
                data-thumb-scroll-up
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="szc-thumb-nav-icon--desktop"
                >
                  <polyline points="18 15 12 9 6 15"></polyline>
                </svg>
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="szc-thumb-nav-icon--mobile"
                >
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
            {%- endif -%}

            <ul class="szc-main-product__thumbnails" role="list" data-thumbnails-list>
              {%- for media in product.media -%}
                <li class="szc-main-product__thumbnail-item">
                  <button
                    type="button"
                    class="szc-main-product__thumbnail-btn {% if media == featured_media %}is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    data-index="{{ forloop.index0 }}"
                    data-img-url="{{ media.preview_image | image_url: width: 1200 }}"
                    data-zoom-url="{{ media.preview_image | image_url: width: 2400 }}"
                  >
                    {% render 'image',
                      image: media.preview_image,
                      aspect_ratio: '1/1',
                      loading: 'lazy',
                      class: 'szc-main-product__thumbnail-img'
                    %}
                  </button>
                </li>
              {%- endfor -%}
            </ul>

            {%- if product.media.size > 5 -%}
              <button
                type="button"
                class="szc-thumb-nav-btn szc-thumb-nav-btn--next"
                aria-label="Scroll Thumbnails Next"
                data-thumb-scroll-down
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="szc-thumb-nav-icon--desktop"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="szc-thumb-nav-icon--mobile"
                >
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="szc-main-product__main-media-wrap">
          <div class="szc-main-product__slider-container" data-main-slider>
            <ul class="szc-main-product__slider-list" role="list" data-slider-list>
              {%- if product.media.size > 0 -%}
                {%- for media in product.media -%}
                  <li
                    class="szc-main-product__slider-slide {% if media == featured_media %}is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    data-index="{{ forloop.index0 }}"
                    data-zoom-url="{{ media.preview_image | image_url: width: 2400 }}"
                  >
                    {{
                      media.preview_image
                      | image_url: width: 1200
                      | image_tag: class: 'szc-main-product__slider-img', loading: 'eager', alt: media.alt
                      | default: product.title
                    }}
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="szc-main-product__slider-slide is-active" data-index="0">
                  {{ 'product-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
                </li>
              {%- endif -%}
            </ul>

            {%- if product.media.size > 1 -%}
              <button
                type="button"
                class="szc-media-arrow szc-media-arrow--prev"
                aria-label="Previous Image"
                data-media-prev
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button
                type="button"
                class="szc-media-arrow szc-media-arrow--next"
                aria-label="Next Image"
                data-media-next
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            {%- endif -%}

            <button type="button" class="szc-main-product__zoom-btn" aria-label="Zoom Image" data-zoom-btn>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Sticky Product Info Details Column -->
    <div class="szc-main-product__info-col">
      <!-- Top-Right Actions: Wishlist & Share Popover -->
      <div class="szc-main-product__top-actions">
        {%- if settings.enable_wishlist != false -%}
          <button
            type="button"
            class="szc-main-product__action-btn szc-main-product__wishlist-btn szc-main-product__wishlist-btn--top"
            data-wishlist-toggle
            data-product-handle="{{ product.handle }}"
            data-product-id="{{ current_variant.id | default: product.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ current_variant.price | default: product.price | money }}"
            data-product-compare-price="{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}"
            data-product-image="{% if product.featured_media != blank %}{{ product.featured_media | image_url: width: 600 }}{% endif %}"
            data-product-url="{{ product.url }}"
            data-product-vendor="{{ product.vendor | escape }}"
            data-product-available="{{ current_variant.available }}"
            aria-label="Add to Wishlist"
            title="Add to Wishlist"
          >
            <span class="szc-wishlist-icon-wrap">
              <svg
                class="szc-icon szc-icon--heart"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#111111"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </span>
          </button>
        {%- endif -%}

        <!-- New Floating Share Popover Component -->
        {%- assign share_prod_url = shop.url | append: product.url -%}
        {%- assign share_prod_title = product.title -%}
        {%- assign share_prod_img = '' -%}
        {%- if product.featured_media != blank -%}
          {%- assign share_prod_img = product.featured_media | image_url: width: 1200 -%}
        {%- endif -%}

        <product-share-popover
          class="szc-product-share-wrap"
          data-share-url="{{ share_prod_url }}"
          data-share-title="{{ share_prod_title | escape }}"
          data-share-img="{{ share_prod_img }}"
        >
          <button
            type="button"
            class="szc-main-product__action-btn szc-main-product__share-btn"
            id="SzcProductShareTrigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="SzcProductShareMenu"
            aria-label="Share this product"
            title="Share this product"
            data-share-trigger
          >
            <svg
              class="szc-icon szc-icon--share"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#111111"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </button>

          <div
            class="szc-share-menu"
            id="SzcProductShareMenu"
            role="menu"
            aria-hidden="true"
            data-share-menu
          >
            <button
              type="button"
              class="szc-share-menu__item szc-share-menu__item--copy"
              role="menuitem"
              data-share-action="copy"
            >
              <span class="szc-share-menu__icon szc-share-menu__icon--link" data-copy-icon-wrap>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                </svg>
              </span>
              <span class="szc-share-menu__label" data-copy-label>Copy link</span>
            </button>

            <a
              href="https://api.whatsapp.com/send?text={{ share_prod_title | url_encode }}%20{{ share_prod_url | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="szc-share-menu__item szc-share-menu__item--whatsapp"
              role="menuitem"
              data-share-action="whatsapp"
            >
              <span class="szc-share-menu__icon-badge szc-share-menu__icon-badge--whatsapp">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.05 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
              </span>
              <span class="szc-share-menu__label">WhatsApp</span>
            </a>

            <a
              href="https://www.facebook.com/sharer/sharer.php?u={{ share_prod_url | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="szc-share-menu__item szc-share-menu__item--facebook"
              role="menuitem"
              data-share-action="facebook"
            >
              <span class="szc-share-menu__icon-badge szc-share-menu__icon-badge--facebook">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </span>
              <span class="szc-share-menu__label">Facebook</span>
            </a>

            <a
              href="https://twitter.com/intent/tweet?text={{ share_prod_title | url_encode }}&url={{ share_prod_url | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="szc-share-menu__item szc-share-menu__item--twitter"
              role="menuitem"
              data-share-action="twitter"
            >
              <span class="szc-share-menu__icon-badge szc-share-menu__icon-badge--x">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </span>
              <span class="szc-share-menu__label">Twitter / X</span>
            </a>

            <a
              href="https://pinterest.com/pin/create/button/?url={{ share_prod_url | url_encode }}&media={{ share_prod_img | url_encode }}&description={{ share_prod_title | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="szc-share-menu__item szc-share-menu__item--pinterest"
              role="menuitem"
              data-share-action="pinterest"
            >
              <span class="szc-share-menu__icon-badge szc-share-menu__icon-badge--pinterest">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.364-.053.225-.174.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12 0z"/>
                </svg>
              </span>
              <span class="szc-share-menu__label">Pinterest</span>
            </a>

            <a
              href="mailto:?subject={{ share_prod_title | url_encode }}&body={{ share_prod_title | url_encode }}%0A%0A{{ share_prod_url | url_encode }}"
              class="szc-share-menu__item szc-share-menu__item--email"
              role="menuitem"
              data-share-action="email"
            >
              <span class="szc-share-menu__icon szc-share-menu__icon--email">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </span>
              <span class="szc-share-menu__label">Email</span>
            </a>

            <button
              type="button"
              class="szc-share-menu__item szc-share-menu__item--more"
              role="menuitem"
              data-share-action="more"
            >
              <span class="szc-share-menu__icon szc-share-menu__icon--more">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="1"></circle>
                  <circle cx="19" cy="12" r="1"></circle>
                  <circle cx="5" cy="12" r="1"></circle>
                </svg>
              </span>
              <span class="szc-share-menu__label">More options</span>
            </button>
          </div>
        </product-share-popover>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'badge' -%}
            <div class="szc-main-product__badge-wrap" {{ block.shopify_attributes }}>
              <span class="szc-main-product__badge">{{ block.settings.text | default: 'NEW ARRIVAL' }}</span>
            </div>

          {%- when 'vendor' -%}
            <div class="szc-main-product__vendor" {{ block.shopify_attributes }}>
              {{ product.vendor }}
            </div>

          {%- when 'title' -%}
            <h1 class="szc-main-product__title" {{ block.shopify_attributes }}>
              {{ product.title }}
            </h1>

          {%- when 'price' -%}
            <div class="szc-main-product__price-wrap" {{ block.shopify_attributes }}>
              <div class="szc-main-product__price">
                {% render 'price',
                  product: product,
                  use_variant: true,
                  variant: current_variant,
                  show_badges: false,
                  show_discount_badge: settings.show_discount_badge
                %}
              </div>
            </div>

          {%- when 'variant_picker' -%}
            <variant-selects
              class="szc-main-product__variants"
              data-section="{{ section.id }}"
              data-url="{{ product.url }}"
              {{ block.shopify_attributes }}
            >
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index0
                    assign opt_name_lower = option.name | downcase
                    assign is_color = false
                    assign is_size = false
                    if opt_name_lower contains 'color' or opt_name_lower contains 'colour'
                      assign is_color = true
                    elsif opt_name_lower contains 'size'
                      assign is_size = true
                    endif
                  -%}
                  <fieldset class="szc-main-product__option-fieldset">
                    <div class="szc-main-product__option-header">
                      <legend class="szc-main-product__option-legend">
                        {{ option.name | upcase }}:
                        <span class="szc-main-product__option-selected" data-option-selected="{{ option.name }}">
                          {{- option.selected_value -}}
                        </span>
                      </legend>
                      {%- if is_size -%}
                        {%- liquid
                          # Sourced directly from product.metafields.custom.size_guide_table / size_guide via render-tab-content
                          assign sg_button_mf = product.metafields.custom.size_guide_table | default: product.metafields.custom.size_guide
                        -%}
                        {%- capture sg_btn_content -%}
                          {% render 'render-tab-content', metafield: sg_button_mf %}
                        {%- endcapture -%}
                        {%- assign sg_btn_stripped = sg_btn_content | strip_html | strip -%}

                        {%- if sg_btn_content != blank and sg_btn_stripped != blank -%}
                          <button
                            type="button"
                            class="szc-size-guide-btn"
                            data-size-guide-trigger
                            aria-haspopup="dialog"
                            aria-expanded="false"
                            aria-controls="SizeGuideModal-{{ section.id }}"
                          >
                            <svg
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <path d="M2 12h20M2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6M6 12v-3M10 12v-2M14 12v-3M18 12v-2"/>
                            </svg>
                            <span>Size Guide</span>
                          </button>
                        {%- endif -%}
                      {%- endif -%}
                    </div>

                    <div class="szc-main-product__swatches-wrap">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_disabled = true
                          for variant in product.variants
                            if variant.options[option_index] == value and variant.available
                              assign option_disabled = false
                            endif
                          endfor
                          assign is_selected = false
                          if option.selected_value == value
                            assign is_selected = true
                          endif
                          assign swatch_kind = 'text'
                          if is_color
                            assign swatch_kind = 'color'
                          elsif is_size
                            assign swatch_kind = 'size'
                          endif
                        -%}
                        {%- assign swatch_dom_id = section.id
                          | append: '-'
                          | append: option.name
                          | handleize
                          | append: '-'
                          | append: value
                          | handleize
                        -%}
                        {% render 'swatch',
                          value: value,
                          type: swatch_kind,
                          name: option.name,
                          checked: is_selected,
                          disabled: option_disabled,
                          id: swatch_dom_id
                        %}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              {%- endunless -%}
              <script type="application/json">
                {{ product.variants | json }}
              </script>
            </variant-selects>

          {%- when 'quantity_selector' -%}

          {%- when 'buy_buttons' -%}
            <div class="szc-main-product__buy-buttons" {{ block.shopify_attributes }}>
              <product-form class="szc-product-form">
                {%- form 'product', product, id: 'product-form-main', class: 'szc-main-product__form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

                  <div class="szc-main-product__btn-row">
                    {%- assign qty_block = section.blocks | where: 'type', 'quantity_selector' | first -%}
                    {%- if qty_block != blank -%}
                      <div class="szc-main-product__quantity" {{ qty_block.shopify_attributes }}>
                        {%- assign qty_input_id = 'Quantity-' | append: section.id -%}
                        {% render 'quantity-input', value: 1, min: 1, id: qty_input_id %}
                      </div>
                    {%- endif -%}

                    {%- assign show_atc = true -%}
                    {%- if block.settings.show_add_to_cart != nil -%}
                      {%- assign show_atc = block.settings.show_add_to_cart -%}
                    {%- endif -%}

                    {%- if show_atc -%}
                      <button
                        type="submit"
                        name="add"
                        class="szc-button szc-button--primary szc-main-product__add-btn"
                        {% if current_variant.available == false %}
                          disabled
                        {% endif %}
                        data-add-to-cart-btn
                      >
                        <span class="szc-btn-text">
                          {%- if current_variant.available -%}
                            ADD TO BAG
                          {%- else -%}
                            SOLD OUT
                          {%- endif -%}
                        </span>
                      </button>
                    {%- endif -%}

                    {%- if block.settings.show_dynamic_checkout != false -%}
                      <button
                        type="button"
                        class="szc-button szc-button--outline szc-main-product__buy-now-btn"
                        data-buy-now-btn
                        {% if current_variant.available == false %}
                          disabled
                        {% endif %}
                      >
                        <span class="szc-btn-text">BUY IT NOW</span>
                      </button>
                    {%- endif -%}
                  </div>
                {%- endform -%}
              </product-form>
            </div>

          {%- when 'trust_badges' -%}
            {%- liquid
              assign icon_color = block.settings.icon_color | default: '#b07d4f'
              assign icon_size = block.settings.icon_size | default: 22
              assign title_color = block.settings.title_color | default: '#111111'
              assign title_size = block.settings.title_size | default: 12
              assign title_weight = block.settings.title_weight | default: '700'
              assign subtext_color = block.settings.subtext_color | default: '#666666'
              assign subtext_size = block.settings.subtext_size | default: 11
              assign subtext_weight = block.settings.subtext_weight | default: '400'
              assign bg_color = block.settings.bg_color | default: 'transparent'
              assign border_color = block.settings.border_color | default: 'transparent'
              assign border_radius = block.settings.border_radius | default: 0
            -%}
            <div
              class="szc-main-product__trust-badges"
              style="
                --tb-icon-color: {{ icon_color }};
                --tb-icon-size: {{ icon_size }}px;
                --tb-title-color: {{ title_color }};
                --tb-title-size: {{ title_size }}px;
                --tb-title-weight: {{ title_weight }};
                --tb-subtext-color: {{ subtext_color }};
                --tb-subtext-size: {{ subtext_size }}px;
                --tb-subtext-weight: {{ subtext_weight }};
                --tb-bg-color: {{ bg_color }};
                --tb-border-color: {{ border_color }};
                --tb-border-radius: {{ border_radius }}px;
              "
              {{ block.shopify_attributes }}
            >
              {%- for i in (1..3) -%}
                {%- liquid
                  assign title_key = 'badge_' | append: i | append: '_title'
                  assign subtext_key = 'badge_' | append: i | append: '_subtext'
                  assign icon_key = 'badge_' | append: i | append: '_icon'

                  assign trust_title_key = 'trust_badge_' | append: i | append: '_title'
                  assign trust_subtext_key = 'trust_badge_' | append: i | append: '_subtext'
                  assign trust_icon_key = 'trust_badge_' | append: i | append: '_icon'

                  assign b_title = settings[trust_title_key] | default: block.settings[title_key]
                  assign b_subtext = settings[trust_subtext_key] | default: block.settings[subtext_key]
                  assign b_icon = settings[trust_icon_key] | default: block.settings[icon_key]
                -%}
                {%- if b_title != blank or b_subtext != blank -%}
                  <div class="szc-trust-badge">
                    <div class="szc-trust-badge__icon">
                      {%- case b_icon -%}
                        {%- when 'returns' -%}
                          <svg
                            width="{{ icon_size }}"
                            height="{{ icon_size }}"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="{{ icon_color }}"
                            stroke-width="2"
                          >
                            <polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                          </svg>
                        {%- when 'secure' -%}
                          <svg
                            width="{{ icon_size }}"
                            height="{{ icon_size }}"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="{{ icon_color }}"
                            stroke-width="2"
                          >
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                          </svg>
                        {%- when 'shield' -%}
                          <svg
                            width="{{ icon_size }}"
                            height="{{ icon_size }}"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="{{ icon_color }}"
                            stroke-width="2"
                          >
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                          </svg>
                        {%- when 'star' -%}
                          <svg
                            width="{{ icon_size }}"
                            height="{{ icon_size }}"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="{{ icon_color }}"
                            stroke-width="2"
                          >
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                          </svg>
                        {%- when 'support' -%}
                          <svg
                            width="{{ icon_size }}"
                            height="{{ icon_size }}"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="{{ icon_color }}"
                            stroke-width="2"
                          >
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                          </svg>
                        {%- else -%}
                          <svg
                            width="{{ icon_size }}"
                            height="{{ icon_size }}"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="{{ icon_color }}"
                            stroke-width="2"
                          >
                            <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
                          </svg>
                      {%- endcase -%}
                    </div>
                    <div class="szc-trust-badge__text">
                      {%- if b_title != blank -%}
                        <strong>{{ b_title }}</strong>
                      {%- endif -%}
                      {%- if b_subtext != blank -%}
                        <span>{{ b_subtext }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="szc-main-product__description" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}

          {%- when 'share' -%}
            {%- comment -%} Old bottom share block removed per product-share-redesign requirement {%- endcomment -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
  {%- if section.settings.enable_product_tabs != false and tab_blocks.size > 0 -%}
    <!-- 4. Lower Content Area: Product Details Horizontal Tabs Card (Reference Matching) -->
    <div
      class="szc-product-tabs-card"
      style="--tab-nav-bg: {{ section.settings.tab_bg_color | default: '#111111' }};"
    >
      <div class="szc-product-tabs__header" role="tablist" aria-label="Product Information Tabs">
        {%- for block in tab_blocks -%}
          {%- liquid
            assign is_active = false
            if forloop.first
              assign is_active = true
            endif
          -%}
          <button
            type="button"
            role="tab"
            id="TabBtn-{{ block.id }}"
            class="szc-tab-btn{% if is_active %} is-active{% endif %}"
            aria-selected="{% if is_active %}true{% else %}false{% endif %}"
            aria-controls="TabPane-{{ block.id }}"
            tabindex="{% if is_active %}0{% else %}-1{% endif %}"
            data-tab="TabPane-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <span class="szc-tab-btn__text">{{ block.settings.heading | default: 'DETAILS' | upcase }}</span>
          </button>
        {%- endfor -%}
      </div>

      <div class="szc-product-tabs__content">
        {%- for block in tab_blocks -%}
          {%- liquid
            assign is_active = false
            if forloop.first
              assign is_active = true
            endif

            assign raw_content = block.settings.tab_content
            assign heading_upper = block.settings.heading | default: '' | upcase
            assign default_metafield = null

            if heading_upper contains 'FABRIC' or heading_upper contains 'CARE' or heading_upper contains 'MATERIAL'
              assign default_metafield = product.metafields.custom.care_instructions | default: product.metafields.custom.fabric_care | default: product.metafields.custom.fabric_and_care | default: product.metafields.custom.materials_care
              if raw_content == blank and default_metafield == blank
                assign raw_content = '<p>Hand wash cold or gentle machine wash with similar colors. Do not bleach or tumble dry. Dry flat in shade. Cool iron on reverse side if required.</p>'
              endif
            elsif heading_upper contains 'SIZE'
              assign default_metafield = product.metafields.custom.size_guide_table | default: product.metafields.custom.size_guide
              if raw_content == blank and default_metafield == blank
                assign raw_content = 'Size Chart not available. Please refer to the product description for sizing information.'
              endif
            elsif heading_upper contains 'SHIPPING' or heading_upper contains 'RETURN'
              assign default_metafield = product.metafields.custom.shipping_returns | default: product.metafields.custom.shipping_and_returns
              if raw_content == blank and default_metafield == blank
                assign raw_content = '<p>Orders are dispatched within 24-48 business hours. Complimentary standard delivery on all domestic orders over $100. Hassle-free 30-day return policy for unused items in original packaging.</p>'
              endif
            elsif heading_upper contains 'DESCRIPTION' or heading_upper contains 'DETAIL' or heading_upper contains 'FIT'
              if raw_content == blank
                assign raw_content = product.description
              endif
            endif
          -%}

          {%- capture rendered_content -%}
            {% render 'render-tab-content', content: raw_content, metafield: default_metafield %}
          {%- endcapture -%}

          <div
            id="TabPane-{{ block.id }}"
            class="szc-tab-pane{% if is_active %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="TabBtn-{{ block.id }}"
            tabindex="0"
            {% unless is_active %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if heading_upper contains 'DESCRIPTION' or heading_upper contains 'DETAIL' or heading_upper contains 'FIT' -%}
              <div class="szc-product-description-content">
                {{ rendered_content }}
              </div>
            {%- else -%}
              <div class="szc-tab-pane-table-wrapper">
                {{ rendered_content }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- liquid
    assign show_related_blog = true
    if section.settings.show_related_blog == false
      assign show_related_blog = false
    endif

    assign related_articles = product.metafields.custom.related_articles.value
    if related_articles == blank
      assign related_articles = product.metafields.custom['related_articles'].value
    endif

    assign valid_articles_count = 0
    if related_articles != blank
      for item in related_articles
        assign article = item.value | default: item
        if article.title != blank
          assign valid_articles_count = valid_articles_count | plus: 1
        endif
      endfor
    endif
  -%}

  <!-- 4.5 Product Related Blog Carousel (Home Page Recent Blog Posts Design) -->
  {%- if show_related_blog and valid_articles_count > 0 -%}
    <div
      class="szc-product-related-blog szc-recent-blog-posts"
      id="RecentBlogPosts-{{ section.id }}-related"
      data-animate="slide-up"
    >
      <div class="szc-recent-blog-posts__header">
        <div class="szc-recent-blog-posts__header-text">
          <h2 class="szc-recent-blog-posts__title">{{ section.settings.related_blog_heading | default: 'Related Blog' }}</h2>
        </div>

        {%- if valid_articles_count > 1 -%}
          <div class="szc-recent-blog-posts__nav" aria-label="Carousel navigation">
            <button
              type="button"
              class="szc-recent-blog-carousel__arrow szc-recent-blog-carousel__arrow--prev"
              aria-label="Previous articles"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="szc-recent-blog-carousel__arrow szc-recent-blog-carousel__arrow--next"
              aria-label="Next articles"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      <recent-blog-carousel
        class="szc-recent-blog-carousel"
        data-section-id="{{ section.id }}-related"
        data-autoplay="false"
        data-autoplay-speed="5000"
        style="--carousel-cols: 3; --carousel-cols-tablet: 2; --carousel-gap: 24px; --panel-bg: rgba(255, 255, 255, 0.72); --panel-blur: 18px;"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.related_blog_heading | default: 'Related Blog' }}"
      >
        <div class="szc-recent-blog-carousel__viewport">
          <div class="szc-recent-blog-carousel__track" id="RecentBlogPostsGrid-{{ section.id }}-related">
            {%- assign slide_index = 0 -%}
            {%- for item in related_articles -%}
              {%- assign article = item.value | default: item -%}
              {%- if article.title != blank -%}
                {%- liquid
                  assign words = article.content | default: article.excerpt | strip_html | split: ' ' | size
                  assign read_mins = words | divided_by: 200 | at_least: 1
                -%}
                <div
                  class="szc-recent-blog-carousel__slide"
                  data-slide-index="{{ slide_index }}"
                  role="group"
                  aria-roledescription="slide"
                  aria-label="{{ slide_index | plus: 1 }} of {{ valid_articles_count }}"
                >
                  <article class="szc-blog-card">
                    <a href="{{ article.url }}" class="szc-blog-card__link" aria-label="{{ article.title | escape }}">
                      <div class="szc-blog-card__media">
                        {%- if article.image -%}
                          {{
                            article.image
                            | image_url: width: 900
                            | image_tag:
                              class: 'szc-blog-card__img',
                              loading: 'lazy',
                              alt: article.title,
                              widths: '400, 600, 800, 1000'
                          }}
                        {%- else -%}
                          <div class="szc-blog-card__placeholder" aria-hidden="true">
                            {{ 'lifestyle-1' | placeholder_svg_tag: 'szc-blog-card__placeholder-svg' }}
                          </div>
                        {%- endif -%}
                      </div>

                      <div class="szc-blog-card__panel">
                        <div class="szc-blog-card__meta">
                          <span class="szc-blog-card__badge">
                            {%- if article.tags.size > 0 -%}
                              {{ article.tags.first | capitalize }}
                            {%- else -%}
                              {{ article.blog.title | default: 'Blog' | capitalize }}
                            {%- endif -%}
                          </span>

                          {%- if article.published_at -%}
                            <span class="szc-blog-card__dot" aria-hidden="true">•</span>
                            <time class="szc-blog-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                              {{ article.published_at | date: "%b %d, %Y" }}
                            </time>
                          {%- endif -%}

                          <span class="szc-blog-card__dot" aria-hidden="true">•</span>
                          <span class="szc-blog-card__read-time">{{ read_mins }} mins read</span>
                        </div>

                        <h3 class="szc-blog-card__title">{{ article.title }}</h3>

                        <div class="szc-blog-card__bottom">
                          {%- assign article_excerpt = article.excerpt_or_content | default: article.excerpt | default: article.content | strip_html | truncate: 110 -%}
                          <p class="szc-blog-card__excerpt">
                            {{ article_excerpt | default: 'Discover the full story, inspiration, and styling insights.' }}
                          </p>

                          <span class="szc-blog-card__arrow-btn" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="5" y1="12" x2="19" y2="12"></line>
                              <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                          </span>
                        </div>
                      </div>
                    </a>
                  </article>
                </div>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </recent-blog-carousel>
    </div>
  {%- endif -%}

  <!-- 5. Sticky Add To Cart Bottom Bar -->
  {%- if settings.enable_sticky_add_to_cart != false -%}
    <div class="szc-sticky-atc-bar" data-sticky-atc-bar>
      <div class="szc-sticky-atc-bar__container page-width">
        <div class="szc-sticky-atc-bar__product">
          <div class="szc-sticky-atc-bar__img-wrap">
            {%- if featured_media != blank -%}
              {{
                featured_media.preview_image
                | image_url: width: 120
                | image_tag: class: 'szc-sticky-atc-bar__img', data-sticky-img: ''
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'szc-sticky-atc-bar__img' }}
            {%- endif -%}
          </div>
          <div class="szc-sticky-atc-bar__info">
            <h4 class="szc-sticky-atc-bar__title">{{ product.title }}</h4>
            <div class="szc-sticky-atc-bar__price-wrap" data-sticky-price-wrap>
              <div class="szc-sticky-atc-bar__price" data-sticky-price>
                <span class="szc-price__item--sale">{{ current_variant.price | money }}</span>
                <s
                  class="szc-price__item--regular"
                  {% if current_variant.compare_at_price <= current_variant.price %}
                    style="display:none;"
                  {% endif %}
                >
                  {{ current_variant.compare_at_price | money }}
                </s>
              </div>
            </div>
          </div>
        </div>
        <div class="szc-sticky-atc-bar__actions">
          <button
            type="button"
            class="szc-button szc-button--outline szc-sticky-buy-now-btn"
            data-sticky-buy-now-btn
            data-buy-now-btn
            {% if current_variant.available == false %}
              disabled
            {% endif %}
          >
            <span class="szc-btn-text">BUY IT NOW</span>
          </button>
          <button
            type="button"
            class="szc-button szc-button--primary szc-sticky-atc-btn"
            data-sticky-atc-btn
            {% if current_variant.available == false %}
              disabled
            {% endif %}
          >
            <span class="szc-btn-text">
              {%- if current_variant.available -%}
                ADD TO BAG
              {%- else -%}
                SOLD OUT
              {%- endif -%}
            </span>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<!-- 5.5 Reusable Size Guide Modal Popup -->
{%- liquid
  # Size Guide Modal Popup Markup & Content Sourcing
  # Note: Intentionally reuses the exact same product Size Guide metafield as the lower Size Guide tab
  assign sg_modal_mf = product.metafields.custom.size_guide_table | default: product.metafields.custom.size_guide
-%}
{%- capture sg_modal_content -%}
  {% render 'render-tab-content', metafield: sg_modal_mf %}
{%- endcapture -%}
{%- assign sg_modal_stripped = sg_modal_content | strip_html | strip -%}

{%- if sg_modal_content != blank and sg_modal_stripped != blank -%}
  <!-- Size Guide Popup Dialog (Reuses product.metafields.custom.size_guide_table / size_guide) -->
  <div
    class="szc-size-guide-modal"
    id="SizeGuideModal-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="Size Guide"
    aria-hidden="true"
    data-size-guide-modal
  >
    <div class="szc-size-guide-modal__backdrop" data-size-guide-close></div>
    <div class="szc-size-guide-modal__dialog">
      <div class="szc-size-guide-modal__header">
        <h3 class="szc-size-guide-modal__title">SIZE GUIDE</h3>
        <button
          type="button"
          class="szc-size-guide-modal__close"
          aria-label="Close Size Guide"
          data-size-guide-close
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="szc-size-guide-modal__body">
        <div class="szc-tab-pane-table-wrapper">
          {{ sg_modal_content }}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<!-- 6. Shopify Style Native Zoom Modal Lightbox (Crystal Clear Ultra High-Res + Top-to-Bottom Scrollable) -->
<div class="szc-zoom-modal" id="ProductZoomModal" aria-hidden="true" data-zoom-modal>
  <div class="szc-zoom-modal__header">
    <span class="szc-zoom-modal__counter" data-zoom-counter>1 / {{ product.media.size }}</span>
    <div class="szc-zoom-modal__controls">
      <button
        type="button"
        class="szc-zoom-modal__ctrl-btn"
        aria-label="Zoom In"
        data-zoom-in-btn
        title="Zoom In (+)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
      </button>
      <button
        type="button"
        class="szc-zoom-modal__ctrl-btn"
        aria-label="Zoom Out"
        data-zoom-out-btn
        title="Zoom Out (-)"
      >
