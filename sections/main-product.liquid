{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<section id="MainProduct-{{ section.id }}" class="szc-main-product page-width">
  {% render 'breadcrumbs' %}

  <div class="szc-main-product__grid">
    <!-- 1. Media Gallery Column (Vertical Thumbnails + Real Slider + Model Info) -->
    <div class="szc-main-product__media-col">
      <div class="szc-main-product__gallery-wrap">
        {%- if product.media.size > 1 -%}
          <div class="szc-main-product__thumbnails-col">
            <ul class="szc-main-product__thumbnails" role="list" data-thumbnails-list>
              {%- for media in product.media -%}
                <li class="szc-main-product__thumbnail-item">
                  <button
                    type="button"
                    class="szc-main-product__thumbnail-btn {% if media == featured_media %}is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    data-index="{{ forloop.index0 }}"
                    data-img-url="{{ media.preview_image | image_url: width: 1200 }}"
                    data-zoom-url="{{ media.preview_image | image_url: width: 2400 }}"
                  >
                    {% render 'image',
                      image: media.preview_image,
                      aspect_ratio: '1/1',
                      loading: 'lazy',
                      class: 'szc-main-product__thumbnail-img'
                    %}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
            {%- if product.media.size > 5 -%}
              <button type="button" class="szc-thumb-nav-btn" aria-label="Scroll Thumbnails Down" data-thumb-scroll-down>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="szc-main-product__main-media-wrap">
          <div class="szc-main-product__slider-container" data-main-slider>
            <ul class="szc-main-product__slider-list" role="list" data-slider-list>
              {%- if product.media.size > 0 -%}
                {%- for media in product.media -%}
                  <li 
                    class="szc-main-product__slider-slide {% if media == featured_media %}is-active{% endif %}" 
                    data-media-id="{{ media.id }}" 
                    data-index="{{ forloop.index0 }}"
                    data-zoom-url="{{ media.preview_image | image_url: width: 2400 }}"
                  >
                    {{ media.preview_image | image_url: width: 1200 | image_tag: class: 'szc-main-product__slider-img', loading: 'eager', alt: media.alt | default: product.title }}
                  </li>
                {%- endfor -%}
              {%- else -%}
                <li class="szc-main-product__slider-slide is-active" data-index="0">
                  {{ 'product-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
                </li>
              {%- endif -%}
            </ul>

            {%- if product.media.size > 1 -%}
              <button type="button" class="szc-media-arrow szc-media-arrow--prev" aria-label="Previous Image" data-media-prev>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <button type="button" class="szc-media-arrow szc-media-arrow--next" aria-label="Next Image" data-media-next>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            {%- endif -%}

            <button type="button" class="szc-main-product__zoom-btn" aria-label="Zoom Image" data-zoom-btn>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="14"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Sticky Product Info Details Column -->
    <div class="szc-main-product__info-col">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'badge' -%}
            <div class="szc-main-product__badge-wrap" {{ block.shopify_attributes }}>
              <span class="szc-main-product__badge">{{ block.settings.text | default: 'NEW ARRIVAL' }}</span>
            </div>

          {%- when 'vendor' -%}
            <div class="szc-main-product__vendor" {{ block.shopify_attributes }}>
              {{ product.vendor }}
            </div>

          {%- when 'title' -%}
            <h1 class="szc-main-product__title" {{ block.shopify_attributes }}>
              {{ product.title }}
            </h1>

          {%- when 'price' -%}
            <div class="szc-main-product__price-wrap" {{ block.shopify_attributes }}>
              <div class="szc-main-product__price">
                {% render 'price',
                  product: product,
                  use_variant: true,
                  variant: current_variant,
                  show_badges: false
                %}
              </div>
            </div>

          {%- when 'rating' -%}
            {%- if product.metafields.reviews.rating.value != blank -%}
              {%- liquid
                assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | plus: 0
                assign rating_count = product.metafields.reviews.rating_count.value | default: 0
              -%}
              <div class="szc-main-product__rating-block" {{ block.shopify_attributes }}>
                <span class="szc-stars">★★★★★</span>
                <span class="szc-rating-val">{{ rating_val | round: 1 }}</span>
                <span class="szc-rating-count">({{ rating_count }} {% if rating_count == 1 %}Review{% else %}Reviews{% endif %})</span>
              </div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            <variant-selects
              class="szc-main-product__variants"
              data-section="{{ section.id }}"
              data-url="{{ product.url }}"
              {{ block.shopify_attributes }}
            >
              {%- unless product.has_only_default_variant -%}
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index0
                    assign opt_name_lower = option.name | downcase
                    assign is_color = false
                    assign is_size = false
                    if opt_name_lower contains 'color' or opt_name_lower contains 'colour'
                      assign is_color = true
                    elsif opt_name_lower contains 'size'
                      assign is_size = true
                    endif
                  -%}
                  <fieldset class="szc-main-product__option-fieldset">
                    <div class="szc-main-product__option-header">
                      <legend class="szc-main-product__option-legend">
                        {{ option.name | upcase }}: <span class="szc-main-product__option-selected" data-option-selected="{{ option.name }}">{{ option.selected_value }}</span>
                      </legend>
                      {%- if is_size -%}
                        <button type="button" class="szc-size-guide-btn" data-size-guide-trigger>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20M2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6M6 12v-3M10 12v-2M14 12v-3M18 12v-2"/></svg>
                          <span>Size Guide</span>
                        </button>
                      {%- endif -%}
                    </div>

                    <div class="szc-main-product__swatches-wrap">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_disabled = true
                          for variant in product.variants
                            if variant.options[option_index] == value and variant.available
                              assign option_disabled = false
                            endif
                          endfor
                          assign is_selected = false
                          if option.selected_value == value
                            assign is_selected = true
                          endif
                          assign swatch_kind = 'text'
                          if is_color
                            assign swatch_kind = 'color'
                          elsif is_size
                            assign swatch_kind = 'size'
                          endif
                        -%}
                        {%- assign swatch_dom_id = section.id | append: '-' | append: option.name | handleize | append: '-' | append: value | handleize -%}
                        {% render 'swatch',
                          value: value,
                          type: swatch_kind,
                          name: option.name,
                          checked: is_selected,
                          disabled: option_disabled,
                          id: swatch_dom_id
                        %}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              {%- endunless -%}
              <script type="application/json">
                {{ product.variants | json }}
              </script>
            </variant-selects>

          {%- when 'quantity_selector' -%}
            <div class="szc-main-product__quantity" {{ block.shopify_attributes }}>
              {%- assign qty_input_id = 'Quantity-' | append: section.id -%}
              {% render 'quantity-input', value: 1, min: 1, id: qty_input_id %}
            </div>

          {%- when 'buy_buttons' -%}
            <div class="szc-main-product__buy-buttons" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'product-form-main', class: 'szc-main-product__form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

                <div class="szc-main-product__btn-row">
                  <button
                    type="submit"
                    name="add"
                    class="szc-button szc-button--primary szc-main-product__add-btn"
                    {% if current_variant.available == false %}disabled{% endif %}
                    data-add-to-cart-btn
                  >
                    <span>
                      {%- if current_variant.available -%}
                        ADD TO BAG
                      {%- else -%}
                        SOLD OUT
                      {%- endif -%}
                    </span>
                  </button>

                  <button type="button" class="szc-main-product__wishlist-btn" aria-label="Add to Wishlist">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                </div>

                <button type="button" class="szc-button szc-button--outline szc-main-product__buy-now-btn">
                  BUY IT NOW
                </button>
              {%- endform -%}
            </div>

          {%- when 'trust_badges' -%}
            {%- liquid
              assign icon_color = block.settings.icon_color | default: '#b07d4f'
              assign icon_size = block.settings.icon_size | default: 22
              assign title_color = block.settings.title_color | default: '#111111'
              assign title_size = block.settings.title_size | default: 12
              assign title_weight = block.settings.title_weight | default: '700'
              assign subtext_color = block.settings.subtext_color | default: '#666666'
              assign subtext_size = block.settings.subtext_size | default: 11
              assign subtext_weight = block.settings.subtext_weight | default: '400'
              assign bg_color = block.settings.bg_color | default: 'transparent'
              assign border_color = block.settings.border_color | default: 'transparent'
              assign border_radius = block.settings.border_radius | default: 0
            -%}
            <div
              class="szc-main-product__trust-badges"
              style="
                --tb-icon-color: {{ icon_color }};
                --tb-icon-size: {{ icon_size }}px;
                --tb-title-color: {{ title_color }};
                --tb-title-size: {{ title_size }}px;
                --tb-title-weight: {{ title_weight }};
                --tb-subtext-color: {{ subtext_color }};
                --tb-subtext-size: {{ subtext_size }}px;
                --tb-subtext-weight: {{ subtext_weight }};
                --tb-bg-color: {{ bg_color }};
                --tb-border-color: {{ border_color }};
                --tb-border-radius: {{ border_radius }}px;
              "
              {{ block.shopify_attributes }}
            >
              {%- for i in (1..3) -%}
                {%- liquid
                  assign title_key = 'badge_' | append: i | append: '_title'
                  assign subtext_key = 'badge_' | append: i | append: '_subtext'
                  assign icon_key = 'badge_' | append: i | append: '_icon'
                  assign b_title = block.settings[title_key]
                  assign b_subtext = block.settings[subtext_key]
                  assign b_icon = block.settings[icon_key]
                -%}
                {%- if b_title != blank or b_subtext != blank -%}
                  <div class="szc-trust-badge">
                    <div class="szc-trust-badge__icon">
                      {%- case b_icon -%}
                        {%- when 'returns' -%}
                          <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ icon_color }}" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                        {%- when 'secure' -%}
                          <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ icon_color }}" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        {%- when 'star' -%}
                          <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ icon_color }}" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        {%- when 'support' -%}
                          <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ icon_color }}" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        {%- else -%}
                          <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ icon_color }}" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                      {%- endcase -%}
                    </div>
                    <div class="szc-trust-badge__text">
                      {%- if b_title != blank -%}
                        <strong>{{ b_title }}</strong>
                      {%- endif -%}
                      {%- if b_subtext != blank -%}
                        <span>{{ b_subtext }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="szc-main-product__description" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- 4. Product Details Tabs Section (Reference Exact Copy) -->
  <div class="szc-product-tabs">
    <div class="szc-product-tabs__header" role="tablist">
      <button type="button" class="szc-tab-btn is-active" data-tab="tab-description">DESCRIPTION</button>
      <button type="button" class="szc-tab-btn" data-tab="tab-fabric">FABRIC & CARE</button>
      <button type="button" class="szc-tab-btn" data-tab="tab-size">SIZE GUIDE</button>
      <button type="button" class="szc-tab-btn" data-tab="tab-shipping">SHIPPING & RETURNS</button>
    </div>

    <div class="szc-product-tabs__content">
      <!-- Tab 1: Description -->
      <div id="tab-description" class="szc-tab-pane is-active">
        <div class="szc-tab-pane__grid">
          <div class="szc-tab-pane__left">
            <p>A timeless essential, this classic denim jacket is crafted from premium cotton with a comfortable, regular fit. Designed for everyday wear, it features button front closures, chest pockets, and a versatile light blue wash that pairs effortlessly with any outfit.</p>
            <ul class="szc-tab-bullets">
              <li>Regular fit</li>
              <li>Button front closure</li>
              <li>Chest flap pockets</li>
              <li>Side welt pockets</li>
              <li>Adjustable button tabs at hem</li>
              <li>Lightweight & durable denim</li>
            </ul>
          </div>
          <div class="szc-tab-pane__right">
            <div class="szc-tab-card">
              <h4 class="szc-tab-card__title">FABRIC & CARE</h4>
              <p class="szc-tab-card__sub">100% Cotton Denim</p>
              <div class="szc-care-icons-grid">
                <div class="szc-care-item">
                  <span class="szc-care-icon">🧺</span>
                  <span>Machine Wash Cold</span>
                </div>
                <div class="szc-care-item">
                  <span class="szc-care-icon">🚫</span>
                  <span>Do Not Bleach</span>
                </div>
                <div class="szc-care-item">
                  <span class="szc-care-icon">🌀</span>
                  <span>Tumble Dry Low</span>
                </div>
                <div class="szc-care-item">
                  <span class="szc-care-icon">👔</span>
                  <span>Iron Low If Needed</span>
                </div>
              </div>
            </div>

            <div class="szc-tab-card" style="margin-top: 16px;">
              <h4 class="szc-tab-card__title">FIT INFORMATION</h4>
              <p class="szc-tab-card__sub">Regular Fit</p>
              <div class="szc-fit-slider">
                <div class="szc-fit-track">
                  <div class="szc-fit-thumb" style="left: 50%;"></div>
                </div>
                <div class="szc-fit-labels">
                  <span>Slim</span>
                  <span style="font-weight: 700;">Regular</span>
                  <span>Relaxed</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Fabric & Care -->
      <div id="tab-fabric" class="szc-tab-pane">
        <p><strong>Material:</strong> 100% Premium Organic Cotton Denim.</p>
        <p><strong>Care Instructions:</strong> Machine wash cold inside out with like colors. Do not bleach. Tumble dry low or line dry in shade. Warm iron if needed.</p>
      </div>

      <!-- Tab 3: Size Guide -->
      <div id="tab-size" class="szc-tab-pane">
        <table class="szc-size-table">
          <thead>
            <tr><th>Size</th><th>Chest (in)</th><th>Waist (in)</th><th>Length (in)</th></tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>36 - 38</td><td>30 - 32</td><td>26.5</td></tr>
            <tr><td>M</td><td>38 - 40</td><td>32 - 34</td><td>27.5</td></tr>
            <tr><td>L</td><td>40 - 42</td><td>34 - 36</td><td>28.5</td></tr>
            <tr><td>XL</td><td>42 - 44</td><td>36 - 38</td><td>29.5</td></tr>
            <tr><td>XXL</td><td>44 - 46</td><td>38 - 40</td><td>30.5</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Tab 4: Shipping & Returns -->
      <div id="tab-shipping" class="szc-tab-pane">
        <p><strong>Free Express Shipping:</strong> Available on all orders over $100. Standard delivery takes 3 - 5 business days.</p>
        <p><strong>Easy 30-Day Returns:</strong> If you are not 100% satisfied with your purchase, return it within 30 days for a full refund or exchange.</p>
      </div>
    </div>
  </div>

  <!-- 5. Sticky Add To Cart Bottom Bar -->
  <div class="szc-sticky-atc-bar" data-sticky-atc-bar>
    <div class="szc-sticky-atc-bar__container page-width">
      <div class="szc-sticky-atc-bar__product">
        <div class="szc-sticky-atc-bar__img-wrap">
          {%- if featured_media != blank -%}
            {{ featured_media.preview_image | image_url: width: 100 | image_tag: class: 'szc-sticky-atc-bar__img' }}
          {%- endif -%}
        </div>
        <div class="szc-sticky-atc-bar__info">
          <h4 class="szc-sticky-atc-bar__title">{{ product.title }}</h4>
          <div class="szc-sticky-atc-bar__price">{{ current_variant.price | money }}</div>
        </div>
      </div>
      <div class="szc-sticky-atc-bar__action">
        <button type="button" class="szc-button szc-button--primary szc-button--sm" data-sticky-atc-btn {% if current_variant.available == false %}disabled{% endif %}>
          {%- if current_variant.available -%}
            ADD TO BAG
          {%- else -%}
            SOLD OUT
          {%- endif -%}
        </button>
      </div>
    </div>
  </div>

  <!-- 6. Shopify Style Native Zoom Modal Lightbox (Crystal Clear Ultra High-Res + Top-to-Bottom Scrollable) -->
  <div class="szc-zoom-modal" id="ProductZoomModal" aria-hidden="true" data-zoom-modal>
    <div class="szc-zoom-modal__header">
      <span class="szc-zoom-modal__counter" data-zoom-counter>1 / {{ product.media.size }}</span>
      <div class="szc-zoom-modal__controls">
        <button type="button" class="szc-zoom-modal__ctrl-btn" aria-label="Zoom In" data-zoom-in-btn title="Zoom In (+)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
        </button>
        <button type="button" class="szc-zoom-modal__ctrl-btn" aria-label="Zoom Out" data-zoom-out-btn title="Zoom Out (-)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line></svg>
        </button>
        <button type="button" class="szc-zoom-modal__ctrl-btn szc-zoom-modal__ctrl-btn--close" aria-label="Close" data-zoom-close title="Close (Esc)">
          &times;
        </button>
      </div>
    </div>

    <button type="button" class="szc-zoom-modal__arrow szc-zoom-modal__arrow--prev" data-zoom-prev>&lsaquo;</button>

    <div class="szc-zoom-modal__viewport" data-zoom-viewport>
      <img
        id="ZoomModalImg"
        src="{{ featured_media.preview_image | image_url: width: 2400 }}"
        alt="{{ product.title | escape }}"
        width="2400"
        height="2400"
        loading="lazy"
        class="szc-zoom-modal__img"
        data-zoom-target
      >
    </div>

    <button type="button" class="szc-zoom-modal__arrow szc-zoom-modal__arrow--next" data-zoom-next>&rsaquo;</button>
  </div>
</section>

{% stylesheet %}
  .szc-main-product {
    padding-top: var(--szc-space-4, 16px);
    padding-bottom: var(--szc-space-12, 48px);
    max-width: var(--szc-page-max-width, 1400px);
    margin: 0 auto;
  }

  .szc-main-product__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--szc-space-8, 32px);
    margin-top: 16px;
  }

  @media (min-width: 990px) {
    .szc-main-product__grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 48px;
    }
  }

  /* Gallery Layout */
  .szc-main-product__gallery-wrap {
    display: flex;
    gap: 16px;
    flex-direction: column-reverse;
  }

  @media (min-width: 750px) {
    .szc-main-product__gallery-wrap {
      flex-direction: row;
    }
  }

