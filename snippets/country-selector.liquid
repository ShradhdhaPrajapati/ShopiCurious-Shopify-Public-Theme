{% comment %}
  Renders Shopify's native country and currency selector form with country flag support.
  Uses native localization.available_countries and localization.country.

  @param {string} [id_prefix] - Unique ID prefix for form and list (e.g. 'AnnouncementBar')
  @param {string} [class] - Optional extra CSS classes
  @param {string} [display_format] - 'flag_currency' (default), 'country_currency', 'flag_country'
{% endcomment %}

{%- liquid
  assign prefix = id_prefix | default: 'AnnouncementBar'
  assign form_id = prefix | append: 'CountryForm'
  assign list_id = prefix | append: 'CountryList'

  assign active_currency_code = cart.currency.iso_code | default: shop.currency
  assign current_country = localization.country

  if current_country != blank and current_country.iso_code != blank
    assign current_country_code = current_country.iso_code
    assign current_country_name = current_country.name
    assign current_currency_code = active_currency_code | default: current_country.currency.iso_code
    assign current_currency_symbol = current_country.currency.symbol | default: cart.currency.symbol
  else
    assign current_country_code = shop.address.country_code
    assign current_country_name = shop.address.country
    assign current_currency_code = active_currency_code | default: shop.currency
    assign current_currency_symbol = cart.currency.symbol
  endif

  assign format = display_format | default: 'flag_currency'

  # Primary country and flag for the active currency
  case active_currency_code
    when 'GBP'
      assign currency_flag = 'gb'
      assign currency_country_name = 'United Kingdom'
      assign currency_country_code = 'GB'
    when 'INR'
      assign currency_flag = 'in'
      assign currency_country_name = 'India'
      assign currency_country_code = 'IN'
    when 'EUR'
      assign currency_flag = 'eu'
      assign currency_country_name = 'European Union'
      assign currency_country_code = 'EU'
    when 'USD'
      assign currency_flag = 'us'
      assign currency_country_name = 'United States'
      assign currency_country_code = 'US'
    when 'CAD'
      assign currency_flag = 'ca'
      assign currency_country_name = 'Canada'
      assign currency_country_code = 'CA'
    when 'AUD'
      assign currency_flag = 'au'
      assign currency_country_name = 'Australia'
      assign currency_country_code = 'AU'
    when 'AED'
      assign currency_flag = 'ae'
      assign currency_country_name = 'United Arab Emirates'
      assign currency_country_code = 'AE'
    when 'JPY'
      assign currency_flag = 'jp'
      assign currency_country_name = 'Japan'
      assign currency_country_code = 'JP'
    when 'CHF'
      assign currency_flag = 'ch'
      assign currency_country_name = 'Switzerland'
      assign currency_country_code = 'CH'
    when 'SGD'
      assign currency_flag = 'sg'
      assign currency_country_name = 'Singapore'
      assign currency_country_code = 'SG'
    when 'NZD'
      assign currency_flag = 'nz'
      assign currency_country_name = 'New Zealand'
      assign currency_country_code = 'NZ'
    when 'CNY'
      assign currency_flag = 'cn'
      assign currency_country_name = 'China'
      assign currency_country_code = 'CN'
    when 'BRL'
      assign currency_flag = 'br'
      assign currency_country_name = 'Brazil'
      assign currency_country_code = 'BR'
    when 'MXN'
      assign currency_flag = 'mx'
      assign currency_country_name = 'Mexico'
      assign currency_country_code = 'MX'
    when 'SAR'
      assign currency_flag = 'sa'
      assign currency_country_name = 'Saudi Arabia'
      assign currency_country_code = 'SA'
    when 'ZAR'
      assign currency_flag = 'za'
      assign currency_country_name = 'South Africa'
      assign currency_country_code = 'ZA'
    when 'SEK'
      assign currency_flag = 'se'
      assign currency_country_name = 'Sweden'
      assign currency_country_code = 'SE'
    when 'NOK'
      assign currency_flag = 'no'
      assign currency_country_name = 'Norway'
      assign currency_country_code = 'NO'
    when 'DKK'
      assign currency_flag = 'dk'
      assign currency_country_name = 'Denmark'
      assign currency_country_code = 'DK'
    when 'PLN'
      assign currency_flag = 'pl'
      assign currency_country_name = 'Poland'
      assign currency_country_code = 'PL'
    when 'TRY'
      assign currency_flag = 'tr'
      assign currency_country_name = 'Turkey'
      assign currency_country_code = 'TR'
    when 'HKD'
      assign currency_flag = 'hk'
      assign currency_country_name = 'Hong Kong'
      assign currency_country_code = 'HK'
    when 'KRW'
      assign currency_flag = 'kr'
      assign currency_country_name = 'South Korea'
      assign currency_country_code = 'KR'
    when 'THB'
      assign currency_flag = 'th'
      assign currency_country_name = 'Thailand'
      assign currency_country_code = 'TH'
    when 'MYR'
      assign currency_flag = 'my'
      assign currency_country_name = 'Malaysia'
      assign currency_country_code = 'MY'
    when 'IDR'
      assign currency_flag = 'id'
      assign currency_country_name = 'Indonesia'
      assign currency_country_code = 'ID'
    when 'PHP'
      assign currency_flag = 'ph'
      assign currency_country_name = 'Philippines'
      assign currency_country_code = 'PH'
    when 'VND'
      assign currency_flag = 'vn'
      assign currency_country_name = 'Vietnam'
      assign currency_country_code = 'VN'
    when 'ILS'
      assign currency_flag = 'il'
      assign currency_country_name = 'Israel'
      assign currency_country_code = 'IL'
    when 'EGP'
      assign currency_flag = 'eg'
      assign currency_country_name = 'Egypt'
      assign currency_country_code = 'EG'
    when 'PKR'
      assign currency_flag = 'pk'
      assign currency_country_name = 'Pakistan'
      assign currency_country_code = 'PK'
    when 'BDT'
      assign currency_flag = 'bd'
      assign currency_country_name = 'Bangladesh'
      assign currency_country_code = 'BD'
    when 'LKR'
      assign currency_flag = 'lk'
      assign currency_country_name = 'Sri Lanka'
      assign currency_country_code = 'LK'
    when 'NPR'
      assign currency_flag = 'np'
      assign currency_country_name = 'Nepal'
      assign currency_country_code = 'NP'
    when 'KWD'
      assign currency_flag = 'kw'
      assign currency_country_name = 'Kuwait'
      assign currency_country_code = 'KW'
    when 'QAR'
      assign currency_flag = 'qa'
      assign currency_country_name = 'Qatar'
      assign currency_country_code = 'QA'
    when 'OMR'
      assign currency_flag = 'om'
      assign currency_country_name = 'Oman'
      assign currency_country_code = 'OM'
    when 'BHD'
      assign currency_flag = 'bh'
      assign currency_country_name = 'Bahrain'
      assign currency_country_code = 'BH'
    when 'JOD'
      assign currency_flag = 'jo'
      assign currency_country_name = 'Jordan'
      assign currency_country_code = 'JO'
    when 'RUB'
      assign currency_flag = 'ru'
      assign currency_country_name = 'Russia'
      assign currency_country_code = 'RU'
    else
      assign currency_flag = current_country_code | downcase
      assign currency_country_name = current_country_name
      assign currency_country_code = current_country_code
  endcase

  # Resolve the flag code:
  # In 'flag_currency' mode (Header, Mobile Drawer), the label is the currency code.
  # The flag must ALWAYS correspond to the active currency (e.g. UK flag 'gb' for GBP).
  if format == 'flag_currency'
    assign flag_code = currency_flag
    if current_country_code == 'US' and active_currency_code != 'USD'
      assign current_country_code = currency_country_code
      assign current_country_name = currency_country_name
    endif
  else
    # In 'flag_country' or 'country_currency' mode:
    if localization.available_countries.size > 1
      assign has_matched_country = false
      for c in localization.available_countries
        if c.iso_code == current_country_code and c.currency.iso_code == active_currency_code
          assign has_matched_country = true
          assign flag_code = c.iso_code | downcase
          break
        endif
      endfor
      unless has_matched_country
        assign flag_code = currency_flag
        assign current_country_name = currency_country_name
        assign current_country_code = currency_country_code
      endunless
    else
      if current_country_code == 'US' and active_currency_code != 'USD'
        assign flag_code = currency_flag
        assign current_country_name = currency_country_name
        assign current_country_code = currency_country_code
      elsif active_currency_code == 'GBP' and current_country_code != 'GB'
        assign flag_code = 'gb'
        assign current_country_name = 'United Kingdom'
        assign current_country_code = 'GB'
      elsif active_currency_code == 'INR' and current_country_code != 'IN'
        assign flag_code = 'in'
        assign current_country_name = 'India'
        assign current_country_code = 'IN'
      else
        assign flag_code = current_country_code | downcase
      endif
    endif
  endif

  assign format = display_format | default: 'flag_currency'
  assign available_countries_count = localization.available_countries.size
-%}

{%- if available_countries_count > 0 -%}
  <country-selector-form class="szc-country-selector {{ class }}">
    {%- form 'localization', id: form_id, class: 'szc-localization-form' -%}
      <div class="szc-localization-wrapper">
        <button
          type="button"
          class="szc-localization-toggle-btn szc-country-toggle-btn"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="{{ list_id }}"
          aria-label="{{ current_country_name }}{% if current_currency_code != blank %} ({{ current_currency_code }}{% if current_currency_symbol != blank %} {{ current_currency_symbol }}{% endif %}){% endif %}"
          {% if available_countries_count <= 1 %}disabled style="cursor: default;"{% endif %}
        >
          {%- unless format == 'country_currency' -%}
            {%- if flag_code != blank -%}
              <span class="szc-country-flag" aria-hidden="true">
                <img
                  class="szc-country-flag-img"
                  src="https://flagcdn.com/w40/{{ flag_code }}.png"
                  srcset="https://flagcdn.com/w80/{{ flag_code }}.png 2x"
                  width="16"
                  height="11"
                  alt=""
                  loading="eager"
                >
              </span>
            {%- endif -%}
          {%- endunless -%}
          <span class="szc-localization-current-name">
            {%- if format == 'flag_country' -%}
              {{ current_country_name }}
            {%- elsif format == 'country_currency' -%}
              {{ current_country_name }}{% if current_currency_code != blank %} · {{ current_currency_code }}{% endif %}
            {%- else -%}
              {{ current_currency_code | default: current_country_name }}
            {%- endif -%}
          </span>
          {%- if available_countries_count > 1 -%}
            <svg class="szc-localization-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          {%- endif -%}
        </button>

        {%- if available_countries_count > 1 -%}
          <ul
            id="{{ list_id }}"
            role="listbox"
            class="szc-localization-dropdown szc-country-dropdown"
            aria-label="{{ 'localization.country_label' | t }}"
            hidden
          >
            {%- for country in localization.available_countries -%}
              <li
                class="szc-localization-item szc-country-item"
                role="option"
                {% if country.iso_code == current_country_code %}aria-selected="true"{% endif %}
              >
                <a
                  class="szc-localization-link szc-country-link {% if country.iso_code == current_country_code %}is-active{% endif %}"
                  href="#"
                  {% if country.iso_code == current_country_code %}aria-current="true"{% endif %}
                  data-value="{{ country.iso_code }}"
                  tabindex="-1"
                >
                  {%- if country.iso_code != blank -%}
                    <span class="szc-country-flag" aria-hidden="true">
                      <img
                        class="szc-country-flag-img"
                        src="https://flagcdn.com/w40/{{ country.iso_code | downcase }}.png"
                        srcset="https://flagcdn.com/w80/{{ country.iso_code | downcase }}.png 2x"
                        width="16"
                        height="11"
                        alt=""
                        loading="lazy"
                      >
                    </span>
                  {%- endif -%}
                  <span class="szc-country-name">{{ country.name }}</span>
                  <span class="szc-country-currency">{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                  {%- if country.iso_code == current_country_code -%}
                    <svg class="szc-country-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <input type="hidden" name="country_code" value="{{ current_country_code }}">
        {%- if localization.language.iso_code != blank -%}
          <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}">
        {%- endif -%}
        <input type="hidden" name="return_to" value="{{ request.path }}">
      </div>
    {%- endform -%}
  </country-selector-form>
{%- elsif current_country_name != blank or current_currency_code != blank -%}
  {%- comment -%} Fallback single country/currency display with flag {%- endcomment -%}
  <div class="szc-country-selector szc-country-selector--single {{ class }}">
    <div class="szc-localization-wrapper">
      <button
        type="button"
        class="szc-localization-toggle-btn szc-country-toggle-btn"
        aria-label="{{ current_country_name }}{% if current_currency_code != blank %} ({{ current_currency_code }}){% endif %}"
        disabled
        style="cursor: default;"
      >
        {%- unless format == 'country_currency' -%}
          {%- if flag_code != blank -%}
            <span class="szc-country-flag" aria-hidden="true">
              <img
                class="szc-country-flag-img"
                src="https://flagcdn.com/w40/{{ flag_code }}.png"
                srcset="https://flagcdn.com/w80/{{ flag_code }}.png 2x"
                width="16"
                height="11"
                alt=""
                loading="eager"
              >
            </span>
          {%- endif -%}
        {%- endunless -%}
        <span class="szc-localization-current-name">
          {%- if format == 'flag_country' -%}
            {{ current_country_name }}
          {%- elsif format == 'country_currency' -%}
            {{ current_country_name }}{% if current_currency_code != blank %} · {{ current_currency_code }}{% endif %}
          {%- else -%}
            {{ current_currency_code | default: current_country_name }}
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .szc-country-selector {
    display: inline-flex;
    align-items: center;
    position: relative;
  }

  .szc-country-selector .szc-localization-form {
    margin: 0;
    padding: 0;
    display: inline-flex;
  }

  .szc-country-selector .szc-localization-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* Reference-matching dropdown toggle button with Flag */
  .szc-country-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background-color: #ffffff;
    border: 1px solid var(--szc-announcement-border, rgba(0, 0, 0, 0.14));
    border-radius: 3px;
    padding: 0 7px;
    font-family: var(--szc-font-family-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--szc-announcement-text, #222222);
    cursor: pointer;
    line-height: 1;
    height: 26px;
    box-sizing: border-box;
    white-space: nowrap;
    text-transform: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
    -webkit-appearance: none;
    appearance: none;
  }

  .szc-country-toggle-btn:hover {
    border-color: #111111;
    background-color: #ffffff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .szc-country-toggle-btn[aria-expanded="true"] {
    border-color: #111111;
    background-color: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .szc-country-toggle-btn:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 1px;
  }

  /* Country Flag Image Styling */
  .szc-country-flag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 1;
  }

  .szc-country-flag-img {
    display: block;
    width: 16px;
    height: 11px;
    object-fit: cover;
    border-radius: 1.5px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .szc-localization-current-name {
    display: inline-block;
    white-space: nowrap;
    line-height: 1;
  }

  .szc-country-toggle-btn .szc-localization-caret {
    width: 8px;
    height: 8px;
    opacity: 0.75;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
    display: inline-block;
  }

  .szc-country-toggle-btn[aria-expanded="true"] .szc-localization-caret {
    transform: rotate(180deg);
  }

  /* Dropdown Menu (Opens cleanly below selector, above all content) */
  .szc-country-dropdown {
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    min-width: 210px;
    max-width: min(300px, calc(100vw - 24px));
    max-height: min(280px, 60vh);
    overflow-y: auto;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
    list-style: none;
    margin: 0;
    padding: 4px 0;
    z-index: 1010;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .szc-country-dropdown[hidden] {
    display: none !important;
  }

  .szc-country-item {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .szc-country-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font-family: var(--szc-font-family-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: 11px;
    font-weight: 400;
    color: #111111;
    text-decoration: none;
    text-transform: none;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
    min-height: 32px;
    box-sizing: border-box;
  }

  .szc-country-link:hover,
  .szc-country-link:focus-visible {
    background-color: #f7f6f4;
    color: #000000;
    outline: none;
  }

  .szc-country-link.is-active {
    background-color: #f2efe9;
    font-weight: 600;
    color: #000000;
  }

  .szc-country-link .szc-country-flag {
    margin-right: 2px;
  }

  .szc-country-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .szc-country-currency {
    color: #777777;
    font-size: 10px;
    font-weight: 400;
    flex-shrink: 0;
  }

  .szc-country-check {
    width: 12px;
    height: 12px;
    color: #111111;
    flex-shrink: 0;
    margin-left: 2px;
  }

  /* RTL Support */
  html[dir="rtl"] .szc-country-dropdown {
    right: auto !important;
    left: 0 !important;
  }

  /* Mobile Drawer Placement: Open upwards above bottom bar */
  .mobile-drawer-country-selector .szc-country-dropdown {
    top: auto;
    bottom: calc(100% + 4px);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
  }

  /* Mobile Responsive (320px - 768px) */
  @media (max-width: 768px) {
    .szc-country-toggle-btn {
      height: 24px;
      padding: 0 5px;
      font-size: 10px;
      gap: 4px;
      border-radius: 2px;
    }

    .szc-country-flag-img {
      width: 14px;
      height: 10px;
    }

    .szc-country-toggle-btn .szc-localization-caret {
      width: 7px;
      height: 7px;
    }

    .szc-country-dropdown {
      top: calc(100% + 4px);
      right: 0;
      min-width: 190px;
      max-width: min(280px, calc(100vw - 20px));
      max-height: min(260px, 55vh);
    }

    .szc-country-link {
      padding: 8px 10px;
      font-size: 10.5px;
      min-height: 34px;
    }
  }

  /* Extremely small mobile (320px) */
  @media (max-width: 340px) {
    .szc-country-toggle-btn {
      padding: 0 4px;
      font-size: 9.5px;
      gap: 3px;
    }

    .szc-country-flag-img {
      width: 13px;
      height: 9px;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .szc-country-toggle-btn,
    .szc-country-toggle-btn .szc-localization-caret,
    .szc-country-link {
      transition: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('country-selector-form')) {
    customElements.define('country-selector-form', class CountrySelectorForm extends HTMLElement {
      constructor() {
        super();
        this.initialized = false;
      }

      connectedCallback() {
        if (this.querySelector('button')) {
          this.init();
        } else {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => this.init(), { once: true });
          } else {
            setTimeout(() => this.init(), 0);
          }
        }
      }

      init() {
        if (this.initialized) return;
        this.form = this.querySelector('form');
        this.button = this.querySelector('.szc-country-toggle-btn');
        this.dropdown = this.querySelector('.szc-country-dropdown');
        this.input = this.querySelector('input[name="country_code"]');
        this.links = this.querySelectorAll('.szc-country-link');
        this.parentBar = this.closest('.szc-announcement-bar');

        if (!this.button) return;
        this.initialized = true;

        if (this.dropdown) {
          this.button.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.toggle();
          });

          // Keyboard navigation: Escape closes dropdown and refocuses button
          this.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' || e.code === 'Escape') {
              this.close();
              this.button.focus();
            } else if (e.key === 'ArrowDown') {
              if (this.dropdown.hasAttribute('hidden')) {
                this.open();
              }
              const activeLink = this.dropdown.querySelector('.szc-country-link.is-active') || this.links[0];
              activeLink?.focus();
              e.preventDefault();
            }
          });

          // Close when clicking or tapping outside
          document.addEventListener('click', (e) => {
            if (!this.contains(e.target)) {
              this.close();
            }
          });

          // Close on blur outside element
          this.addEventListener('focusout', (e) => {
            if (!this.contains(e.relatedTarget)) {
              this.close();
            }
          });

          // Country selection & native Shopify submission
          this.links.forEach((link, idx) => {
            link.addEventListener('click', (e) => {
              e.preventDefault();
              if (this.input && this.form) {
                this.input.value = link.dataset.value;
                this.form.submit();
              }
            });

            // Keyboard arrow navigation between options
            link.addEventListener('keydown', (e) => {
              if (e.key === 'ArrowDown') {
                e.preventDefault();
                const nextLink = this.links[idx + 1] || this.links[0];
                nextLink?.focus();
              } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                const prevLink = this.links[idx - 1] || this.links[this.links.length - 1];
                prevLink?.focus();
              } else if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                link.click();
              }
            });
          });
        }
      }

      toggle() {
        if (!this.dropdown) return;
        const expanded = this.button.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          this.close();
        } else {
          this.open();
        }
      }

      open() {
        if (!this.dropdown) return;
        this.button.setAttribute('aria-expanded', 'true');
        this.dropdown.removeAttribute('hidden');
        if (this.parentBar) {
          this.parentBar.classList.add('is-dropdown-open');
        }
      }

      close() {
        if (!this.dropdown) return;
        this.button.setAttribute('aria-expanded', 'false');
        this.dropdown.setAttribute('hidden', '');
        if (this.parentBar) {
          this.parentBar.classList.remove('is-dropdown-open');
        }
      }
    });
  }
