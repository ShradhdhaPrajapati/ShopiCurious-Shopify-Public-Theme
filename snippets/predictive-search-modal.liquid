{% comment %}
  ShopziCurious - 100% Dynamic Mobile & Desktop Predictive Search Modal
  Matching User's Reference Screenshots 1:1
{% endcomment %}

<div
  id="PredictiveSearchModal"
  class="szc-search-modal-wrapper"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Search Store"
>
  <!-- Overlay Backdrop -->
  <div class="szc-search-modal__backdrop" data-search-close></div>

  <!-- Popover / Fullscreen Mobile Container -->
  <div class="szc-search-modal__popover">
    <!-- Desktop Pointer Arrow -->
    <div class="szc-search-modal__arrow" id="SearchModalArrow"></div>

    <div class="szc-search-modal__content">
      <!-- Top Mobile Navigation Header Bar (Image 1) -->
      <div class="szc-search-modal-top-bar">
        <button type="button" class="szc-search-back-btn" data-search-close aria-label="Back">
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </button>

        <div class="szc-search-brand-title">
          <span class="szc-brand-name">{{ shop.name | upcase }}</span>
          <span class="szc-brand-sub">PREMIUM FASHION</span>
        </div>

        <div class="szc-search-top-icons">
          <a href="{{ routes.account_url }}" class="szc-top-icon-link" aria-label="Account">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
          <a href="{{ routes.cart_url }}" class="szc-top-icon-link szc-cart-badge-wrap" aria-label="Cart">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="szc-cart-badge-count">{{ cart.item_count | default: 1 }}</span>
          </a>
        </div>
      </div>

      <!-- Top Search Form Input Bar (Image 1) -->
      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="szc-search-form"
        id="PredictiveSearchForm"
      >
        <div class="szc-search-input-wrap">
          <svg
            class="szc-search-icon-input"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>

          <input
            type="search"
            name="q"
            id="SearchInputPredictive"
            class="szc-search-input-field"
            placeholder="Search products, collections..."
            value=""
            autocomplete="off"
            autocorrect="off"
            capitalize="off"
            spellcheck="false"
            aria-autocomplete="list"
            aria-controls="PredictiveSearchResults"
          >

          <button type="button" class="szc-search-clear-btn" id="SearchClearBtn" aria-label="Clear Search">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </form>

      <!-- 3-Column Desktop / Vertical Stack Mobile Search Results -->
      <div id="PredictiveSearchResults" class="szc-search-results-grid">
        <!-- SECTION 1: SUGGESTIONS / TRENDING KEYWORDS -->
        <div class="szc-search-col szc-search-col--suggestions" id="ColSuggestions">
          <h4 class="szc-search-col__title" id="ColTitleSuggestions">TRENDING SEARCHES</h4>
          <ul class="szc-suggestions-list" id="SearchSuggestionsList">
            {%- assign raw_keywords = settings.search_trending_keywords -%}
            {%- if raw_keywords == blank -%}{%- assign raw_keywords = 'Dresses, Jackets, Denim, Linen, Coats' -%}{%- endif -%}
            {%- assign trending_keywords = raw_keywords | split: ',' -%}
            {%- for keyword in trending_keywords -%}
              {%- assign clean_kw = keyword | strip -%}
              {%- if clean_kw != blank -%}
                <li>
                  <a href="{{ routes.search_url }}?q={{ clean_kw | url_encode }}" class="szc-suggestion-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <span>{{ clean_kw }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <!-- SECTION 2: POPULAR PRODUCTS -->
        <div class="szc-search-col szc-search-col--products">
          <h4 class="szc-search-col__title" id="ColTitleProducts">POPULAR PRODUCTS</h4>
          <div class="szc-search-products-list" id="SearchProductsList">
            {%- assign popular_products = collections.all.products -%}
            {%- if popular_products.size == 0 -%}
              {%- for c in collections -%}
                {%- if c.products.size > 0 -%}
                  {%- assign popular_products = c.products -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if popular_products.size > 0 -%}
              {%- for product in popular_products limit: 4 -%}
                <a href="{{ product.url }}" class="szc-search-product-card">
                  <div class="szc-search-product-thumb">
                    {%- if product.featured_media != blank -%}
                      {{
                        product.featured_media
                        | image_url: width: 140
                        | image_tag: loading: 'lazy', alt: product.title
                      }}
                    {%- elsif product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 140
                        | image_tag: loading: 'lazy', alt: product.title
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'szc-placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div class="szc-search-product-info">
                    <h5 class="szc-search-product-title">{{ product.title }}</h5>
                    <div class="szc-search-product-price">{{ product.price | money }}</div>
                  </div>
                </a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <!-- SECTION 3: COLLECTIONS -->
        <div class="szc-search-col szc-search-col--collections">
          <h4 class="szc-search-col__title" id="ColTitleCollections">COLLECTIONS</h4>
          <div class="szc-search-collections-list" id="SearchCollectionsList">
            {%- assign coll_count = 0 -%}
            {%- for collection in collections -%}
              {%- unless collection.handle == 'frontpage' -%}
                {%- if coll_count < 4 -%}
                  {%- assign coll_count = coll_count | plus: 1 -%}
                  <a href="{{ collection.url }}" class="szc-search-collection-card">
                    <div class="szc-search-collection-thumb">
                      {%- if collection.featured_image != blank -%}
                        {{
                          collection.featured_image
                          | image_url: width: 180
                          | image_tag: loading: 'lazy', alt: collection.title
                        }}
                      {%- elsif collection.products.first.featured_media != blank -%}
                        {{
                          collection.products.first.featured_media
                          | image_url: width: 180
                          | image_tag: loading: 'lazy', alt: collection.title
                        }}
                      {%- else -%}
                        {{ 'collection-1' | placeholder_svg_tag: 'szc-placeholder-svg' }}
                      {%- endif -%}
                    </div>
                    <div class="szc-search-collection-info">
                      <h5 class="szc-search-collection-title">{{ collection.title | upcase }}</h5>
                      <div class="szc-search-collection-count">
                        {{ collection.all_products_count | default: 12 }} items
                      </div>
                    </div>
                    <svg
                      class="szc-search-collection-arrow"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </a>
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- Bottom View All Button (Matches User Screenshot 1:1) -->
      <div class="szc-search-modal__footer" id="SearchModalFooter">
        <a href="{{ routes.search_url }}" class="szc-search-view-all-btn" id="SearchSubmitBtn">
          <span>VIEW ALL RESULTS</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Root Search Modal Backdrop Overlay */
  .szc-search-modal-wrapper {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .szc-search-modal-wrapper.is-open {
    display: block;
    opacity: 1;
  }

  .szc-search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  /* Popover Floating Box (Desktop) */
  .szc-search-modal__popover {
    position: absolute;
    top: 75px;
    right: max(24px, calc((100vw - 1200px) / 2));
    width: 900px;
    max-width: calc(100vw - 32px);
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.16);
    border: 1px solid #eaeaea;
    z-index: 2;
    overflow: visible;
    animation: szcSearchPopIn 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes szcSearchPopIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Triangle Pointer Arrow */
  .szc-search-modal__arrow {
    position: absolute;
    top: -9px;
    right: 145px;
    width: 16px;
    height: 16px;
    background: #ffffff;
    border-left: 1px solid #eaeaea;
    border-top: 1px solid #eaeaea;
    transform: rotate(45deg);
    z-index: 3;
  }

  .szc-search-modal__content {
    padding: 24px 28px 20px;
    box-sizing: border-box;
  }

  /* Top Mobile Navigation Header Bar (Hidden on Desktop) */
  .szc-search-modal-top-bar {
    display: none;
  }

  /* Search Input Field */
  .szc-search-form {
    margin-bottom: 24px;
  }

  .szc-search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #111111;
    border-radius: 8px;
    padding: 0 16px;
    height: 48px;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .szc-search-input-wrap:focus-within {
    border-color: #111111;
    box-shadow: 0 0 0 1px #111111;
  }

  .szc-search-icon-input {
    color: #444444;
    flex-shrink: 0;
    margin-right: 12px;
  }

  /* Strict fix to remove inner border/outline & native webkit cancel button on input */
  .szc-search-input-field,
  .szc-search-input-field:focus,
  .szc-search-input-field:focus-visible,
  .szc-search-input-field:active {
    width: 100%;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    font-size: 15px;
    font-weight: 500;
    color: #111111;
    font-family: inherit;
    -webkit-appearance: none;
    appearance: none;
  }

  .szc-search-input-field::-webkit-search-cancel-button,
  .szc-search-input-field::-webkit-search-decoration,
  .szc-search-input-field::-webkit-search-results-button,
  .szc-search-input-field::-webkit-search-results-decoration {
    -webkit-appearance: none !important;
    appearance: none !important;
    display: none !important;
  }

  .szc-search-input-field::placeholder {
    color: #777777;
  }

  .szc-search-clear-btn {
    background: transparent;
    border: none;
    color: #666666;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: color 150ms ease, background-color 150ms ease;
  }

  .szc-search-clear-btn:hover {
    color: #000000;
    background-color: #f2f2f2;
  }

  /* 3-Column Grid Layout (Desktop) */
  .szc-search-results-grid {
    display: grid;
    grid-template-columns: 220px 1.25fr 1fr;
    gap: 28px;
    min-height: 360px;
    padding-bottom: 12px;
  }

  .szc-search-col__title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #222222;
    margin: 0 0 18px;
  }

  /* Column 1: Suggestions List */
  .szc-suggestions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .szc-suggestion-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #333333;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .szc-suggestion-link svg {
    color: #777777;
    flex-shrink: 0;
  }

  .szc-suggestion-link:hover {
    color: #000000;
    font-weight: 600;
  }

  /* Column 2: Popular Products List */
  .szc-search-products-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .szc-search-product-card {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    padding: 6px;
    border-radius: 8px;
    transition: background-color 150ms ease;
  }

  .szc-search-product-card:hover {
    background-color: #fafafa;
  }

  .szc-search-product-thumb {
    width: 62px;
    height: 74px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f4f4f4;
    flex-shrink: 0;
    border: 1px solid #efefef;
  }

  .szc-search-product-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-search-product-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .szc-search-product-title {
    font-size: 14px;
    font-weight: 700;
    color: #111111;
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .szc-search-product-price {
    font-size: 14px;
    font-weight: 800;
    color: #111111;
    margin-bottom: 0;
  }

  /* Column 3: Collections List */
  .szc-search-collections-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .szc-search-collection-card {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    padding: 6px;
    border-radius: 8px;
    transition: background-color 150ms ease;
  }

  .szc-search-collection-card:hover {
    background-color: #fafafa;
  }

  .szc-search-collection-thumb {
    width: 80px;
    height: 56px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #f4f4f4;
    flex-shrink: 0;
    border: 1px solid #efefef;
  }

  .szc-search-collection-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-search-collection-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .szc-search-collection-title {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #111111;
    margin: 0 0 3px;
    text-transform: uppercase;
  }

  .szc-search-collection-count {
    font-size: 12px;
    color: #777777;
  }

  .szc-search-collection-arrow {
    color: #999999;
    flex-shrink: 0;
  }

  /* Bottom Footer Bar */
  .szc-search-modal__footer {
    border-top: 1px solid #eeeeee;
    padding-top: 18px;
    text-align: center;
  }

  .szc-search-view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: #111111;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 150ms ease, color 150ms ease;
  }

  .szc-search-view-all-btn:hover {
    color: #000000;
    transform: translateX(3px);
  }

  /* MOBILE VIEW LUXURY UI/UX (Matching Screenshots 1 & 2 1:1) */
  @media (max-width: 767px) {
    .szc-search-modal__popover {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100vw;
      height: 100vh;
      max-width: 100vw;
      border-radius: 0;
      border: none;
      box-shadow: none;
      background: #ffffff;
      overflow-y: auto;
      z-index: 999999;
      animation: none;
    }

    .szc-search-modal__arrow {
      display: none !important;
    }

    .szc-search-modal__content {
      padding: 14px 18px 40px 18px;
      min-height: auto;
      display: block;
      box-sizing: border-box;
    }

    /* Mobile Header Bar - Show Back Arrow only, hide brand title and user/cart icons */
    .szc-search-modal-top-bar {
      display: flex !important;
      align-items: center;
      justify-content: flex-start;
      margin-bottom: 12px;
      padding-bottom: 0;
      border-bottom: none;
    }

    .szc-search-back-btn {
      background: transparent;
      border: none;
      color: #111111;
      cursor: pointer;
      padding: 4px;
      display: flex !important;
      align-items: center;
    }

    .szc-search-brand-title,
    .szc-search-top-icons {
      display: none !important;
    }

    /* Stacked Sections Layout */
    .szc-search-results-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
      min-height: auto;
      padding-bottom: 0;
    }

    .szc-search-product-thumb {
      width: 76px;
      height: 90px;
      border-radius: 10px;
    }

    /* Hide COLLECTIONS on Mobile Search Modal per user request */
    .szc-search-col--collections {
      display: none !important;
    }

    /* SHOW VIEW ALL RESULTS button directly below POPULAR PRODUCTS (Red Mark Area) */
    .szc-search-modal__footer {
      display: block !important;
      margin-top: 24px;
      padding-top: 18px;
      padding-bottom: 24px;
      border-top: 1px solid #eeeeee;
      text-align: center;
      background: transparent;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('PredictiveSearchModal');
    const input = document.getElementById('SearchInputPredictive');
    const clearBtn = document.getElementById('SearchClearBtn');
    const displayTerm = document.getElementById('SearchTermDisplay');
    const submitBtn = document.getElementById('SearchSubmitBtn');
    const arrow = document.getElementById('SearchModalArrow');

    const colSuggestions = document.getElementById('ColSuggestions');
    const suggestionsList = document.getElementById('SearchSuggestionsList');
    const productsList = document.getElementById('SearchProductsList');
    const collectionsList = document.getElementById('SearchCollectionsList');

    const triggers = document.querySelectorAll('.szc-search-trigger');
    const closers = document.querySelectorAll('[data-search-close]');

    // Cache initial default markup for empty input state
    const initialProductsHTML = productsList ? productsList.innerHTML : '';
    const initialCollectionsHTML = collectionsList ? collectionsList.innerHTML : '';

    let debounceTimer = null;

    // Dynamically position popover pointer arrow under header search icon
    function alignArrowToSearchIcon() {
      if (window.innerWidth < 768) return;
      const searchBtn = document.querySelector('.szc-search-trigger');
      const popover = document.querySelector('.szc-search-modal__popover');
      if (searchBtn && popover && arrow) {
        const btnRect = searchBtn.getBoundingClientRect();
        const popoverRect = popover.getBoundingClientRect();
        const arrowRightOffset = popoverRect.right - btnRect.left - btnRect.width / 2 - 8;
        if (arrowRightOffset > 10 && arrowRightOffset < popoverRect.width - 20) {
          arrow.style.right = arrowRightOffset + 'px';
        }
      }
    }

    // Open Modal
    function openModal() {
      if (!modal) return;
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      alignArrowToSearchIcon();
      setTimeout(() => {
        if (input) input.focus();
        alignArrowToSearchIcon();
      }, 80);
    }

    // Close Modal
    function closeModal() {
      if (!modal) return;
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    window.addEventListener('resize', alignArrowToSearchIcon);

    // Bind triggers
    triggers.forEach((trig) => {
      trig.addEventListener('click', function (e) {
        e.preventDefault();
        openModal();
      });
    });

    closers.forEach((c) => {
      c.addEventListener('click', closeModal);
    });

    // Close on ESC
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // Clear input
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (input) {
          input.value = '';
          input.focus();
          updateDisplayTerm('');
          resetToInitialState();
        }
      });
    }

    function resetToInitialState() {
      if (colSuggestions) colSuggestions.style.display = 'none';
      if (suggestionsList) suggestionsList.innerHTML = '';
      if (productsList) productsList.innerHTML = initialProductsHTML;
      if (collectionsList) collectionsList.innerHTML = initialCollectionsHTML;
    }

    // Update bottom display term
    function updateDisplayTerm(val) {
      if (!submitBtn) return;
      const query = val.trim();
      const textSpan = submitBtn.querySelector('span');
      if (textSpan) {
        if (query) {
          textSpan.textContent = `VIEW ALL RESULTS FOR "${query.toUpperCase()}"`;
          submitBtn.setAttribute('href', '{{ routes.search_url }}?q=' + encodeURIComponent(query));
        } else {
          textSpan.textContent = `VIEW ALL RESULTS`;
          submitBtn.setAttribute('href', '{{ routes.search_url }}');
        }
      }
    }

    const enablePredictiveSearch = {{ settings.enable_predictive_search | default: true | json }};

    // Live Predictive Search JSON API Querying
    if (input) {
      input.addEventListener('input', function () {
        const query = input.value.trim();
        updateDisplayTerm(query);

        if (!query) {
          resetToInitialState();
          return;
        }

        if (!enablePredictiveSearch) {
          return;
        }

        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          if (query.length >= 2) {
            fetchDynamicSuggestJSON(query);
          }
        }, 200);
      });
    }

    // Fetch JSON from Shopify /search/suggest.json
    function fetchDynamicSuggestJSON(query) {
      const suggestUrl = `{{ routes.predictive_search_url }}.json?q=${encodeURIComponent(
        query
      )}&resources[type]=product,collection,query&resources[limit]=4`;

      fetch(suggestUrl)
        .then((response) => {
          if (!response.ok) return null;
          return response.json();
        })
        .then((data) => {
          if (data && data.resources && data.resources.results) {
            renderLiveResults(data.resources.results, query);
          } else {
            fetchDynamicSection(query);
          }
        })
        .catch((err) => {
          fetchDynamicSection(query);
        });
    }

    function renderLiveResults(results, query) {
      const products = results.products || [];
      const collections = results.collections || [];
      const queries = results.queries || [];

      // 1. Render Suggestions Column ONLY when real query suggestions exist
      if (suggestionsList && colSuggestions) {
        if (queries.length > 0) {
          let sugHTML = '';
          queries.forEach((q) => {
            sugHTML += `
              <li>
                <a href="${q.url}" class="szc-suggestion-link">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                  <span>${q.text}</span>
                </a>
              </li>`;
          });
          suggestionsList.innerHTML = sugHTML;
          colSuggestions.style.display = 'block';
        } else {
          colSuggestions.style.display = 'none';
        }
      }

      // 2. Render Products Column
      if (productsList) {
        if (products.length > 0) {
          let prodHTML = '';
          products.forEach((p) => {
            const priceFormatted = p.price
              ? p.price.includes('$')
                ? p.price
                : '$' + parseFloat(p.price).toFixed(2)
              : '';
            const imgSrc = p.image || p.featured_image || '{{ "about-story-1.png" | asset_url }}';

            prodHTML += `
              <a href="${p.url}" class="szc-search-product-card">
                <div class="szc-search-product-thumb">
                  <img src="${imgSrc}" alt="${p.title}" width="70" height="85" loading="lazy">
                </div>
                <div class="szc-search-product-info">
                  <h5 class="szc-search-product-title">${p.title}</h5>
                  <div class="szc-search-product-price">${priceFormatted}</div>
                </div>
              </a>`;
          });
          productsList.innerHTML = prodHTML;
        }
      }

      // 3. Render Collections Column
      if (collectionsList) {
        if (collections.length > 0) {
          let collHTML = '';
          collections.forEach((c) => {
            const collImg = c.image || '{{ "about-story-1.png" | asset_url }}';
            collHTML += `
              <a href="${c.url}" class="szc-search-collection-card">
                <div class="szc-search-collection-thumb">
                  <img src="${collImg}" alt="${c.title}" width="90" height="65" loading="lazy">
                </div>
                <div class="szc-search-collection-info">
                  <h5 class="szc-search-collection-title">${c.title.toUpperCase()}</h5>
                  <div class="szc-search-collection-count">Featured Collection</div>
                </div>
                <svg class="szc-search-collection-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </a>`;
          });
          collectionsList.innerHTML = collHTML;
        }
      }
    }

    function fetchDynamicSection(query) {
      const sectionUrl = `{{ routes.predictive_search_url }}?q=${encodeURIComponent(
        query
      )}&resources[type]=product,collection,query&resources[limit]=4&section_id=predictive-search`;
      fetch(sectionUrl)
        .then((res) => res.text())
        .then((text) => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(text, 'text/html');
          const newGrid = doc.getElementById('PredictiveSearchResults');
          if (newGrid) {
            const curGrid = document.getElementById('PredictiveSearchResults');
            if (curGrid) curGrid.innerHTML = newGrid.innerHTML;
          }
        });
    }
  });
</script>
