{% doc %}
  Renders reusable Trust Badges (Free Shipping, Easy Returns, Secure Payment).

  @param {string} [class] - Optional additional CSS class for wrapper
  @param {boolean} [show_badges] - Controls visibility (Default: true)
  @param {object} [settings] - Optional block or section settings object for dynamic overrides

  @example
  {% render 'trust-badges', class: 'szc-cart-drawer__trust-footer' %}
{% enddoc %}

{%- liquid
  assign display_badges = true
  if show_badges == false
    assign display_badges = false
  endif

  if settings != blank and settings.show_trust_badges == false
    assign display_badges = false
  endif

  assign custom_class = class | default: ''
  assign icon_color = settings.icon_color | default: '#111111'
  assign icon_size = settings.icon_size | default: 20

  assign b1_title = settings.badge_1_title | default: 'Free Shipping'
  assign b1_subtext = settings.badge_1_subtext | default: 'On orders over $100'
  assign b1_icon = settings.badge_1_icon | default: 'shipping'

  assign b2_title = settings.badge_2_title | default: 'Easy Returns'
  assign b2_subtext = settings.badge_2_subtext | default: '30-day returns'
  assign b2_icon = settings.badge_2_icon | default: 'returns'

  assign b3_title = settings.badge_3_title | default: 'Secure Payment'
  assign b3_subtext = settings.badge_3_subtext | default: '100% secure checkout'
  assign b3_icon = settings.badge_3_icon | default: 'secure'
-%}

{%- if display_badges -%}
  <div class="szc-trust-badges-snippet {{ custom_class }}">
    <div class="szc-trust-badge-item">
      <div class="szc-trust-badge-item__icon">
        {%- case b1_icon -%}
          {%- when 'returns' -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
          {%- when 'secure' -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          {%- else -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
        {%- endcase -%}
      </div>
      <div class="szc-trust-badge-item__text">
        <strong>{{ b1_title }}</strong>
        <span>{{ b1_subtext }}</span>
      </div>
    </div>

    <div class="szc-trust-badge-item">
      <div class="szc-trust-badge-item__icon">
        {%- case b2_icon -%}
          {%- when 'shipping' -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          {%- when 'secure' -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          {%- else -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
        {%- endcase -%}
      </div>
      <div class="szc-trust-badge-item__text">
        <strong>{{ b2_title }}</strong>
        <span>{{ b2_subtext }}</span>
      </div>
    </div>

    <div class="szc-trust-badge-item">
      <div class="szc-trust-badge-item__icon">
        {%- case b3_icon -%}
          {%- when 'shipping' -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          {%- when 'returns' -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
            </svg>
          {%- else -%}
            <svg
              width="{{ icon_size }}"
              height="{{ icon_size }}"
              viewBox="0 0 24 24"
              fill="none"
              stroke="{{ icon_color }}"
              stroke-width="1.8"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
        {%- endcase -%}
      </div>
      <div class="szc-trust-badge-item__text">
        <strong>{{ b3_title }}</strong>
        <span>{{ b3_subtext }}</span>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .szc-trust-badges-snippet {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px dashed #e5e5e5;
    text-align: center;
  }

  .szc-trust-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .szc-trust-badge-item__text strong {
    display: block;
    font-size: 11px;
    font-weight: 700;
    color: #111111;
    line-height: 1.2;
  }

  .szc-trust-badge-item__text span {
    display: block;
    font-size: 10px;
    color: #666666;
    line-height: 1.2;
  }
{% endstylesheet %}
