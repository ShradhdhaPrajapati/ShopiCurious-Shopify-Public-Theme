{% doc %}
  Renders social media sharing links (Facebook, Pinterest, X/Twitter, WhatsApp, Email, Copy Link) for products and blog articles.

  @param {string} share_title - The page or product title to share
  @param {string} share_permalink - Canonical URL to share
  @param {image} [share_image] - Product image or featured image for Pinterest sharing
  @param {string} [class] - Additional CSS class names

  @example
  {% render 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product.featured_image %}
{% enddoc %}

{%- liquid
  assign title = share_title | default: page_title | url_param_escape
  assign permalink = share_permalink | default: canonical_url | url_param_escape
  assign custom_class = class | default: ''
  if share_image != blank
    assign img_url = share_image | image_url: width: 1024 | url_param_escape
  endif
-%}

<div class="szc-social-sharing {{ custom_class }}">
  <span class="szc-social-sharing__label">{{ 'general.share.share_url' | t | default: 'Share:' }}</span>
  <ul class="szc-social-sharing__list" role="list">
    <!-- Facebook -->
    <li class="szc-social-sharing__item">
      <a
        href="//www.facebook.com/sharer.php?u={{ permalink }}"
        class="szc-social-sharing__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.share.share_on_facebook' | t | default: 'Share on Facebook' }}"
      >
        <svg class="szc-social-sharing__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
    </li>

    <!-- X / Twitter -->
    <li class="szc-social-sharing__item">
      <a
        href="//twitter.com/intent/tweet?text={{ title }}&url={{ permalink }}"
        class="szc-social-sharing__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.share.share_on_twitter' | t | default: 'Share on X' }}"
      >
        <svg class="szc-social-sharing__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </li>

    <!-- Pinterest -->
    {%- if img_url != blank -%}
      <li class="szc-social-sharing__item">
        <a
          href="//pinterest.com/pin/create/button/?url={{ permalink }}&media={{ img_url }}&description={{ title }}"
          class="szc-social-sharing__link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ 'general.share.share_on_pinterest' | t | default: 'Share on Pinterest' }}"
        >
          <svg class="szc-social-sharing__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
        </a>
      </li>
    {%- endif -%}

    <!-- WhatsApp -->
    <li class="szc-social-sharing__item">
      <a
        href="//api.whatsapp.com/send?text={{ title }}%20{{ permalink }}"
        class="szc-social-sharing__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ 'general.share.share_on_whatsapp' | t | default: 'Share on WhatsApp' }}"
      >
        <svg class="szc-social-sharing__icon" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
      </a>
    </li>
  </ul>
</div>

{% stylesheet %}
  .szc-social-sharing {
    display: flex;
    align-items: center;
    gap: var(--szc-space-3, 12px);
  }

  .szc-social-sharing__label {
    font-family: var(--szc-font-family-body);
    font-size: var(--szc-font-size-xs, 12px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--szc-letter-spacing-wide, 0.05em);
    color: var(--szc-color-text-muted, #757575);
  }

  .szc-social-sharing__list {
    display: flex;
    align-items: center;
    gap: var(--szc-space-2, 8px);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .szc-social-sharing__item {
    display: inline-flex;
  }

  .szc-social-sharing__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--szc-color-text-primary, #2b2b2b);
    background-color: var(--szc-color-surface, #f8f9fa);
    transition: all var(--szc-transition-fast, 150ms ease);
    text-decoration: none;
  }

  .szc-social-sharing__link:hover {
    color: var(--szc-color-primary, #111111);
    background-color: var(--szc-color-secondary, #d4a373);
    transform: translateY(-2px);
  }

  .szc-social-sharing__icon {
    width: 16px;
    height: 16px;
  }
{% endstylesheet %}
