{% doc %}
  Renders the ShopziCurious luxury slide-out AJAX Cart Drawer pixel-matched to approved UI design.
  Includes free shipping progress bar, line items, order notes, financial summary breakdown, 
  checkout CTAs, and footer trust badges.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

{%- liquid
  assign free_shipping_threshold = settings.free_shipping_threshold | default: 10000
  assign cart_total = cart.total_price
  assign amount_left = free_shipping_threshold | minus: cart_total

  if free_shipping_threshold > 0
    if amount_left <= 0
      assign shipping_progress = 100
      assign free_shipping_reached = true
    else
      assign shipping_progress = cart_total | times: 100.0 | divided_by: free_shipping_threshold
      assign free_shipping_reached = false
    endif
  endif
-%}

{%- if settings.cart_type == 'drawer' -%}
<cart-drawer id="CartDrawer" class="szc-drawer szc-cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
  <div class="szc-drawer__overlay" data-drawer-close></div>

  <div class="szc-drawer__container">
    <!-- Drawer Header -->
    <div class="szc-drawer__header">
      <h2 id="CartDrawerTitle" class="szc-drawer__title">
        YOUR CART <span class="szc-drawer__count">({{ cart.item_count }})</span>
      </h2>
      <button
        type="button"
        class="szc-drawer__close-btn"
        data-drawer-close
        aria-label="Close cart"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Free Shipping Progress Bar -->
    {%- if free_shipping_threshold > 0 -%}
      <div class="szc-cart-drawer__shipping-bar">
        <div class="szc-cart-drawer__shipping-text">
          {%- if free_shipping_reached -%}
            <span>You qualify for <strong>FREE shipping!</strong></span>
          {%- else -%}
            <span>You're <strong>{{ amount_left | money }}</strong> away from free shipping!</span>
          {%- endif -%}
        </div>
        <div class="szc-cart-drawer__progress-row">
          <div class="szc-cart-drawer__progress-track">
            <div class="szc-cart-drawer__progress-fill" style="width: {{ shipping_progress }}%;"></div>
          </div>
          <span class="szc-cart-drawer__progress-target">{{ free_shipping_threshold | money }}</span>
        </div>
      </div>
    {%- endif -%}

    <!-- Main Content Body -->
    <div class="szc-drawer__body">
      {%- if cart.item_count > 0 -%}
        <div class="szc-cart-drawer__items">
          {%- for item in cart.items -%}
            <div class="szc-cart-drawer__item" data-line-index="{{ forloop.index }}" data-key="{{ item.key }}">
              <!-- Item Thumbnail -->
              <a href="{{ item.url }}" class="szc-cart-drawer__item-media">
                {%- if item.image != blank -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.title | escape }}"
                    width="90"
                    height="105"
                    loading="lazy"
                    class="szc-cart-drawer__item-img"
                  >
                {%- else -%}
                  <div class="szc-cart-drawer__item-placeholder">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </a>

              <!-- Item Details -->
              <div class="szc-cart-drawer__item-details">
                <a href="{{ item.url }}" class="szc-cart-drawer__item-title">
                  {{ item.product.title }}
                </a>

                {%- unless item.product.has_only_default_variant -%}
                  <div class="szc-cart-drawer__item-options">
                    {%- for option in item.options_with_values -%}
                      <span>{{ option.value }}</span>{%- unless forloop.last -%} <span class="szc-cart-drawer__dot">•</span> {%- endunless -%}
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

                <div class="szc-cart-drawer__item-price">
                  {%- if item.original_price != item.final_price -%}
                    <s class="szc-price--compare">{{ item.original_price | money }}</s>
                    <span class="szc-price--final">{{ item.final_line_price | money }}</span>
                  {%- else -%}
                    <span>{{ item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>

                <!-- Quantity & Remove Row -->
                <div class="szc-cart-drawer__item-bottom">
                  <div class="szc-cart-drawer__quantity-stepper">
                    <button
                      type="button"
                      class="szc-cart-drawer__qty-btn"
                      data-action="minus"
                      data-line="{{ forloop.index }}"
                      aria-label="Decrease quantity"
                    >-</button>
                    <input
                      type="number"
                      class="szc-cart-drawer__qty-input"
                      value="{{ item.quantity }}"
                      min="0"
                      data-line="{{ forloop.index }}"
                      aria-label="Quantity"
                      readonly
                    >
                    <button
                      type="button"
                      class="szc-cart-drawer__qty-btn"
                      data-action="plus"
                      data-line="{{ forloop.index }}"
                      aria-label="Increase quantity"
                    >+</button>
                  </div>

                  <button
                    type="button"
                    class="szc-cart-drawer__remove-btn"
                    data-action="remove"
                    data-line="{{ forloop.index }}"
                    aria-label="Remove {{ item.title | escape }}"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      <line x1="10" y1="11" x2="10" y2="17"></line>
                      <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Order Notes Collapsible -->
        <details class="szc-cart-drawer__notes-accordion">
          <summary class="szc-cart-drawer__notes-summary">
            <span>ORDER NOTES</span>
            <svg class="szc-cart-drawer__notes-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="szc-cart-drawer__notes-content">
            <textarea
              name="note"
              class="szc-cart-drawer__note-input"
              placeholder="Add a note about your order"
            >{{ cart.note }}</textarea>
          </div>
        </details>

        <!-- Discount Code Collapsible -->
        <details class="szc-cart-drawer__notes-accordion szc-cart-drawer__discount-accordion" open>
          <summary class="szc-cart-drawer__notes-summary">
            <span>DISCOUNT CODE</span>
            <svg class="szc-cart-drawer__notes-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="szc-cart-drawer__notes-content">
            <div class="szc-discount-box szc-discount-box--drawer">
              <div class="szc-discount-form-row">
                <label for="DrawerCartDiscountInput" class="visually-hidden">Discount Code</label>
                <input
                  type="text"
                  id="DrawerCartDiscountInput"
                  name="discount"
                  class="szc-discount-input{% if cart.cart_level_discount_applications.size > 0 %} is-applied{% endif %}"
                  placeholder="Enter discount code"
                  aria-label="Enter discount code"
                  aria-describedby="DrawerDiscountStatusMessage"
                  value="{% if cart.cart_level_discount_applications.size > 0 %}{{ cart.cart_level_discount_applications.first.title }}{% endif %}"
                  {% if cart.cart_level_discount_applications.size > 0 %}disabled{% endif %}
                  autocomplete="off"
                >
                <button
                  type="button"
                  class="szc-discount-apply-btn{% if cart.cart_level_discount_applications.size > 0 %} is-applied{% endif %}"
                  id="DrawerApplyDiscountBtn"
                  aria-label="Apply discount code"
                  {% if cart.cart_level_discount_applications.size > 0 %}disabled{% endif %}
                >
                  <span class="szc-btn-text">
                    {%- if cart.cart_level_discount_applications.size > 0 -%}
                      ✓ APPLIED
                    {%- else -%}
                      APPLY
                    {%- endif -%}
                  </span>
                  <span class="szc-btn-spinner-wrapper" style="display:none;" aria-hidden="true">
                    <svg class="szc-btn-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.2" stroke-width="2.5"></circle>
                      <path d="M12 2 a 10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                    </svg>
                  </span>
                </button>
              </div>

              <!-- Applied Discount Tag Pill -->
              <div id="DrawerDiscountTagsContainer" class="szc-discount-tags">
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  {%- for discount_application in cart.cart_level_discount_applications -%}
                    <div class="szc-discount-tag" data-discount-title="{{ discount_application.title }}">
                      <svg class="szc-tag-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                      </svg>
                      <span class="szc-tag-title">{{ discount_application.title }}</span>
                      <button type="button" class="szc-tag-remove-btn" data-remove-discount aria-label="Remove discount {{ discount_application.title }}">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </button>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>

              <div id="DrawerDiscountStatusMessage" class="szc-discount-status" aria-live="polite" style="display:none;"></div>
            </div>
          </div>
        </details>
      {%- else -%}
        <!-- Empty Cart State -->
        <div class="szc-cart-drawer__empty">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#999999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <p class="szc-cart-drawer__empty-title">Your cart is currently empty</p>
          <a href="{{ routes.all_products_collection_url }}" class="szc-button szc-button--primary szc-cart-drawer__continue-btn">
            CONTINUE SHOPPING
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Drawer Footer Summary & Checkout -->
    {%- if cart.item_count > 0 -%}
      <div class="szc-drawer__footer">
        <div class="szc-cart-drawer__summary">
          <div class="szc-summary-row">
            <span class="szc-summary-row__label">Subtotal</span>
            <span class="szc-summary-row__val">{{ cart.original_total_price | money }}</span>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount_application in cart.cart_level_discount_applications -%}
              <div class="szc-summary-row szc-summary-row--discount">
                <div class="szc-summary-discount-info" style="display:flex; align-items:center; gap:8px;">
                  <span class="szc-summary-row__label">Discount</span>
                  <div class="szc-discount-tag" data-discount-title="{{ discount_application.title }}">
                    <svg class="szc-tag-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                      <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span class="szc-tag-title">{{ discount_application.title }}</span>
                    <button type="button" class="szc-tag-remove-btn" data-remove-discount aria-label="Remove discount">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>
                </div>
                <span class="szc-summary-row__val szc-summary-val--discount">-{{ discount_application.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- elsif cart.total_discount > 0 -%}
            <div class="szc-summary-row szc-summary-row--discount">
              <div class="szc-summary-discount-info" style="display:flex; align-items:center; gap:8px;">
                <span class="szc-summary-row__label">Discount</span>
                {%- if cart.discount_applications.size > 0 -%}
                  <div class="szc-discount-tag" data-discount-title="{{ cart.discount_applications.first.title }}">
                    <svg class="szc-tag-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                      <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span class="szc-tag-title">{{ cart.discount_applications.first.title }}</span>
                    <button type="button" class="szc-tag-remove-btn" data-remove-discount aria-label="Remove discount">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                      </svg>
                    </button>
                  </div>
                {%- endif -%}
              </div>
              <span class="szc-summary-row__val szc-summary-val--discount">-{{ cart.total_discount | money }}</span>
            </div>
          {%- endif -%}

          <div class="szc-summary-row">
            <span class="szc-summary-row__label">Shipping</span>
            <span class="szc-summary-row__subtext">Calculated at checkout</span>
          </div>

          <div class="szc-summary-row">
            <span class="szc-summary-row__label">
              Estimated Taxes 
              <span class="szc-tooltip-icon" title="Taxes estimated based on location">?</span>
            </span>
            <span class="szc-summary-row__val">{{ cart.total_tax | money }}</span>
          </div>

          <hr class="szc-cart-drawer__divider">

          <div class="szc-summary-row szc-summary-row--total">
            <span class="szc-summary-row__label">Total</span>
            <span class="szc-summary-row__val">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="szc-cart-drawer__cta-group">
          <a href="{{ routes.cart_url }}" class="szc-cart-btn szc-cart-btn--view">
            VIEW CART
          </a>

          <form action="{{ routes.cart_url }}" method="post" id="CartDrawerCheckoutForm">
            <button type="submit" name="checkout" class="szc-cart-btn szc-cart-btn--checkout">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>CHECKOUT SECURELY</span>
            </button>
          </form>
        </div>

        <!-- Footer Trust Badges -->
        {% render 'trust-badges' %}
      </div>
    {%- endif -%}
  </div>
</cart-drawer>
{%- endif -%}

{% stylesheet %}
  .szc-cart-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 250ms ease, visibility 250ms ease;
  }

  .szc-cart-drawer.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .szc-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .szc-drawer__container {
    position: relative;
    width: 100%;
    max-width: 430px;
    height: 100%;
    background-color: #ffffff;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    z-index: 2;
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .szc-cart-drawer.is-open .szc-drawer__container {
    transform: translateX(0);
  }

  /* Drawer Header */
  .szc-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 16px 24px;
    background-color: #ffffff;
  }

  .szc-drawer__title {
    margin: 0;
    font-family: var(--szc-font-family-heading, Georgia, serif);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #111111;
    text-transform: uppercase;
  }

  .szc-drawer__count {
    font-weight: 500;
    color: #111111;
  }

  .szc-drawer__close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #111111;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 150ms ease;
  }

  .szc-drawer__close-btn:hover {
    opacity: 0.7;
  }

  /* Shipping Progress Bar */
  .szc-cart-drawer__shipping-bar {
    padding: 10px 24px 16px 24px;
    background-color: #ffffff;
  }

  .szc-cart-drawer__shipping-text {
    font-size: 13px;
    color: #111111;
    text-align: center;
    margin-bottom: 10px;
  }

  .szc-cart-drawer__progress-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .szc-cart-drawer__progress-track {
    flex: 1;
    height: 8px;
    background-color: #f0ece6;
    border-radius: 999px;
    overflow: hidden;
  }

  .szc-cart-drawer__progress-fill {
    height: 100%;
    background-color: #b07d4f;
    border-radius: 999px;
    transition: width 300ms ease;
  }

  .szc-cart-drawer__progress-target {
    font-size: 13px;
    font-weight: 700;
    color: #111111;
    flex-shrink: 0;
  }

  /* Drawer Body */
  .szc-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 12px 24px 20px 24px;
  }

  .szc-cart-drawer__items {
    display: flex;
    flex-direction: column;
  }

  .szc-cart-drawer__item {
    display: flex;
    gap: 16px;
    padding-bottom: 18px;
    margin-bottom: 18px;
    border-bottom: 1px solid #f0f0f0;
  }

  .szc-cart-drawer__item-media {
    width: 90px;
    height: 105px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f7f5f0;
    display: block;
  }

  .szc-cart-drawer__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .szc-cart-drawer__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .szc-cart-drawer__item-title {
    font-size: 14px;
    font-weight: 600;
    color: #111111;
    text-decoration: none;
    line-height: 1.3;
    display: block;
    margin-bottom: 3px;
  }

  .szc-cart-drawer__item-title:hover {
    color: #b07d4f;
  }

  .szc-cart-drawer__item-options {
    font-size: 12px;
    color: #666666;
    margin-bottom: 6px;
  }

  .szc-cart-drawer__dot {
    margin: 0 4px;
    color: #999999;
  }

  .szc-cart-drawer__item-price {
    font-size: 14px;
    font-weight: 700;
    color: #111111;
  }

  .szc-price--compare {
    color: #888888;
    margin-right: 6px;
    font-weight: 400;
    font-size: 12px;
  }

  .szc-cart-drawer__item-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
  }

  .szc-cart-drawer__quantity-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    height: 34px;
    background-color: #ffffff;
    overflow: hidden;
  }

  .szc-cart-drawer__qty-btn {
    width: 32px;
    height: 100%;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 500;
    color: #333333;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease;
  }

  .szc-cart-drawer__qty-btn:hover {
    background-color: #f5f5f5;
  }

  .szc-cart-drawer__qty-input {
    width: 36px;
    height: 100%;
    border: none;
    outline: none;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    color: #111111;
    background: transparent;
    -moz-appearance: textfield;
  }

  .szc-cart-drawer__qty-input::-webkit-outer-spin-button,
  .szc-cart-drawer__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .szc-cart-drawer__remove-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #333333;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 150ms ease;
    margin-left: auto;
  }

