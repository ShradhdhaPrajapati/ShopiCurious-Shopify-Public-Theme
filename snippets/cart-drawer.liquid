{% doc %}
  Renders the high-converting slide-out AJAX Cart Drawer with free shipping progress bar,
  line items list, quantity steppers, cart notes, and checkout CTA.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

{%- liquid
  assign free_shipping_threshold = settings.free_shipping_threshold | default: 10000
  assign cart_total = cart.total_price
  assign amount_left = free_shipping_threshold | minus: cart_total

  if free_shipping_threshold > 0
    if amount_left <= 0
      assign shipping_progress = 100
      assign free_shipping_reached = true
    else
      assign shipping_progress = cart_total | times: 100 | divided_by: free_shipping_threshold
      assign free_shipping_reached = false
    endif
  endif
-%}

<cart-drawer id="CartDrawer" class="szc-drawer szc-cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
  <div class="szc-drawer__overlay" data-drawer-close></div>

  <div class="szc-drawer__container">
    <!-- Header -->
    <div class="szc-drawer__header">
      <h2 id="CartDrawerTitle" class="szc-drawer__title">
        {{ 'sections.cart.title' | t | default: 'Your Shopping Bag' }}
        <span class="szc-drawer__count">({{ cart.item_count }})</span>
      </h2>
      <button
        type="button"
        class="szc-drawer__close-btn"
        data-drawer-close
        aria-label="{{ 'accessibility.close' | t | default: 'Close cart' }}"
      >
        {% render 'icon', icon: 'close', class: 'szc-drawer__close-icon' %}
      </button>
    </div>

    <!-- Free Shipping Progress Bar -->
    {%- if free_shipping_threshold > 0 -%}
      <div class="szc-cart-drawer__shipping-bar" data-threshold="{{ free_shipping_threshold }}">
        <div class="szc-cart-drawer__shipping-text">
          {%- if free_shipping_reached -%}
            <span>🎉 {{ 'sections.cart.free_shipping_reached' | t | default: 'Congratulations! You qualify for FREE Shipping!' }}</span>
          {%- else -%}
            <span>
              {{ 'sections.cart.free_shipping_remaining_html' | t: amount: amount_left | default: 'Add ' }}
              <strong>{{ amount_left | money }}</strong>
              {{ 'sections.cart.free_shipping_more' | t | default: ' more to get FREE Shipping' }}
            </span>
          {%- endif -%}
        </div>
        <div class="szc-cart-drawer__progress-track">
          <div class="szc-cart-drawer__progress-fill" style="width: {{ shipping_progress }}%;"></div>
        </div>
      </div>
    {%- endif -%}

    <!-- Main Content Area -->
    <div class="szc-drawer__body">
      {%- if cart.item_count > 0 -%}
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" class="szc-cart-drawer__form">
          <div class="szc-cart-drawer__items" data-cart-items>
            {%- for item in cart.items -%}
              <div class="szc-cart-drawer__item" data-key="{{ item.key }}" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="szc-cart-drawer__item-media">
                  {% render 'image',
                    image: item.image,
                    aspect_ratio: '1/1',
                    loading: 'lazy',
                    class: 'szc-cart-drawer__item-image'
                  %}
                </a>

                <div class="szc-cart-drawer__item-details">
                  <div class="szc-cart-drawer__item-top">
                    <h3 class="szc-cart-drawer__item-title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h3>
                    <button
                      type="button"
                      class="szc-cart-drawer__item-remove"
                      data-remove-line="{{ forloop.index }}"
                      aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                    >
                      {% render 'icon', icon: 'trash', class: 'szc-cart-drawer__remove-icon' %}
                    </button>
                  </div>

                  {%- unless item.product.has_only_default_variant -%}
                    <div class="szc-cart-drawer__item-options">
                      {{ item.variant.title }}
                    </div>
                  {%- endunless -%}

                  <div class="szc-cart-drawer__item-bottom">
                    {% render 'quantity-input',
                      line: forloop.index,
                      value: item.quantity,
                      min: 0,
                      class: 'szc-cart-drawer__quantity'
                    %}

                    <div class="szc-cart-drawer__item-price">
                      {%- if item.original_price != item.final_price -%}
                        <s class="szc-price__item--regular">{{ item.original_price | money }}</s>
                        <span class="szc-price__item--sale">{{ item.final_price | money }}</span>
                      {%- else -%}
                        <span>{{ item.final_line_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </form>
      {%- else -%}
        <div class="szc-cart-drawer__empty">
          {% render 'icon', icon: 'bag', class: 'szc-cart-drawer__empty-icon' %}
          <p class="szc-cart-drawer__empty-text">{{ 'sections.cart.empty' | t | default: 'Your shopping bag is currently empty.' }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="szc-button szc-button--primary">
            {{ 'general.continue_shopping' | t | default: 'Start Shopping' }}
          </a>
        </div>
      {%- endif -%}

      {%- comment -%} Optional cart drawer upsells {%- endcomment -%}
      {%- if false -%}
        {% render 'product-card-horizontal', card_product: nil %}
      {%- endif -%}
    </div>

    <!-- Footer Subtotal & Checkout -->
    {%- if cart.item_count > 0 -%}
      <div class="szc-drawer__footer">
        <div class="szc-cart-drawer__subtotal-row">
          <span class="szc-cart-drawer__subtotal-label">{{ 'sections.cart.subtotal' | t | default: 'Subtotal' }}</span>
          <span class="szc-cart-drawer__subtotal-value">{{ cart.total_price | money }}</span>
        </div>

        <p class="szc-cart-drawer__taxes-note">
          {{ 'sections.cart.taxes_and_shipping_at_checkout' | t | default: 'Taxes and shipping calculated at checkout.' }}
        </p>

        <div class="szc-cart-drawer__buttons">
          <button
            type="submit"
            name="checkout"
            form="CartDrawerForm"
            class="szc-button szc-button--primary szc-button--full-width szc-cart-drawer__checkout-btn"
          >
            {% render 'icon', icon: 'bag', class: 'szc-button__icon' %}
            <span>{{ 'sections.cart.checkout' | t | default: 'Proceed to Checkout' }}</span>
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% stylesheet %}
  .szc-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: var(--szc-z-drawer, 500);
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all var(--szc-transition-base, 250ms ease);
  }

  .szc-drawer.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .szc-drawer__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--szc-color-overlay, rgba(0, 0, 0, 0.5));
    backdrop-filter: blur(var(--szc-backdrop-blur, 4px));
  }

  .szc-drawer__container {
    position: relative;
    width: 100%;
    max-width: 440px;
    height: 100%;
    background-color: var(--szc-color-background, #ffffff);
    box-shadow: var(--szc-shadow-xl);
    display: flex;
    flex-direction: column;
    z-index: 2;
    transform: translateX(100%);
    transition: transform var(--szc-transition-base, 250ms ease);
  }

  .szc-drawer.is-open .szc-drawer__container {
    transform: translateX(0);
  }

  .szc-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--szc-space-4, 16px) var(--szc-space-6, 24px);
    border-bottom: 1px solid var(--szc-color-border, #e5e5e5);
  }

  .szc-drawer__title {
    margin: 0;
    font-family: var(--szc-font-family-heading);
    font-size: var(--szc-font-size-lg, 18px);
    font-weight: 600;
  }

  .szc-drawer__close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--szc-color-text-primary, #111111);
  }

  .szc-drawer__close-icon {
    width: 20px;
    height: 20px;
  }

  /* Free Shipping Bar */
  .szc-cart-drawer__shipping-bar {
    padding: var(--szc-space-3, 12px) var(--szc-space-6, 24px);
    background-color: var(--szc-color-surface, #f8f9fa);
    border-bottom: 1px solid var(--szc-color-border, #e5e5e5);
    font-size: var(--szc-font-size-xs, 12px);
    text-align: center;
  }

  .szc-cart-drawer__progress-track {
    width: 100%;
    height: 6px;
    background-color: var(--szc-color-border, #e5e5e5);
    border-radius: 9999px;
    margin-top: 8px;
    overflow: hidden;
  }

  .szc-cart-drawer__progress-fill {
    height: 100%;
    background-color: var(--szc-color-success, #2a9d8f);
    transition: width var(--szc-transition-base, 250ms ease);
  }

  .szc-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: var(--szc-space-6, 24px);
  }

  .szc-cart-drawer__item {
    display: flex;
    gap: var(--szc-space-4, 16px);
    padding-bottom: var(--szc-space-4, 16px);
    margin-bottom: var(--szc-space-4, 16px);
    border-bottom: 1px solid var(--szc-color-border-subtle, #f0f0f0);
  }

  .szc-cart-drawer__item-media {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: var(--szc-radius-sm, 4px);
    overflow: hidden;
  }

  .szc-cart-drawer__item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .szc-cart-drawer__item-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .szc-cart-drawer__item-title {
    margin: 0;
    font-size: var(--szc-font-size-sm, 14px);
    font-weight: 600;
  }

  .szc-cart-drawer__item-title a {
    color: var(--szc-color-text-primary, #111111);
    text-decoration: none;
  }

  .szc-cart-drawer__item-remove {
    background: transparent;
    border: none;
    color: var(--szc-color-text-muted, #757575);
    cursor: pointer;
  }

  .szc-cart-drawer__remove-icon {
    width: 16px;
    height: 16px;
  }

  .szc-cart-drawer__item-options {
    font-size: 12px;
    color: var(--szc-color-text-muted, #757575);
  }

  .szc-cart-drawer__item-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
  }

  .szc-drawer__footer {
    padding: var(--szc-space-6, 24px);
    border-top: 1px solid var(--szc-color-border, #e5e5e5);
    background-color: var(--szc-color-background, #ffffff);
  }

  .szc-cart-drawer__subtotal-row {
    display: flex;
    justify-content: space-between;
    font-size: var(--szc-font-size-base, 16px);
    font-weight: 700;
  }

  .szc-cart-drawer__taxes-note {
    font-size: 12px;
    color: var(--szc-color-text-muted, #757575);
    margin: 6px 0 16px 0;
  }

  .szc-cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    text-align: center;
  }

  .szc-cart-drawer__empty-icon {
    width: 48px;
    height: 48px;
    color: var(--szc-color-text-muted, #757575);
    margin-bottom: 16px;
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cart-drawer')) {
    customElements.define(
      'cart-drawer',
      class CartDrawer extends HTMLElement {
        constructor() {
          super();
          this.container = this.querySelector('.szc-drawer__container');

          this.querySelectorAll('[data-drawer-close]').forEach((btn) =>
            btn.addEventListener('click', this.close.bind(this))
          );

          document.addEventListener('click', (e) => {
            const trigger = e.target.closest('.szc-cart-trigger');
            if (trigger) {
              e.preventDefault();
              this.open();
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.classList.contains('is-open')) {
              this.close();
            }
          });
        }

        open() {
          this.classList.add('is-open');
          this.setAttribute('aria-hidden', 'false');
          if (window.ShopziCurious && window.ShopziCurious.trapFocus) {
            window.ShopziCurious.trapFocus(this.container);
          }
        }

        close() {
          this.classList.remove('is-open');
          this.setAttribute('aria-hidden', 'true');
          if (window.ShopziCurious && window.ShopziCurious.removeTrapFocus) {
            window.ShopziCurious.removeTrapFocus(this.container);
          }
        }
      }
    );
  }
{% endjavascript %}
