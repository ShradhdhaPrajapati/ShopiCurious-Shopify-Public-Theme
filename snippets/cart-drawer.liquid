{% endstylesheet %}

{% javascript %}
  if (!customElements.get('cart-drawer')) {
    customElements.define(
      'cart-drawer',
      class CartDrawer extends HTMLElement {
        constructor() {
          super();
          this.initDrawer();
        }

        initDrawer() {
          // Close listeners
          this.querySelectorAll('[data-drawer-close]').forEach((btn) => {
            btn.addEventListener('click', () => this.close());
          });

          // Global trigger listener
          document.addEventListener('click', (e) => {
            const cartType = (window.ShopziCurious && window.ShopziCurious.settings && window.ShopziCurious.settings.cartType) ? window.ShopziCurious.settings.cartType : 'drawer';
            if (cartType === 'page') return;

            const trigger = e.target.closest('.szc-cart-trigger');
            if (trigger && !e.target.closest('form')) {
              e.preventDefault();
              this.open();
            }
          });

          // Keyboard ESC listener
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.classList.contains('is-open')) {
              this.close();
            }
          });

          // AJAX Quantity Stepper & Remove listener
          this.addEventListener('click', (e) => {
            const actionBtn = e.target.closest('[data-action]');
            if (!actionBtn) return;

            const action = actionBtn.dataset.action;
            const line = actionBtn.dataset.line;
            if (!line) return;

            const qtyInput = this.querySelector(`input.szc-cart-drawer__qty-input[data-line="${line}"]`);
            let currentQty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;

            if (action === 'plus') {
              this.updateCartLine(line, currentQty + 1);
            } else if (action === 'minus') {
              this.updateCartLine(line, Math.max(0, currentQty - 1));
            } else if (action === 'remove') {
              this.updateCartLine(line, 0);
            }
          });

          // --- Drawer Discount Code Logic ---
          const drawerDiscountInput = this.querySelector('#DrawerCartDiscountInput');
          const drawerApplyBtn = this.querySelector('#DrawerApplyDiscountBtn');
          const drawerStatusDiv = this.querySelector('#DrawerDiscountStatusMessage');

          if (drawerDiscountInput) {
            drawerDiscountInput.addEventListener('input', () => {
              drawerDiscountInput.classList.remove('szc-discount-input--error');
              drawerDiscountInput.removeAttribute('aria-invalid');
              if (drawerStatusDiv) {
                drawerStatusDiv.style.display = 'none';
                drawerStatusDiv.innerHTML = '';
              }
              if (drawerApplyBtn && drawerApplyBtn.classList.contains('is-applied')) {
                drawerApplyBtn.classList.remove('is-applied');
                const textSpan = drawerApplyBtn.querySelector('.szc-btn-text');
                if (textSpan) textSpan.textContent = 'APPLY';
              }
            });

            drawerDiscountInput.addEventListener('keydown', (e) => {
              if (e.key === 'Enter') {
                e.preventDefault();
                if (drawerApplyBtn && !drawerApplyBtn.disabled) {
                  drawerApplyBtn.click();
                }
              }
            });
          }

          if (drawerApplyBtn) {
            drawerApplyBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              if (window._szcIsApplyingDrawerDiscount) return;
              window._szcIsApplyingDrawerDiscount = true;

              const input = this.querySelector('#DrawerCartDiscountInput');
              const status = this.querySelector('#DrawerDiscountStatusMessage');
              const rawCode = input ? input.value.trim() : '';

              if (status) {
                status.style.display = 'none';
                status.innerHTML = '';
              }
              if (input) {
                input.classList.remove('szc-discount-input--error');
                input.removeAttribute('aria-invalid');
              }

              if (!rawCode) {
                if (input) {
                  input.classList.add('szc-discount-input--error');
                  input.setAttribute('aria-invalid', 'true');
                  input.focus();
                }
                if (status) {
                  status.style.display = 'block';
                  status.className = 'szc-discount-status szc-discount-status--error';
                  status.textContent = 'Please enter a valid discount code.';
                }
                window._szcIsApplyingDrawerDiscount = false;
                return;
              }

              drawerApplyBtn.disabled = true;
              if (input) input.disabled = true;
              const textSpan = drawerApplyBtn.querySelector('.szc-btn-text');
              const spinnerWrapper = drawerApplyBtn.querySelector('.szc-btn-spinner-wrapper');
              if (textSpan) textSpan.style.display = 'none';
              if (spinnerWrapper) spinnerWrapper.style.display = 'inline-flex';

              try {
                await fetch(`/discount/${encodeURIComponent(rawCode)}?redirect=/cart`);

                const cartRes = await fetch(`/cart.js?_t=${Date.now()}`, { cache: 'no-store' });
                const cartData = await cartRes.json();
                const applications = (cartData && cartData.cart_level_discount_applications) || [];

                if (applications.length > 0 || (cartData && cartData.total_discount > 0)) {
                  await this.refreshCart(true);
                  if (window.ShopziCurious && window.ShopziCurious.refreshCartPage) {
                    await window.ShopziCurious.refreshCartPage();
                  }
                  if (window.ShopziCurious && window.ShopziCurious.showToast) {
                    window.ShopziCurious.showToast('Discount applied successfully.');
                  }
                } else {
                  if (input) {
                    input.disabled = false;
                    input.classList.add('szc-discount-input--error');
                    input.setAttribute('aria-invalid', 'true');
                    input.focus();
                  }
                  if (drawerApplyBtn) {
                    drawerApplyBtn.disabled = false;
                    drawerApplyBtn.classList.remove('is-applied');
                    const newTextSpan = drawerApplyBtn.querySelector('.szc-btn-text');
                    if (newTextSpan) newTextSpan.textContent = 'APPLY';
                  }
                  if (status) {
                    status.style.display = 'block';
                    status.className = 'szc-discount-status szc-discount-status--error';
                    status.textContent = 'Invalid discount code. Please check and try again.';
                  }
                }
              } catch (err) {
                console.error('Failed to apply drawer discount:', err);
                if (input) {
                  input.disabled = false;
                  input.classList.add('szc-discount-input--error');
                }
                if (drawerApplyBtn) drawerApplyBtn.disabled = false;
                if (status) {
                  status.style.display = 'block';
                  status.className = 'szc-discount-status szc-discount-status--error';
                  status.textContent = 'Invalid discount code. Please check and try again.';
                }
              } finally {
                window._szcIsApplyingDrawerDiscount = false;
                if (textSpan) textSpan.style.display = 'inline';
                if (spinnerWrapper) spinnerWrapper.style.display = 'none';
              }
            });
          }

          this.querySelectorAll('[data-remove-discount]').forEach((removeBtn) => {
            removeBtn.addEventListener('click', async (e) => {
              e.preventDefault();
              removeBtn.disabled = true;

              try {
                await fetch('/cart/update.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                  body: JSON.stringify({ discount: "" })
                });
                await fetch('/discount/CLEAR?redirect=/cart');
                await fetch('/cart?discount=');

                await this.refreshCart(true);
                if (window.ShopziCurious && window.ShopziCurious.refreshCartPage) {
                  await window.ShopziCurious.refreshCartPage();
                }

                if (window.ShopziCurious && window.ShopziCurious.showToast) {
                  window.ShopziCurious.showToast('Discount removed');
                }
              } catch (err) {
                console.error('Failed to remove discount from drawer:', err);
              }
            });
          });

          // Listen for Global Cart Updated events (e.g. Add to Cart)
          if (window.ShopziCurious && window.ShopziCurious.pubsub) {
            window.ShopziCurious.pubsub.subscribe('cart:updated', (data) => {
              this.refreshCart(data && data.openDrawer);
            });
            window.ShopziCurious.pubsub.subscribe('CART_UPDATED', (data) => {
              this.refreshCart(data && data.openDrawer);
            });
          }

        }

        open() {
          this.classList.add('is-open');
          this.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        close() {
          this.classList.remove('is-open');
          this.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        async updateCartLine(line, quantity) {
          try {
            const res = await fetch('/cart/change.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ line: parseInt(line, 10), quantity: parseInt(quantity, 10) })
            });
            if (res.ok) {
              this.refreshCart(true);
              if (window.ShopziCurious && window.ShopziCurious.refreshCartPage) {
                await window.ShopziCurious.refreshCartPage();
              }
            }
          } catch (err) {
            console.error('Failed to update cart line:', err);
          }
        }

        async refreshCart(openDrawer = false) {
          try {
            const res = await fetch(window.location.href);
            const text = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(text, 'text/html');
            const newDrawer = doc.querySelector('#CartDrawer');

            if (newDrawer) {
              this.innerHTML = newDrawer.innerHTML;
              this.initDrawer();
            }

            // Update cart count badges on page
            const cartRes = await fetch('/cart.js');
            const cartData = await cartRes.json();
            document.querySelectorAll('[data-cart-count], .szc-header__cart-count').forEach(el => {
              el.textContent = cartData.item_count;
            });

            if (openDrawer) {
              this.open();
            }
          } catch (err) {
            console.error('Failed to refresh cart drawer:', err);
          }
        }
      }
    );
  }
{% endjavascript %}
