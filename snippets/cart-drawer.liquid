    height: 15px;
    border-radius: 50%;
    background-color: #e5e5e5;
    color: #666666;
    font-size: 10px;
    font-weight: 700;
    margin-left: 4px;
    cursor: help;
  }

  .szc-cart-drawer__divider {
    border: none;
    border-top: 1px solid #e5e5e5;
