{% doc %}
  Renders a high-converting fashion product card matching the approved ShopziCurious UI design pixel-for-pixel.

  @param {product} [card_product] - Product Liquid object to display
  @param {string} [title_override] - Title override for demo placeholder
  @param {string} [price_override] - Price override for demo placeholder
  @param {number} [rating_count] - Review count for demo placeholder
  @param {string} [media_aspect_ratio] - Aspect ratio override ('3/4', '4/5', '1/1', Default: '3/4')
  @param {boolean} [show_secondary_image] - Displays secondary hover image if available
  @param {boolean} [show_vendor] - Displays vendor/brand name if true
  @param {boolean} [show_rating] - Displays product rating stars if true
  @param {boolean} [show_price] - Displays product price if true
  @param {boolean} [show_quick_add] - Displays quick add to cart button if true
  @param {boolean} [show_quick_view] - Displays quick view modal trigger if true
  @param {boolean} [lazy_load] - Uses native lazy loading if true (Default: true)
  @param {string} [class] - Additional CSS class names

  @example
  {% render 'product-card', card_product: product, show_secondary_image: true, show_rating: true %}
{% enddoc %}

{%- liquid
  assign product = card_product
  assign aspect_ratio = media_aspect_ratio | default: settings.product_card_aspect_ratio | default: '3/4'
  assign show_secondary = show_secondary_image | default: settings.product_card_show_secondary_image | default: true
  assign show_brand = show_vendor | default: false
  assign display_rating = show_rating | default: settings.product_card_show_rating | default: true
  assign display_price = show_price | default: settings.product_card_show_price | default: true
  assign show_view = show_quick_view | default: false
  assign show_add = show_quick_add | default: settings.product_card_show_quick_add | default: true
  assign is_lazy = lazy_load | default: true
  assign custom_class = class | default: ''

  assign loading_attr = 'lazy'
  if is_lazy == false
    assign loading_attr = 'eager'
  endif

  assign featured_img = product.featured_media.preview_image
  assign second_img = product.media[1].preview_image

  assign demo_title = title_override | default: 'Oversized Knit Sweater'
  assign demo_price = price_override | default: '$59.99'
  assign demo_reviews = rating_count | default: 24
-%}

{%- if product != blank -%}
  <product-card class="szc-product-card {{ custom_class }}" data-product-handle="{{ product.handle }}">
    <div class="szc-product-card__media-container" style="aspect-ratio: {{ aspect_ratio }};">
      <a href="{{ product.url }}" class="szc-product-card__media-link" aria-label="{{ product.title | escape }}">
        {%- if featured_img != blank -%}
          {% render 'image',
            image: featured_img,
            aspect_ratio: aspect_ratio,
            loading: loading_attr,
            class: 'szc-product-card__image szc-product-card__image--primary'
          %}
          {%- if show_secondary and second_img != blank -%}
            {% render 'image',
              image: second_img,
              aspect_ratio: aspect_ratio,
              loading: 'lazy',
              class: 'szc-product-card__image szc-product-card__image--secondary'
            %}
          {%- endif -%}
        {%- else -%}
          <div class="szc-product-card__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
          </div>
        {%- endif -%}
      </a>

      <!-- Badges Overlay -->
      <div class="szc-product-card__badges">
        {%- if product.available == false -%}
          {% render 'badge', label: 'Sold Out', type: 'sold-out', size: 'sm' %}
        {%- elsif product.compare_at_price > product.price -%}
          {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          {%- assign badge_label = savings | prepend: '-' | append: '%' -%}
          {% render 'badge', label: badge_label, type: 'sale', size: 'sm' %}
        {%- elsif product.tags contains 'New' or product.tags contains 'new' -%}
          {% render 'badge', label: 'New', type: 'new', size: 'sm' %}
        {%- endif -%}
      </div>

      <!-- Wishlist Action Top-Right -->
      <div class="szc-product-card__actions">
        <button
          type="button"
          class="szc-product-card__wishlist-btn"
          aria-label="{{ 'products.product.wishlist_add' | t | default: 'Add to Wishlist' }}"
        >
          {% render 'icon', icon: 'heart', class: 'szc-product-card__wishlist-icon' %}
        </button>
        {%- if show_view -%}
          <button
            type="button"
            class="szc-product-card__wishlist-btn szc-quick-view-btn"
            data-product-handle="{{ product.handle }}"
            aria-label="{{ 'products.product.quick_view' | t | default: 'Quick View' }}"
          >
            {% render 'icon', icon: 'eye', class: 'szc-product-card__wishlist-icon' %}
          </button>
        {%- endif -%}
      </div>

      <!-- Quick Add Overlay Button -->
      {%- if show_add and product.available -%}
        <div class="szc-product-card__quick-add">
          {%- if product.has_only_default_variant -%}
            <button
              type="button"
              class="szc-button szc-button--primary szc-button--sm szc-button--full-width szc-quick-add-btn"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            >
              {% render 'icon', icon: 'bag', class: 'szc-button__icon' %}
              <span>{{ 'products.product.add_to_cart' | t | default: 'Quick Add' }}</span>
            </button>
          {%- else -%}
            <a
              href="{{ product.url }}"
              class="szc-button szc-button--secondary szc-button--sm szc-button--full-width"
            >
              <span>{{ 'products.product.choose_options' | t | default: 'Choose Options' }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info Details -->
    <div class="szc-product-card__info">
      {%- if show_brand and product.vendor != blank -%}
        <div class="szc-product-card__vendor">{{ product.vendor }}</div>
      {%- endif -%}

      <h3 class="szc-product-card__title">
        <a href="{{ product.url }}" class="szc-product-card__title-link">
          {{ product.title }}
        </a>
      </h3>

      {%- if display_price -%}
        <div class="szc-product-card__price-wrapper">
          {% render 'price', product: product, show_badges: false %}
        </div>
      {%- endif -%}

      {%- if display_rating and product.metafields.reviews.rating.value != blank -%}
        {%- liquid
          assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
          assign rating_count_val = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
          assign rating_floor = rating_val | floor
        -%}
        <div class="szc-product-card__rating">
          <div class="szc-product-card__stars" aria-label="{{ rating_val }} out of 5 stars">
            {%- for i in (1..5) -%}
              {%- if i <= rating_floor -%}
                {% render 'icon', icon: 'star', class: 'szc-star-icon szc-star-icon--filled' %}
              {%- else -%}
                {% render 'icon', icon: 'star-empty', class: 'szc-star-icon szc-star-icon--empty' %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if rating_count_val != blank -%}
            <span class="szc-product-card__review-count">({{ rating_count_val }})</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </product-card>
{%- else -%}
  <!-- Demo Placeholder Product Card matching Approved UI Screenshot -->
  <div class="szc-product-card szc-product-card--placeholder {{ custom_class }}">
    <div class="szc-product-card__media-container" style="aspect-ratio: {{ aspect_ratio }};">
      {{ 'product-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
      <div class="szc-product-card__actions">
        <button type="button" class="szc-product-card__wishlist-btn" aria-label="Add to Wishlist">
          {% render 'icon', icon: 'heart', class: 'szc-product-card__wishlist-icon' %}
        </button>
      </div>
    </div>
    <div class="szc-product-card__info">
      <h3 class="szc-product-card__title">
        <span class="szc-product-card__title-link">{{ demo_title }}</span>
      </h3>
      {%- if display_price -%}
        <div class="szc-product-card__price-wrapper">
          <span class="szc-price__item">{{ demo_price }}</span>
        </div>
      {%- endif -%}
      {%- if display_rating -%}
        <div class="szc-product-card__rating">
          <div class="szc-product-card__stars">
            {%- for i in (1..5) -%}
              {% render 'icon', icon: 'star', class: 'szc-star-icon szc-star-icon--filled' %}
            {%- endfor -%}
          </div>
          <span class="szc-product-card__review-count">({{ demo_reviews }})</span>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .szc-product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    border-radius: 12px;
    background-color: #ffffff;
    border: 1px solid #f0f0f0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    overflow: hidden;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .szc-product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
  }

  .szc-product-card__media-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f7f5f0;
  }

  .szc-product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .szc-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .szc-product-card:hover .szc-product-card__image--primary {
    transform: scale(1.04);
  }

  .szc-product-card__image--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .szc-product-card:hover .szc-product-card__image--secondary {
    opacity: 1;
  }

  .szc-product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f0eee9;
  }

  /* Badges Overlay */
  .szc-product-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 2;
  }

  /* Wishlist Button Top-Right */
  .szc-product-card__actions {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .szc-product-card__wishlist-btn {
    background: #ffffff;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #111111;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: all 200ms ease;
    padding: 0;
  }

  .szc-product-card__wishlist-btn:hover {
    background: #ffffff;
    color: #e63946;
    transform: scale(1.08);
  }

  .szc-product-card__wishlist-icon {
    width: 16px;
    height: 16px;
  }

  /* Quick Add Overlay Button */
  .szc-product-card__quick-add {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    z-index: 3;
    opacity: 0;
    transform: translateY(8px);
    transition: all 250ms ease;
  }

  .szc-product-card:hover .szc-product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  /* Info Details */
  .szc-product-card__info {
    padding: 14px 16px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: #ffffff;
  }

  .szc-product-card__vendor {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #757575;
  }

  .szc-product-card__title {
    margin: 0;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .szc-product-card__title-link {
    color: #111111;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-product-card__title-link:hover {
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-product-card__price-wrapper {
    font-weight: 700;
    font-size: 14px;
    color: #111111;
    margin-top: 2px;
  }

  .szc-price__item {
    font-weight: 700;
    color: #111111;
  }

  .szc-product-card__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .szc-product-card__stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .szc-star-icon {
    width: 13px;
    height: 13px;
  }

  .szc-star-icon--filled {
    color: #f4a261;
    fill: #f4a261;
  }

  .szc-star-icon--empty {
    color: #e0e0e0;
    fill: none;
  }

  .szc-product-card__review-count {
    font-size: 12px;
    color: #888888;
  }

  @media screen and (max-width: 480px) {
    .szc-product-card__actions {
      top: 8px;
      right: 8px;
    }

    .szc-product-card__wishlist-btn {
      width: 28px;
      height: 28px;
    }

    .szc-product-card__wishlist-icon {
      width: 14px;
      height: 14px;
    }

    .szc-product-card__info {
      padding: 10px 10px 12px 10px;
    }

    .szc-product-card__title {
      font-size: 12px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .szc-product-card__price-wrapper {
      font-size: 13px;
    }
  }
{% endstylesheet %}
