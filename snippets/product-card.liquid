{% doc %}
  Renders a high-converting fashion product card matching the approved ShopziCurious UI design pixel-for-pixel.

  @param {product} [card_product] - Product Liquid object to display
  @param {string} [title_override] - Title override for demo placeholder
  @param {string} [price_override] - Price override for demo placeholder
  @param {string} [media_aspect_ratio] - Aspect ratio override ('3/4', '4/5', '1/1', Default: '3/4')
  @param {boolean} [show_secondary_image] - Displays secondary hover image if available
  @param {boolean} [show_vendor] - Displays vendor/brand name if true
  @param {boolean} [show_price] - Displays product price if true
  @param {boolean} [show_quick_add] - Displays quick add to cart button if true
  @param {boolean} [show_quick_view] - Displays quick view modal trigger if true
  @param {boolean} [lazy_load] - Uses native lazy loading if true (Default: true)
  @param {string} [class] - Additional CSS class names

  @example
{% enddoc %}

{%- liquid
  assign product = card_product
  assign raw_aspect = media_aspect_ratio
  if raw_aspect == 'theme' or raw_aspect == blank or raw_aspect == 'default'
    assign raw_aspect = settings.product_card_image_ratio | default: settings.product_card_aspect_ratio | default: '3/4'
  endif
  
  if raw_aspect == 'natural' or raw_aspect == 'adapt'
    if product != blank and product.featured_media.preview_image != blank
      assign aspect_ratio = product.featured_media.preview_image.aspect_ratio
    else
      assign aspect_ratio = '1'
    endif
    assign is_fixed_aspect = false
  elsif raw_aspect == '1/1' or raw_aspect == 'square'
    assign aspect_ratio = '1/1'
    assign is_fixed_aspect = true
  elsif raw_aspect == '3/4' or raw_aspect == 'portrait'
    assign aspect_ratio = '3/4'
    assign is_fixed_aspect = true
  elsif raw_aspect == '2/3'
    assign aspect_ratio = '2/3'
    assign is_fixed_aspect = true
  elsif raw_aspect == 'landscape' or raw_aspect == '4/3'
    assign aspect_ratio = '4/3'
    assign is_fixed_aspect = true
  else
    assign aspect_ratio = raw_aspect
    assign is_fixed_aspect = true
  endif
  
  assign show_secondary = true
  if settings.show_secondary_image == false or settings.product_card_show_secondary_image == false
    assign show_secondary = false
  elsif show_secondary_image == false
    assign show_secondary = false
  elsif show_secondary_image == true
    assign show_secondary = true
  elsif settings.show_secondary_image != blank
    assign show_secondary = settings.show_secondary_image
  elsif settings.product_card_show_secondary_image != blank
    assign show_secondary = settings.product_card_show_secondary_image
  endif

  assign show_brand = show_vendor | default: false

  assign display_price = true
  if show_price == false
    assign display_price = false
  elsif show_price == true
    assign display_price = true
  endif

  assign show_view = true
  if settings.enable_quick_shop == false
    assign show_view = false
  elsif show_quick_view == false
    assign show_view = false
  elsif show_quick_view == true
    assign show_view = true
  elsif settings.enable_quick_shop != blank
    assign show_view = settings.enable_quick_shop
  endif

  assign show_add = true
  if show_quick_add == false
    assign show_add = false
  elsif show_quick_add == true
    assign show_add = true
  endif

  assign is_lazy = lazy_load | default: true
  assign custom_class = class | default: ''

  assign loading_attr = 'lazy'
  if is_lazy == false
    assign loading_attr = 'eager'
  endif

  assign featured_img = product.featured_media.preview_image
  assign second_img = product.media[1].preview_image

  assign demo_title = title_override | default: 'Oversized Knit Sweater'
  assign demo_price = price_override | default: '$59.99'
-%}

{%- if product != blank -%}
  <product-card class="szc-product-card {% if is_fixed_aspect %}szc-product-card--fixed-ratio{% endif %} {{ custom_class }}">
    <div class="szc-product-card__media-container" style="aspect-ratio: {{ aspect_ratio }};">
      <a href="{{ product.url }}" class="szc-product-card__media-link" aria-label="{{ product.title | escape }}">
        {%- if featured_img != blank -%}
          {% render 'image',
            image: featured_img,
            aspect_ratio: aspect_ratio,
            loading: loading_attr,
            class: 'szc-product-card__image szc-product-card__image--primary'
          %}
          {%- if show_secondary and second_img != blank -%}
            {% render 'image',
              image: second_img,
              aspect_ratio: aspect_ratio,
              loading: 'lazy',
              class: 'szc-product-card__image szc-product-card__image--secondary'
            %}
          {%- endif -%}
        {%- else -%}
          <div class="szc-product-card__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
          </div>
        {%- endif -%}
      </a>

      <!-- Badges Overlay -->
      <div class="szc-product-card__badges">
        {%- if product.available == false -%}
          {% render 'badge', label: 'Sold Out', type: 'sold-out', size: 'sm' %}
        {%- elsif product.compare_at_price > product.price and settings.show_sale_badge != false -%}
          {%- assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
          {%- assign badge_label = savings | prepend: '-' | append: '%' -%}
          {% render 'badge', label: badge_label, type: 'sale', size: 'sm' %}
        {%- else -%}
          {%- assign is_new = false -%}
          {%- if product.tags contains 'New' or product.tags contains 'new' -%}
            {%- assign is_new = true -%}
          {%- endif -%}
          {%- assign is_bestseller = false -%}
          {%- if product.tags contains 'Bestseller' or product.tags contains 'bestseller' -%}
            {%- assign is_bestseller = true -%}
          {%- endif -%}
          {%- assign is_limited = false -%}
          {%- if product.tags contains 'Limited' or product.tags contains 'limited' -%}
            {%- assign is_limited = true -%}
          {%- endif -%}

          {%- if is_new -%}
            {% render 'badge', label: 'New', type: 'new', size: 'sm' %}
          {%- elsif is_bestseller -%}
            {% render 'badge', label: 'Best Seller', type: 'bestseller', size: 'sm' %}
          {%- elsif is_limited -%}
            {% render 'badge', label: 'Limited', type: 'limited', size: 'sm' %}
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- Wishlist Action Top-Right -->
      <div class="szc-product-card__actions">
        {%- if settings.enable_wishlist != false and settings.enable_wishlist_button != false -%}
          <button
            type="button"
            class="szc-product-card__wishlist-btn"
            data-wishlist-toggle
            data-product-handle="{{ product.handle }}"
            data-product-id="{{ product.selected_or_first_available_variant.id | default: product.id }}"
            data-product-title="{{ product.title | escape }}"
            data-product-price="{{ product.price | money }}"
            data-product-compare-price="{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money }}{% endif %}"
            data-product-image="{% if featured_img != blank %}{{ featured_img | image_url: width: 600 }}{% elsif product.featured_media != blank %}{{ product.featured_media | image_url: width: 600 }}{% elsif product.featured_image != blank %}{{ product.featured_image | image_url: width: 600 }}{% endif %}"
            data-product-url="{{ product.url }}"
            data-product-vendor="{{ product.vendor | escape }}"
            data-product-available="{{ product.available }}"
            aria-label="{{ 'products.product.wishlist_add' | t | default: 'Add to Wishlist' }}"
          >
            <span class="szc-wishlist-icon-wrap">
              {% render 'icon', icon: 'heart', class: 'szc-product-card__wishlist-icon' %}
            </span>
          </button>
        {%- endif -%}
        {%- if show_view -%}
          <button
            type="button"
            class="szc-product-card__wishlist-btn szc-quick-view-btn"
            data-product-handle="{{ product.handle }}"
            data-quick-view-trigger
            aria-label="{{ 'products.product.quick_view' | t | default: 'Quick View' }}"
          >
            {% render 'icon', icon: 'eye', class: 'szc-product-card__wishlist-icon' %}
          </button>
        {%- endif -%}
      </div>

      <!-- Quick Add Overlay Button -->
      {%- if show_add and product.available -%}
        <div class="szc-product-card__quick-add">
          {%- if product.has_only_default_variant -%}
            <button
              type="button"
              class="szc-button szc-button--primary szc-button--sm szc-button--full-width szc-quick-add-btn"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            >
              {% render 'icon', icon: 'bag', class: 'szc-button__icon' %}
              <span>{{ 'products.product.add_to_cart' | t | default: 'Quick Add' }}</span>
            </button>
          {%- else -%}
            <a
              href="{{ product.url }}"
              class="szc-button szc-button--secondary szc-button--sm szc-button--full-width"
            >
              <span>{{ 'products.product.choose_options' | t | default: 'Choose Options' }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Info Details -->
    <div class="szc-product-card__info">
      {%- if show_brand and product.vendor != blank -%}
        <div class="szc-product-card__vendor">{{ product.vendor }}</div>
      {%- endif -%}

      <h3 class="szc-product-card__title">
        <a href="{{ product.url }}" class="szc-product-card__title-link">
          {{ product.title }}
        </a>
      </h3>

      {%- if display_price -%}
        <div class="szc-product-card__price-wrapper">
          {% render 'price', product: product, show_badges: false %}
        </div>
      {%- endif -%}

      {%- if settings.enable_color_swatches != false -%}
        {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
        {%- if color_option == blank -%}
          {%- assign color_option = product.options_with_values | where: 'name', 'color' | first -%}
        {%- endif -%}
        {%- if color_option != blank and color_option.values.size > 0 -%}
          <div class="szc-product-card__swatches">
            {%- for val in color_option.values limit: 5 -%}
              <span class="szc-card-swatch" style="background-color: {{ val | downcase | remove: ' ' }};" title="{{ val }}"></span>
            {%- endfor -%}
            {%- if color_option.values.size > 5 -%}
              <span class="szc-card-swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
            {%- endif -%}
          </div>
        {%- elsif product == blank -%}
          <div class="szc-product-card__swatches">
            <span class="szc-card-swatch" style="background-color: #111111;" title="Black"></span>
            <span class="szc-card-swatch" style="background-color: #d4a373;" title="Beige"></span>
            <span class="szc-card-swatch" style="background-color: #e0e0e0;" title="White"></span>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.enable_size_swatches != false -%}
        {%- assign size_option = product.options_with_values | where: 'name', 'Size' | first -%}
        {%- if size_option == blank -%}
          {%- assign size_option = product.options_with_values | where: 'name', 'size' | first -%}
        {%- endif -%}
        {%- if size_option != blank and size_option.values.size > 0 -%}
          <div class="szc-product-card__sizes">
            {%- for val in size_option.values limit: 5 -%}
              <span class="szc-card-size-badge">{{ val }}</span>
            {%- endfor -%}
          </div>
        {%- elsif product == blank -%}
          <div class="szc-product-card__sizes">
            <span class="szc-card-size-badge">XS</span>
            <span class="szc-card-size-badge">S</span>
            <span class="szc-card-size-badge">M</span>
            <span class="szc-card-size-badge">L</span>
            <span class="szc-card-size-badge">XL</span>
          </div>
        {%- endif -%}
      {%- endif -%}

      <!-- List View Quick Add / Add to Cart Button -->
      {%- if show_add -%}
        <div class="szc-product-card__list-add">
          {%- if product.available -%}
            {%- if product.has_only_default_variant -%}
              <button
                type="button"
                class="szc-button szc-button--primary szc-button--sm szc-quick-add-btn"
                data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              >
                {% render 'icon', icon: 'bag', class: 'szc-button__icon' %}
                <span>{{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}</span>
              </button>
            {%- else -%}
              <a
                href="{{ product.url }}"
                class="szc-button szc-button--secondary szc-button--sm"
              >
                <span>{{ 'products.product.choose_options' | t | default: 'Choose Options' }}</span>
              </a>
            {%- endif -%}
          {%- else -%}
            <button type="button" class="szc-button szc-button--secondary szc-button--sm" disabled>
              <span>{{ 'products.product.sold_out' | t | default: 'Sold Out' }}</span>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </product-card>
{%- else -%}
  <!-- Demo Placeholder Product Card matching Approved UI Screenshot -->
  <div class="szc-product-card szc-product-card--placeholder {% if is_fixed_aspect %}szc-product-card--fixed-ratio{% endif %} {{ custom_class }}">
    <div class="szc-product-card__media-container" style="aspect-ratio: {{ aspect_ratio }};">
      {{ 'product-1' | placeholder_svg_tag: 'szc-image-placeholder' }}
      <div class="szc-product-card__actions">
        {%- if settings.enable_wishlist != false and settings.enable_wishlist_button != false -%}
          <button type="button" class="szc-product-card__wishlist-btn" aria-label="Add to Wishlist">
            {% render 'icon', icon: 'heart', class: 'szc-product-card__wishlist-icon' %}
          </button>
        {%- endif -%}
      </div>
    </div>
    <div class="szc-product-card__info">
      <h3 class="szc-product-card__title">
        <span class="szc-product-card__title-link">{{ demo_title }}</span>
      </h3>
      {%- if display_price -%}
        <div class="szc-product-card__price-wrapper">
          <span class="szc-price__item">{{ demo_price }}</span>
        </div>
      {%- endif -%}
      <!-- List View Add to Cart Button for Demo -->
      {%- if show_add -%}
        <div class="szc-product-card__list-add">
          <button
            type="button"
            class="szc-button szc-button--primary szc-button--sm szc-quick-add-btn"
          >
            {% render 'icon', icon: 'bag', class: 'szc-button__icon' %}
            <span>Add to Cart</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .szc-product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    border-radius: var(--szc-radius-card, 12px);
    background-color: var(--szc-color-surface, #ffffff);
    border: 1px solid var(--szc-color-border, #f0f0f0);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    overflow: hidden;
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .szc-product-card--fixed-ratio {
    height: 100%;
    flex: 1;
  }

  .szc-product-card--fixed-ratio .szc-product-card__info {
    flex-grow: 1;
  }

  .szc-product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
  }

  .szc-product-card__media-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--szc-color-surface-subtle, #f7f5f0);
  }

  .szc-product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .szc-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .szc-product-card:hover .szc-product-card__image--primary {
    transform: scale(1.04);
  }

  .szc-product-card__image--secondary {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .szc-product-card:hover .szc-product-card__image--secondary {
    opacity: 1;
  }

  .szc-product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--szc-color-surface-subtle, #f0eee9);
  }

  /* Badges Overlay */
  .szc-product-card__badges {
    position: absolute;
    top: 10px;
    left: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 2;
  }

  /* Wishlist Button Top-Right */
  .szc-product-card__actions {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .szc-product-card__wishlist-btn {
    background: var(--szc-color-surface, #ffffff);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--szc-color-text-primary, #111111);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: all 200ms ease;
    padding: 0;
  }

  .szc-product-card__wishlist-btn:hover {
    background: var(--szc-color-surface, #ffffff);
    color: var(--szc-color-error, #e63946);
    transform: scale(1.08);
  }

  .szc-product-card__wishlist-icon {
    width: 16px;
    height: 16px;
  }

  /* Quick Add Overlay Button */
  .szc-product-card__quick-add {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    z-index: 3;
    opacity: 0;
    transform: translateY(8px);
    transition: all 250ms ease;
  }

  .szc-product-card:hover .szc-product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  /* List View Add to Cart Button */
  .szc-product-card__list-add {
    display: none;
    margin-top: 10px;
  }

  /* Info Details */
  .szc-product-card__info {
    padding: 14px 16px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: var(--szc-color-surface, #ffffff);
  }

  .szc-product-card__vendor {
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--szc-color-text-muted, #757575);
  }

  .szc-product-card__title {
    margin: 0;
    font-family: var(--szc-font-family-body, sans-serif);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .szc-product-card__title-link {
    color: var(--szc-color-heading, var(--szc-color-text-primary, #111111));
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-product-card__title-link:hover {
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-product-card__price-wrapper {
    font-weight: 700;
    font-size: 14px;
    color: var(--szc-color-text-primary, #111111);
    margin-top: 2px;
  }

  .szc-price__item {
    font-weight: 700;
    color: var(--szc-color-text-primary, #111111);
  }

  .szc-product-card__rating {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .szc-product-card__stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .szc-star-icon {
    width: 13px;
    height: 13px;
  }

  .szc-star-icon--filled {
    color: var(--szc-color-warning, #f4a261);
    fill: var(--szc-color-warning, #f4a261);
  }

  .szc-star-icon--empty {
    color: var(--szc-color-border, #e0e0e0);
    fill: none;
  }

  .szc-product-card__review-count {
    font-size: 12px;
    color: var(--szc-color-text-muted, #888888);
  }

  @media screen and (max-width: 480px) {
    .szc-product-card__actions {
      top: 8px;
      right: 8px;
    }

    .szc-product-card__wishlist-btn {
      width: 28px;
      height: 28px;
    }

    .szc-product-card__wishlist-icon {
      width: 14px;
      height: 14px;
    }

    .szc-product-card__info {
      padding: 10px 10px 12px 10px;
    }

    .szc-product-card__title {
      font-size: 12px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .szc-product-card__price-wrapper {
      font-size: 13px;
    }
  }

  /* Variant Swatches & Size Badges */
  .szc-product-card__swatches {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
  }

  .szc-card-swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    display: inline-block;
  }

  .szc-card-swatch-more {
    font-size: 10px;
    color: var(--szc-color-text-muted, #777);
  }

  .szc-product-card__sizes {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .szc-card-size-badge {
    font-size: 10px;
    padding: 1px 5px;
    border: 1px solid var(--szc-color-border, #e0e0e0);
    border-radius: 2px;
    color: var(--szc-color-text-secondary, #555);
    line-height: 1.2;
  }

  /* Quick Add Loading State Responsive Fix */
  .szc-product-card__quick-add:has(.szc-btn--loading),
  .szc-product-card__quick-add:has(.is-loading) {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  .szc-quick-add-btn.szc-btn--loading,
  .szc-quick-add-btn.is-loading {
    padding: 0 6px !important;
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden !important;
    justify-content: center !important;
    align-items: center !important;
    white-space: nowrap !important;
  }

  .szc-quick-add-btn.szc-btn--loading .szc-button__icon,
  .szc-quick-add-btn.is-loading .szc-button__icon {
    display: none !important;
  }

  .szc-quick-add-btn.szc-btn--loading::before,
  .szc-quick-add-btn.is-loading::before {
    margin-right: 6px !important;
    flex-shrink: 0 !important;
  }

  .szc-quick-add-btn.szc-btn--loading span,
  .szc-quick-add-btn.is-loading span {
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    font-size: 11px !important;
