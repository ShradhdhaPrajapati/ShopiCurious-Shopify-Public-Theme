{% doc %}
  Renders a primary reusable CTA button or link with optional icon and loading spinner.

  @param {string} label - Text label displayed inside the button
  @param {string} [url] - Destination URL (renders <a> tag instead of <button> if provided)
  @param {string} [type] - Button HTML type ('button', 'submit', 'reset', Default: 'button')
  @param {string} [style] - Visual design variant ('primary', 'secondary', 'accent', 'outline', 'text', Default: 'primary')
  @param {string} [variant] - Visual design variant alias ('primary', 'secondary', 'accent', 'outline', 'text')
  @param {string} [size] - Button size ('sm', 'md', 'lg', Default: 'md')
  @param {string} [icon] - Optional icon name to render inside the button
  @param {string} [icon_position] - Position of icon relative to label ('left' or 'right', Default: 'left')
  @param {string} [class] - Additional CSS class names
  @param {string} [id] - DOM ID attribute
  @param {string} [aria_label] - ARIA accessibility label override
  @param {boolean} [disabled] - Disables the button if true
  @param {boolean} [loading] - Displays loading spinner if true

  @example
  {% render 'button', label: 'Add to Bag', type: 'submit', style: 'primary', icon: 'bag' %}
  {% render 'button', label: 'Explore Collection', url: '/collections/all', style: 'outline' %}
{% enddoc %}

{%- liquid
  assign btn_label = label | default: ''
  assign btn_url = url
  assign btn_type = type | default: 'button'
  assign btn_style = style | default: variant | default: 'primary'
  assign btn_size = size | default: 'md'
  assign btn_icon = icon
  assign btn_icon_pos = icon_position | default: 'left'
  assign btn_class = class | default: ''
  assign btn_id = id
  assign btn_aria = aria_label | default: btn_label | escape
  assign is_disabled = disabled | default: false
  assign is_loading = loading | default: false

  assign full_class = 'szc-button szc-button--' | append: btn_style | append: ' szc-button--' | append: btn_size
  if is_loading
    assign full_class = full_class | append: ' is-loading'
  endif
  if btn_class != blank
    assign full_class = full_class | append: ' ' | append: btn_class
  endif

  if btn_url != blank
    assign tag_name = 'a'
  else
    assign tag_name = 'button'
  endif
-%}

<{{ tag_name }}
  {% if tag_name == 'button' %}
    type="{{ btn_type }}"
    {% if is_disabled or is_loading %}disabled{% endif %}
  {% else %}
    href="{{ btn_url }}"
    {% if is_disabled %}aria-disabled="true" tabindex="-1"{% endif %}
  {% endif %}
  {% if btn_id != blank %}id="{{ btn_id }}"{% endif %}
  class="{{ full_class }}"
  aria-label="{{ btn_aria }}"
>
  {%- if is_loading -%}
    {% render 'icon', icon: 'spinner', class: 'szc-button__spinner' %}
  {%- endif -%}

  {%- if btn_icon != blank and btn_icon_pos == 'left' and is_loading == false -%}
    {% render 'icon', icon: btn_icon, class: 'szc-button__icon szc-button__icon--left' %}
  {%- endif -%}

  <span class="szc-button__text">{{ btn_label }}</span>

  {%- if btn_icon != blank and btn_icon_pos == 'right' and is_loading == false -%}
    {% render 'icon', icon: btn_icon, class: 'szc-button__icon szc-button__icon--right' %}
  {%- endif -%}
</{{ tag_name }}>

{% stylesheet %}
  .szc-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--szc-space-2, 8px);
    height: var(--szc-button-height, 48px);
    padding: 0 var(--szc-space-6, 24px);
    font-family: var(--szc-font-family-body);
    font-size: var(--szc-font-size-sm, 14px);
    font-weight: var(--szc-font-weight-semibold, 600);
    letter-spacing: var(--szc-letter-spacing-wide, 0.05em);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--szc-radius-button, 2px);
    border: 1px solid transparent;
    cursor: pointer;
    user-select: none;
    transition: all var(--szc-transition-fast, 150ms ease);
    position: relative;
    overflow: hidden;
  }

  .szc-button--sm {
    height: 38px;
    padding: 0 var(--szc-space-4, 16px);
    font-size: var(--szc-font-size-xs, 12px);
  }

  .szc-button--lg {
    height: 56px;
    padding: 0 var(--szc-space-8, 32px);
    font-size: var(--szc-font-size-base, 16px);
  }

  /* Style Variants */
  .szc-button--primary {
    background-color: var(--szc-color-primary, #111111);
    color: var(--szc-color-text-inverse, #ffffff);
    border-color: var(--szc-color-primary, #111111);
  }

  .szc-button--primary:hover:not([disabled]) {
    background-color: var(--szc-color-primary-light, #2c2c2c);
    border-color: var(--szc-color-primary-light, #2c2c2c);
    transform: translateY(-2px);
    box-shadow: var(--szc-shadow-md);
  }

  .szc-button--secondary {
    background-color: var(--szc-color-secondary, #d4a373);
    color: var(--szc-color-primary, #111111);
    border-color: var(--szc-color-secondary, #d4a373);
  }

  .szc-button--secondary:hover:not([disabled]) {
    background-color: var(--szc-color-secondary-light, #d6b87b);
    transform: translateY(-2px);
  }

  .szc-button--accent {
    background-color: var(--szc-color-accent, #e76f51);
    color: #ffffff;
    border-color: var(--szc-color-accent, #e76f51);
  }

  .szc-button--accent:hover:not([disabled]) {
    background-color: var(--szc-color-accent-dark, #d64a27);
    transform: translateY(-2px);
  }

  .szc-button--outline {
    background-color: transparent;
    color: var(--szc-color-primary, #111111);
    border-color: var(--szc-color-primary, #111111);
  }

  .szc-button--outline:hover:not([disabled]) {
    background-color: var(--szc-color-primary, #111111);
    color: var(--szc-color-text-inverse, #ffffff);
  }

  .szc-button--text {
    background-color: transparent;
    color: var(--szc-color-primary, #111111);
    border-color: transparent;
    padding: 0;
    height: auto;
  }

  .szc-button--text:hover:not([disabled]) {
    color: var(--szc-color-secondary, #d4a373);
  }

  .szc-button:disabled,
  .szc-button[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }

  .szc-button__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .szc-button__spinner {
    width: 18px;
    height: 18px;
    animation: szc-spin 0.8s linear infinite;
  }

  @keyframes szc-spin {
    to {
      transform: rotate(360deg);
    }
  }
{% endstylesheet %}
