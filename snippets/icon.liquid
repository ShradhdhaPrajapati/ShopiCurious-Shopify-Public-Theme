  {%- when 'instagram' -%}
    <svg class="szc-icon szc-icon--instagram {{ custom_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
