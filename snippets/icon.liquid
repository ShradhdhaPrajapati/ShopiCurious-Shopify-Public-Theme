    </svg>

  {%- when 'shield-check', 'badge-check' -%}
    <svg class="szc-icon szc-icon--shield-check {{ custom_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="5" y="4" width="14" height="16" rx="3"/>
      <polyline points="9 12 11 14 15 10"/>
    </svg>

  {%- when 'user-heart', 'trusted-user' -%}
    <svg class="szc-icon szc-icon--user-heart {{ custom_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
