{% doc %}
  Renders luxury faceted collection filtering sidebar/drawer matching the approved Luxora design.

  @param {object} results - Shopify collection or search object
  @param {boolean} [enable_filtering] - Toggles filter rendering (Default: true)
  @param {boolean} [enable_sorting] - Toggles sort dropdown rendering (Default: false)
  @param {string} [filter_type] - Layout mode ('sidebar', 'drawer', Default: 'sidebar')

  @example
  {% render 'facets', results: collection, enable_filtering: true %}
{% enddoc %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0

  for filter in results.filters
    assign total_active_values = total_active_values | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign total_active_values = total_active_values | plus: 1
      endif
    endif
  endfor
-%}

<facet-filters-form class="szc-facets szc-facets--{{ filter_type | default: 'sidebar' }}">
  <form id="FacetFiltersForm" class="szc-facets__form">
    {%- if results.terms -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input type="hidden" name="type" value="product">
    {%- endif -%}

    <div class="szc-facets__wrapper">
      <!-- 1. ACTIVE FILTERS PILL BAR -->
      {%- if total_active_values > 0 -%}
        <div class="szc-facets__active-bar">
          <span class="szc-facets__active-heading">{{ 'products.facets.active_filters' | t | default: 'Active Filters:' }}</span>
          <div class="szc-facets__active-list">
            {%- for filter in results.filters -%}
              {%- for value in filter.active_values -%}
                <a href="{{ value.url_to_remove }}" class="szc-facets__active-pill">
                  <span>{{ filter.label }}: {{ value.label }}</span>
                  {% render 'icon', icon: 'close', class: 'szc-facets__active-icon' %}
                </a>
              {%- endfor -%}

              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                  <a href="{{ filter.url_to_remove }}" class="szc-facets__active-pill">
                    <span>
                      {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
                      -
                      {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
                    </span>
                    {% render 'icon', icon: 'close', class: 'szc-facets__active-icon' %}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            <a href="{{ results.url }}" class="szc-facets__clear-all">
              {{ 'products.facets.clear_all' | t | default: 'Clear all' }}
            </a>
          </div>
        </div>
      {%- endif -%}

      <!-- 2. CATEGORIES SIDEBAR LIST (DYNAMIC WITH CIRCULAR THUMBNAILS) -->
      <div class="szc-facets__block szc-facets__block--categories">
        <h3 class="szc-facets__heading">CATEGORIES</h3>
        <ul class="szc-facets__category-list" role="list">
          {%- assign valid_collections_count = 0 -%}
          {%- for col in collections -%}
            {%- if col.all_products_count > 0 -%}
              {%- assign valid_collections_count = valid_collections_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if valid_collections_count > 0 -%}
            <li>
              <a href="{{ routes.all_products_collection_url }}" class="szc-facets__category-link {% if collection.handle == 'all' or collection.handle == blank %}is-active{% endif %}">
                <span class="szc-facets__category-name">All Products</span>
                <span class="szc-facets__count">({{ collections.all.all_products_count | default: collection.products_count }})</span>
              </a>
            </li>
            {%- for col in collections -%}
              {%- if col.all_products_count > 0 -%}
                <li>
                  <a href="{{ col.url }}" class="szc-facets__category-link {% if collection.handle == col.handle %}is-active{% endif %}">
                    <span class="szc-facets__category-name">{{ col.title }}</span>
                    <span class="szc-facets__count">({{ col.all_products_count }})</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>

      <!-- 3. FILTER BY ACCORDION GROUPS -->
      {%- if enable_filtering != false -%}
        <div class="szc-facets__block szc-facets__block--filters">
          {%- if results.filters.size > 0 -%}
            {%- for filter in results.filters -%}
              {%- capture filter_content -%}
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    {%- assign is_color = false -%}
                    {%- assign label_down = filter.label | downcase -%}
                    {%- if label_down contains 'color' or label_down contains 'colour' -%}
                      {%- assign is_color = true -%}
                    {%- endif -%}

                    {%- if is_color -%}
                      <!-- CIRCULAR COLOR SWATCHES -->
                      <div class="szc-facets__swatches">
                        {%- for value in filter.values -%}
                          {%- liquid
                            assign color_name = value.label | downcase | strip
                            assign bg_style = color_name
                            if color_name == 'beige'
                              assign bg_style = '#d8c3a5'
                            elsif color_name == 'navy'
                              assign bg_style = '#1b2a4a'
                            elsif color_name == 'olive'
                              assign bg_style = '#556b2f'
                            elsif color_name == 'mauve'
                              assign bg_style = '#915c83'
                            elsif color_name == 'dark green'
                              assign bg_style = '#2d3a2f'
                            elsif color_name == 'brown'
                              assign bg_style = '#5c4033'
                            endif
                          -%}
                          <label class="szc-facet-swatch {% if value.active %}is-active{% endif %}" title="{{ value.label }}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              class="szc-facet-swatch__input"
                              {% if value.active %}checked{% endif %}
                            >
                            <span class="szc-facet-swatch__color" style="background-color: {{ bg_style }};"></span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <!-- CHECKBOX LIST -->
                      <ul class="szc-facets__list" role="list">
                        {%- for value in filter.values -%}
                          <li class="szc-facets__item">
                            <label class="szc-facets__label {% if value.count == 0 and value.active == false %}is-disabled{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                class="szc-facets__checkbox"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              <span class="szc-facets__text">{{ value.label }}</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                  {%- when 'price_range' -%}
                    {%- liquid
                      assign max_price_val = filter.range_max | money_without_currency | replace: ',', '' | floor | default: 5000
                      if max_price_val == 0
                        assign max_price_val = 5000
                      endif
                      assign current_min = filter.min_value.value | money_without_currency | replace: ',', '' | floor | default: 0
                      assign current_max = filter.max_value.value | money_without_currency | replace: ',', '' | floor | default: max_price_val
                      assign curr_symbol = cart.currency.symbol | default: '$'
                      assign is_price_active = false
                      if filter.min_value.value != null or filter.max_value.value != null
                        assign is_price_active = true
                      endif
                    -%}
                    <div
                      class="szc-price-slider {% if is_price_active %}is-active{% endif %}"
                      data-price-slider
                      data-max-limit="{{ max_price_val }}"
                    >
                      <div class="szc-price-slider__range-container">
                        <div class="szc-price-slider__track"></div>
                        <div class="szc-price-slider__progress" data-slider-progress></div>
                        <input
                          type="range"
                          class="szc-price-slider__input szc-price-slider__input--min"
                          min="0"
                          max="{{ max_price_val }}"
                          value="{{ current_min }}"
                          step="1"
                          data-range-min
                          aria-label="Minimum price"
                        >
                        <input
                          type="range"
                          class="szc-price-slider__input szc-price-slider__input--max"
                          min="0"
                          max="{{ max_price_val }}"
                          value="{{ current_max }}"
                          step="1"
                          data-range-max
                          aria-label="Maximum price"
                        >
                      </div>

                      <div class="szc-price-slider__label">
                        <span class="szc-price-slider__text">
                          Price: <span class="szc-price-slider__value-display" data-label-display>
                            {%- if is_price_active -%}
                              <span class="szc-price-slider__currency">{{ curr_symbol }}</span><span data-label-min>{{ current_min }}</span> - <span class="szc-price-slider__currency">{{ curr_symbol }}</span><span data-label-max>{{ current_max }}</span>
                            {%- else -%}
                              Any Price
                            {%- endif -%}
                          </span>
                        </span>
                      </div>

                      <input
                        type="hidden"
                        name="{{ filter.min_value.param_name }}"
                        value="{% if filter.min_value.value %}{{ current_min }}{% endif %}"
                        data-hidden-min
                      >
                      <input
                        type="hidden"
                        name="{{ filter.max_value.param_name }}"
                        value="{% if filter.max_value.value %}{{ current_max }}{% endif %}"
                        data-hidden-max
                      >
                    </div>
                {%- endcase -%}
              {%- endcapture -%}

              {% render 'accordion',
                heading: filter.label,
                content: filter_content,
                open: true,
                class: 'szc-facets__group'
              %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </form>
</facet-filters-form>

{% stylesheet %}
  .szc-facets {
    display: block;
    width: 100%;
  }

  .szc-facets__heading {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--szc-color-text-primary, #111111);
    margin: 0 0 16px 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--szc-color-border, #e5e5e5);
  }

  .szc-facets__block {
    margin-bottom: 32px;
  }

  .szc-facets__category-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .szc-facets__category-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 13px;
    color: var(--szc-color-text-secondary, #444444);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .szc-facets__category-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .szc-facets__category-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
    transition: transform 150ms ease;
  }

  .szc-facets__category-link:hover .szc-facets__category-thumb {
    transform: scale(1.1);
  }

  .szc-facets__category-thumb-placeholder {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--szc-color-surface-subtle, #f4f3ef);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #555555;
  }

  .szc-facets__category-thumb-placeholder svg,
  .szc-facets__category-icon {
    width: 12px;
    height: 12px;
  }

  .szc-facets__category-link:hover,
  .szc-facets__category-link.is-active {
    color: var(--szc-color-primary, #111111);
    font-weight: 600;
  }

  .szc-facets__count {
    font-size: 12px;
    color: var(--szc-color-text-muted, #888888);
  }

  /* COLOR SWATCHES */
  .szc-facets__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 6px;
    padding-bottom: 12px;
  }

  .szc-facet-swatch {
    position: relative;
    cursor: pointer;
    display: inline-flex;
  }

  .szc-facet-swatch__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .szc-facet-swatch__color {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.15);
    display: block;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .szc-facet-swatch:hover .szc-facet-swatch__color {
    transform: scale(1.15);
  }

  .szc-facet-swatch__input:checked + .szc-facet-swatch__color,
  .szc-facet-swatch.is-active .szc-facet-swatch__color {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 3px #111111;
  }

  /* CHECKBOX LIST */
  .szc-facets__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .szc-facets__item {
    padding: 4px 0;
  }

  .szc-facets__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--szc-color-text-secondary, #444444);
    cursor: pointer;
  }

  .szc-facets__checkbox {
    accent-color: var(--szc-color-primary, #111111);
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }

  /* DUAL PRICE SLIDER (MATCHING SHOPIFY THEME STORE ARCHITECTURE) */
  .szc-price-slider {
    padding: 10px 0 6px 0;
  }

  .szc-price-slider__range-container {
    position: relative;
    width: 100%;
    height: 28px;
    display: flex;
    align-items: center;
  }

  .szc-price-slider__track {
    position: absolute;
    width: 100%;
    height: 5px;
    background-color: #e2e8f0;
    border-radius: 5px;
  }

  /* Neutral when inactive, active color bar ONLY when .is-active */
  .szc-price-slider__progress {
    position: absolute;
    height: 5px;
    background-color: #1b4947;
    border-radius: 5px;
    z-index: 1;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .szc-price-slider.is-active .szc-price-slider__progress {
    opacity: 1;
  }

  .szc-price-slider__input {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 0;
    width: 100%;
    height: 5px;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
    margin: 0;
    z-index: 2;
  }

  /* Range Thumbs */
  .szc-price-slider__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    border: 3.5px solid #a0aec0;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
    transition: transform 150ms ease, border-color 200ms ease, box-shadow 150ms ease;
  }

  .szc-price-slider__input::-moz-range-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    border: 3.5px solid #a0aec0;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12);
    transition: transform 150ms ease, border-color 200ms ease, box-shadow 150ms ease;
  }

  /* When slider is active, handles get active dark teal border */
  .szc-price-slider.is-active .szc-price-slider__input::-webkit-slider-thumb {
    border-color: #1b4947;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .szc-price-slider.is-active .szc-price-slider__input::-moz-range-thumb {
    border-color: #1b4947;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .szc-price-slider__input::-webkit-slider-thumb:hover,
  .szc-price-slider__input::-webkit-slider-thumb:active {
    transform: scale(1.18);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
  }

  .szc-price-slider__input::-moz-range-thumb:hover,
  .szc-price-slider__input::-moz-range-thumb:active {
    transform: scale(1.18);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
  }

  .szc-price-slider__label {
    margin-top: 10px;
  }

  .szc-price-slider__text {
    font-size: 14px;
    font-weight: 500;
    color: #2d3748;
  }

  .szc-price-slider__currency {
    font-weight: 600;
  }

  .szc-facets__active-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    margin-bottom: 16px;
    border-bottom: 1px solid #e5e5e5;
  }

  .szc-facets__active-heading {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .szc-facets__active-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .szc-facets__active-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    font-size: 11px;
    background-color: #f4f3ef;
    border-radius: 12px;
    text-decoration: none;
    color: #111;
  }

  .szc-facets__active-icon {
    width: 10px;
    height: 10px;
  }

  .szc-facets__clear-all {
    font-size: 11px;
    color: #777;
    text-decoration: underline;
  }
{% endstylesheet %}

{% javascript %}
  function initPriceSliders() {
    const sliders = document.querySelectorAll('[data-price-slider]');
    sliders.forEach(function(slider) {
      const minInput = slider.querySelector('[data-range-min]');
      const maxInput = slider.querySelector('[data-range-max]');
      const progress = slider.querySelector('[data-slider-progress]');
      const labelDisplay = slider.querySelector('[data-label-display]');
      const hiddenMin = slider.querySelector('[data-hidden-min]');
      const hiddenMax = slider.querySelector('[data-hidden-max]');

      if (!minInput || !maxInput) return;

      const maxLimit = parseFloat(slider.getAttribute('data-max-limit')) || parseFloat(minInput.max) || 5000;

      function updateUI() {
        let minVal = parseFloat(minInput.value) || 0;
        let maxVal = parseFloat(maxInput.value) || maxLimit;

        if (minVal > maxVal) {
          if (document.activeElement === minInput) {
            minInput.value = maxVal;
            minVal = maxVal;
          } else {
            maxInput.value = minVal;
            maxVal = minVal;
          }
        }

        const isFiltered = (minVal > 0) || (maxVal < maxLimit);

        if (isFiltered) {
          slider.classList.add('is-active');
        } else {
          slider.classList.remove('is-active');
        }

        const pctMin = Math.min(100, Math.max(0, (minVal / maxLimit) * 100));
        const pctMax = Math.min(100, Math.max(0, 100 - (maxVal / maxLimit) * 100));

        if (progress) {
          progress.style.left = pctMin + '%';
          progress.style.right = pctMax + '%';
        }

        if (labelDisplay) {
          if (isFiltered) {
            const curr = slider.querySelector('.szc-price-slider__currency')?.textContent || '$';
            labelDisplay.innerHTML = `<span class="szc-price-slider__currency">${curr}</span>${minVal} - <span class="szc-price-slider__currency">${curr}</span>${maxVal}`;
          } else {
            labelDisplay.textContent = 'Any Price';
          }
        }

        if (hiddenMin) hiddenMin.value = minVal > 0 ? minVal : '';
        if (hiddenMax) hiddenMax.value = maxVal < maxLimit ? maxVal : '';
      }

      minInput.addEventListener('input', updateUI);
      maxInput.addEventListener('input', updateUI);

      const form = slider.closest('form');
      if (form) {
        minInput.addEventListener('change', function() {
          form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        });
        maxInput.addEventListener('change', function() {
          form.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        });
      }

      updateUI();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPriceSliders);
  } else {
    initPriceSliders();
  }

  if (!customElements.get('facet-filters-form')) {
    customElements.define(
      'facet-filters-form',
      class FacetFiltersForm extends HTMLElement {
        constructor() {
          super();
          this.form = this.querySelector('form');
          if (this.form) {
            this.form.addEventListener('input', this.onFormSubmit.bind(this));
            this.form.addEventListener('change', this.onFormSubmit.bind(this));
            this.form.addEventListener('submit', this.onFormSubmit.bind(this));
          }
          initPriceSliders();
        }

        onFormSubmit(e) {
          if (e.target && e.target.type === 'range' && e.type === 'input') {
            return;
          }
          e.preventDefault();
          const formData = new FormData(this.form);
          const searchParams = new URLSearchParams(formData).toString();
          window.location.search = searchParams;
        }
      }
    );
  }
{% endjavascript %}
